  </Item>
  <Item class="ServerScriptService" referent="RBX16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX17">
      <Properties>
        <string name="Name">FlightServer</string>
        <ProtectedString name="Source">-- Independent two-pilot duels with fenced persistent personal statistics.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local PlayerStats = require(script.Parent:WaitForChild("PlayerStats"))
local BattleLab = require(script.Parent:WaitForChild("BattleLab"))
local Telemetry = require(script.Parent:WaitForChild("Telemetry"))
local shared = ReplicatedStorage:WaitForChild("FlightGame")
local PlaneCatalog = require(shared.PlaneCatalog)
local PowerCatalog = require(shared.PowerCatalog)
local CosmeticCatalog = require(shared.CosmeticCatalog)
local Simulation = require(shared.Simulation)
local World = require(shared.World)
local BattleSimulation = require(shared.BattleSimulation)
local SkillCatalog = require(shared.SkillCatalog)
local command, snapshots = shared.Command, shared.Snapshot
-- Distance racing stays available for isolated development. Normal servers
-- enter plane battles unless this server Script explicitly opts in at startup.
local distanceModeEnabled = script:GetAttribute("DistanceModeEnabled") == true
shared:SetAttribute("DistanceModeEnabled",distanceModeEnabled)
World.buildLobby(distanceModeEnabled)

local DURATIONS = {Voting=8, Configure=25, Aim=20, Countdown=3, Flight=45, Results=90}
local VARIANTS = {"Coast", "Skyline", "Storm"}
local GADGETS = {Shield=true, Magnet=true, Boost=true}
local profiles, matches, queues = {}, {}, {}
-- PLAY searches briefly for a human rival, then starts a labelled ghost flight.
local QUICK_FALLBACK = 6
local quickQueue, baySlots = {}, {}
local clubBest = nil
local shuttingDown = false
local serverSession = HttpService:GenerateGUID(false)
-- Local Studio deliberately never touches the live player-data store.
local sessionOnly = RunService:IsStudio() or (game.GameId or 0) == 0
local statsStore
if not sessionOnly then
    local ok, store = pcall(function() return game:GetService("DataStoreService"):GetDataStore(PlayerStats.DATASTORE_NAME) end)
    if ok then statsStore=store else warn("SKYBOUND_STATS_UNAVAILABLE", "DataStore initialization failed") end
end
local statsService
statsService=PlayerStats.new({store=statsStore,sessionId=serverSession,sessionOnly=sessionOnly,
    onChanged=function(userId)
        local p=profiles[userId]
        if p and p.statsHandle then
            local _,status=statsService:get(p.statsHandle)
            p.player:SetAttribute("StatsSaveStatus",status)
            if not p.matchId then p.settings.trailId=statsService:getEconomy(p.statsHandle).equippedTrail end
        end
    end})
-- Starter analytics run in published live servers; set this Script attribute to
-- false to opt out. Studio and unpublished sessions never submit events.
local telemetry=Telemetry.new({enabled=not sessionOnly and script:GetAttribute("AnalyticsEnabled")~=false})
local nextMatchId, broadcastAccumulator, queueAccumulator = 0, 0, 0
for _,station in ipairs(World.DUEL_STATIONS) do queues[station.id]={seats={false,false}} end
local function now() return workspace:GetServerTimeNow() end
local function copySettings(s)
    local plane=PlaneCatalog.get(s.planeId) or PlaneCatalog.get(PlaneCatalog.DEFAULT_ID)
    local power=PowerCatalog.get(s.powerId) or PowerCatalog.get(PowerCatalog.DEFAULT_ID)
    return {planeId=plane.id,angle=s.angle or plane.defaultAngle,speed=plane.speed,
        powerId=power.id,gadget=s.gadget or "Shield",color=s.color or 1,
        trailId=CosmeticCatalog.get(s.trailId) and s.trailId or CosmeticCatalog.DEFAULT_ID}
end
local function finite(v) return type(v)=="number" and v==v and v&gt;-math.huge and v&lt;math.huge end
local function safeSettings(input, trailId)
    trailId=trailId or CosmeticCatalog.DEFAULT_ID
    if type(input)~="table" or not PlaneCatalog.isSelectable(input.planeId) or not finite(input.angle) then return nil end
    local plane=PlaneCatalog.get(input.planeId)
    -- Only the catalog can determine speed. Echoing a snapshot is allowed;
    -- obsolete power or fabricated speed cannot change the selected profile.
    if (input.trailId~=nil and input.trailId~=trailId) or input.power~=nil or (input.speed~=nil and input.speed~=plane.speed)
        or (input.launchSpeed~=nil and input.launchSpeed~=plane.speed) then return nil end
    if type(input.gadget)~="string" or not GADGETS[input.gadget] or not finite(input.color) then return nil end
    -- Power identity is the only power field clients may choose. Charges,
    -- trigger state and strength always come from the server simulation.
    if input.powerId~=nil and not PowerCatalog.get(input.powerId) then return nil end
    local power=PowerCatalog.get(input.powerId or PowerCatalog.DEFAULT_ID)
    if not power then return nil end
    return {planeId=plane.id,angle=math.clamp(math.round(input.angle),PlaneCatalog.MIN_ANGLE,PlaneCatalog.MAX_ANGLE),
        speed=plane.speed,gadget=input.gadget,powerId=power.id,
        color=math.clamp(math.round(input.color),1,4),trailId=trailId}
end
local function safeAimSettings(input, locked)
    if type(input)~="table" or not finite(input.angle) then return nil end
    -- The aiming view can send just an angle or echo the whole settings object.
    -- Reject attempted loadout changes atomically, including a Ready payload.
    if (input.planeId~=nil and input.planeId~=locked.planeId)
        or (input.powerId~=nil and input.powerId~=locked.powerId)
        or (input.gadget~=nil and input.gadget~=locked.gadget)
        or (input.color~=nil and input.color~=locked.color)
        or (input.trailId~=nil and input.trailId~=locked.trailId)
        or input.power~=nil or (input.speed~=nil and input.speed~=locked.speed)
        or (input.launchSpeed~=nil and input.launchSpeed~=locked.speed) then return nil end
    local result=copySettings(locked)
    result.angle=math.clamp(math.round(input.angle),PlaneCatalog.MIN_ANGLE,PlaneCatalog.MAX_ANGLE)
    return result
end
local function moveCharacter(p, inMatch)
    local character=p.player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.Anchored=inMatch
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
    character:PivotTo(CFrame.new(inMatch and Vector3.new(0,1000,-3500) or World.LOBBY_SPAWN))
end
local function clearQuick(p)
    if p.quick then
        local index=table.find(quickQueue,p.player.UserId)
        if index then table.remove(quickQueue,index) end
        p.quick=nil
    end
end
local function clearQueue(p)
    clearQuick(p)
    if p.queue then
        local q=queues[p.queue.stationId]
        if q and q.seats[p.queue.seat]==p.player.UserId then q.seats[p.queue.seat]=false; q.fullSince=nil end
        p.queue=nil
    end
end
-- Replicated look attributes let every client render the club's parked planes.
local function publishLook(p)
    local player=p.player
    player:SetAttribute("SkyboundPlane",p.settings.planeId)
    player:SetAttribute("SkyboundColor",p.settings.color)
    player:SetAttribute("SkyboundTrail",p.settings.trailId)
    player:SetAttribute("SkyboundFlying",p.matchId~=nil or p.inBattleLab==true)
    player:SetAttribute("SkyboundBay",p.bay or 0)
end
local function release(p, message)
    clearQueue(p)
    p.matchId=nil; p.ready=false; p.queueCooldown=now()+2
    p.settings.trailId=statsService:getEconomy(p.statsHandle).equippedTrail
    p.message=message or "Walk onto a 1v1 pad with another pilot."
    moveCharacter(p,false)
end
local function voteCounts(m)
    local counts={Coast=0,Skyline=0,Storm=0}
    for _,variant in pairs(m.votes) do counts[variant]+=1 end
    return counts
end
local function publicFlight(s)
    if not s then return nil end
    local used={}
    for id in pairs(s.used) do table.insert(used,id) end
    table.sort(used)
    return {x=s.x,y=s.y,vx=s.vx,vy=s.vy,alive=s.alive,distance=s.distance,
        elapsed=s.elapsed,pickups=s.pickups,hits=s.hits,shield=s.shield,nearMisses=s.nearMisses or 0,
        powerId=s.powerId,powerCharges=s.powerCharges,powerPhase=s.powerPhase,
        powerPeak=s.powerPeak,powerUses=s.powerUses,
        usedIds=used,lastEvent=s.lastEvent,recentEvents=s.recentEvents,finishReason=s.finishReason}
end
local function queueSnapshot()
    local result={}
    for _,station in ipairs(World.DUEL_STATIONS) do
        local names={false,false}
        for seat,id in ipairs(queues[station.id].seats) do
            if id and profiles[id] then names[seat]=profiles[id].player.DisplayName end
        end
        table.insert(result,{id=station.id,name=station.name,seats=names})
    end
    return result
end
local function canRematch(m)
    for _,e in ipairs(m.entrants) do
        if not e.bot and (not profiles[e.userId] or profiles[e.userId].matchId~=m.id) then return false end
    end
    return true
end
local function snapshot(p)
    local m=p.matchId and matches[p.matchId]
    local list={}
    if m then
        for _,e in ipairs(m.entrants) do
            local profile=profiles[e.userId]
            local attached=profile and profile.matchId==m.id
            table.insert(list,{userId=e.userId,name=e.name,bot=e.bot or false,
                settings=copySettings(attached and profile.settings or e.settings),
                ready=e.bot or (attached and profile.ready) or false,
                rematchReady=m.rematchVotes[e.userId] or e.bot or false,
                left=not e.bot and not attached,flight=publicFlight(e.flight),best=profile and profile.best or 0})
        end
    else
        table.insert(list,{userId=p.player.UserId,name=p.player.DisplayName,settings=copySettings(p.settings),ready=false,best=p.best})
    end
    local personalStats,saveStatus=statsService:get(p.statsHandle)
    local economy=statsService:getEconomy(p.statsHandle)
    economy.canShop=economy.canShop and not m and not p.queue and not p.quick and not p.inBattleLab
    local queue=p.queue
    if not queue and p.quick then queue={quick=true,stationName="QUICK MATCH",fallbackAt=p.quick.fallbackAt} end
    return {phase=p.inBattleLab and "BattleLab" or (m and m.phase or (queue and "Queued" or "Lobby")),
        matchId=m and m.id or 0,roundId=m and m.round or 0,
        endsAt=m and m.endsAt or 0,courseName=m and m.courseName or "Coast",
        courseSeed=m and m.course.seed or 104729,votes=m and voteCounts(m) or {},players=list,
        results=m and m.results or {},message=m and m.message or p.message,
        elapsed=m and m.elapsed or 0,serverTime=now(),prototype=true,stats=personalStats,saveStatus=saveStatus,
        economy=economy,cosmeticFeedback=p.cosmeticFeedback,
        queue=queue,queues=queueSnapshot(),canRematch=m and canRematch(m) or false}
end
local function broadcast()
    for _,p in pairs(profiles) do publishLook(p); snapshots:FireClient(p.player,snapshot(p)) end
    local count=0
    for _ in pairs(matches) do count+=1 end
    shared:SetAttribute("ActiveDuels",count)
end
local function setPhase(m, phase, message)
    m.phase=phase; m.endsAt=now()+DURATIONS[phase]
    if message then m.message=message end
end
local function beginVoting(m)
    m.round+=1; m.votes={}; m.results={}; m.rematchVotes={}; m.elapsed=0; m.accumulator=0; m.finished=false; m.aborted=false
    for _,e in ipairs(m.entrants) do
        e.flight=nil; e.forfeit=false
        local p=profiles[e.userId]
        if p then p.ready=false end
    end
    setPhase(m,"Voting","Pick the landscape for your duel. Both pilots face the same course.")
end
local configure
-- Fly Again keeps the course type both pilots just flew and skips the vote;
-- the seed still changes, and powers can be changed before aiming.
local function beginRematch(m)
    local courseName=m.courseName
    beginVoting(m)
    for _,e in ipairs(m.entrants) do
        if not e.bot then m.votes[e.userId]=courseName end
    end
    configure(m)
    m.votes={}
end
function configure(m)
    local counts=voteCounts(m)
    local highest,tied=-1,{}
    for _,name in ipairs(VARIANTS) do
        if counts[name]&gt;highest then highest=counts[name]; tied={name}
        elseif counts[name]==highest then table.insert(tied,name) end
    end
    m.courseName=tied[(m.round-1)%#tied+1]
    m.course=Simulation.makeCourse(104729+m.id*7919+m.round*3571,m.courseName)
    for _,e in ipairs(m.entrants) do
        if e.bot then
            local plane=PlaneCatalog.get(PlaneCatalog.ORDER[m.course.seed % #PlaneCatalog.ORDER + 1])
            local powers=PowerCatalog.all()
            local power=powers[m.course.seed % #powers + 1]
            e.settings=copySettings({planeId=plane.id,angle=plane.defaultAngle,powerId=power.id,color=2})
        end
    end
    m.readyAt=now()+1
    setPhase(m,"Configure","Choose your superpower. One power for this round. Aim your jet next.")
end
local function beginAim(m)
    for _,e in ipairs(m.entrants) do
        local p=profiles[e.userId]
        if p then
            e.settings=copySettings(p.settings)
            p.ready=false
        end
    end
    m.readyAt=now()+1
    setPhase(m,"Aim","Point ahead of your jet to aim. Ready locks your launch angle.")
end
local function checkedMatchSettings(p, m, input)
    if m and m.phase=="Aim" then
        for _,e in ipairs(m.entrants) do
            if e.userId==p.player.UserId then return safeAimSettings(input,e.settings) end
        end
        return nil
    end
    return safeSettings(input,p.settings.trailId)
end
local function launch(m)
    m.elapsed=0; m.accumulator=0; m.finished=false; m.aborted=false
    for _,e in ipairs(m.entrants) do
        local p=profiles[e.userId]
        if p then e.settings=copySettings(p.settings); telemetry:matchStart(p.player,m.practice) end
        e.flight=Simulation.newFlight(e.settings,m.course)
    end
    setPhase(m,"Flight",m.practice and "Practice · one ghost opponent · powers activate automatically" or "Powers activate automatically. Fly farther to win!")
end
local function finish(m)
    if m.finished then return end
    m.finished=true
    m.results={}
    local forfeited=false
    for _,e in ipairs(m.entrants) do
        local f=e.flight
        if f then
            f.alive=false; f.finishReason=f.finishReason or (m.aborted and "aborted" or "time_limit")
            local distance=math.floor(f.distance*10+0.5)/10
            local completed=not e.forfeit and (f.finishReason=="landed" or f.finishReason=="timeout" or f.finishReason=="time_limit")
            table.insert(m.results,{userId=e.userId,name=e.name,distance=distance,bot=e.bot or false,
                forfeit=e.forfeit or false,completed=completed,creditsEarned=0})
            forfeited=forfeited or e.forfeit
        end
    end
    table.sort(m.results,function(a,b)
        if a.forfeit~=b.forfeit then return not a.forfeit end
        if a.distance==b.distance then return a.userId&gt;b.userId end
        return a.distance&gt;b.distance
    end)
    local rank=1
    for i,r in ipairs(m.results) do
        if i&gt;1 and (r.distance~=m.results[i-1].distance or r.forfeit~=m.results[i-1].forfeit) then rank=i end
        r.rank=rank
    end
    local sharedWin=m.results[2] and m.results[2].rank==1
    local resultId=serverSession..":duel:"..tostring(m.id)..":"..tostring(m.round)
    for _,r in ipairs(m.results) do
        local p=profiles[r.userId]
        if p and not r.bot then
            local outcome=r.forfeit and "loss" or (sharedWin and "draw" or (r.rank==1 and "win" or "loss"))
            local _,credits=statsService:recordFlight(p.statsHandle,resultId,{distance=r.distance,practice=m.practice,
                outcome=outcome,forfeit=r.forfeit,completed=r.completed,aborted=m.aborted})
            r.creditsEarned=credits or 0
            if r.completed and not r.forfeit then
                p.best=math.max(p.best,r.distance); p.player:SetAttribute("SessionBest",p.best)
                if not clubBest or r.distance&gt;clubBest.distance then clubBest={name=r.name,distance=r.distance} end
            end
            telemetry:matchComplete(p.player,r.forfeit and "forfeit" or (outcome=="draw" and "tie" or outcome),m.practice)
            task.spawn(function() statsService:save(p.statsHandle,false) end)
        end
    end
    local winner=m.results[1]
    local message="Duel complete. Rematch or return to the hub."
    if winner then
        message=forfeited and (winner.name.." wins · opponent left the duel")
            or (m.results[2] and m.results[2].rank==1 and string.format("Shared win · %.1f m",winner.distance))
            or string.format("%s flew furthest · %.1f m",winner.name,winner.distance)
    end
    setPhase(m,"Results",message)
    print("SKYBOUND_DUEL_COMPLETE",m.id,m.round,message)
end
local function createMatch(ids, practice)
    if not distanceModeEnabled then return nil end
    for _,id in ipairs(ids) do if not profiles[id] or profiles[id].matchId or profiles[id].inBattleLab then return nil end end
    if #ids~=(practice and 1 or 2) or (#ids==2 and ids[1]==ids[2]) then return nil end
    nextMatchId+=1
    local m={id=nextMatchId,round=0,entrants={},votes={},rematchVotes={},results={},elapsed=0,accumulator=0,
        practice=practice or false,courseName="Coast",course=Simulation.makeCourse(104729,"Coast")}
    matches[m.id]=m
    for _,id in ipairs(ids) do
        local p=profiles[id]
        clearQueue(p); p.matchId=m.id; moveCharacter(p,true)
        table.insert(m.entrants,{userId=id,name=p.player.DisplayName,settings=copySettings(p.settings)})
    end
    if practice then
        table.insert(m.entrants,{userId=-100001,name="Practice · Skipper",bot=true,
            settings=copySettings({planeId=PlaneCatalog.DEFAULT_ID,gadget="Magnet",color=2})})
    end
    beginVoting(m)
    return m
end
local function leaveMatch(p)
    local m=p.matchId and matches[p.matchId]
    local abandonedPhase=m and m.phase or ((p.queue or p.quick) and "Queued" or "Lobby")
    release(p)
    if not m then
        if abandonedPhase=="Queued" then telemetry:phaseAbandoned(p.player,abandonedPhase) end
        return
    end
    if m.phase=="Flight" then
        m.aborted=true
        for _,e in ipairs(m.entrants) do
            if e.userId==p.player.UserId then e.forfeit=true; e.flight.finishReason="forfeit" end
        end
        finish(m)
    elseif m.phase~="Results" then
        for _,e in ipairs(m.entrants) do
            local other=profiles[e.userId]
            if other and other.matchId==m.id then
                telemetry:phaseAbandoned(other.player,abandonedPhase)
                release(other,"Your opponent left. Join another 1v1 pad.")
            end
        end
    end
    if abandonedPhase~="Results" then telemetry:phaseAbandoned(p.player,abandonedPhase) end
end
local function onPad(p, position)
    if p.matchId or p.inBattleLab or now()&lt;(p.queueCooldown or 0) then return false end
    local character=p.player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health&lt;=0 then return false end
    local d=root.Position-position
    return math.abs(d.X)&lt;=6 and math.abs(d.Z)&lt;=6 and d.Y&gt;=0 and d.Y&lt;=8
end
local function scanQueues()
    for _,station in ipairs(World.DUEL_STATIONS) do
        local q=queues[station.id]
        for seat,id in ipairs(q.seats) do
            if id and (not profiles[id] or not onPad(profiles[id],station.seats[seat])) then
                if profiles[id] then profiles[id].queue=nil; telemetry:phaseAbandoned(profiles[id].player,"Queued") end
                q.seats[seat]=false; q.fullSince=nil
            end
        end
        for seat,position in ipairs(station.seats) do
            if not q.seats[seat] then
                for id,p in pairs(profiles) do
                    if not p.queue and not p.quick and onPad(p,position) then
                        q.seats[seat]=id; p.queue={stationId=station.id,stationName=station.name,seat=seat}
                        telemetry:queueStart(p.player); break
                    end
                end
            end
        end
        if q.seats[1] and q.seats[2] then
            q.fullSince=q.fullSince or now()
            if now()-q.fullSince&gt;=1.5 then createMatch({q.seats[1],q.seats[2]},false) end
        else q.fullSince=nil end
    end
    local counts={}
    for id,q in pairs(queues) do counts[id]=(q.seats[1] and 1 or 0)+(q.seats[2] and 1 or 0) end
    World.updateLobbyQueues(counts)
end
-- A pilot alone on a pad is also a valid rival for PLAY, so a small
-- population is never divided between the pads and the quick queue.
local function padWaiter(excludeId)
    for _,station in ipairs(World.DUEL_STATIONS) do
        local q=queues[station.id]
        local first,second=q.seats[1],q.seats[2]
        if first and not second and first~=excludeId and profiles[first] then return first end
        if second and not first and second~=excludeId and profiles[second] then return second end
    end
    return nil
end
local function quickRival(excludeId)
    for _,id in ipairs(quickQueue) do
        if id~=excludeId and profiles[id] and not profiles[id].matchId then return id end
    end
    return padWaiter(excludeId)
end
local function startQuick(p)
    if p.matchId or p.queue or p.quick then return end
    local id=p.player.UserId
    local rival=quickRival(id)
    if rival then createMatch({rival,id},false); return end
    p.quick={since=now(),fallbackAt=now()+QUICK_FALLBACK}
    table.insert(quickQueue,id)
    telemetry:queueStart(p.player)
end
local function scanQuick()
    for index=#quickQueue,1,-1 do
        local id=quickQueue[index]
        local p=profiles[id]
        if not p or not p.quick or p.matchId then
            table.remove(quickQueue,index)
            if p then p.quick=nil end
        else
            local rival=padWaiter(id)
            if rival then createMatch({rival,id},false)
            elseif now()&gt;=p.quick.fallbackAt then createMatch({id},true) end
        end
    end
end
local function updateBoard()
    if not World.updateLobbyBoard then return end
    local flying=nil
    local lowest=math.huge
    for matchId,m in pairs(matches) do
        if (m.phase=="Flight" or m.phase=="Countdown") and matchId&lt;lowest and m.entrants[2] then
            lowest=matchId; flying=m.entrants[1].name.."  vs  "..m.entrants[2].name
        end
    end
    World.updateLobbyBoard(flying,clubBest)
end
local battleLab=BattleLab.new({simulation=BattleSimulation,skills=SkillCatalog,now=now,
    sessionId=serverSession,
    allowFixedSeed=RunService:IsStudio(),
    allowExperimental=RunService:IsStudio(),
    resolveRoster=function()
        if script:GetAttribute("BattleExperimental")~=true then return nil end
        local function ids(value)
            local result={}
            for id in string.gmatch(type(value)=="string" and value or "", "[^, ]+") do table.insert(result,id) end
            return result
        end
        return {version=script:GetAttribute("BattleExperimentalVersion") or "studio-experiment-v1",
            offences=ids(script:GetAttribute("BattleExperimentalOffences")),wilds=ids(script:GetAttribute("BattleExperimentalWilds"))}
    end,
    fixedSeed=RunService:IsStudio() and script:GetAttribute("BattleFixedSeed") or nil,
    getPlayers=function() return Players:GetPlayers() end,
    identity=function(player)
        local p=profiles[player.UserId]
        return {userId=player.UserId,name=player.DisplayName,planeId=p and p.settings.planeId or PlaneCatalog.DEFAULT_ID,
            color=p and p.settings.color or 1,trailId=p and p.settings.trailId or CosmeticCatalog.DEFAULT_ID}
    end,
    onEvent=function(player,event,data) telemetry:battleEvent(player,event,data) end,
    onTerminal=function(player,result)
        local p=profiles[player.UserId]
        if not p then return nil end
        p.hasCompletedBattle=true
        local applied,reward=statsService:recordBattle(p.statsHandle,serverSession..":battle:"..tostring(result.matchId)..":"..tostring(player.UserId),result)
        if applied then task.spawn(function() statsService:save(p.statsHandle,false) end) end
        return reward
    end,
    canEnter=function(player)
        local p=profiles[player.UserId]
        return not shuttingDown and p~=nil and not p.matchId and not p.queue and not p.quick and not p.inBattleLab
    end,
    entered=function(player)
        local p=profiles[player.UserId]
        p.inBattleLab=true; moveCharacter(p,true); broadcast()
    end,
    exited=function(player)
        local p=profiles[player.UserId]
        if p then p.inBattleLab=false; release(p); broadcast() end
    end,
    emit=function(player,data)
        local p=profiles[player.UserId]
        if p then
            local _,status=statsService:get(p.statsHandle)
            data.saveStatus=status;data.economy=statsService:getEconomy(p.statsHandle);data.cosmeticFeedback=p.cosmeticFeedback
            if data.reward then
                data.reward.status=status
                data.reward.progression=statsService:getBattle(p.statsHandle)
                data.reward.confirmed=status=="saved" and p.statsHandle.savedVersion &gt;= (data.reward.version or math.huge)
            end
        end
        shared.BattleSnapshot:FireClient(player,data)
    end})
shared.BattleCommand.OnServerEvent:Connect(function(player,payload)
    local p=profiles[player.UserId]
    if shuttingDown or not p or type(payload)~="table" then return end
    if payload.kind=="uiReady" then
        local stats=statsService:get(p.statsHandle)
        telemetry:battleEvent(player,"usable_lobby",{device=payload.device,cohort=p.analyticsCohort or "unknown"})
        return
    elseif payload.kind=="rewardShown" then
        local current=battleLab:snapshot(player)
        if current.phase=="MatchOver" and current.matchId==payload.matchId then
            telemetry:battleEvent(player,"reward_shown",{matchId=current.matchId})
        end
        return
    end
    battleLab:command(player,payload)
end)

local function joined(player)
    if shuttingDown then return end
    local p={player=player,settings=copySettings({planeId=PlaneCatalog.DEFAULT_ID,gadget="Shield",color=1}),ready=false,best=0,
        lastCommand={},message="Walk onto a 1v1 pad with another pilot."}
    profiles[player.UserId]=p
    for slot=1,#(World.LINEUP_BAYS or {}) do
        if not baySlots[slot] then baySlots[slot]=player.UserId; p.bay=slot; break end
    end
    p.statsHandle=statsService:open(player.UserId)
    player:SetAttribute("SessionBest",0)
    player:SetAttribute("StatsSaveStatus",p.statsHandle.status)
    player:SetAttribute("PrototypeSaveStatus",sessionOnly and "Session only · local Studio" or "Persistent player statistics")
    telemetry:sessionStart(player)
    telemetry:battleEvent(player,"join",{})
    task.spawn(function()
        statsService:load(p.statsHandle)
        if (p.statsHandle.safe or sessionOnly) and not p.hasCompletedBattle then
            p.analyticsCohort=statsService:getBattle(p.statsHandle).matches&gt;0 and "returning" or "new"
            telemetry:battleContext(player,{cohort=p.analyticsCohort})
        end
    end)
    local function placeCharacter(character)
        if character:WaitForChild("HumanoidRootPart",10) then moveCharacter(p,p.matchId~=nil or p.inBattleLab==true) end
    end
    player.CharacterAdded:Connect(placeCharacter)
    if player.Character then task.spawn(placeCharacter,player.Character) end
    task.defer(broadcast)
end
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player)
    battleLab:remove(player)
    local p=profiles[player.UserId]
    if p then
        if not shuttingDown then leaveMatch(p) end
        telemetry:sessionEnd(player)
        telemetry:battleLeave(player)
        if p.bay then baySlots[p.bay]=nil end
        profiles[player.UserId]=nil
        task.spawn(function() statsService:close(p.statsHandle) end)
    end
    broadcast()
end)
for _,player in ipairs(Players:GetPlayers()) do joined(player) end

local ALLOWED={request=true,vote=true,configure=true,ready=true,practice=true,play=true,leaveQueue=true,returnLobby=true,rematch=true,
    buyCosmetic=true,equipCosmetic=true,claimStarter=true,selectGoal=true}
local function cosmeticFeedback(p,result)
    p.cosmeticFeedbackSequence=(p.cosmeticFeedbackSequence or 0)+1
    result.id=p.cosmeticFeedbackSequence
    p.cosmeticFeedback=result
end
local function handleCommand(p,payload)
    if shuttingDown then return end
    if type(payload)~="table" or type(payload.kind)~="string" or not ALLOWED[payload.kind] then return end
    if now()-(p.lastCommand[payload.kind] or 0)&lt;0.04 then return end
    p.lastCommand[payload.kind]=now()
    local m=p.matchId and matches[p.matchId]
    if payload.kind=="request" then snapshots:FireClient(p.player,snapshot(p)); return end
    local cosmeticAction=payload.kind=="buyCosmetic" or payload.kind=="equipCosmetic" or payload.kind=="claimStarter" or payload.kind=="selectGoal"
    if p.inBattleLab and not (cosmeticAction and battleLab:snapshot(p.player).phase=="MatchOver") then return end
    if cosmeticAction then
        -- One shared limit prevents alternating buy/equip from bypassing it.
        if now()-(p.lastCosmeticCommand or -math.huge)&lt;0.25 then return end
        p.lastCosmeticCommand=now()
        if m or p.queue or p.quick then
            cosmeticFeedback(p,{ok=false,code="not_in_lobby",message="Return to the hangar before changing your collection."})
        else
            local result
            if payload.kind=="buyCosmetic" then result=statsService:buyCosmetic(p.statsHandle,payload.itemId)
            elseif payload.kind=="claimStarter" then result=statsService:claimStarter(p.statsHandle,payload.itemId)
            elseif payload.kind=="selectGoal" then result=statsService:selectGoal(p.statsHandle,payload.itemId)
            else result=statsService:equipCosmetic(p.statsHandle,payload.itemId) end
            cosmeticFeedback(p,result)
            if result.ok then
                local goalId=statsService:getBattle(p.statsHandle).goalId
                if payload.itemId==goalId and result.code~="already_equipped" then
                    local event=payload.kind=="selectGoal" and "goal_selected" or (payload.kind=="buyCosmetic" and "goal_earned" or "goal_equipped")
                    telemetry:battleEvent(p.player,event,{itemId=payload.itemId})
                end
                p.settings.trailId=statsService:getEconomy(p.statsHandle).equippedTrail
                task.spawn(function() statsService:save(p.statsHandle,false) end)
            end
        end
        snapshots:FireClient(p.player,snapshot(p)); return
    end
    if payload.kind=="practice" and not m then createMatch({p.player.UserId},true)
    elseif payload.kind=="play" and not m then
        if distanceModeEnabled then startQuick(p)
        else battleLab:command(p.player,{kind="enter"}) end
    elseif payload.kind=="leaveQueue" and not m then
        -- Cancelling a search leaves the pilot standing where they are.
        if p.quick then clearQuick(p); telemetry:phaseAbandoned(p.player,"Queued") else leaveMatch(p) end
    elseif payload.kind=="returnLobby" then leaveMatch(p)
    elseif m and payload.kind=="rematch" and m.phase=="Results" and canRematch(m) then
        m.rematchVotes[p.player.UserId]=true
        telemetry:rematch(p.player)
        local ready=true
        for _,e in ipairs(m.entrants) do if not e.bot and not m.rematchVotes[e.userId] then ready=false end end
        if ready then beginRematch(m) end
    elseif m and payload.kind=="vote" and m.phase=="Voting" and table.find(VARIANTS,payload.variant) then
        m.votes[p.player.UserId]=payload.variant
    elseif payload.kind=="configure" and (not m or m.phase=="Configure" or m.phase=="Voting" or m.phase=="Aim") then
        local checked=checkedMatchSettings(p,m,payload.settings)
        if not checked then return end
        p.settings=checked; p.ready=false
    elseif m and payload.kind=="ready" and (m.phase=="Configure" or m.phase=="Aim") and type(payload.ready)=="boolean" then
        if payload.settings then
            local checked=checkedMatchSettings(p,m,payload.settings)
            if not checked then return end
            p.settings=checked
        end
        p.ready=payload.ready
    else return end
    broadcast()
end
command.OnServerEvent:Connect(function(player,payload)
    local p=profiles[player.UserId]
    if p then handleCommand(p,payload) end
end)
RunService.Heartbeat:Connect(function(dt)
    if shuttingDown then return end
    statsService:step()
    battleLab:step(dt)
    queueAccumulator+=dt
    if queueAccumulator&gt;=0.15 then
        queueAccumulator=0
        if distanceModeEnabled then scanQueues(); scanQuick(); updateBoard() end
    end
    for id,m in pairs(matches) do
        local attached=false
        for _,e in ipairs(m.entrants) do if profiles[e.userId] and profiles[e.userId].matchId==id then attached=true end end
        if not attached then matches[id]=nil; continue end
        if m.phase=="Flight" then
            m.accumulator+=dt
            local steps=0
            while m.accumulator&gt;=1/60 and steps&lt;120 do
                m.accumulator-=1/60; steps+=1; m.elapsed+=1/60
                local alive=false
                for _,e in ipairs(m.entrants) do
                    if e.flight.alive then Simulation.step(e.flight,m.course,1/60) end
                    alive=alive or e.flight.alive
                end
                if not alive or m.elapsed&gt;=Simulation.MAX_FLIGHT_TIME then finish(m); break end
            end
        elseif (m.phase=="Configure" or m.phase=="Aim") and now()&gt;=m.readyAt then
            local allReady=true
            for _,e in ipairs(m.entrants) do if not e.bot and not profiles[e.userId].ready then allReady=false end end
            if allReady then
                if m.phase=="Configure" then beginAim(m)
                else setPhase(m,"Countdown","Both flight plans locked. Get ready!") end
            end
        end
        if now()&gt;=m.endsAt then
            if m.phase=="Voting" then configure(m)
            elseif m.phase=="Configure" then beginAim(m)
            elseif m.phase=="Aim" then setPhase(m,"Countdown","Flight plans locked. Get ready!")
            elseif m.phase=="Countdown" then launch(m)
            elseif m.phase=="Flight" then finish(m)
            elseif m.phase=="Results" then
                for _,e in ipairs(m.entrants) do
                    local p=profiles[e.userId]
                    if p and p.matchId==m.id then release(p) end
                end
                matches[id]=nil
            end
        end
    end
    broadcastAccumulator+=dt
    if broadcastAccumulator&gt;=0.1 then broadcastAccumulator=0; broadcast() end
end)

game:BindToClose(function()
    shuttingDown=true
    battleLab:shutdown()
    for _,p in pairs(profiles) do
        local m=p.matchId and matches[p.matchId]
        local phase=m and m.phase or (p.queue and "Queued" or "Lobby")
        if phase~="Lobby" and phase~="Results" then telemetry:phaseAbandoned(p.player,phase) end
        telemetry:sessionEnd(p.player)
    end
    statsService:shutdown(25)
end)

-- Studio diagnostics exercise the same command and match code used by players.
if RunService:IsStudio() then
    local debugFunction=Instance.new("BindableFunction")
    debugFunction.Name="FlightDebug"; debugFunction.Parent=ServerStorage
    debugFunction.OnInvoke=function(action,data)
        data=data or {}
        local p=profiles[data.userId or (Players:GetPlayers()[1] and Players:GetPlayers()[1].UserId)]
        if action=="battleTelemetry" then return telemetry:battleLog() end
        if action=="battleSnapshot" then return p and battleLab:snapshot(p.player) end
        if action=="battleCommand" and p then battleLab:command(p.player,data.payload); return battleLab:snapshot(p.player) end
        if action=="snapshot" then return p and snapshot(p) end
        if action=="snapshots" then local all={}; for id,profile in pairs(profiles) do all[tostring(id)]=snapshot(profile) end; return all end
        if action=="validateSettings" then return safeSettings(data) end
        if action=="tests" then return require(ServerStorage.SimulationTests)(Simulation) end
        if action=="forcePair" then local m=createMatch(data.ids,false); broadcast(); return m and m.id end
        if not p then return nil end
        if action=="command" then handleCommand(p,data.payload); return snapshot(p) end
        if action=="queueMove" then
            local station
            for _,s in ipairs(World.DUEL_STATIONS) do if s.id==data.stationId then station=s end end
            if station and (data.seat==1 or data.seat==2) and not p.matchId and p.player.Character then
                p.queueCooldown=0; p.player.Character:PivotTo(CFrame.new(station.seats[data.seat]+Vector3.new(0,3,0)))
            end
            return snapshot(p)
        end
        if action=="practice" and not p.matchId then createMatch({p.player.UserId},true) end
        local m=p.matchId and matches[p.matchId]
        if action=="launch" and m then if m.phase=="Voting" then configure(m) end; launch(m) end
        if action=="configure" and m then
            m.results={}; m.elapsed=0
            for _,e in ipairs(m.entrants) do e.flight=nil; if profiles[e.userId] then profiles[e.userId].ready=false end end
            configure(m)
        end
        if action=="aim" and m and m.phase=="Configure" then beginAim(m) end
        broadcast(); return snapshot(p)
    end
end
print("SKYBOUND_SERVER_READY","walkable hub · independent 1v1 duels")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX18">
      <Properties>
        <string name="Name">PlayerStats</string>
        <ProtectedString name="Source">--!nonstrict
-- One atomic record per player. UpdateAsync owns acquisition, renewal and release
-- of a fenced session lease. Writes require a verified load and an owned lease.
-- Reference: https://create.roblox.com/docs/cloud-services/data-stores/player-data-purchasing
local CosmeticCatalog = require(game:GetService("ReplicatedStorage"):WaitForChild("FlightGame"):WaitForChild("CosmeticCatalog"))
local SkillCatalog = require(game:GetService("ReplicatedStorage"):WaitForChild("FlightGame"):WaitForChild("SkillCatalog"))
local PlayerStats = {}
PlayerStats.__index = PlayerStats
PlayerStats.DATASTORE_NAME = "Skybound_PlayerStats_v1"
PlayerStats.SCHEMA_VERSION = 3
PlayerStats.MAX_CREDITS = 1e12
PlayerStats.RECEIPT_LIMIT = 128

local FIELDS = { "bestDistance", "totalFlights", "wins", "losses", "draws", "currentStreak", "bestStreak", "practiceFlights" }
local function finite(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end
local function copyStats(source)
	local result = {}
	for _, field in ipairs(FIELDS) do result[field] = source and source[field] or 0 end
	return result
end
local function copyArray(source)
	local result = {}
	for _, value in ipairs(source or {}) do table.insert(result, value) end
	return result
end
local BATTLE_FIELDS = { "matches", "wins", "losses", "draws", "currentStreak", "bestStreak" }
local function copyBattle(source)
    local result = { mastery = {}, starterAvailable = source and source.starterAvailable == true or false,
        starterChoice = source and source.starterChoice or nil, goalId = source and source.goalId or CosmeticCatalog.BATTLE_GOAL_ID }
    for _,field in ipairs(BATTLE_FIELDS) do result[field] = source and source[field] or 0 end
    for id,value in pairs(source and source.mastery or {}) do result.mastery[id] = value end
    return result
end
local function starter(id)
    for _,choice in ipairs(CosmeticCatalog.STARTER_CHOICES) do if choice == id then return true end end
    return false
end
local function decodeBattle(value)
    if type(value) ~= "table" or type(value.mastery) ~= "table" or type(value.starterAvailable) ~= "boolean" then return nil end
    for _,field in ipairs(BATTLE_FIELDS) do
        if not finite(value[field]) or value[field] &lt; 0 or value[field] % 1 ~= 0 or value[field] &gt; 1e12 then return nil end
    end
    for id,amount in pairs(value.mastery) do
        if not SkillCatalog.valid(id) or not finite(amount) or amount &lt; 0 or amount % 1 ~= 0 or amount &gt; 1e12 then return nil end
    end
    if value.starterChoice ~= nil and not starter(value.starterChoice) then return nil end
    if value.starterChoice and value.starterAvailable then return nil end
    local goal = CosmeticCatalog.get(value.goalId)
    if not goal or goal.earnedOnly or goal.price &lt;= 0 then return nil end
    return copyBattle(value)
end
local function copyEconomy(source)
	local owned = { [CosmeticCatalog.DEFAULT_ID] = true }
	for id, value in pairs(source and source.owned or {}) do if value then owned[id] = true end end
	return { credits = source and source.credits or 0, owned = owned,
		equippedTrail = source and source.equippedTrail or CosmeticCatalog.DEFAULT_ID }
end
local function decodeEconomy(value)
	if type(value) ~= "table" or not finite(value.credits) or value.credits &lt; 0
		or value.credits &gt; PlayerStats.MAX_CREDITS or value.credits % 1 ~= 0 or type(value.owned) ~= "table" then return nil end
	for id, owned in pairs(value.owned) do
		if owned ~= true or not CosmeticCatalog.get(id) then return nil end
	end
	if not CosmeticCatalog.get(value.equippedTrail) or value.owned[value.equippedTrail] ~= true then return nil end
	return copyEconomy(value)
end
local function decode(value)
	if value == nil then return { schemaVersion = PlayerStats.SCHEMA_VERSION, stats = copyStats(), receipts = {}, economy = copyEconomy(), battle = copyBattle() } end
	if type(value) ~= "table" or (value.schemaVersion ~= 1 and value.schemaVersion ~= 2 and value.schemaVersion ~= PlayerStats.SCHEMA_VERSION)
		or type(value.stats) ~= "table" then return nil end
	local stats = copyStats(value.stats)
	for _, field in ipairs(FIELDS) do
		if not finite(stats[field]) or stats[field] &lt; 0 or stats[field] &gt; 1e12 then return nil end
		if field ~= "bestDistance" and stats[field] % 1 ~= 0 then return nil end
	end
	if value.lease ~= nil and (type(value.lease) ~= "table" or type(value.lease.id) ~= "string" or not finite(value.lease.expiresAt)) then return nil end
	local receipts = {}
	if value.receipts ~= nil and type(value.receipts) ~= "table" then return nil end
	for _, id in ipairs(value.receipts or {}) do
		if type(id) ~= "string" or #id &gt; 160 then return nil end
		table.insert(receipts, id)
	end
	while #receipts &gt; PlayerStats.RECEIPT_LIMIT do table.remove(receipts, 1) end
	local economy = value.schemaVersion == 1 and copyEconomy() or decodeEconomy(value.economy)
	if not economy then return nil end
    local battle = value.schemaVersion &lt; 3 and copyBattle() or decodeBattle(value.battle)
    if not battle or (battle.starterChoice and not economy.owned[battle.starterChoice]) then return nil end
	return { schemaVersion = PlayerStats.SCHEMA_VERSION, stats = stats, receipts = receipts, economy = economy, battle = battle,
		lease = value.lease, lastWrite = value.lastWrite }
end

function PlayerStats.new(options)
	options = options or {}
	assert(type(options.sessionId) == "string" and #options.sessionId &gt; 0, "A unique server session ID is required")
	return setmetatable({
		store = options.store, sessionId = options.sessionId, sessionOnly = options.sessionOnly == true,
		clock = options.clock or os.time, monotonic = options.monotonic or os.clock,
		wait = options.wait or function(seconds) task.wait(seconds) end,
		spawn = options.spawn or function(callback) task.spawn(callback) end,
		onChanged = options.onChanged, jitter = options.jitter or math.random,
		leaseSeconds = options.leaseSeconds or 180, saveInterval = options.saveInterval or 45,
		maxAttempts = options.maxAttempts or 3, records = {}, sequence = 0, nextSweep = 0,
	}, PlayerStats)
end

function PlayerStats:_changed(record)
	if self.onChanged then pcall(self.onChanged, record.userId, record.status) end
end

function PlayerStats:open(userId)
	self.sequence = self.sequence + 1
	local token = self.sessionId .. ":" .. tostring(userId) .. ":" .. tostring(self.sequence)
	local record = { userId = userId, token = token, key = "player_" .. tostring(userId), stats = copyStats(),
		status = self.sessionOnly and "session_only" or "loading", safe = false, busy = false,
		loaded = self.sessionOnly, loadFailures = 0,
		version = 0, savedVersion = 0, writeSequence = 0, receipts = {}, seen = {}, pending = {}, economy = copyEconomy(), battle = copyBattle(),
		nextSave = self.clock() + self.saveInterval + math.abs(userId) % 15 }
	self.records[token] = record
	return record
end

function PlayerStats:get(record)
	return copyStats(record and record.stats), record and record.status or "unavailable"
end

function PlayerStats:canShop(record)
	return record ~= nil and not record.closed and not record.closing
		and (record.status == "session_only" or (record.safe and (record.status == "saved" or record.status == "pending")))
end

function PlayerStats:getBattle(record)
    local result = copyBattle(record and record.battle)
    result.title = result.matches &gt;= 15 and "Sky Rival" or result.matches &gt;= 5 and "Wingmate" or result.matches &gt;= 1 and "Rookie" or "New Pilot"
    result.nextTitleAt = result.matches &lt; 1 and 1 or result.matches &lt; 5 and 5 or result.matches &lt; 15 and 15 or nil
    result.status = record and record.status or "unavailable"
    result.confirmed = result.status == "saved"
    return result
end
function PlayerStats:getEconomy(record)
    local result = copyEconomy(record and record.economy)
    result.canShop = self:canShop(record)
    result.progression = self:getBattle(record)
    result.starterChoices = copyArray(CosmeticCatalog.STARTER_CHOICES)
    local goal = CosmeticCatalog.get(result.progression.goalId)
    result.goal = {id=goal.id,name=goal.name,price=goal.price,owned=result.owned[goal.id]==true,
        remaining=result.owned[goal.id] and 0 or math.max(0,goal.price-result.credits)}
    return result
end

local function feedback(ok, code, message, itemId)
	return { ok = ok, code = code, message = message, itemId = itemId }
end
function PlayerStats:_cosmetic(record, itemId, equip)
	local item = CosmeticCatalog.get(itemId)
	if not item then return feedback(false, "invalid_item", "That effect is not in the hangar shop.") end
	if not self:canShop(record) then
		local loading = record and record.status == "loading"
		return feedback(false, loading and "loading" or "unavailable",
			loading and "Your collection is still loading. Try again in a moment." or "Saving is unavailable. The shop will reopen when your data is safe.", itemId)
	end
	local economy = record.economy
    if not equip and item.earnedOnly then return feedback(false,"earned_only","Choose this trail after your first completed battle.",itemId) end
	if equip then
		if not economy.owned[itemId] then return feedback(false, "not_owned", "Unlock this trail before equipping it.", itemId) end
		if economy.equippedTrail == itemId then return feedback(true, "already_equipped", item.name .. " is already equipped.", itemId) end
		economy.equippedTrail = itemId
	else
		if economy.owned[itemId] then return feedback(false, "already_owned", "You already own " .. item.name .. ". Select Equip to use it.", itemId) end
		if economy.credits &lt; item.price then
			return feedback(false, "insufficient_credits", "Earn " .. tostring(item.price - economy.credits) .. " more coins to buy " .. item.name .. ".", itemId)
		end
		-- The debit and ownership grant share one fenced persistence record.
		economy.credits = economy.credits - item.price
		economy.owned[itemId] = true
	end
	record.version = record.version + 1
	if not self.sessionOnly then record.status = "pending" end
	self:_changed(record)
	return feedback(true, equip and "equipped" or "purchased",
		equip and (item.name .. " equipped. Ready for takeoff.") or (item.name .. " unlocked! Select Equip to use it."), itemId)
end

function PlayerStats:buyCosmetic(record, itemId)
	return self:_cosmetic(record, itemId, false)
end

function PlayerStats:equipCosmetic(record, itemId)
	return self:_cosmetic(record, itemId, true)
end

function PlayerStats:claimStarter(record, itemId)
    if not starter(itemId) then return feedback(false,"invalid_item","Choose one of the two first-battle trails.",itemId) end
    if not self:canShop(record) then return feedback(false,"unavailable","Your collection must finish saving before this choice.",itemId) end
    if record.battle.starterChoice then return feedback(false,"already_claimed","Your first-battle trail is already in your collection.",record.battle.starterChoice) end
    if not record.battle.starterAvailable then return feedback(false,"not_earned","Complete a battle to choose your first trail.",itemId) end
    record.battle.starterAvailable = false; record.battle.starterChoice = itemId
    record.economy.owned[itemId] = true; record.economy.equippedTrail = itemId
    record.version = record.version + 1
    if not self.sessionOnly then record.status = "pending" end
    self:_changed(record)
    return feedback(true,"claimed",CosmeticCatalog.get(itemId).name.." chosen and equipped!",itemId)
end
function PlayerStats:selectGoal(record, itemId)
    local item=CosmeticCatalog.get(itemId)
    if not item or item.earnedOnly or item.price&lt;=0 then return feedback(false,"invalid_goal","Choose an earned-coin cosmetic goal.",itemId) end
    if not self:canShop(record) then return feedback(false,"unavailable","Your collection is not ready. Try again after saving.",itemId) end
    if record.battle.goalId==itemId then return feedback(true,"already_selected",item.name.." is your goal.",itemId) end
    record.battle.goalId=itemId;record.version=record.version+1
    if not self.sessionOnly then record.status="pending" end
    self:_changed(record)
    return feedback(true,"goal_selected",item.name.." is your new goal.",itemId)
end

function PlayerStats:_retry(callback)
	local lastError
	for attempt = 1, self.maxAttempts do
		local ok, result, reason = pcall(callback)
		if ok and result then return true, result end
		lastError = ok and reason or result
		if lastError == "corrupt" or lastError == "lease_lost" or lastError == "closed" then break end
		if attempt &lt; self.maxAttempts then
			self.wait(math.min(4, 2 ^ (attempt - 1)) + self.jitter() * 0.25)
		end
	end
	return false, lastError
end

function PlayerStats:_apply(record, id, outcome)
	if record.seen[id] then return false, 0 end
	record.seen[id] = true
	table.insert(record.receipts, id)
	while #record.receipts &gt; PlayerStats.RECEIPT_LIMIT do table.remove(record.receipts, 1) end
	local stats = record.stats
	stats.totalFlights = stats.totalFlights + 1
	if outcome.practice then
		stats.practiceFlights = stats.practiceFlights + 1
	elseif outcome.forfeit or outcome.outcome == "loss" then
		stats.losses = stats.losses + 1
		stats.currentStreak = 0
	elseif outcome.outcome == "win" then
		stats.wins = stats.wins + 1
		stats.currentStreak = stats.currentStreak + 1
		stats.bestStreak = math.max(stats.bestStreak, stats.currentStreak)
	elseif outcome.outcome == "draw" then
		stats.draws = stats.draws + 1 -- A draw preserves the current streak.
	end
	if outcome.completed and not outcome.forfeit then stats.bestDistance = math.max(stats.bestDistance, outcome.distance) end
	local credits = 0
	if outcome.completed and not outcome.forfeit and not outcome.aborted then
		credits = outcome.practice and CosmeticCatalog.PRACTICE_REWARD or (CosmeticCatalog.DUEL_REWARD
			+ (outcome.outcome == "win" and CosmeticCatalog.WIN_BONUS or (outcome.outcome == "draw" and CosmeticCatalog.DRAW_BONUS or 0)))
	end
	credits = math.min(credits, PlayerStats.MAX_CREDITS - record.economy.credits)
	record.economy.credits = record.economy.credits + credits
	record.version = record.version + 1
	return true, credits
end

function PlayerStats:recordFlight(record, resultId, input)
	if not record or record.closed or record.closing or type(resultId) ~= "string" or #resultId == 0 or #resultId &gt; 160 then return false end
	if type(input) ~= "table" or not finite(input.distance) or input.distance &lt; 0 or input.distance &gt; 1e7 then return false end
	if not input.practice and input.outcome ~= "win" and input.outcome ~= "loss" and input.outcome ~= "draw" and not input.forfeit then return false end
	local outcome = { distance = input.distance, practice = input.practice == true, completed = input.completed == true,
		forfeit = input.forfeit == true, aborted = input.aborted == true, outcome = input.outcome }
	local applied, credits = self:_apply(record, resultId, outcome)
	if not applied then return false, 0 end
	if not record.loaded then table.insert(record.pending, { id = resultId, outcome = outcome })
	elseif record.safe and record.status ~= "unavailable" then record.status = "pending" end
	self:_changed(record)
	return true, credits
end

-- A terminal battle is a separate ledger operation from the archived distance
-- game. Coins, entitlement, mastery and receipt advance in one fenced record.
function PlayerStats:_applyBattle(record, id, outcome)
    if record.seen[id] then return false,0 end
    record.seen[id]=true;table.insert(record.receipts,id)
    while #record.receipts&gt;PlayerStats.RECEIPT_LIMIT do table.remove(record.receipts,1) end
    local credits=0
    if outcome.eligible then
        local battle=record.battle
        battle.matches=battle.matches+1
        if outcome.outcome=="win" then
            battle.wins=battle.wins+1;battle.currentStreak=battle.currentStreak+1;battle.bestStreak=math.max(battle.bestStreak,battle.currentStreak)
        elseif outcome.outcome=="loss" then battle.losses=battle.losses+1;battle.currentStreak=0
        else battle.draws=battle.draws+1 end
        if battle.matches==1 and not battle.starterChoice then battle.starterAvailable=true end
        local used={}
        for _,skill in ipairs(outcome.skills) do
            if not used[skill] then battle.mastery[skill]=(battle.mastery[skill] or 0)+1;used[skill]=true end
        end
        credits=CosmeticCatalog.BATTLE_COMPLETION_REWARD+(outcome.outcome=="win" and CosmeticCatalog.BATTLE_WIN_BONUS or 0)
        credits=math.min(credits,PlayerStats.MAX_CREDITS-record.economy.credits)
        record.economy.credits=record.economy.credits+credits
    elseif outcome.abandoned then
        -- A real quit breaks a streak without granting completion, coins or
        -- mastery. Diagnostic matches never alter the public streak.
        record.battle.currentStreak=0
    end
    record.version=record.version+1
    return true,credits
end
function PlayerStats:recordBattle(record, resultId, input)
    if not record or record.closed or record.closing or type(resultId)~="string" or #resultId==0 or #resultId&gt;160 or type(input)~="table" then return false end
    if not finite(input.completedRounds) or input.completedRounds&lt;0 or input.completedRounds&gt;5 or input.completedRounds%1~=0
        or not finite(input.fightSeconds) or input.fightSeconds&lt;0 or input.fightSeconds&gt;240 then return false end
    local outcome=input.outcome
    local abandoned=input.abandoned==true or outcome=="abandoned"
    if outcome=="abandoned" then outcome="loss" end
    if outcome==nil and (input.winner==0 or input.winner==1 or input.winner==2) then outcome=input.winner==0 and "draw" or input.winner==1 and "win" or "loss" end
    if outcome~="win" and outcome~="loss" and outcome~="draw" then return false end
    local normal=input.reason=="first_to_two" or input.reason=="round_cap" or input.reason=="wall_cap"
    local departure=input.reason=="exit" or input.reason=="disconnect"
    local eligible=not abandoned and not input.diagnostic and input.mode~="experimental"
        and ((normal and input.completedRounds&gt;=1) or (departure and (input.completedRounds&gt;=1 or input.fightSeconds&gt;=30)))
    local reason=eligible and (departure and "opponent_departed" or "completed") or abandoned and "abandoned"
        or (input.diagnostic or input.mode=="experimental") and "diagnostic" or departure and "early_departure" or "uncompleted"
    local skills={}
    if input.offenceId~=nil then
        if not SkillCatalog.valid(input.offenceId,"offence") then return false end
        skills[#skills+1]=input.offenceId
    elseif eligible then return false end
    if input.wildIds~=nil and type(input.wildIds)~="table" then return false end
    if input.offenceId and not SkillCatalog.build(input.offenceId,input.wildIds) then return false end
    local seen={};local count=0
    for _,id in ipairs(input.wildIds or {}) do
        if not SkillCatalog.valid(id,"wild") or seen[id] then return false end
        count=count+1;if count&gt;2 then return false end;seen[id]=true;skills[#skills+1]=id
    end
    local operation={eligible=eligible,outcome=outcome,skills=skills,
        abandoned=abandoned and not input.diagnostic and input.mode~="experimental"}
    local applied,credits=self:_applyBattle(record,resultId,operation)
    if applied then
        if not record.loaded then table.insert(record.pending,{id=resultId,kind="battle",outcome=operation})
        elseif record.safe and record.status~="unavailable" then record.status="pending" end
        self:_changed(record)
    end
    return applied,{coins=credits,balance=record.economy.credits,eligible=eligible,reason=reason,
        duplicate=not applied,status=record.status,confirmed=record.status=="saved",version=record.version,progression=self:getBattle(record)}
end

function PlayerStats:_loadFailed(record, reason)
	record.safe = false
	record.status = "unavailable"
	record.loadFailures = math.min(record.loadFailures + 1, 5)
	-- Keep pending ledger operations until a verified load can replay them.
	-- Corrupt data must not be retried into a replacement/default profile.
	if reason == "corrupt" or reason == "closed" then
		record.loadRetryAt = nil
	else
		local delay = math.min(60, 5 * 2 ^ (record.loadFailures - 1) + self.jitter() * 0.25)
		record.loadRetryAt = self.clock() + delay
	end
end

function PlayerStats:load(record)
	if not record or record.closed or record.closing or record.busy then return false end
	if self.sessionOnly then record.status = "session_only"; self:_changed(record); return true end
	if record.loaded then return record.safe end
	if record.status ~= "loading" and (not record.loadRetryAt or self.clock() &lt; record.loadRetryAt) then return false end
	if not self.store then self:_loadFailed(record, "store_unavailable"); self:_changed(record); return false end
	record.busy = true
	local ok, loaded = self:_retry(function()
		if record.closed or record.closing then return false, "closed" end
		local rejection
		local timestamp = self.clock()
		local result = self.store:UpdateAsync(record.key, function(old)
			rejection = nil
			local value = decode(old)
			if not value then rejection = "corrupt"; return nil end
			if value.lease and value.lease.id ~= record.token and value.lease.expiresAt &gt; timestamp then rejection = "locked"; return nil end
			value.lease = { id = record.token, expiresAt = timestamp + self.leaseSeconds }
			return value
		end)
		if result and result.lease and result.lease.id == record.token then return result end
		return false, rejection or "load_failed"
	end)
	if ok then
		record.stats = copyStats(loaded.stats)
		record.economy = copyEconomy(loaded.economy)
        record.battle = copyBattle(loaded.battle)
		record.receipts = copyArray(loaded.receipts)
		record.seen = {}
		for _, id in ipairs(record.receipts) do record.seen[id] = true end
		record.version, record.savedVersion = 0, 0
		for _, pending in ipairs(record.pending) do
            if pending.kind=="battle" then self:_applyBattle(record,pending.id,pending.outcome)
            else self:_apply(record, pending.id, pending.outcome) end
        end
		record.pending = {}
		record.loaded = true
		record.loadFailures = 0
		record.loadRetryAt = nil
		record.safe = true
		record.status = record.version &gt; 0 and "pending" or "saved"
		record.nextSave = self.clock() + (record.version &gt; 0 and 0 or self.saveInterval)
	else
		self:_loadFailed(record, loaded)
	end
	record.busy = false
	self:_changed(record)
	if record.closed and record.safe then self:save(record, true) end
	return ok
end

function PlayerStats:save(record, releaseLease)
	if not record or (record.closed and not releaseLease) or record.busy or not record.safe or self.sessionOnly or not self.store then return false end
	record.busy = true
	record.writeSequence = record.writeSequence + 1
	local operationId = record.token .. ":write:" .. tostring(record.writeSequence)
	local stats, receipts, economy, battle, version = copyStats(record.stats), copyArray(record.receipts), copyEconomy(record.economy), copyBattle(record.battle), record.version
	local ok, reason = self:_retry(function()
		local rejection, alreadyCommitted
		local timestamp = self.clock()
		local result = self.store:UpdateAsync(record.key, function(old)
			rejection, alreadyCommitted = nil, false
			local value = decode(old)
			if not value then rejection = "corrupt"; return nil end
			-- A successful final write can lose its network response. Recognize its
			-- receipt without reacquiring or touching a newer server's lease.
			if releaseLease and value.lastWrite and value.lastWrite.id == operationId then alreadyCommitted = true; return nil end
			if not value.lease or value.lease.id ~= record.token then rejection = "lease_lost"; return nil end
			return { schemaVersion = PlayerStats.SCHEMA_VERSION, stats = copyStats(stats), receipts = copyArray(receipts), economy = copyEconomy(economy), battle = copyBattle(battle),
				lease = not releaseLease and { id = record.token, expiresAt = timestamp + self.leaseSeconds } or nil,
				lastWrite = { id = operationId, version = version } }
		end)
		if alreadyCommitted or (result and result.lastWrite and result.lastWrite.id == operationId) then return true end
		return false, rejection or "save_failed"
	end)
	if ok then
		record.savedVersion = version
		record.status = record.version == version and "saved" or "pending"
		if releaseLease then record.safe = false; record.released = true end
	else
		record.status = "unavailable"
		if reason == "lease_lost" or reason == "corrupt" then record.safe = false end
	end
	record.busy = false
	self:_changed(record)
	if record.closed and record.safe and not releaseLease then self:save(record, true) end
	return ok
end

function PlayerStats:close(record, timeout)
	if not record or record.closed then return true end
	if record.closing then return false end
	record.closing = true
	local deadline = self.monotonic() + (timeout or 20)
	while record.busy and self.monotonic() &lt; deadline do self.wait(0.05) end
	local saved = self.sessionOnly
	if not record.busy and record.safe then saved = self:save(record, true) end
	-- A request still in flight retains its handle until it finishes. Never let
	-- another handle use this lease; an unreleased lock expires on its own.
	record.closed = true
	self.records[record.token] = nil
	return saved
end

function PlayerStats:step()
	local timestamp = self.clock()
	if timestamp &lt; self.nextSweep then return end
	self.nextSweep = timestamp + 1
	for _, record in pairs(self.records) do
		if not record.loaded and record.loadRetryAt and timestamp &gt;= record.loadRetryAt
			and not record.busy and not record.closing and not record.loadRetryQueued then
			record.loadRetryQueued = true
			self.spawn(function()
				self:load(record)
				record.loadRetryQueued = false
			end)
		elseif record.safe and not record.busy and not record.closing and timestamp &gt;= record.nextSave then
			record.nextSave = timestamp + self.saveInterval
			self.spawn(function() self:save(record, false) end)
		end
	end
end

function PlayerStats:shutdown(timeout)
	local deadline = self.monotonic() + (timeout or 25)
	for _, record in pairs(self.records) do
		if not record.closed and not record.closing then
			self.spawn(function() self:close(record, math.max(0, deadline - self.monotonic())) end)
		end
	end
	-- Also wait for PlayerRemoving saves that were already running when Roblox
	-- started shutdown; they share this service's active-record registry.
	while next(self.records) ~= nil and self.monotonic() &lt; deadline do self.wait(0.05) end
	return next(self.records) == nil
end

return PlayerStats
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX19">
      <Properties>
        <string name="Name">Telemetry</string>
        <ProtectedString name="Source">-- Native server analytics; explicitly opt in with Telemetry.new({enabled = true}).
-- Studio is always disabled by the default environment check. isStudio/analytics/
-- clock can be injected for isolated tests. No HTTP service or external endpoint.
-- https://create.roblox.com/docs/production/analytics/custom-events
-- https://create.roblox.com/docs/production/analytics/event-types
-- https://create.roblox.com/docs/production/analytics/custom-fields
local Telemetry = {}
Telemetry.__index = Telemetry

local WINDOW_SECONDS = 60
local PLAYER_LIMIT = 16
local MAX_SESSIONS = 256
local OUTCOMES = {win = true, loss = true, tie = true, draw = true, abandoned = true, forfeit = true, completed = true}
local PHASES = {Lobby = true, Queued = true, Voting = true, Configure = true, Aim = true,
	Countdown = true, Flight = true, Results = true}

local function finite(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function service(name)
	local ok, result = pcall(function() return game:GetService(name) end)
	return ok and result or nil
end

local function studioCheck(override)
	if type(override) == "boolean" then return override end
	local ok, result = pcall(function()
		if type(override) == "function" then return override() end
		return game:GetService("RunService"):IsStudio()
	end)
	-- Unavailable or ambiguous environment detection must fail closed.
	return not ok or result ~= false
end

local function prune(timestamps, now)
	while timestamps[1] and now - timestamps[1] &gt;= WINDOW_SECONDS do
		table.remove(timestamps, 1)
	end
end

function Telemetry.new(options)
	options = type(options) == "table" and options or {}
	local enabled = options.enabled == true and not studioCheck(options.isStudio)
	local analytics = enabled and (options.analytics or service("AnalyticsService")) or nil
	return setmetatable({
		_enabled = enabled and analytics ~= nil,
		_analytics = analytics,
		_clock = type(options.clock) == "function" and options.clock or os.clock,
		_lastNow = 0,
		_sessions = {},
		_sessionCount = 0,
		_events = {},
		_battle = {},
		_battleLog = {},
	}, Telemetry)
end

function Telemetry:_now()
	local ok, value = pcall(self._clock)
	if not ok or not finite(value) then return nil end
	self._lastNow = math.max(self._lastNow, value)
	return self._lastNow
end

function Telemetry:_emit(player, state, eventName, value, fields)
	local now = self:_now()
	if not self._enabled or not now then return false end
	prune(state.events, now)
	prune(self._events, now)
	-- Roblox's limit is 120 + 20*CCU requests/minute. Reserve headroom for other
	-- systems; these rolling windows also bound retained timestamps and retries.
	if #state.events &gt;= PLAYER_LIMIT or #self._events &gt;= 100 + 12 * self._sessionCount then return false end
	table.insert(state.events, now)
	table.insert(self._events, now)
	-- LogCustomEvent does not yield. Do not retry or expose error text/player data.
	local ok = pcall(function()
		self._analytics:LogCustomEvent(player, eventName, value, fields)
	end)
	return ok
end

function Telemetry:sessionStart(player)
	if not self._enabled or player == nil or self._sessions[player] or self._sessionCount &gt;= MAX_SESSIONS then return false end
	local now = self:_now()
	if not now then return false end
	local state = {startedAt = now, events = {}}
	self._sessions[player] = state
	self._sessionCount = self._sessionCount + 1
	return self:_emit(player, state, "SessionStarted", 1)
end

function Telemetry:sessionEnd(player)
	local state = self._sessions[player]
	if not state then return false end
	local now = self:_now()
	local sent = now and self:_emit(player, state, "SessionDurationSeconds", math.min(now - state.startedAt, 86400)) or false
	-- Always clean up, even when the clock or AnalyticsService fails.
	self._sessions[player] = nil
	self._sessionCount = self._sessionCount - 1
	return sent
end

function Telemetry:queueStart(player)
	local state = self._sessions[player]
	if not state or state.queued or state.matchStartedAt then return false end
	state.queued = true
	state.abandonedPhase = nil
	return self:_emit(player, state, "QueueStarted", 1)
end

function Telemetry:matchStart(player, practice)
	local state = self._sessions[player]
	if not state or state.matchStartedAt then return false end
	local now = self:_now()
	if not now then return false end
	state.matchStartedAt = now
	state.mode = practice == true and "practice" or "duel"
	state.queued = false
	state.completed = false
	state.rematched = false
	state.abandonedPhase = nil
	return self:_emit(player, state, "MatchStarted", 1, {CustomField01 = state.mode})
end

function Telemetry:matchComplete(player, outcome, practice)
	local state = self._sessions[player]
	if not state or not state.matchStartedAt then return false end
	local startedAt = state.matchStartedAt
	state.matchStartedAt = nil
	state.completed = true
	-- Prefer the mode captured at launch; no caller-provided identifiers are sent.
	local fields = {CustomField01 = state.mode or (practice == true and "practice" or "duel"),
		CustomField02 = type(outcome) == "string" and OUTCOMES[outcome] and outcome or "unknown"}
	local sent = self:_emit(player, state, "MatchCompleted", 1, fields)
	local now = self:_now()
	if now then self:_emit(player, state, "MatchDurationSeconds", math.min(now - startedAt, 3600), fields) end
	return sent
end

function Telemetry:rematch(player)
	local state = self._sessions[player]
	if not state or not state.completed or state.rematched then return false end
	state.rematched = true
	return self:_emit(player, state, "RematchRequested", 1, {CustomField01 = state.mode})
end

function Telemetry:phaseAbandoned(player, phase)
	local state = self._sessions[player]
	if not state then return false end
	local safePhase = type(phase) == "string" and PHASES[phase] and phase or "Unknown"
	if state.abandonedPhase == safePhase then return false end
	state.abandonedPhase = safePhase
	state.queued = false
	state.matchStartedAt = nil
	state.completed = false
	return self:_emit(player, state, "PhaseAbandoned", 1, {CustomField03 = safePhase})
end

-- Version 1 rivalry funnel. Identifiers stay in a bounded server diagnostic ring;
-- native analytics receives only fixed, low-cardinality segments and durations.
local BATTLE_EVENTS = {join=true,usable_lobby=true,queue=true,match_accepted=true,
    first_launch=true,terminal_result=true,reward_shown=true,replay_requested=true,
    next_actual_launch=true,abandoned=true,goal_selected=true,goal_earned=true,goal_equipped=true}
local DEVICES = {phone=true,tablet=true,desktop=true,console=true,unknown=true}
local MODES = {public=true,challenge=true,practice=true,experimental=true}
function Telemetry:battleEvent(player, name, data)
    if not player or not BATTLE_EVENTS[name] then return false end
    data = type(data)=="table" and data or {}
    local now = self:_now()
    if not now then return false end
    local state = self._battle[player]
    if not state then
        state={startedAt=now,seen={},order={},device="unknown",cohort="unknown"}
        self._battle[player]=state
    end
    if DEVICES[data.device] then state.device=data.device end
    if data.cohort=="new" or data.cohort=="returning" then state.cohort=data.cohort end
    local matchId=tostring(data.matchId or "session")
    local key=name..":"..matchId..":"..tostring(data.itemId or "")
    if name=="queue" then key=key..":"..tostring(data.queueId or data.sequence or 0) end
    if state.seen[key] then return false end
    state.seen[key]=true; table.insert(state.order,key)
    if #state.order&gt;128 then state.seen[table.remove(state.order,1)]=nil end
    if name=="usable_lobby" then state.usableAt=state.usableAt or now end
    if name=="terminal_result" then state.resultAt=now; state.resultMatch=matchId; state.lastOutcome=data.outcome;state.voluntary=false end
    if name=="replay_requested" then state.voluntary=true end
    local entry={version=1,event=name,rosterVersion=string.sub(tostring(data.rosterVersion or "sky-battle-public-v1"),1,64),matchId=matchId,time=now,device=state.device,cohort=state.cohort,
        developer=not self._enabled,mode=MODES[data.mode] and data.mode or "public",
        opponentType=data.opponentType=="human" and "human" or "bot",outcome=data.outcome,
        voluntary=data.voluntary==true,phase=data.phase,elapsed=data.elapsed,queueSeconds=data.queueSeconds,draftSeconds=data.draftSeconds,
        fightSeconds=data.fightSeconds,transitionSeconds=data.transitionSeconds}
    if name=="first_launch" then
        if not state.launched then entry.firstLaunchSeconds=now-(state.usableAt or state.startedAt)
        else entry.event="match_launch" end
        state.launched=true
        if state.resultAt and state.resultMatch~=matchId then
            entry.resultToLaunchSeconds=now-state.resultAt
            self:battleEvent(player,"next_actual_launch",{matchId=matchId,mode=entry.mode,rosterVersion=entry.rosterVersion,
                opponentType=entry.opponentType,outcome=state.lastOutcome,elapsed=entry.resultToLaunchSeconds,voluntary=state.voluntary})
            state.resultAt=nil
        end
    end
    table.insert(self._battleLog,entry)
    if #self._battleLog&gt;256 then table.remove(self._battleLog,1) end
    local native=self._sessions[player]
    if native then
        entry.submitted=self:_emit(player,native,"SkyBattle_v1_"..entry.event,
            math.max(0,math.min(86400,entry.firstLaunchSeconds or data.elapsed or 1)),
            {CustomField01=state.cohort..":"..state.device,
             CustomField02=entry.mode..":"..entry.opponentType..":"..entry.rosterVersion,
             CustomField03=(OUTCOMES[data.outcome] and data.outcome or "none")..(name=="next_actual_launch" and (entry.voluntary and ":voluntary" or ":continuation") or "")})
    end
    return true
end
function Telemetry:battleLog()
    local result={}
    for _,entry in ipairs(self._battleLog) do
        local copy={}; for key,value in pairs(entry) do copy[key]=value end
        table.insert(result,copy)
    end
    return result
end
function Telemetry:battleContext(player,data)
    local state=self._battle[player]
    if state and (data.cohort=="new" or data.cohort=="returning") then state.cohort=data.cohort end
end
function Telemetry:battleLeave(player)
    self._battle[player]=nil
end
return Telemetry
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX20">
      <Properties>
        <string name="Name">BattleLab</string>
        <ProtectedString name="Source">-- Authoritative, same-server Sky Battle rivalry. The public combat pool never
-- reads account ownership. Only recipient-owned draft data crosses the remote.
local BattleLab = {}
BattleLab.__index = BattleLab
BattleLab.ROSTER_VERSION = "sky-battle-public-v1"
BattleLab.QUEUE_SECONDS = 8
BattleLab.PICK_SECONDS = 10
BattleLab.MATCH_SECONDS = 240
BattleLab.MAX_ROUNDS = 5
local PUBLIC = {offences={"Meteor","Firework","MachineGun","Pinball"},
    wilds={"Afterburner","SpringBumper","FizzyFuel","Magnet","SecondWind"}}
local function finite(value)
    return type(value)=="number" and value==value and value&gt;-math.huge and value&lt;math.huge
end
local function copy(value)
    if type(value)~="table" then return value end
    local result={}; for key,item in pairs(value) do result[key]=copy(item) end; return result
end
local function contains(list,value)
    for _,item in ipairs(list or {}) do if item==value then return true end end
    return false
end
local function seat(index,side)
    return side==2 and (index==1 and 2 or index==2 and 1 or index) or index
end
local function pair(values,side)
    return {copy(values[side]),copy(values[3-side])}
end
-- Everything seen by client 2 uses its own seat as 1, including event emphasis,
-- projectile ownership and the left-hand opening. Never mutate the shared sim.
local function perspective(value,side)
    local result=copy(value)
    if side~=2 or not result then return result end
    local function visit(item)
        if type(item)~="table" then return end
        for key,v in pairs(item) do
            if type(v)=="table" then visit(v)
            elseif key=="actor" or key=="target" or key=="owner" or key=="winner" then item[key]=seat(v,side)
            elseif key=="x" or key=="vx" or key=="lockX" or key=="_knockX" or key=="_chargeX" or key=="_recoverX" then
                if type(v)=="number" then item[key]=-v end
            elseif key=="heading" or key=="_attackHeading" then
                if type(v)=="number" then item[key]=(math.pi-v+math.pi)%(2*math.pi)-math.pi end
            end
        end
    end
    visit(result)
    if result.fighters then
        result.fighters={result.fighters[2],result.fighters[1]}
        for index,fighter in ipairs(result.fighters) do fighter.id=index end
    end
    return result
end
function BattleLab.new(deps)
    return setmetatable({deps=deps,sessions={},matches={},queue={},throttle={},sequence=0,roundSequence=0,
        queueSequence=0,broadcastTime=0,lobbyBroadcastTime=0,seed=math.floor(deps.now()*1000)+7919,seedBase=math.floor(deps.now()*1000)+7919,previous={},invitations={},userInvites={},inviteSequence=0,inviteCooldown={},challengeFeedback={}},BattleLab)
end
function BattleLab:random(maximum)
    self.seed=(self.seed*16807)%2147483647
    return math.floor((self.seed/2147483647)*maximum)+1
end
function BattleLab:roster(player)
    local requested=self.deps.allowExperimental and self.deps.resolveRoster and self.deps.resolveRoster(player)
    local source=requested or PUBLIC
    local result={mode=requested and "experimental" or "public",version=requested and requested.version or self.ROSTER_VERSION,
        offences={},wilds={}}
    for _,kind in ipairs({"offences","wilds"}) do
        local validKind=kind=="offences" and "offence" or "wild"
        for _,id in ipairs(source[kind] or {}) do
            if self.deps.skills.valid(id,validKind) and id~="Copycat" and not contains(result[kind],id) then
                result[kind][#result[kind]+1]=id
            end
        end
    end
    if #result.offences==0 or #result.wilds&lt;2 then return nil end
    -- Fingerprinting the actual pools isolates stale or changed experiments too.
    result.key=result.mode..":"..tostring(result.version)..":"..table.concat(result.offences,",")..":"..table.concat(result.wilds,",")
    return result
end
function BattleLab:identity(player)
    if not player then
        local personas={{"Comet","Bold dives. Same cards as you.","☄️","cruiser",1},{"Pip","Patient aim. Same cards as you.","🐦","skyhopper",2},{"Fizz","Loves a comeback. Same cards as you.","⚡","dart",4}}
        local persona=personas[(self.sequence-1)%#personas+1]
        return {userId=0,name=persona[1],bot=true,portrait=persona[3],personality=persona[2],planeId=persona[4],color=persona[5],trailId="classic"}
    end
    local extra=self.deps.identity and self.deps.identity(player) or {}
    return {userId=player.UserId,name=extra.name or player.DisplayName or player.Name,bot=false,
        planeId=extra.planeId or player:GetAttribute("SkyboundPlane") or "cruiser",
        color=extra.color or player:GetAttribute("SkyboundColor") or 1,
        trailId=extra.trailId or player:GetAttribute("SkyboundTrail") or "classic"}
end
function BattleLab:event(player,name,m,extra)
    if not self.deps.onEvent or not player then return end
    local data={matchId=m and m.id or 0,roundId=m and m.roundId or 0,roundNumber=m and m.roundNumber or 0,
        stage=m and m.stage or 0,mode=m and m.mode or "public",rosterVersion=m and m.roster.version or self.ROSTER_VERSION,
        opponentType=m and (m.participants[2].player and "human" or "bot") or "unknown",
        elapsed=m and self.deps.now()-m.startedAt or 0,queueSeconds=m and m.queueSeconds or 0,
        fightSeconds=m and m.fightSeconds or 0,draftSeconds=m and m.draftSeconds or 0,transitionSeconds=m and m.transitionSeconds or 0}
    for key,value in pairs(extra or {}) do data[key]=value end
    self.deps.onEvent(player,name,data)
end
function BattleLab:eligible(m,side)
    local result={}; local build=m.settings[side]
    for _,id in ipairs(m.stage==1 and m.roster.offences or m.roster.wilds) do
        if not contains(build.wildIds,id) then result[#result+1]=id end
    end
    return result
end
function BattleLab:offer(eligible,old)
    local shuffled=copy(eligible)
    for index=#shuffled,2,-1 do local other=self:random(index); shuffled[index],shuffled[other]=shuffled[other],shuffled[index] end
    local result={}; for index=1,math.min(3,#shuffled) do result[index]=shuffled[index] end
    if old and #eligible&gt;3 then
        local same=true; for _,id in ipairs(result) do if not contains(old,id) then same=false end end
        if same then for _,id in ipairs(eligible) do if not contains(result,id) then result[#result]=id; break end end end
    end
    return result
end
function BattleLab:changePhase(m,phase,endsAt)
    local elapsed=math.max(0,self.deps.now()-(m.phaseAt or self.deps.now()))
    if m.phase=="Pick" then m.draftSeconds=m.draftSeconds+elapsed
    elseif m.phase=="Fight" then m.fightSeconds=m.fightSeconds+math.min(35,elapsed)
    elseif m.phase then m.transitionSeconds=m.transitionSeconds+elapsed end
    m.phase=phase; m.phaseAt=self.deps.now(); m.endsAt=endsAt or 0
end
function BattleLab:startPick(m)
    self:changePhase(m,"Pick",self.deps.now()+self.PICK_SECONDS)
    m.selected={}; m.locked={false,false}; m.offers={}; m.offerRevision={1,1}; m.pickAnyActive={false,false}
    for side,participant in ipairs(m.participants) do
        m.offers[side]=self:offer(self:eligible(m,side))
        if not participant.player then m.selected[side]=m.offers[side][self:random(#m.offers[side])]; m.locked[side]=true end
    end
end
function BattleLab:startRound(m)
    self.roundSequence=self.roundSequence+1
    m.roundId=self.roundSequence; m.roundNumber=m.roundNumber+1
    local seed
    if self.deps.allowFixedSeed and finite(self.deps.fixedSeed) then seed=self.deps.fixedSeed
    else seed=(self.seedBase+self.roundSequence*7919)%2147483646+1 end
    m.simulation=self.deps.simulation.newRound(seed,m.settings[1],m.settings[2])
    m.roundEvents={}; m.eventSerial=0; m.accumulator=0
    self:changePhase(m,"Countdown",self.deps.now()+2.4)
end
function BattleLab:reveal(m)
    for side=1,2 do
        local selected=m.selected[side] or m.offers[side][1]
        if m.stage==1 then m.settings[side].offenceId=selected
        else table.insert(m.settings[side].wildIds,selected) end
    end
    self:startRound(m)
end
function BattleLab:createMatch(a,b,mode,botIdentity)
    if not a or not self.sessions[a.player.UserId] then return nil end
    self.sequence=self.sequence+1
    local m={id=self.sequence,participants={{player=a.player},{player=b and b.player}},identities={self:identity(a.player),copy(botIdentity) or self:identity(b and b.player)},
        roster=copy(a.roster),mode=mode or a.roster.mode,diagnostic=a.roster.mode=="experimental" or (self.deps.allowFixedSeed and finite(self.deps.fixedSeed)),startedAt=self.deps.now(),score={0,0},stage=1,
        roundNumber=0,roundId=0,settings={{wildIds={},angle=35},{wildIds={},angle=35}},resources={{reroll=1,pickAny=1},{reroll=1,pickAny=1}},
        votes={false,false},rewards={},rounds={},completedRounds=0,decisiveRounds=0,fightSeconds=0,draftSeconds=0,transitionSeconds=0,
        queueSeconds=math.max(0,self.deps.now()-a.queuedAt)}
    self.matches[m.id]=m
    for side,p in ipairs(m.participants) do
        if p.player then
            self.sessions[p.player.UserId]={player=p.player,match=m,side=side}
            self:event(p.player,"match_accepted",m)
        end
    end
    self:startPick(m); self:emitMatch(m)
    return m
end
function BattleLab:compactQueue()
    local result={}
    for _,entry in ipairs(self.queue) do if self.sessions[entry.player.UserId]==entry then result[#result+1]=entry end end
    self.queue=result
end
function BattleLab:matchQueue()
    self:compactQueue()
    local index=1
    while index&lt;=#self.queue do
        local a=self.queue[index]; local partner
        for other=index+1,#self.queue do if self.queue[other].roster.key==a.roster.key then partner=other; break end end
        if partner then
            local b=table.remove(self.queue,partner); table.remove(self.queue,index); self:createMatch(a,b)
        elseif self.deps.now()&gt;=a.queuedAt+self.QUEUE_SECONDS then table.remove(self.queue,index); self:createMatch(a,nil)
        else index=index+1 end
    end
end
function BattleLab:enter(player)
    if self.sessions[player.UserId] or not self.deps.canEnter(player) then return end
    local roster=self:roster(player); if not roster then return end
    self:cancelInviteFor(player,"unavailable","A pilot entered matchmaking.")
    self.queueSequence=self.queueSequence+1
    local entry={player=player,queuedAt=self.deps.now(),queueId=self.queueSequence,roster=roster}
    self.sessions[player.UserId]=entry; table.insert(self.queue,entry)
    self.deps.entered(player); self:event(player,"queue",nil,{queueId=entry.queueId,mode=roster.mode,rosterVersion=roster.version})
    self:matchQueue()
end
function BattleLab:facts(m,result,side)
    if result.reason=="disconnect" or result.reason=="exit" then return {"The rival left the match."} end
    if result.reason=="wall_cap" then return {result.winner==0 and "Time limit: completed round wins were tied. Match drawn." or "Time limit: completed round wins decide the match."} end
    if result.reason=="round_cap" then return {result.winner==0 and "Five rounds played: completed round wins were tied. Match drawn." or "Five rounds played: completed round wins decide the match."} end
    if result.reason=="shutdown" then return {"Server closed: the match ended without a winner."} end
    local reason=result.decidingRoundReason or result.reason
    if result.winner==0 then
        return {reason=="knockout" and "Both planes lost their final armor together." or "Equal armor: this round gave neither pilot a point."}
    end
    if reason=="timeout" or reason=="time" then return {"At 35 seconds, the plane with more armor won."} end
    local facts={}
    for index=#(result.events or {}),1,-1 do
        local event=result.events[index]
        if event.kind=="hit" or event.kind=="wake_hit" then
            local skill=self.deps.skills.get(event.skillId or "")
            facts[1]=(event.actor==side and "Your " or "Rival's ")..(skill and skill.name or "attack").." landed the final hit."
            break
        end
    end
    for index=#(result.events or {}),1,-1 do
        local event=result.events[index]
        if event.kind=="blocked" then
            facts[#facts+1]=(event.actor==side and "Your " or "Rival's ").."Spring Bumper blocked an attack."
            break
        end
    end
    if #facts==0 then facts[1]="The round ended with more armor on the winning plane." end
    return facts
end
function BattleLab:viewResult(m,result,side)
    if not result then return nil end
    local value=perspective(result,side)
    value.score=pair(result.score or m.score,side)
    value.facts=self:facts(m,result,side)
    return value
end
function BattleLab:snapshot(player)
    local session=self.sessions[player.UserId]
    if not session then return self:lobbySnapshot(player) end
    if not session.match then return {active=true,phase="Searching",serverTime=self.deps.now(),endsAt=session.queuedAt+self.QUEUE_SECONDS,
        queuedAt=session.queuedAt,queueId=session.queueId,rosterVersion=session.roster.version,mode=session.roster.mode} end
    local m,side=session.match,session.side
    local eligible=m.phase=="Pick" and self:eligible(m,side) or {}
    local resources=copy(m.resources[side]); local reason
    if resources.reroll==0 then reason="Used this match"
    elseif #eligible&lt;=3 then reason="All remaining cards are already offered"
    elseif m.pickAnyActive[side] then reason="Pick Any is open" end
    return {active=true,phase=m.phase,matchId=m.id,roundId=m.roundId,roundNumber=m.roundNumber,stage=m.stage,
        slot=m.stage==1 and "offence" or "wild",score=pair(m.score,side),settings=pair(m.settings,side),players=pair(m.identities,side),
        simulation=perspective(m.simulation,side),endsAt=m.endsAt,pickDeadline=m.phase=="Pick" and m.endsAt or 0,
        fightDeadline=m.phase=="Fight" and m.fightDeadline or 0,
        matchDeadline=m.startedAt+self.MATCH_SECONDS,serverTime=self.deps.now(),simulatedOpponent=m.identities[3-side].bot,
        offer=m.phase=="Pick" and copy(m.offers[side]) or {},offerRevision=m.offerRevision[side],eligible=eligible,
        selected=m.phase=="Pick" and m.selected[side] or nil,locked=pair(m.locked or {false,false},side),
        resources=resources,pickAnyActive=m.pickAnyActive[side],rerollReason=reason,matchPoint=m.score[1]==1 or m.score[2]==1,
        result=self:viewResult(m,m.result,side),roundResult=self:viewResult(m,m.roundResult,side),reward=copy(m.rewards[side]),
        rematchVotes=pair(m.votes,side),rivalGone=m.participants[3-side].gone==true,
        rematchStatus=m.participants[3-side].gone and "unavailable" or m.votes[side] and "waiting" or "ready",
        rosterVersion=m.roster.version,mode=m.mode,experimental=m.roster.mode=="experimental"}
end
function BattleLab:emit(player) self.deps.emit(player,self:snapshot(player)) end
function BattleLab:emitMatch(m)
    for _,participant in ipairs(m.participants) do if participant.player and not participant.gone then self:emit(participant.player) end end
end
function BattleLab:terminal(m,winner,reason,leaver)
    if m.phase=="MatchOver" then return end
    self:changePhase(m,"MatchOver")
    m.result={winner=winner,reason=reason,score=copy(m.score),events=copy(m.roundResult and m.roundResult.events or {}),
        decidingRoundReason=reason=="first_to_two" and m.roundResult and m.roundResult.reason or nil}
    for side,p in ipairs(m.participants) do
        if p.player then
            local result={matchId=m.id,winner=seat(winner,side),reason=reason,score=pair(m.score,side),abandoned=side==leaver,
                completedRounds=m.completedRounds,decisiveRounds=m.decisiveRounds,fightSeconds=m.fightSeconds,
                elapsed=self.deps.now()-m.startedAt,opponentType=m.identities[3-side].bot and "bot" or "human",mode=m.mode,
                rosterVersion=m.roster.version,diagnostic=m.diagnostic==true,outcome=side==leaver and "abandoned" or winner==0 and "draw" or winner==side and "win" or "loss",offenceId=m.settings[side].offenceId,wildIds=copy(m.settings[side].wildIds),rounds=copy(m.rounds)}
            self.previous[p.player.UserId]={matchId=m.id,result=result.winner,endedAt=self.deps.now(),requested=false}
            self:event(p.player,"terminal_result",m,result)
            if self.deps.onTerminal then m.rewards[side]=self.deps.onTerminal(p.player,result) end
        end
    end
end
function BattleLab:roundEnded(m)
    local sim=m.simulation; local winner=sim.winner or 0
    m.completedRounds=m.completedRounds+1
    if winner&gt;0 then m.score[winner]=m.score[winner]+1; m.decisiveRounds=m.decisiveRounds+1 end
    local result={winner=winner,reason=sim.reason or "knockout",score=copy(m.score),events=copy(m.roundEvents),roundNumber=m.roundNumber}
    m.roundResult=result
    m.rounds[#m.rounds+1]={seed=sim.seed,settings=copy(m.settings),winner=winner,reason=result.reason,duration=sim.elapsed,roundNumber=m.roundNumber}
    if m.score[1]&gt;=2 or m.score[2]&gt;=2 then self:terminal(m,m.score[1]&gt;=2 and 1 or 2,"first_to_two")
    elseif m.roundNumber&gt;=self.MAX_ROUNDS then self:terminal(m,m.score[1]==m.score[2] and 0 or m.score[1]&gt;m.score[2] and 1 or 2,"round_cap")
    else self:changePhase(m,"RoundOver",self.deps.now()+2) end
end
function BattleLab:leave(player,reason)
    local session=self.sessions[player.UserId]; if not session then return end
    local m=session.match
    if m then
        local side=session.side
        if m.phase~="MatchOver" then
            self:event(player,"abandoned",m,{phase=m.phase,reason=reason or "exit"})
            self:terminal(m,3-side,reason or "exit",side)
        end
        m.participants[side].gone=true; m.votes[side]=false
        self.sessions[player.UserId]=nil
        self:emitMatch(m)
        if (m.participants[1].gone or not m.participants[1].player) and (m.participants[2].gone or not m.participants[2].player) then self.matches[m.id]=nil end
    else
        self:event(player,"abandoned",nil,{phase="Searching",queueId=session.queueId,elapsed=self.deps.now()-session.queuedAt})
        self.sessions[player.UserId]=nil; self:compactQueue()
    end
    self.deps.exited(player)
end
-- Invitations are offers, not reservations: walking/queueing stays usable.
-- Acceptance checks both players and freezes their shared pool before reserving
-- either one. No yielding callbacks occur until both records are installed.
function BattleLab:available(player)
    return player~=nil and self.sessions[player.UserId]==nil and self.deps.canEnter(player)
end
function BattleLab:lobbySnapshot(player)
    local candidates={}
    for _,other in ipairs(self.deps.getPlayers and self.deps.getPlayers() or {}) do
        if other.UserId~=player.UserId then
            candidates[#candidates+1]={userId=other.UserId,name=other.DisplayName or other.Name,available=self:available(other) and not self.userInvites[other.UserId]}
        end
    end
    table.sort(candidates,function(a,b)return a.userId&lt;b.userId end)
    local invite=self.userInvites[player.UserId]; local view
    if invite then
        local incoming=invite.to.UserId==player.UserId; local other=incoming and invite.from or invite.to
        view={inviteId=invite.id,direction=incoming and "incoming" or "outgoing",name=other.DisplayName or other.Name,
            userId=other.UserId,expiresAt=invite.expiresAt}
    end
    return {active=false,serverTime=self.deps.now(),challenge=view,challengeCandidates=candidates,
        challengeFeedback=copy(self.challengeFeedback[player.UserId])}
end
function BattleLab:clearInvite(invite,code,message,silent)
    if not invite or self.invitations[invite.id]~=invite then return end
    self.invitations[invite.id]=nil
    for _,player in ipairs({invite.from,invite.to}) do
        if self.userInvites[player.UserId]==invite then self.userInvites[player.UserId]=nil end
        self.challengeFeedback[player.UserId]={ok=code=="accepted",code=code,text=message}
    end
    if not silent then self:emit(invite.from); self:emit(invite.to) end
end
function BattleLab:cancelInviteFor(player,code,message)
    self:clearInvite(self.userInvites[player.UserId],code,message)
end
function BattleLab:challengeCommand(player,payload)
    local kind=payload.kind;local invite=self.userInvites[player.UserId]
    local function refuse(code,message)
        self.challengeFeedback[player.UserId]={ok=false,code=code,text=message};self:emit(player)
    end
    if kind=="challenge" then
        if not self:available(player) then refuse("busy","Return to the hangar to challenge a pilot.");return end
        if invite then refuse("pending","Answer or cancel the current challenge first.");return end
        if self.deps.now()&lt;(self.inviteCooldown[player.UserId] or 0) then refuse("cooldown","Wait a moment before challenging again.");return end
        local target
        for _,other in ipairs(self.deps.getPlayers and self.deps.getPlayers() or {}) do if other.UserId==payload.targetUserId then target=other end end
        if not target or target.UserId==player.UserId or not self:available(target) or self.userInvites[target.UserId] then
            refuse("unavailable","That pilot is unavailable. Choose another pilot.");return
        end
        local a,b=self:roster(player),self:roster(target)
        if not a or not b or a.key~=b.key then refuse("roster","These pilots are in different test pools.");return end
        self.inviteSequence=self.inviteSequence+1
        local duration=finite(self.deps.challengeSeconds) and math.max(5,math.min(60,self.deps.challengeSeconds)) or 25
        invite={id=self.inviteSequence,from=player,to=target,expiresAt=self.deps.now()+duration}
        self.invitations[invite.id]=invite;self.userInvites[player.UserId]=invite;self.userInvites[target.UserId]=invite
        self.inviteCooldown[player.UserId]=self.deps.now()+3
        self.challengeFeedback[player.UserId]={ok=true,code="sent",text="Challenge sent."}
        self.challengeFeedback[target.UserId]=nil;self:emit(player);self:emit(target)
    elseif invite and payload.inviteId==invite.id then
        if self.deps.now()&gt;=invite.expiresAt then self:clearInvite(invite,"expired","Challenge expired.");return end
        if kind=="challengeCancel" and invite.from==player then self:clearInvite(invite,"cancelled","Challenge cancelled.")
        elseif kind=="challengeDecline" and invite.to==player then self:clearInvite(invite,"declined","Challenge declined.")
        elseif kind=="challengeAccept" and invite.to==player then
            local a,b=invite.from,invite.to
            local rosterA,rosterB=self:roster(a),self:roster(b)
            if not self:available(a) or not self:available(b) or not rosterA or not rosterB or rosterA.key~=rosterB.key then
                self:clearInvite(invite,"unavailable","A pilot is no longer available.");return
            end
            local entryA={player=a,queuedAt=self.deps.now(),roster=rosterA}
            local entryB={player=b,queuedAt=self.deps.now(),roster=rosterB}
            self.sessions[a.UserId]=entryA;self.sessions[b.UserId]=entryB
            self:clearInvite(invite,"accepted","Challenge accepted.",true)
            self.deps.entered(a);self.deps.entered(b)
            self:createMatch(entryA,entryB,"challenge")
        end
    else refuse("expired","That challenge is no longer available.") end
end
function BattleLab:command(player,payload)
    if type(payload)~="table" or type(payload.kind)~="string" then return end
    local kind=payload.kind; local time=self.deps.now()
    if kind=="exit" then
        local current=self.sessions[player.UserId]
        if current and current.match and payload.matchId~=nil and payload.matchId~=current.match.id then return end
        if current and not current.match and payload.queueId~=nil and payload.queueId~=current.queueId then return end
        self:cancelInviteFor(player,"cancelled","Challenge cancelled.")
        self:leave(player,"exit"); self:emit(player); return
    end
    local budget=self.throttle[player.UserId] or {time=time,tokens=8}
    budget.tokens=math.min(8,budget.tokens+math.max(0,time-budget.time)*15); budget.time=time; self.throttle[player.UserId]=budget
    if budget.tokens&lt;1 then return end; budget.tokens=budget.tokens-1
    local session=self.sessions[player.UserId]; local m=session and session.match
    if kind=="request" then self:emit(player); return end
    if kind=="challenge" or kind=="challengeAccept" or kind=="challengeDecline" or kind=="challengeCancel" then
        self:challengeCommand(player,payload); return
    end
    if kind=="enter" and not session then self:enter(player)
    elseif m and payload.matchId==m.id then
        local side=session.side
        if kind=="rematchDecline" and m.phase=="MatchOver" then
            local players={m.participants[1].player,m.participants[2].player}
            for _,participant in ipairs(players) do
                if participant and self.sessions[participant.UserId] then self:leave(participant); self:emit(participant) end
            end
        elseif kind=="again" and m.phase=="MatchOver" then
            self:event(player,"replay_requested",m,{route="queue"})
            if self.previous[player.UserId] then self.previous[player.UserId].requested=true end
            self:leave(player); self:enter(player)
        elseif kind=="rematch" and m.phase=="MatchOver" and not m.participants[3-side].gone and not m.votes[side] then
            m.votes[side]=true
            self:event(player,"replay_requested",m,{route="rematch"})
            if self.previous[player.UserId] then self.previous[player.UserId].requested=true end
            if not m.participants[3-side].player then m.votes[3-side]=true end
            if m.votes[1] and m.votes[2] then
                local a={player=m.participants[1].player,queuedAt=time,roster=m.roster}
                local b=m.participants[2].player and {player=m.participants[2].player,queuedAt=time,roster=m.roster} or nil
                self.matches[m.id]=nil; self:createMatch(a,b,m.mode,not b and m.identities[2] or nil)
            end
        elseif m.phase=="Pick" and time&lt;m.endsAt and payload.stage==m.stage and payload.offerRevision==m.offerRevision[side] and not m.locked[side]
            and payload.side==nil and payload.userId==nil and payload.playerId==nil and payload.settings==nil then
            local eligible=self:eligible(m,side)
            if kind=="pick" and payload.slot==(m.stage==1 and "offence" or "wild") and contains(m.offers[side],payload.skillId) then
                m.selected[side]=payload.skillId
            elseif kind=="lock" and payload.slot==(m.stage==1 and "offence" or "wild") and contains(m.offers[side],payload.skillId) then
                -- Lock exactly the card the pilot saw. Only the deadline may
                -- auto-pick: an old offer or missing selection cannot do so.
                m.selected[side]=payload.skillId; m.locked[side]=true
                if m.locked[1] and m.locked[2] then self:reveal(m) end
            elseif kind=="reroll" and m.resources[side].reroll&gt;0 and #eligible&gt;3 and not m.pickAnyActive[side] then
                m.offers[side]=self:offer(eligible,m.offers[side]); m.resources[side].reroll=0; m.selected[side]=nil
                m.offerRevision[side]=m.offerRevision[side]+1
            elseif kind=="pickAny" and m.resources[side].pickAny&gt;0 then
                m.resources[side].pickAny=0; m.pickAnyActive[side]=true; m.offers[side]=eligible; m.selected[side]=nil
                m.offerRevision[side]=m.offerRevision[side]+1
            end
        end
        self:emitMatch(m)
    end
    self:emit(player)
end
function BattleLab:step(dt)
    if not finite(dt) or dt&lt;=0 then return end
    for _,invite in pairs(self.invitations) do
        if self.deps.now()&gt;=invite.expiresAt then self:clearInvite(invite,"expired","Challenge expired.") end
    end
    self:matchQueue()
    self.lobbyBroadcastTime=self.lobbyBroadcastTime+dt
    if self.lobbyBroadcastTime&gt;=.5 then
        self.lobbyBroadcastTime=0
        for _,player in ipairs(self.deps.getPlayers and self.deps.getPlayers() or {}) do
            if not self.sessions[player.UserId] then self:emit(player) end
        end
    end
    self.broadcastTime=self.broadcastTime+dt
    local emit=self.broadcastTime&gt;=1/20; if emit then self.broadcastTime=0 end
    local time=self.deps.now()
    for _,m in pairs(self.matches) do
        if m.phase~="MatchOver" and time&gt;=m.startedAt+self.MATCH_SECONDS then
            self:terminal(m,m.score[1]==m.score[2] and 0 or m.score[1]&gt;m.score[2] and 1 or 2,"wall_cap")
        elseif m.phase=="Pick" and time&gt;=m.endsAt then
            for side=1,2 do if not m.locked[side] then m.selected[side]=m.offers[side][1]; m.locked[side]=true end end
            self:reveal(m)
        elseif m.phase=="Countdown" and time&gt;=m.endsAt then
            self:changePhase(m,"Fight"); m.accumulator=0; m.fightDeadline=time+35
            for _,p in ipairs(m.participants) do
                if p.player then
                    self:event(p.player,m.roundNumber==1 and "first_launch" or "round_launch",m,{seed=m.simulation.seed})
                end
            end
        elseif m.phase=="RoundOver" and time&gt;=m.endsAt then
            if m.roundResult.winner&gt;0 then m.stage=m.stage+1; self:startPick(m) else self:startRound(m) end
        end
        if m.phase=="Fight" and time&gt;=m.fightDeadline then
            local sim=m.simulation;local a,b=sim.fighters[1],sim.fighters[2]
            sim.finished=true;sim.elapsed=35;sim.reason="timeout"
            sim.winner=a.armor==b.armor and 0 or a.armor&gt;b.armor and 1 or 2
            a.armed=false;b.armed=false
            self:roundEnded(m)
        end
        if m.phase=="Fight" then
            m.accumulator=math.min(m.accumulator+dt,0.25)
            while m.accumulator+0.000000001&gt;=self.deps.simulation.FIXED_DT do
                m.accumulator=m.accumulator-self.deps.simulation.FIXED_DT
                self.deps.simulation.step(m.simulation,self.deps.simulation.FIXED_DT)
                for _,event in ipairs(m.simulation.events or {}) do
                    if event.serial&gt;m.eventSerial then
                        m.eventSerial=event.serial
                        if event.kind=="hit" or event.kind=="wake_hit" or event.kind=="blocked" or event.kind=="finish" or event.kind=="revive" then
                            local recorded=copy(event); recorded.roundNumber=m.roundNumber; recorded.outcome=event.kind
                            local sourceSkills={meteor="Meteor",rocket="Firework",machinegun="MachineGun",pinball="Pinball",wake="FizzyFuel"}
                            recorded.skillId=recorded.skillId or sourceSkills[recorded.source]
                            m.roundEvents[#m.roundEvents+1]=recorded
                        end
                    end
                end
                if m.simulation.finished then self:roundEnded(m); break end
            end
        end
        if emit then self:emitMatch(m) end
    end
    if emit then for _,entry in ipairs(self.queue) do self:emit(entry.player) end end
end
function BattleLab:shutdown()
    for _,m in pairs(self.matches) do
        if m.phase~="MatchOver" then self:terminal(m,0,"shutdown") end
    end
    local players={}
    for _,session in pairs(self.sessions) do players[#players+1]=session.player end
    for _,player in ipairs(players) do self:leave(player,"shutdown");self:emit(player) end
    for _,invite in pairs(self.invitations) do self:clearInvite(invite,"shutdown","Server closing.") end
    self.queue={}
end
function BattleLab:remove(player)
    self:cancelInviteFor(player,"departed","The other pilot left the server.")
    self:leave(player,"disconnect"); self.throttle[player.UserId]=nil; self.previous[player.UserId]=nil
    self.inviteCooldown[player.UserId]=nil; self.challengeFeedback[player.UserId]=nil
end
return BattleLab
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="RBX21">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX22">
      <Properties>
        <string name="Name">SimulationTests</string>
        <ProtectedString name="Source">-- Pure tests: run require(thisModule)(Simulation) in Studio or any Lua runtime.
-- No services or game state are touched. The returned string lists coverage.
return function(Simulation)
	local passed = 0
	local function check(condition, message)
		assert(condition, message)
	end
	local function close(a, b)
		return math.abs(a - b) &lt; 0.0000001
	end
	local function test(name, callback)
		local ok, problem = pcall(callback)
		assert(ok, name .. ": " .. tostring(problem))
		passed = passed + 1
	end
	local function emptyCourse()
		return { seed = 1, name = "Test", items = {}, length = 4200 }
	end
	local function run(settings, course)
		local state = Simulation.newFlight(settings, course)
		for _ = 1, math.ceil(Simulation.MAX_FLIGHT_TIME / Simulation.FIXED_DT) + 1 do
			Simulation.step(state, course, Simulation.FIXED_DT)
			if not state.alive then
				return state
			end
		end
		error("Flight exceeded safety timeout")
	end
	local function item(kind, x, y, id, value)
		return { id = id or 1, kind = kind, x = x, y = y, radius = 2, value = value or 10 }
	end

	test("course and flight determinism", function()
		local a, b = Simulation.makeCourse(492531, "Storm"), Simulation.makeCourse(492531, "Storm")
		check(#a.items == #b.items and #a.items &gt; 20, "Course item count changed")
		for i, entry in ipairs(a.items) do
			local other = b.items[i]
			check(entry.id == i, "Course IDs must be unique")
			check(entry.kind == other.kind and entry.x == other.x and entry.y == other.y and entry.value == other.value, "Seed produced different course")
			local ax, ay = Simulation.itemPosition(entry, 12.5)
			local bx, by = Simulation.itemPosition(other, 12.5)
			check(ax == bx and ay == by, "Missile motion is nondeterministic")
		end
		local f, g = run(Simulation.DEFAULT_SETTINGS, a), run(Simulation.DEFAULT_SETTINGS, b)
		check(f.x == g.x and f.y == g.y and f.elapsed == g.elapsed and f.hits == g.hits and f.pickups == g.pickups, "Repeated flight differed")
		check(f.lastEvent.kind == g.lastEvent.kind and f.finishReason == g.finishReason, "Finish differs")
		check(f.nearMisses == g.nearMisses and f.eventSerial == g.eventSerial, "Event sequence differs")
		for id in pairs(f.used) do
			check(g.used[id], "Collision order differs")
		end
	end)

	test("fuel adds forward and upward motion only once", function()
		local course = emptyCourse()
		course.items = { item("fuel", 0, 18, 1, 20) }
		local baseline = Simulation.newFlight(nil, course)
		local boosted = Simulation.newFlight(nil, course)
		Simulation.step(baseline, emptyCourse(), Simulation.FIXED_DT)
		Simulation.step(boosted, course, Simulation.FIXED_DT)
		check(boosted.vx &gt; baseline.vx and boosted.vy &gt; baseline.vy, "Fuel did not boost both velocities")
		check(boosted.pickups == 1 and boosted.used[1] and boosted.lastEvent.kind == "fuel", "Missing pickup event")
		for _ = 1, 4 do
			Simulation.step(boosted, course, Simulation.FIXED_DT)
		end
		check(boosted.pickups == 1, "Fuel collected twice")
	end)

	test("shield blocks exactly one missile", function()
		local course = emptyCourse()
		course.items = { item("missile", 0, 18, 1), item("missile", 0, 18, 2) }
		local state = Simulation.newFlight({ gadget = "Shield" }, course)
		local initialSpeed = state.vx
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.alive and state.hits == 2 and state.shield == 0, "Shield must consume once and allow damage afterward")
		check(state.vx &lt; initialSpeed * 0.95 and state.vx &gt; initialSpeed * 0.88 and state.lastEvent.kind == "missile", "Exactly one missile should damage through the shield")
	end)

	test("missile damage is recoverable with fuel", function()
		local course = emptyCourse()
		local state = Simulation.newFlight({ gadget = "Magnet" }, course)
		state.x, state.y, state.vx, state.vy = 0, 70, 60, -5
		course.items = { item("missile", 0, 70, 1) }
		Simulation.step(state, course, Simulation.FIXED_DT)
		local damagedVx, damagedVy = state.vx, state.vy
		check(state.alive and damagedVy &lt; -14 and state.hits == 1, "Missile should hurt without ending flight")
		course.items = { item("fuel", state.x, state.y, 2, 20) }
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.alive and state.vx &gt; damagedVx and state.vy &gt; damagedVy + 15, "Fuel cannot recover a damaged plane")
	end)

	test("magnet increases fuel reach but not missile reach", function()
		local course = emptyCourse()
		course.items = { item("fuel", 0, 35, 1), item("missile", 0, 35, 2) }
		local magnet = Simulation.newFlight({ gadget = "Magnet" }, course)
		local normal = Simulation.newFlight({ gadget = "Shield" }, course)
		Simulation.step(magnet, course, Simulation.FIXED_DT)
		Simulation.step(normal, course, Simulation.FIXED_DT)
		check(magnet.pickups == 1 and normal.pickups == 0, "Magnet does not increase pickup radius")
		check(magnet.hits == 0, "Magnet attracted a missile")
	end)

	test("automatic rescue boost fires once", function()
		local course = emptyCourse()
		local state = Simulation.newFlight({ gadget = "Boost" }, course)
		state.elapsed, state.y, state.vy = 2, 18, -10
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.boostUsed and state.vy &gt; 20 and state.lastEvent.kind == "boost", "Rescue did not fire automatically")
		state.y, state.vy = 18, -10
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.vy &lt; 0, "Rescue fired twice")
	end)

	test("swept collision catches skipped endpoints", function()
		local course = emptyCourse()
		course.items = { item("fuel", 100, 50, 1, 5) }
		local state = Simulation.newFlight(nil, course)
		state.y, state.vx, state.vy = 50, 12000, 0
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.x &gt; 190 and state.pickups == 1, "Swept collision missed a crossed pickup")
	end)

	test("moving missile uses matching visual position", function()
		local course = emptyCourse()
		local missile = item("missile", 0, 50, 1)
		missile.amplitude, missile.frequency, missile.phase = 100, math.pi / Simulation.FIXED_DT, -math.pi / 2
		course.items = { missile }
		local state = Simulation.newFlight({ gadget = "Shield" }, course)
		state.y, state.vx, state.vy = 50, 18, 0
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.hits == 1 and state.shield == 0, "Relative sweep missed moving missile")
	end)

	test("ground touchdown ends run at first impact and locks distance", function()
		local course = emptyCourse()
		local state = Simulation.newFlight(nil, course)
		state.y, state.vy, state.vx = 0.01, -20, 60
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(not state.alive and state.y == 0 and state.finishReason == "landed", "Ground touchdown failed to end run")
		check(state.lastEvent.text == "TOUCHDOWN! Distance locked!", "Touchdown feedback is missing")
		check(state.distance &gt; 0 and state.distance &lt; 0.1, "Distance continued past first ground contact")
		local finalDistance, elapsed = state.distance, state.elapsed
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.distance == finalDistance and state.elapsed == elapsed, "Finished flight advanced")
	end)

	test("hard timeout prevents endless rounds", function()
		local course = emptyCourse()
		local state = Simulation.newFlight(nil, course)
		state.elapsed, state.y, state.vy = Simulation.MAX_FLIGHT_TIME - 0.005, 150, 20
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(not state.alive and state.finishReason == "timeout" and close(state.elapsed, Simulation.MAX_FLIGHT_TIME), "Timeout failed")
	end)

	test("invalid inputs are bounded and finite", function()
		local course = Simulation.makeCourse(0 / 0, "unknown")
		check(course.name == "Coast" and course.seed == 1, "Course defaults failed")
		local state = Simulation.newFlight({ planeId = "unknown", angle = math.huge, speed = 0 / 0, gadget = "PaidPower" }, course)
		check(state.settings.planeId == "cruiser" and state.settings.angle == 35 and state.settings.speed == 72.25 and state.gadget == "Shield", "Settings defaults failed")
		local capped = Simulation.newFlight({ planeId = "dart", angle = 9999, speed = -9999, power = 100 }, course)
		check(capped.settings.angle == 60 and capped.settings.speed == 81 and capped.settings.power == nil, "Angle clamp or fixed plane speed failed")
		Simulation.step(state, course, 0 / 0)
		Simulation.step(state, course, -1)
		check(state.elapsed == 0, "Invalid timestep advanced flight")
	end)

	test("all plane angle and gadget choices finish safely", function()
		for _, variant in ipairs({ "Coast", "Skyline", "Storm" }) do
			for _, angle in ipairs({ 15, 35, 60 }) do
				for _, planeId in ipairs({ "cruiser", "skyhopper", "dart" }) do
					for _, gadget in ipairs({ "Shield", "Magnet", "Boost" }) do
						local state = run({ planeId = planeId, angle = angle, gadget = gadget }, Simulation.makeCourse(12345, variant))
						check(state.distance &gt; 0 and state.distance &lt; 5000 and state.elapsed &lt;= Simulation.MAX_FLIGHT_TIME, "Invalid extreme result")
						check(state.x == state.x and state.y == state.y, "NaN in flight")
					end
				end
			end
		end
	end)

	test("launch settings change outcome", function()
		local course = Simulation.makeCourse(98123, "Coast")
		local low = run({ planeId = "cruiser", angle = 15, gadget = "Shield" }, course)
		local high = run({ planeId = "cruiser", angle = 60, gadget = "Shield" }, course)
		check(math.abs(low.distance - high.distance) &gt; 10, "Launch settings had no meaningful effect")
	end)

	test("plane profiles fix speed while launch direction follows the chosen angle", function()
		local course = emptyCourse()
		for _, profile in ipairs({ { "cruiser", 35, 72.25 }, { "skyhopper", 48, 64.5 }, { "dart", 24, 81 } }) do
			local defaults = Simulation.newFlight({ planeId = profile[1] }, course)
			check(defaults.settings.angle == profile[2], "Plane default angle was lost")
			for _, angle in ipairs({ 15, 27.4, 60 }) do
				local state = Simulation.newFlight({ planeId = profile[1], angle = angle, speed = 999, power = 999 }, course)
				local radians = math.rad(math.floor(angle + 0.5))
				check(close(state.vx, math.cos(radians) * profile[3]) and close(state.vy, math.sin(radians) * profile[3]), "Aim and velocity direction disagree")
				check(close(math.sqrt(state.vx * state.vx + state.vy * state.vy), profile[3]), "A client field overrode plane speed")
			end
		end
		local default = Simulation.newFlight(nil, course)
		local explicit = Simulation.newFlight({ planeId = "cruiser", angle = 35, gadget = "Shield" }, course)
		check(default.vx == explicit.vx and default.vy == explicit.vy and default.settings.speed == 72.25, "Default plane differs from explicit Cruiser")
	end)

	test("all planes repeat exactly on shared seeded conditions", function()
		for _, planeId in ipairs({ "cruiser", "skyhopper", "dart" }) do
			local settings = { planeId = planeId, angle = 29, gadget = "Magnet" }
			local a = run(settings, Simulation.makeCourse(98123, "Storm"))
			local b = run(settings, Simulation.makeCourse(98123, "Storm"))
			check(a.distance == b.distance and a.elapsed == b.elapsed and a.eventSerial == b.eventSerial, "Plane flight is nondeterministic")
		end
	end)

	test("aim preview uses real physics without mutating settings or live flight", function()
		local settings = { planeId = "dart", angle = 27, gadget = "Boost" }
		local course = emptyCourse()
		local live = Simulation.newFlight(settings, course)
		local points = Simulation.previewTrajectory(settings, 2)
		check(#points == 21 and points[1].x == 0 and points[1].y == 18, "Preview origin or sampling changed")
		check(live.elapsed == 0 and not live.boostUsed and settings.angle == 27, "Preview changed active state")
		for _ = 1, 120 do Simulation.step(live, course, Simulation.FIXED_DT) end
		check(close(points[#points].x, live.x) and close(points[#points].y, live.y), "Preview diverges from empty-course physics")
		check(#Simulation.previewTrajectory(settings, math.huge) == 26 and #Simulation.previewTrajectory(settings, 99) == 41, "Preview duration is not bounded")
	end)

	test("dense course mixes values and leaves room between encounter objects", function()
		for _, variant in ipairs({ "Coast", "Skyline", "Storm" }) do
			local course = Simulation.makeCourse(812345, variant)
			check(#course.items &gt;= 240, "Course has too few objects for dense upcoming encounters")
			local earlyFuel, earlyMissiles, lateFuel, lateMissiles = 0, 0, 0, 0
			local lowRescues, highSmallFuel = 0, 0
			for _, entry in ipairs(course.items) do
				check(entry.y &gt;= 20 and entry.y &lt;= 172, "Object is outside the readable flight bands")
				if entry.kind == "missile" then
					check(entry.amplitude &lt;= 10, "Missile moves too far from its visible corridor")
				else
					if entry.value == 20 and entry.y &lt;= 40 then lowRescues = lowRescues + 1 end
					if entry.value == 5 and entry.y &gt; 120 then highSmallFuel = highSmallFuel + 1 end
				end
				if entry.x &lt; 900 then
					if entry.kind == "fuel" then earlyFuel = earlyFuel + 1 else earlyMissiles = earlyMissiles + 1 end
				elseif entry.x &gt; 1500 then
					if entry.kind == "fuel" then lateFuel = lateFuel + 1 else lateMissiles = lateMissiles + 1 end
				end
			end
			check(lowRescues &gt; 0 and highSmallFuel &gt; 0, "Fuel strength is still tied only to altitude")
			check(earlyMissiles &gt; 0 and lateMissiles / lateFuel &gt; earlyMissiles / earlyFuel, "Later course should visibly add pressure")
			for i, a in ipairs(course.items) do
				for j = i + 1, #course.items do
					local b = course.items[j]
					if math.abs(a.x - b.x) &lt; 40 then
						local dx, dy = a.x - b.x, a.y - b.y
						check(dx * dx + dy * dy &gt; (a.radius + b.radius) ^ 2, "Encounter contains overlapping pickup or hazard bodies")
					end
				end
			end
		end
	end)

	test("near miss waits for full clearance and has no mechanical reward", function()
		local course = emptyCourse()
		course.items = { item("missile", 30, 66, 1) }
		local state, baseline = Simulation.newFlight(nil, course), Simulation.newFlight(nil, course)
		state.y, state.vx, state.vy = 50, 60, 0
		baseline.y, baseline.vx, baseline.vy = 50, 60, 0
		for _ = 1, 40 do
			Simulation.step(state, course, Simulation.FIXED_DT)
			Simulation.step(baseline, emptyCourse(), Simulation.FIXED_DT)
		end
		check(state.nearMisses == 0, "Near miss announced before clearing the missile")
		for _ = 1, 40 do
			Simulation.step(state, course, Simulation.FIXED_DT)
			Simulation.step(baseline, emptyCourse(), Simulation.FIXED_DT)
		end
		check(state.nearMisses == 1 and state.hits == 0 and not state.used[1], "Close pass did not resolve exactly once")
		check(state.x == baseline.x and state.y == baseline.y and state.vx == baseline.vx and state.vy == baseline.vy, "Near miss changed flight performance")
		check(state.lastEvent.kind == "nearMiss" and state.lastEvent.itemId == 1, "Near-miss feedback missing")
	end)

	test("a missile cannot award both contact and near miss", function()
		local course = emptyCourse()
		course.items = { item("missile", 30, 50, 1) }
		local state = Simulation.newFlight(nil, course)
		state.y, state.vx, state.vy = 50, 60, 0
		for _ = 1, 90 do Simulation.step(state, course, Simulation.FIXED_DT) end
		check(state.hits == 1 and state.used[1] and state.nearMisses == 0, "Hit missile also counted as a near miss")
	end)

	test("ground contact prevents a terminal-step near miss", function()
		local course = emptyCourse()
		course.items = { item("missile", -19.5, 10, 1) }
		local state = Simulation.newFlight(nil, course)
		state.y, state.vy, state.vx = 0.01, -20, 60
		state.nearCandidates[1] = 1
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.finishReason == "landed" and state.distance &lt; 0.1 and state.nearMisses == 0, "Near miss awarded after first ground contact")
	end)

	test("feedback history preserves rapid events with bounded ordered serials", function()
		local course = emptyCourse()
		course.items = { item("fuel", 0, 18, 1, 5), item("fuel", 0, 18, 2, 20) }
		local state = Simulation.newFlight(nil, course)
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.recentEvents[2].itemId == 1 and state.recentEvents[3].itemId == 2, "Rapid events were overwritten")
		check(state.recentEvents[2].value == 5 and state.recentEvents[3].value == 20, "Fuel feedback lost its number")
		for id = 3, 30 do
			course.items = { item("fuel", state.x, state.y, id, 5) }
			Simulation.step(state, course, Simulation.FIXED_DT)
		end
		check(#state.recentEvents &lt;= Simulation.EVENT_HISTORY_LIMIT, "Feedback history grows without limit")
		for index, entry in ipairs(state.recentEvents) do
			check(type(entry.x) == "number" and type(entry.y) == "number" and type(entry.value) == "number", "Feedback lost spatial/value metadata")
			if index &gt; 1 then check(entry.serial == state.recentEvents[index - 1].serial + 1 and entry.at &gt;= state.recentEvents[index - 1].at, "Feedback serial/time order changed") end
		end
		check(state.lastEvent.serial == state.eventSerial and state.lastEvent.serial == state.recentEvents[#state.recentEvents].serial, "Latest event serial is inconsistent")
	end)

	test("late fuel visibly rescues a dive before touchdown", function()
		local course = emptyCourse()
		local state = Simulation.newFlight({ gadget = "Shield" }, course)
		state.y, state.vy, state.vx = 12, -22, 60
		course.items = { item("fuel", 0, 12, 1, 20) }
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.alive and state.vy &gt; 0 and state.pickups == 1, "Large fuel pickup did not turn a near-ground dive upward")
		local rescuedHeight = state.y
		for _ = 1, 20 do Simulation.step(state, course, Simulation.FIXED_DT) end
		check(state.alive and state.y &gt; rescuedHeight, "Recovered flight did not visibly climb")
	end)

	test("a valid round power suppresses every legacy gadget effect", function()
		for _, powerId in ipairs({ "Pinball", "Muncher", "Meteor" }) do
			local course = emptyCourse()
			local shield = Simulation.newFlight({ powerId = powerId, gadget = "Shield" }, course)
			check(shield.shield == 0 and shield.powerId == powerId and shield.settings.powerId == powerId, "Round power kept a shield or lost identity")
			local magnet = Simulation.newFlight({ powerId = powerId, gadget = "Magnet" }, course)
			course.items = { item("fuel", 0, 35, 1) }
			Simulation.step(magnet, course, Simulation.FIXED_DT)
			check(magnet.pickups == 0, "Round power kept magnet reach")
			local boost = Simulation.newFlight({ powerId = powerId, gadget = "Boost" }, course)
			boost.elapsed, boost.y, boost.vy = 2, 10, -10
			Simulation.step(boost, emptyCourse(), Simulation.FIXED_DT)
			check(not boost.boostUsed, "Round power kept the rescue gadget")
			for _, entry in ipairs(boost.recentEvents) do check(entry.kind ~= "boost", "Legacy rescue feedback leaked into round powers") end
		end
	end)

	test("missing or invalid powers retain the legacy simulation path", function()
		for _, invalid in ipairs({ "Unknown", "pinball", 123, {} }) do
			local state = Simulation.newFlight({ powerId = invalid, gadget = "Shield", powerCharges = 999 }, emptyCourse())
			check(state.powerId == nil and state.powerCharges == 0 and state.powerUses == 0 and state.shield == 1, "Invalid power affected the simulation")
		end
		local state = Simulation.newFlight({ powerId = "Meteor", powerCharges = 999, powerPeak = 99999 }, emptyCourse())
		check(state.powerCharges == 1 and state.powerPeak == 18 and state.powerPhase == "armed", "Client fields supplied power strength")
	end)

	test("Pinball bounces at three descending contacts and lands on the fourth", function()
		local course = emptyCourse()
		local state = Simulation.newFlight({ powerId = "Pinball" }, course)
		for bounce = 1, 3 do
			local oldX = state.x
			state.y, state.vy, state.vx = 0.01, -20, 60
			Simulation.step(state, course, Simulation.FIXED_DT)
			check(state.alive and state.y == 0 and state.vy &gt; 0 and state.vx &gt; 75, "Pinball did not turn impact into forward/upward motion")
			check(state.x &gt; oldX and state.x &lt; oldX + 0.1, "Bounce advanced past the first ground contact")
			check(state.powerCharges == 3 - bounce and state.powerUses == bounce, "Bounce charge count differs")
			check(state.lastEvent.kind == "pinball" and state.lastEvent.value == bounce and state.lastEvent.y == 0, "Bounce feedback lacks impact position/count")
			Simulation.step(state, course, Simulation.FIXED_DT)
			check(state.y &gt; 0 and state.powerUses == bounce, "Takeoff from a bounce consumed another charge")
		end
		check(state.powerPhase == "spent", "Exhausted Pinball stayed armed")
		state.y, state.vy = 0.01, -20
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(not state.alive and state.finishReason == "landed" and state.powerUses == 3, "Fourth ground contact did not end the flight")
		local distance, serial = state.distance, state.eventSerial
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.distance == distance and state.eventSerial == serial, "Finished Pinball resumed")
	end)

	test("Pinball cannot resurrect a plane already below ground or survive its deadline", function()
		local course = emptyCourse()
		local below = Simulation.newFlight({ powerId = "Pinball" }, course)
		below.y, below.vy = -1, -10
		Simulation.step(below, course, Simulation.FIXED_DT)
		check(not below.alive and below.powerUses == 0, "Pinball resurrected a plane below ground")
		local late = Simulation.newFlight({ powerId = "Pinball" }, course)
		late.elapsed, late.y, late.vy = Simulation.MAX_FLIGHT_TIME - 0.001, 0.001, -20
		Simulation.step(late, course, Simulation.FIXED_DT)
		check(not late.alive and late.powerUses == 0 and close(late.elapsed, Simulation.MAX_FLIGHT_TIME), "Pinball bounced after the flight deadline")
	end)

	test("Muncher eats exactly three missiles with escalating kicks then takes a hit", function()
		local course = emptyCourse()
		local state = Simulation.newFlight({ powerId = "Muncher", gadget = "Shield" }, course)
		local previousKick, previousLift = 0, -12
		for bite = 1, 3 do
			state.y, state.vy, state.vx = 70, -12, 40
			course.items = { item("missile", state.x, state.y, bite) }
			Simulation.step(state, course, Simulation.FIXED_DT)
			local kick = state.vx - 40
			check(kick &gt; previousKick and state.vy &gt; previousLift and state.hits == 0, "Bite did not give a growing harmless boost")
			check(state.used[bite] and state.powerUses == bite and state.powerCharges == 3 - bite, "Missile bite count changed")
			check(state.lastEvent.kind == "munch" and state.lastEvent.itemId == bite and state.lastEvent.value == bite, "Bite feedback lost its missile/count")
			Simulation.step(state, course, Simulation.FIXED_DT)
			check(state.powerUses == bite, "A consumed missile was eaten again")
			previousKick, previousLift = kick, state.vy
		end
		check(state.powerPhase == "spent", "Exhausted Muncher stayed armed")
		state.y, state.vy, state.vx = 70, 0, 80
		course.items = { item("missile", state.x, state.y, 4) }
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.hits == 1 and state.vx &lt; 75 and state.vy &lt; -9 and state.powerUses == 3 and state.lastEvent.kind == "missile", "Fourth missile was absorbed or still granted a boost")
	end)

	test("Muncher resolves multiple swept contacts in order without sharing charges", function()
		local course = emptyCourse()
		for id = 1, 4 do table.insert(course.items, item("missile", 0, 18, id)) end
		local first = Simulation.newFlight({ powerId = "Muncher" }, course)
		local other = Simulation.newFlight({ powerId = "Muncher" }, course)
		Simulation.step(first, course, Simulation.FIXED_DT)
		check(first.powerUses == 3 and first.hits == 1 and first.powerCharges == 0, "Simultaneous missiles bypassed exhaustion")
		for index = 2, 4 do
			check(first.recentEvents[index].kind == "munch" and first.recentEvents[index].itemId == index - 1, "Eating order was nondeterministic")
		end
		check(other.powerCharges == 3 and other.powerUses == 0 and next(other.used) == nil, "One pilot consumed another pilot's charges or missiles")
		Simulation.step(other, course, Simulation.FIXED_DT)
		check(first.x == other.x and first.vx == other.vx and first.vy == other.vy and first.eventSerial == other.eventSerial, "Identical pilots diverged on the same course")
	end)

	test("Meteor automatically dives at its first apex and safely pulls up once", function()
		local course = emptyCourse()
		local state = Simulation.newFlight({ powerId = "Meteor" }, course)
		state.y, state.vy = 100, 0.01
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.powerPhase == "diving" and state.vy &lt; -40 and state.powerPeak &gt;= 100 and state.lastEvent.kind == "meteorDive", "Meteor did not turn its apex into a dive")
		check(state.powerCharges == 1 and state.powerUses == 0, "Meteor consumed its burst before the pull-up")
		local diveSerial, previousSpeed = state.eventSerial, state.vx
		for _ = 1, 180 do
			previousSpeed = state.vx
			Simulation.step(state, course, Simulation.FIXED_DT)
			check(state.alive and state.y &gt; 0, "Meteor hit the ground before pulling up")
			if state.powerPhase == "spent" then break end
		end
		check(state.powerPhase == "spent" and state.powerUses == 1 and state.powerCharges == 0, "Meteor did not spend exactly one burst")
		check(state.vx &gt; previousSpeed + 50 and state.vy &gt; 22 and state.vy &lt;= 32 and state.lastEvent.kind == "meteorBoost" and state.eventSerial == diveSerial + 1, "Meteor pull-up lacks its forward blast or compact recovery")
		state.y, state.vy = 10, -15
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.powerUses == 1 and state.vy &lt; 0 and state.eventSerial == diveSerial + 1, "Spent Meteor reactivated")
	end)

	test("Meteor height determines a bounded blast and low-altitude crossing cannot tunnel", function()
		local function blast(peak)
			local state = Simulation.newFlight({ powerId = "Meteor" }, emptyCourse())
			state.powerPhase, state.powerPeak = "diving", peak
			state.y, state.vy, state.vx = 18.01, -64, 60
			Simulation.step(state, emptyCourse(), 1 / 15)
			check(state.alive and state.y &gt; 18 and state.vy &gt; 0 and state.powerPhase == "spent", "Coarse-step Meteor tunneled below the pull-up")
			return state
		end
		local low, high, extreme = blast(40), blast(160), blast(10000)
		check(high.vx &gt; low.vx + 25 and high.vy &gt; low.vy, "Achieved height did not strengthen Meteor")
		check(extreme.vx &lt;= 165 and extreme.vy &lt;= 32, "Meteor strength is unbounded")
	end)

	test("fuel cannot cancel Meteor's committed dive or erase its high-speed burst", function()
		local course = emptyCourse()
		local state = Simulation.newFlight({ powerId = "Meteor" }, course)
		state.powerPhase, state.powerPeak = "diving", 160
		state.y, state.vy, state.vx = 80, -50, 100
		course.items = { item("fuel", state.x, state.y, 1, 20) }
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.pickups == 1 and state.vy &lt; -40 and state.powerPhase == "diving", "Fuel reversed the committed Meteor dive")
		state.y, state.vy = 18.01, -64
		Simulation.step(state, emptyCourse(), Simulation.FIXED_DT)
		local burstSpeed = state.vx
		check(burstSpeed &gt; 130, "Meteor burst was not larger than the legacy fuel cap")
		course.items = { item("fuel", state.x, state.y, 2, 5) }
		Simulation.step(state, course, Simulation.FIXED_DT)
		check(state.pickups == 2 and state.vx &gt;= burstSpeed and state.vx &lt;= 165, "Ordinary fuel erased Meteor's forward kick")
	end)

	test("all powers preserve hard timeouts and finish within bounded generated flights", function()
		for _, powerId in ipairs({ "Pinball", "Muncher", "Meteor" }) do
			local late = Simulation.newFlight({ powerId = powerId }, emptyCourse())
			late.elapsed, late.y, late.vy = Simulation.MAX_FLIGHT_TIME - 0.001, 120, 0
			Simulation.step(late, emptyCourse(), Simulation.FIXED_DT)
			check(not late.alive and late.finishReason == "timeout" and late.powerUses == 0, "Power bypassed the hard timeout")
			for _, variant in ipairs({ "Coast", "Skyline", "Storm" }) do
				for _, angle in ipairs({ 15, 35, 60 }) do
					local settings = { powerId = powerId, planeId = "cruiser", angle = angle }
					local a = run(settings, Simulation.makeCourse(74123, variant))
					local b = run(settings, Simulation.makeCourse(74123, variant))
					check(not a.alive and a.elapsed &lt;= Simulation.MAX_FLIGHT_TIME and a.distance &gt; 0 and a.distance &lt; 7500, "Powered flight escaped round bounds")
					check(a.distance == b.distance and a.powerUses == b.powerUses and a.eventSerial == b.eventSerial, "Powered seeded flight was nondeterministic")
					check(a.vx &lt;= 165 and a.vy == a.vy and a.powerCharges &gt;= 0, "Power velocity or charges were unbounded")
				end
			end
		end
	end)

	test("power bursts fade without surrendering earned distance or fuel momentum", function()
		local course = emptyCourse()
		local boosted = Simulation.newFlight({ powerId = "Muncher" }, course)
		local baseline = Simulation.newFlight({ powerId = "Muncher" }, course)
		boosted.y, boosted.vy = 120, 0
		baseline.y, baseline.vy = 120, 0
		course.items = { item("missile", 0, 120, 1) }
		Simulation.step(boosted, course, Simulation.FIXED_DT)
		Simulation.step(baseline, emptyCourse(), Simulation.FIXED_DT)
		baseline.vy = boosted.vy
		local kick = boosted.vx - baseline.vx
		check(kick &gt; 10, "Power burst lost its immediate kick")
		-- Both pilots collect identical fuel after the kick. Fading the burst
		-- must not subtract that ordinary earned momentum from either flight.
		for _, state in ipairs({ boosted, baseline }) do
			local fuel = emptyCourse()
			fuel.items = { item("fuel", state.x, state.y, 2, 10) }
			Simulation.step(state, fuel, Simulation.FIXED_DT)
		end
		local previousGap = boosted.x - baseline.x
		for _ = 1, 300 do
			Simulation.step(boosted, emptyCourse(), Simulation.FIXED_DT)
			Simulation.step(baseline, emptyCourse(), Simulation.FIXED_DT)
			local gap = boosted.x - baseline.x
			check(boosted.alive and baseline.alive and gap &gt;= previousGap, "Burst decay erased earned distance")
			previousGap = gap
		end
		check(boosted.vx &gt; baseline.vx and boosted.vx - baseline.vx &lt; kick * 0.05, "Burst left a permanent speed advantage")
		check(previousGap &gt; 10 and previousGap &lt; 25, "Brief burst did not earn bounded forward distance")
	end)

	test("fuel at the burst speed cap still earns lasting momentum", function()
		local boosted = Simulation.newFlight({ powerId = "Muncher" }, emptyCourse())
		local baseline = Simulation.newFlight({ powerId = "Muncher" }, emptyCourse())
		boosted.y, boosted.vy, boosted.vx = 120, 0, 100
		baseline.y, baseline.vy, baseline.vx = 120, 0, 100
		local missiles = emptyCourse()
		for id = 1, 3 do table.insert(missiles.items, item("missile", 0, 120, id)) end
		Simulation.step(boosted, missiles, Simulation.FIXED_DT)
		Simulation.step(baseline, emptyCourse(), Simulation.FIXED_DT)
		baseline.vy = boosted.vy
		check(boosted.vx == 125, "Regression setup did not fill the Muncher speed cap")
		for _, state in ipairs({ boosted, baseline }) do
			local fuel = emptyCourse()
			for id = 4, 6 do table.insert(fuel.items, item("fuel", state.x, state.y, id, 20)) end
			Simulation.step(state, fuel, Simulation.FIXED_DT)
		end
		for _ = 1, 300 do
			Simulation.step(boosted, emptyCourse(), Simulation.FIXED_DT)
			Simulation.step(baseline, emptyCourse(), Simulation.FIXED_DT)
			check(boosted.vx &gt;= baseline.vx - 0.0000001 and boosted.distance &gt;= baseline.distance, "Burst cap forfeited fuel momentum after the power faded")
			check(boosted.vx &lt;= 125 and boosted.burstVx &gt;= 0, "Fuel replacement escaped the speed cap")
		end
	end)

	test("headwind follows a shared clock and preserves unspent power charges", function()
		local function fall(elapsed, x, charges)
			local state = Simulation.newFlight({ powerId = "Pinball" }, emptyCourse())
			state.elapsed, state.x, state.y, state.vy, state.powerCharges = elapsed, x, 100, 0, charges
			Simulation.step(state, emptyCourse(), Simulation.FIXED_DT)
			check(state.powerCharges == charges, "Headwind silently consumed a power charge")
			return state.vy
		end
		local early = fall(5, 0, 3)
		local before = fall(Simulation.PRESSURE_START - 1, 900, 3)
		local middle = fall(Simulation.PRESSURE_START + Simulation.PRESSURE_RAMP / 2, 200, 1)
		local leader = fall(Simulation.PRESSURE_START + Simulation.PRESSURE_RAMP / 2, 2200, 3)
		local late = fall(Simulation.PRESSURE_START + Simulation.PRESSURE_RAMP + 1, 0, 0)
		check(close(early, before), "Headwind altered the opening launch")
		check(middle &lt; early and late &lt; middle, "Late pressure did not build gradually")
		check(close(middle, leader), "Headwind depends on race position or remaining power")
	end)

	test("headwind weakens late fuel lift while retaining its forward reward", function()
		local function refuel(elapsed)
			local course = emptyCourse()
			local state = Simulation.newFlight({ powerId = "Muncher" }, course)
			state.elapsed, state.y, state.vy, state.vx = elapsed, 12, -22, 60
			course.items = { item("fuel", 0, 12, 1, 20) }
			Simulation.step(state, course, Simulation.FIXED_DT)
			return state
		end
		local early, late = refuel(5), refuel(Simulation.PRESSURE_START + Simulation.PRESSURE_RAMP)
		check(early.vy &gt; late.vy and late.vy &gt; 0, "Late fuel should give a small save rather than another long climb")
		check(close(early.vx, late.vx) and late.pickups == 1, "Headwind removed the earned forward fuel reward")
	end)

	test("Pinball recoveries shrink and resolve promptly without course contacts", function()
		local state = Simulation.newFlight({ powerId = "Pinball" }, emptyCourse())
		state.y, state.vy = 0.01, -20
		local lastUses, lastLift, firstBounce = 0, math.huge, nil
		for _ = 1, 1500 do
			Simulation.step(state, emptyCourse(), Simulation.FIXED_DT)
			if state.powerUses &gt; lastUses then
				check(state.vy &gt; 0 and state.vy &lt; lastLift, "Successive bounces did not get lower")
				firstBounce = firstBounce or state.elapsed
				lastLift, lastUses = state.vy, state.powerUses
			end
			if not state.alive then break end
		end
		check(not state.alive and state.powerUses == 3 and state.finishReason == "landed", "Compact skips failed to finish after three charges")
		check(state.elapsed - firstBounce &lt; 17, "Three empty-course skips still create a long second flight")
	end)

	return tostring(passed) .. " simulation tests passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX23">
      <Properties>
        <string name="Name">BattleSimulationTests</string>
        <ProtectedString name="Source">-- Pure tests: require(thisModule)(BattleSimulation, SkillCatalog, BattleSkills)
-- in Studio or a Lua runtime. The last two are optional.
return function(Simulation, Catalog, Skills)
	local passed = 0
	local function check(value, message) assert(value, message) end
	local function close(a, b) return math.abs(a - b) &lt; 0.0000001 end
	local function test(name, callback)
		local ok, problem = pcall(callback)
		assert(ok, name .. ": " .. tostring(problem))
		passed = passed + 1
	end
	local function equal(a, b)
		if type(a) ~= type(b) then return false end
		if type(a) ~= "table" then return a == b end
		for key, value in pairs(a) do if not equal(value, b[key]) then return false end end
		for key in pairs(b) do if a[key] == nil then return false end end
		return true
	end
	local function run(seed, a, b)
		local state = Simulation.newRound(seed, a, b)
		for _ = 1, math.ceil(Simulation.MAX_TIME / Simulation.FIXED_DT) + 2 do
			Simulation.step(state, Simulation.FIXED_DT)
			if state.finished then return state end
		end
		error("Round exceeded hard limit")
	end
	local function passive(fighter, x, y, heading)
		fighter.x, fighter.y, fighter.heading = x, y, heading or 0
		fighter.vx, fighter.vy = math.cos(fighter.heading) * 30, math.sin(fighter.heading) * 30
		fighter.phase, fighter.phaseLeft, fighter.armed = "Recover", 100, false
		fighter._recoverX = x + math.cos(fighter.heading) * 30
		fighter._recoverY = y + math.sin(fighter.heading) * 30
		fighter._knockX, fighter._knockY = 0, 0
	end
	local function projectile(id, owner, x, y, vx, vy)
		return { id = id, owner = owner, x = x, y = y, vx = vx, vy = vy, life = 2, radius = 3.5 }
	end
	local function armed(fighter, x, heading)
		passive(fighter, x, 50, heading)
		fighter.offenceId = "Meteor"
		fighter.phase, fighter.phaseLeft, fighter.armed = "Attack", 1, true
		fighter._attackHeading, fighter._attackHit = heading, false
	end
	local function wake(id, owner, x, y, armLeft)
		return { id = id, owner = owner, skillId = "FizzyFuel", x = x, y = y, radius = Simulation.WAKE_RADIUS,
			life = Simulation.WAKE_LIFE, maxLife = Simulation.WAKE_LIFE, armLeft = armLeft or 0 }
	end

	test("same seed settings and frame times reproduce entire round", function()
		local a = run(8137, { offenceId = "Meteor", angle = 10 }, { offenceId = "Firework", angle = 55 })
		local b = run(8137, { offenceId = "Meteor", angle = 10 }, { offenceId = "Firework", angle = 55 })
		check(equal(a, b), "Deterministic replay differed")
		check(a.finished and a.eventSerial &gt; 2, "No combat occurred")
	end)

	test("fixed ticks are independent of frame grouping", function()
		local a, b = Simulation.newRound(37), Simulation.newRound(37)
		for _ = 1, 60 do Simulation.step(a, 1 / 60) end
		for _ = 1, 10 do Simulation.step(b, 0.1) end
		check(close(a.elapsed, 1) and close(b.elapsed, 1), "Wrong accumulated time")
		check(equal(a.fighters, b.fighters) and equal(a.events, b.events), "Frame partition changed combat")
	end)

	test("invalid dt is ignored and stalled frames are bounded", function()
		local state = Simulation.newRound(1)
		for _, dt in ipairs({ 0, -1, math.huge, -math.huge, 0 / 0, "1" }) do Simulation.step(state, dt) end
		Simulation.step(state, nil)
		check(state.elapsed == 0, "Invalid time advanced the round")
		Simulation.step(state, 10000)
		check(close(state.elapsed, Simulation.MAX_STEP_DT), "Stalled frame ran unbounded work")
		local partial = Simulation.newRound(1)
		Simulation.step(partial, Simulation.FIXED_DT / 2)
		check(partial.elapsed == 0, "Partial tick advanced")
		Simulation.step(partial, Simulation.FIXED_DT / 2)
		check(close(partial.elapsed, Simulation.FIXED_DT), "Partial ticks were discarded")
	end)

	test("settings are validated copied and bounded", function()
		local input = { offenceId = "Meteor", angle = 999 }
		local state = Simulation.newRound(0 / 0, input, { offenceId = "unknown", angle = math.huge })
		input.angle = 10
		check(state.seed == 1 and state.fighters[1].settings.angle == 55, "Seed or settings ownership failed")
		check(state.fighters[2].offenceId == "Firework" and state.fighters[2].settings.angle == 32, "Fallback failed")
		local other = Simulation.newRound({}, { angle = -99 }, false)
		check(other.fighters[1].settings.angle == 10 and other.fighters[2].armor == 3, "Malformed settings failed")
		check(Simulation.validOffence("Meteor") and Simulation.validOffence("Firework") and not Simulation.validOffence("Paid"), "Offence validation failed")
		check(not Simulation.validOffence("Afterburner") and not Simulation.validWild("Meteor") and not Simulation.validWild({}), "Skill kinds were mixed up")
	end)

	test("passive body contact only bumps", function()
		local state = Simulation.newRound(1)
		passive(state.fighters[1], -3, 50, math.pi)
		passive(state.fighters[2], 3, 50, 0)
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[1].armor == 3 and state.fighters[2].armor == 3, "Passive collision dealt damage")
		check(state.events[#state.events].kind == "bump", "Body contact lacked feedback")
		check(state.fighters[1]._knockX &lt; 0 and state.fighters[2]._knockX &gt; 0, "Bump did not separate fighters")
	end)

	test("armed frontal strike deals one pip and rear contact does not", function()
		local hit = Simulation.newRound(1)
		armed(hit.fighters[1], -8, 0)
		passive(hit.fighters[2], 0, 50, 0)
		Simulation.step(hit, Simulation.FIXED_DT)
		check(hit.fighters[2].armor == 2 and hit.fighters[1].hits == 1, "Frontal strike failed")
		check(hit.fighters[2].invulnerable &gt; 0 and hit.fighters[1].phase == "Recover", "Hit lacked protection/recovery")
		local back = Simulation.newRound(1)
		armed(back.fighters[1], 5, 0)
		passive(back.fighters[2], 0, 50, 0)
		Simulation.step(back, Simulation.FIXED_DT)
		check(back.fighters[2].armor == 3, "Rear body contact counted as an armed nose")
	end)

	test("projectile sweep catches a target between endpoints", function()
		local state = Simulation.newRound(1)
		passive(state.fighters[1], -55, 50, 0)
		passive(state.fighters[2], 0, 50, 0)
		state.projectiles = { projectile(1, 1, -25, 50, 6000, 0) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].armor == 2 and #state.projectiles == 0, "Swept rocket missed or survived impact")
		check(state.fighters[1].armor == 3 and state.fighters[1].hits == 1, "Wrong rocket attribution")
	end)

	test("projectile ownership excludes its own plane", function()
		local state = Simulation.newRound(1)
		passive(state.fighters[1], 0, 50, 0)
		passive(state.fighters[2], 50, 80, 0)
		state.projectiles = { projectile(1, 1, -20, 50, 1800, 0) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[1].armor == 3 and state.fighters[2].armor == 3, "Projectile hit its owner")
		check(#state.projectiles == 1, "Projectile consumed itself against owner")
	end)

	test("impact protection blocks stacked hits and consumes rockets", function()
		local state = Simulation.newRound(1)
		passive(state.fighters[1], -55, 50, 0)
		passive(state.fighters[2], 0, 50, 0)
		state.projectiles = { projectile(1, 1, -25, 50, 6000, 0), projectile(2, 1, -25, 50, 6000, 0) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].armor == 2 and state.fighters[1].hits == 1, "Stacked damage bypassed protection")
		check(#state.projectiles == 0, "Blocked rocket remained inside target")
		for _ = 1, 10 do Simulation.step(state, Simulation.FIXED_DT) end
		check(state.fighters[2].armor == 2, "Protection allowed delayed impact damage")
	end)

	test("committed attacks and rockets cannot home", function()
		local state = Simulation.newRound(1)
		armed(state.fighters[1], -40, 0.3)
		passive(state.fighters[2], 40, 80, 0)
		state.projectiles = { projectile(1, 1, -50, 15, 30, 0) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[1].heading == 0.3, "Committed dive turned toward opponent")
		check(state.projectiles[1].vx == 30 and state.projectiles[1].vy == 0, "Rocket homed after launch")
	end)

	test("dive commitment survives a hit and recovery within one broadcast interval", function()
		local state = Simulation.newRound(1, { offenceId = "Meteor", wildIds = {} })
		passive(state.fighters[1], -8, 50, 0)
		passive(state.fighters[2], 0, 50, 0)
		state.fighters[1].phase, state.fighters[1].phaseLeft = "Windup", 0
		Simulation.step(state, 1 / 20)
		check(state.fighters[1].phase == "Recover" and state.fighters[2].armor == 2, "Fixture did not commit and hit before next snapshot")
		local count, commitment, impact = 0, nil, nil
		for _, entry in ipairs(state.events) do
			if entry.kind == "dive" then count, commitment = count + 1, entry end
			if entry.kind == "hit" then impact = entry end
		end
		check(count == 1 and commitment and impact and commitment.serial &lt; impact.serial, "Commit event missing, duplicated, or out of order")
		check(commitment.actor == 1 and commitment.target == 2 and commitment.source == "meteor", "Wrong dive attribution")
		check(commitment.heading == 0 and commitment.x == -8 and commitment.y == 50, "Commit did not retain its actual origin and heading")
		check(commitment.at &lt;= 1 / 20 and commitment.at == impact.at, "Immediate commit timing changed")
	end)

	test("controlled Meteor charge creates continuous space before a visible landed dive", function()
		local state = Simulation.newRound(731, { offenceId = "Meteor", angle = 32 }, { offenceId = "Firework", angle = 32 })
		-- Hold the rival tell constant: this fixture measures charge geometry,
		-- not whether the current Firework tuning wins the opening exchange.
		state.fighters[2].windupDuration = 1.05
		local charge, commitment, impact, waypointX, waypointY, previousHeading
		local serial = state.eventSerial
		for _ = 1, 300 do
			local fighter = state.fighters[1]
			local oldX, oldY = fighter.x, fighter.y
			previousHeading = fighter.heading
			Simulation.step(state, Simulation.FIXED_DT)
			for _, entry in ipairs(state.events) do
				if entry.serial &gt; serial and entry.actor == 1 then
					if entry.kind == "windup" then charge = entry end
					if entry.kind == "dive" then commitment = entry end
					if entry.kind == "hit" and entry.source == "meteor" then impact = entry end
				end
			end
			serial = state.eventSerial
			check((fighter.x - oldX) ^ 2 + (fighter.y - oldY) ^ 2 &lt;= (65 * Simulation.FIXED_DT + 0.00001) ^ 2,
				"Charging or release teleported the plane")
			if fighter.phase == "Windup" then
				check(not fighter.armed and fighter.invulnerable == 0, "Charge gained damage or immunity")
				check(fighter.windupDuration == Simulation.METEOR_WINDUP, "Renderer charge duration differs")
				waypointX, waypointY = waypointX or fighter._chargeX, waypointY or fighter._chargeY
				check(fighter._chargeX == waypointX and fighter._chargeY == waypointY, "Backoff waypoint homed during charge")
				local turn = (fighter.heading - previousHeading + math.pi) % (math.pi * 2) - math.pi
				check(math.abs(turn) &lt;= 8 * Simulation.FIXED_DT + 0.00001, "Charge heading snapped")
			end
			if impact then break end
		end
		check(charge and commitment and impact, "Default charge did not finish in a real strike")
		check(close(commitment.at - charge.at, Simulation.METEOR_WINDUP), "Charge duration changed")
		check(impact.at - commitment.at &gt;= 0.25 and impact.at - commitment.at &lt;= 0.7, "Default strike has no visible flight")
		check(math.abs(commitment.x - charge.x) &gt; 20, "Charge failed to create real separation")
		check(state.fighters[2].armor == 2 and state.fighters[1].armor == 3, "Strike changed the one-pip damage rule")
		check(state.fighters[2].windupDuration == 1.05, "Firework windup changed")
	end)

	test("Meteor remains vulnerable during the backoff charge", function()
		local state = Simulation.newRound(1)
		local fighter = state.fighters[1]
		passive(fighter, 0, 50, 0)
		fighter.phase, fighter.phaseLeft = "Windup", 0.8
		fighter._chargeX, fighter._chargeY = -40, 80
		passive(state.fighters[2], -40, 50, 0)
		state.projectiles = { projectile(1, 2, -25, 50, 6000, 0) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(fighter.armor == 2 and fighter.phase == "Recover", "Charging Meteor ignored a valid rocket")
		check(not fighter.armed and fighter.attacks == 0, "Interrupted charge still released a dive")
	end)

	test("a committed Meteor can visibly miss and bank without damage", function()
		local state = Simulation.newRound(1)
		armed(state.fighters[1], -40, 0)
		passive(state.fighters[2], 30, 80, 0)
		for _ = 1, 62 do Simulation.step(state, Simulation.FIXED_DT) end
		local missed = false
		for _, entry in ipairs(state.events) do
			if entry.kind == "miss" and entry.actor == 1 then missed = true end
		end
		check(missed and state.fighters[1].phase == "Recover", "Miss lacked normal recovery")
		check(state.fighters[1].hits == 0 and state.fighters[2].armor == 3, "Miss fabricated a hit")
	end)

	test("simultaneous knockout is a draw without player-index priority", function()
		local state = Simulation.newRound(1)
		armed(state.fighters[1], -4, 0)
		armed(state.fighters[2], 4, math.pi)
		state.fighters[1].armor, state.fighters[2].armor = 1, 1
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.finished and state.winner == 0 and state.reason == "knockout", "Double knockout was biased")
		check(state.fighters[1].armor == 0 and state.fighters[2].armor == 0, "One simultaneous hit disappeared")
	end)

	test("pressure visibly shrinks bounds without dealing damage", function()
		local state = Simulation.newRound(1)
		state.elapsed = 26.5
		passive(state.fighters[1], -72, 8, math.pi)
		passive(state.fighters[2], 72, 96, 0)
		Simulation.step(state, Simulation.FIXED_DT)
		check(close(state.pressure, (state.elapsed - 18) / 17), "Pressure timing differs")
		check(close(state.bounds.left, -72 + 24 * state.pressure) and close(state.bounds.top, 96 - 14 * state.pressure), "Rendered bounds contract differs")
		for _, fighter in ipairs(state.fighters) do
			check(fighter.x &gt;= state.bounds.left and fighter.x &lt;= state.bounds.right and fighter.y &gt;= state.bounds.bottom and fighter.y &lt;= state.bounds.top, "Plane escaped pressure")
			check(fighter.armor == 3, "Invisible edge damage")
		end
	end)

	test("time cap awards higher armor and preserves equal armor draws", function()
		for _, armor in ipairs({ 2, 3 }) do
			local state = Simulation.newRound(1)
			state.elapsed = Simulation.MAX_TIME - 0.005
			state.fighters[2].armor = armor
			Simulation.step(state, Simulation.FIXED_DT)
			check(state.finished and state.elapsed == Simulation.MAX_TIME and state.reason == "timeout", "Hard limit failed")
			check(state.winner == (armor == 3 and 0 or 1), "Armor tiebreak failed")
			local elapsed, serial, x = state.elapsed, state.eventSerial, state.fighters[1].x
			Simulation.step(state, 1)
			check(state.elapsed == elapsed and state.eventSerial == serial and state.fighters[1].x == x, "Finished round changed")
		end
	end)

	test("extreme angles both sides stay finite bounded and finish", function()
		local wins, phases = {}, {}
		for _, power in ipairs({ "Meteor", "Firework" }) do
			for _, a in ipairs({ 10, 32, 55 }) do
				for _, b in ipairs({ 10, 32, 55 }) do
					local state = Simulation.newRound(104729 + a * 7919 + b, { offenceId = power, angle = a },
						{ offenceId = power == "Meteor" and "Firework" or "Meteor", angle = b })
					for _ = 1, 2102 do
						Simulation.step(state, Simulation.FIXED_DT)
						check(#state.events &lt;= 24, "Event history leaked")
						for _, fighter in ipairs(state.fighters) do
							check(fighter.x == fighter.x and fighter.y == fighter.y and math.abs(fighter.vx) &lt; 100 and math.abs(fighter.vy) &lt; 100, "Nonfinite/excessive motion")
							check(fighter.x &gt;= state.bounds.left and fighter.x &lt;= state.bounds.right and fighter.y &gt;= state.bounds.bottom and fighter.y &lt;= state.bounds.top, "Out of bounds")
							check(fighter.armor &gt;= 0 and fighter.armor &lt;= 3, "Armor out of bounds")
							phases[fighter.phase] = true
						end
						if state.finished then break end
					end
					check(state.finished and state.elapsed &lt;= Simulation.MAX_TIME, "Nonterminating match")
					if state.winner ~= 0 then wins[state.fighters[state.winner].offenceId] = true end
					for index = 2, #state.events do check(state.events[index].serial &gt; state.events[index - 1].serial, "Event order changed") end
				end
			end
		end
		check(phases.Approach and phases.Windup and phases.Attack and phases.Recover, "A combat phase never occurred")
		check(wins.Meteor and wins.Firework, "One signature could never win the sample")
	end)

	local function has(fighter, id)
		for _, wildId in ipairs(fighter.wildIds) do if wildId == id then return true end end
		return false
	end
	local WILD = { "Afterburner", "FizzyFuel", "SpringBumper" }
	-- Every way to carry zero, one or two different wild cards.
	local LOADOUTS = { {}, { "Afterburner" }, { "FizzyFuel" }, { "SpringBumper" },
		{ "Afterburner", "FizzyFuel" }, { "Afterburner", "SpringBumper" }, { "FizzyFuel", "SpringBumper" } }

	test("wild cards validate and reset independently each round", function()
		local invalid = Simulation.newRound(1, { wildIds = { "PaidShield", {}, "Meteor" } }, { wildIds = "Afterburner" })
		check(#invalid.fighters[1].wildIds == 0 and #invalid.fighters[2].wildIds == 0, "Invalid wild cards accepted")
		check(invalid.fighters[1].bumperReady == nil, "A skill's private state appeared without the skill")
		for _, id in ipairs(WILD) do
			check(Simulation.validWild(id), "Catalog wild card rejected")
			local first = Simulation.newRound(12, { wildIds = { id } }, { wildIds = { id } })
			first.fighters[1].armor, first.fighters[1].boostLeft, first.fighters[1].bumperReady = 0, 0.8, false
			first.wakes = { wake(1, 1, 0, 50) }
			local nextRound = Simulation.newRound(12, { wildIds = { id } }, { wildIds = { id } })
			check(nextRound.fighters[1].armor == 3 and nextRound.fighters[1].boostLeft == 0 and #nextRound.wakes == 0, "Previous round effects leaked")
			check((nextRound.fighters[1].bumperReady == true) == (id == "SpringBumper"), "Bumper charge did not reset")
			check(nextRound.eventSerial == 2, "Activation events leaked into launch")
		end
	end)

	test("a build keeps at most two different wild cards in a fixed order", function()
		local state = Simulation.newRound(1, { wildIds = { "SpringBumper", "SpringBumper", "Afterburner", "FizzyFuel" } },
			{ wildIds = { "FizzyFuel", "Afterburner" } })
		local a, b = state.fighters[1].wildIds, state.fighters[2].wildIds
		check(#a == 2 and a[1] == "Afterburner" and a[2] == "SpringBumper", "Duplicate or third wild card kept")
		check(#b == 2 and b[1] == "Afterburner" and b[2] == "FizzyFuel", "Pick order leaked into the fight")
		local picked = { wildIds = { "SpringBumper", "FizzyFuel" } }
		local swapped = { wildIds = { "FizzyFuel", "SpringBumper" } }
		check(equal(run(4421, picked, picked), run(4421, swapped, swapped)), "Pick order changed a fight")
		check(#picked.wildIds == 2 and picked.wildIds[1] == "SpringBumper", "Caller's settings were edited")
	end)

	if Catalog and Skills then
		test("catalog and skill behaviour agree and catalog records are detached", function()
			local count = { offence = 0, wild = 0 }
			for _, entry in ipairs(Catalog.all()) do
				count[entry.kind] = count[entry.kind] + 1
				check(Skills[entry.kind][entry.id] ~= nil, "Catalog skill has no behaviour: " .. entry.id)
				check(Simulation.validOffence(entry.id) == (entry.kind == "offence") and
					Simulation.validWild(entry.id) == (entry.kind == "wild"), "Catalog and simulation disagree")
			end
			for kind, total in pairs(count) do
				local behaviours = 0
				for id in pairs(Skills[kind]) do
					behaviours = behaviours + 1
					check(Catalog.valid(id, kind), "Behaviour has no catalog entry: " .. id)
				end
				check(behaviours == total, "Catalog and behaviour counts differ")
			end
			for id, offence in pairs(Skills.offence) do
				for _, field in ipairs({ "windup", "attackTime", "attackSpeed", "earliest", "leadSpeed", "leadFactor" }) do
					check(type(offence[field]) == "number", id .. " lacks " .. field)
				end
			end
			check(Catalog.MAX_WILD == Simulation.MAX_WILD, "Wild card limit differs")
		end)
	end

	test("afterburner starts only after an attack and expires without retriggering", function()
		local state = Simulation.newRound(1, { offenceId = "Firework", wildIds = { "Afterburner" } })
		local fighter = state.fighters[1]
		passive(fighter, -40, 50, 0)
		passive(state.fighters[2], 50, 80, 0)
		Simulation.step(state, Simulation.FIXED_DT)
		check(fighter.boostLeft == 0 and close(math.sqrt(fighter.vx ^ 2 + fighter.vy ^ 2), 30), "Boost appeared without attacking")
		fighter.phase, fighter.phaseLeft = "Windup", 0
		Simulation.step(state, Simulation.FIXED_DT)
		check(fighter.phase == "Attack" and fighter.boostLeft == 0, "Boost altered committed attack")
		fighter.phaseLeft = 0
		Simulation.step(state, Simulation.FIXED_DT)
		check(fighter.phase == "Recover" and fighter.boostLeft &gt; 0, "Attack did not trigger recovery boost")
		check(close(math.sqrt(fighter.vx ^ 2 + fighter.vy ^ 2), 44), "Boost did not change recovery speed")
		local activations = 0
		for _, entry in ipairs(state.events) do
			if entry.kind == "skill" and entry.skillId == "Afterburner" then activations = activations + 1 end
		end
		check(activations == 1, "Boost activation duplicated")
		for _ = 1, 60 do Simulation.step(state, Simulation.FIXED_DT) end
		check(fighter.boostLeft == 0 and fighter.phase == "Recover", "Boost did not expire during recovery")
		check(close(math.sqrt(fighter.vx ^ 2 + fighter.vy ^ 2), 30), "Boost speed persisted")
	end)

	test("spring bumper ignores passive or protected contact and blocks one valid strike", function()
		local state = Simulation.newRound(1, nil, { wildIds = { "SpringBumper" } })
		passive(state.fighters[1], -3, 50, math.pi)
		passive(state.fighters[2], 3, 50, 0)
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].bumperReady, "Passive bump spent the bumper")
		armed(state.fighters[1], -8, 0)
		passive(state.fighters[2], 0, 50, 0)
		state.fighters[2].invulnerable = 0.2
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].bumperReady and state.fighters[2].armor == 3, "Protected contact spent the bumper")
		armed(state.fighters[1], -8, 0)
		passive(state.fighters[2], 0, 50, 0)
		state.fighters[2].invulnerable = 0
		Simulation.step(state, Simulation.FIXED_DT)
		check(not state.fighters[2].bumperReady and state.fighters[2].armor == 3, "Bumper did not absorb strike")
		check(state.fighters[1].hits == 0 and state.fighters[1].phase == "Recover", "Blocked strike counted as armor damage")
		check(state.fighters[1]._knockX &lt; 0 and state.fighters[2]._knockX &gt; 0, "Bumper failed to separate planes")
		local entry = state.events[#state.events]
		check(entry.kind == "blocked" and entry.actor == 2 and entry.target == 1 and entry.source == "meteor", "Block attribution differs")
		state.fighters[2].invulnerable = 0
		state.projectiles = { projectile(7, 1, -25, state.fighters[2].y, 6000, 0) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].armor == 2, "Spent bumper blocked a second hit")
	end)

	test("spring bumper consumes a rocket without reporting armor loss", function()
		local state = Simulation.newRound(1, nil, { wildIds = { "SpringBumper" } })
		passive(state.fighters[1], -55, 50, 0)
		passive(state.fighters[2], 0, 50, 0)
		state.projectiles = { projectile(1, 1, -25, 50, 6000, 0) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(#state.projectiles == 0 and state.fighters[2].armor == 3, "Bumper rocket resolution failed")
		local entry = state.events[#state.events]
		check(entry.kind == "blocked" and entry.source == "rocket" and entry.at == state.elapsed, "Blocked rocket has wrong feedback")
	end)

	test("fizzy wake starts at commitment and visibly arms before damage", function()
		local state = Simulation.newRound(1, { offenceId = "Firework", wildIds = { "FizzyFuel" } })
		local fighter = state.fighters[1]
		passive(fighter, -40, 50, 0)
		passive(state.fighters[2], 50, 80, 0)
		Simulation.step(state, Simulation.FIXED_DT)
		check(#state.wakes == 0, "Wake emitted outside attack")
		fighter.phase, fighter.phaseLeft = "Windup", 0
		Simulation.step(state, Simulation.FIXED_DT)
		check(#state.wakes == 1 and state.wakes[1].x &lt; fighter.x, "Attack did not leave a wake behind")
		check(state.wakes[1].armLeft &gt; 0 and state.wakes[1].radius == Simulation.WAKE_RADIUS, "Wake lacks visible arming/radius")
		local emitted = state._wakeSerial
		fighter.phaseLeft = 0
		for _ = 1, 12 do Simulation.step(state, Simulation.FIXED_DT) end
		check(fighter.phase == "Recover" and state._wakeSerial &gt; emitted, "An early attack ending truncated its promised wake")
		local contact = Simulation.newRound(1)
		passive(contact.fighters[1], -55, 50, 0)
		passive(contact.fighters[2], 0, 50, 0)
		contact.wakes = { wake(1, 1, 0, 50, Simulation.WAKE_ARM_TIME) }
		for _ = 1, 3 do Simulation.step(contact, Simulation.FIXED_DT) end
		check(contact.fighters[2].armor == 3, "Wake damaged before its cue armed")
		for _ = 1, math.ceil(Simulation.WAKE_ARM_TIME / Simulation.FIXED_DT) do
			-- Hold contact for this timer unit case; live avoidance is sampled separately.
			passive(contact.fighters[2], 0, 50, 0)
			Simulation.step(contact, Simulation.FIXED_DT)
		end
		check(contact.fighters[2].armor == 2 and #contact.wakes == 0, "Armed wake failed contact resolution")
		local count = 0
		for _, entry in ipairs(contact.events) do
			if entry.kind == "wake_hit" then count = count + 1 end
			check(entry.kind ~= "hit", "Wake duplicated its hit event")
		end
		check(count == 1, "Wake damage feedback duplicated or missing")
	end)

	test("Spring Bumper trades its full block for visible defender recoil", function()
		local state = Simulation.newRound(1, nil, { wildIds = { "SpringBumper" } })
		armed(state.fighters[1], -8, 0); passive(state.fighters[2], 0, 50, 0)
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].armor == 3 and not state.fighters[2].bumperReady, "Recoil weakened the promised full block")
		check(close(state.fighters[2].phaseLeft, Simulation.RECOVERY_TIME + 0.7), "Defender did not take visible extra recovery")
		check(close(state.fighters[1].phaseLeft, Simulation.RECOVERY_TIME), "Attacker inherited defender recoil")
	end)

	test("wake ownership protection and bumper interactions are consistent", function()
		local owner = Simulation.newRound(1)
		passive(owner.fighters[1], 0, 50, 0)
		passive(owner.fighters[2], 50, 80, 0)
		owner.wakes = { wake(1, 1, 0, 50) }
		Simulation.step(owner, Simulation.FIXED_DT)
		check(owner.fighters[1].armor == 3 and #owner.wakes == 1, "Wake hit its owner")
		for _, modifier in ipairs({ "None", "SpringBumper" }) do
			local state = Simulation.newRound(1, nil, { wildIds = { modifier } })
			passive(state.fighters[1], -55, 50, 0)
			passive(state.fighters[2], 0, 50, 0)
			state.wakes = { wake(1, 1, 0, 50), wake(2, 1, 0, 50) }
			Simulation.step(state, Simulation.FIXED_DT)
			check(state.fighters[2].armor == (modifier == "None" and 2 or 3), "Wake bypassed bumper/protection")
			check(#state.wakes == 0, "Overlapping wake remained inside protected plane")
			if modifier == "SpringBumper" then
				local entry = state.events[#state.events]
				check(not state.fighters[2].bumperReady and entry.kind == "blocked" and entry.source == "wake", "Wake did not consume bumper visibly")
			end
		end
	end)

	test("wake instances are bounded and expire after emission stops", function()
		local state = Simulation.newRound(1, { wildIds = { "FizzyFuel" } }, { wildIds = { "FizzyFuel" } })
		for _ = 1, 180 do
			for id, fighter in ipairs(state.fighters) do
				passive(fighter, 0, id == 1 and 80 or 20, id == 1 and 0 or math.pi)
				fighter.phase, fighter.phaseLeft, fighter._attackHeading = "Attack", 100, fighter.heading
				fighter.armed, fighter._wakeLeft = false, 100
			end
			Simulation.step(state, Simulation.FIXED_DT)
			check(#state.wakes &lt;= Simulation.MAX_WAKES, "Wake instance count leaked")
			local owned = { 0, 0 }
			for _, entry in ipairs(state.wakes) do owned[entry.owner] = owned[entry.owner] + 1 end
			check(owned[1] &lt;= 6 and owned[2] &lt;= 6, "One plane exhausted the shared wake budget")
		end
		for id, fighter in ipairs(state.fighters) do
			passive(fighter, id == 1 and -50 or 50, 50, id == 1 and math.pi or 0)
			fighter._wakeLeft = 0
		end
		for _ = 1, math.ceil(Simulation.WAKE_LIFE / Simulation.FIXED_DT) + 2 do Simulation.step(state, Simulation.FIXED_DT) end
		check(#state.wakes == 0, "Expired wake persisted")
	end)

	test("afterburner and fizzy fuel both fire from one attack", function()
		local state = Simulation.newRound(1, { offenceId = "Firework", wildIds = { "FizzyFuel", "Afterburner" } })
		local fighter = state.fighters[1]
		passive(fighter, -40, 50, 0)
		passive(state.fighters[2], 50, 80, 0)
		fighter.phase, fighter.phaseLeft = "Windup", 0
		Simulation.step(state, Simulation.FIXED_DT)
		check(fighter.phase == "Attack" and #state.wakes == 1 and fighter.boostLeft == 0, "Wake or boost timing changed when paired")
		fighter.phaseLeft = 0
		for _ = 1, 12 do Simulation.step(state, Simulation.FIXED_DT) end
		check(fighter.phase == "Recover" and fighter.boostLeft &gt; 0 and state._wakeSerial &gt; 1, "Paired wild cards did not both run")
		check(close(math.sqrt(fighter.vx ^ 2 + fighter.vy ^ 2), 44), "Boost speed lost when paired with a wake")
	end)

	test("spring bumper still blocks once beside another wild card", function()
		for _, partner in ipairs({ "Afterburner", "FizzyFuel" }) do
			local state = Simulation.newRound(1, nil, { wildIds = { partner, "SpringBumper" } })
			armed(state.fighters[1], -8, 0)
			passive(state.fighters[2], 0, 50, 0)
			Simulation.step(state, Simulation.FIXED_DT)
			check(not state.fighters[2].bumperReady and state.fighters[2].armor == 3, "Paired bumper did not absorb: " .. partner)
			local entry = state.events[#state.events]
			check(entry.kind == "blocked" and entry.skillId == "SpringBumper", "Paired block lacks feedback")
			state.fighters[2].invulnerable = 0
			state.projectiles = { projectile(7, 1, -25, state.fighters[2].y, 6000, 0) }
			Simulation.step(state, Simulation.FIXED_DT)
			check(state.fighters[2].armor == 2, "Paired bumper blocked twice: " .. partner)
		end
	end)

	test("a bumper carrier's own wake and boost are untouched by its block", function()
		local state = Simulation.newRound(1, { offenceId = "Firework", wildIds = { "Afterburner", "SpringBumper" } },
			{ wildIds = { "FizzyFuel", "SpringBumper" } })
		passive(state.fighters[1], -55, 50, 0)
		passive(state.fighters[2], 0, 50, 0)
		state.wakes = { wake(1, 2, -55, 50) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[1].armor == 3 and not state.fighters[1].bumperReady, "Bumper did not stop a rival wake")
		check(state.fighters[2].bumperReady and #state.wakes == 0, "Wake owner lost its own bumper or kept the puff")
	end)

	test("every loadout pair is deterministic bounded and terminates", function()
		for _, a in ipairs(LOADOUTS) do
			for _, b in ipairs(LOADOUTS) do
				local settingsA, settingsB = { offenceId = "Meteor", wildIds = a, angle = 10 }, { offenceId = "Firework", wildIds = b, angle = 55 }
				local first, second = run(91273, settingsA, settingsB), run(91273, settingsA, settingsB)
				local label = table.concat(a, "+") .. "/" .. table.concat(b, "+")
				check(equal(first, second), "Loadout replay differed: " .. label)
				check(#first.wakes &lt;= Simulation.MAX_WAKES and first.elapsed &lt;= Simulation.MAX_TIME, "Loadout lifecycle escaped bounds")
				for id, fighter in ipairs(first.fighters) do
					check(has(fighter, "SpringBumper") == (fighter.bumperReady ~= nil), "Bumper state on the wrong plane")
					check(#fighter.wildIds == #(id == 1 and a or b), "Loadout changed during the fight")
				end
				for _, entry in ipairs(first.events) do check(type(entry.at) == "number" and entry.at &lt;= first.elapsed, "Event timestamp missing") end
			end
		end
	end)


	test("Machine Gun requires three connections and caps a burst at one pip", function()
		local state = Simulation.newRound(1, { offenceId = "MachineGun" })
		local actor = state.fighters[1]
		passive(actor, -55, 50, 0); passive(state.fighters[2], 0, 50, 0)
		actor.attacks, actor.burstConnections, actor.burstCancelled, actor._burstDamaged = 1, 0, false, false
		local function bullet(id)
			local shot = projectile(id, 1, -25, state.fighters[2].y, 6000, 0)
			shot.source, shot.burstId = "machinegun", 1
			return shot
		end
		state.projectiles = { bullet(1), bullet(2) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].armor == 3 and actor.burstConnections == 2, "Stray tracers dealt a pip")
		state.projectiles = { bullet(3), bullet(4), bullet(5), bullet(6) }
		Simulation.step(state, Simulation.FIXED_DT)
		check(state.fighters[2].armor == 2 and actor.hits == 1 and actor._burstDamaged, "Burst threshold or cap failed")
		check(#state.projectiles == 0, "Contacting tracers leaked")
	end)

	test("bumper cancels an entire burst and protection preserves the bumper", function()
		for _, protected in ipairs({ false, true }) do
			local state = Simulation.newRound(1, { offenceId = "MachineGun" }, { wildIds = { "SpringBumper" } })
			local actor, target = state.fighters[1], state.fighters[2]
			passive(actor, -55, 50, 0); passive(target, 0, 50, 0)
			actor.attacks, actor.burstConnections, actor.burstCancelled = 1, 0, false
			target.invulnerable = protected and 1 or 0
			local shot = projectile(1, 1, -25, 50, 6000, 0)
			shot.source, shot.burstId = "machinegun", 1
			state.projectiles = { shot }; Simulation.step(state, Simulation.FIXED_DT)
			check(actor.burstCancelled and target.bumperReady == protected and target.armor == 3, "Wrong defense precedence")
			target.invulnerable = 0
			for id = 2, 6 do
				local nextShot = projectile(id, 1, -25, target.y, 6000, 0)
				nextShot.source, nextShot.burstId = "machinegun", 1
				state.projectiles[#state.projectiles + 1] = nextShot
			end
			Simulation.step(state, Simulation.FIXED_DT)
			check(target.armor == 3 and actor.burstConnections == 0, "Cancelled burst resumed after protection")
		end
	end)

	test("Pinball arms only on a true rail reflection", function()
		local state = Simulation.newRound(1, { offenceId = "Pinball" })
		local actor = state.fighters[1]
		passive(actor, -71.8, 50, math.pi); passive(state.fighters[2], 40, 70, 0)
		actor.phase, actor.phaseLeft, actor._bankX, actor._bankY = "Windup", 1, -150, 50
		Simulation.step(state, Simulation.FIXED_DT)
		check(actor.armed and actor.phase == "Attack" and math.abs(actor._attackHeading) &lt; 0.00001, "Rail failed specular reflection")
		local entry = state.events[#state.events]
		check(entry.kind == "ricochet" and entry.source == "pinball", "Bounce lacks authoritative cue")
		check(actor.armor == 3 and state.fighters[2].armor == 3, "Rail dealt damage")
	end)

	test("Second Wind triggers once at one armor without healing including simultaneous hits", function()
		local state = Simulation.newRound(1, { wildIds = { "SecondWind" } }, { wildIds = { "SecondWind" } })
		armed(state.fighters[1], -4, 0); armed(state.fighters[2], 4, math.pi)
		state.fighters[1].armor, state.fighters[2].armor = 2, 2
		Simulation.step(state, Simulation.FIXED_DT)
		for _, fighter in ipairs(state.fighters) do
			check(fighter.armor == 1 and fighter.secondWind, "Simultaneous last-armor trigger failed")
			check(close(fighter.phaseLeft, Simulation.RECOVERY_TIME * 0.84), "Trigger did not shorten same-step recovery")
		end
		local triggers = 0
		for _, entry in ipairs(state.events) do if entry.skillId == "SecondWind" then triggers = triggers + 1 end end
		check(triggers == 2, "Second Wind trigger duplicated or missing")
	end)

	test("Magnet pulls symmetrically once and recovery can escape at full pressure", function()
		local function pulled(both)
			local state = Simulation.newRound(1, { wildIds = { "Magnet" } }, { wildIds = both and { "Magnet" } or {} })
			state.elapsed = 34
			passive(state.fighters[1], -25, 50, math.pi); passive(state.fighters[2], 25, 50, 0)
			state.fighters[1].magnetLeft = 1
			if both then state.fighters[2].magnetLeft = 1 end
			Simulation.step(state, Simulation.FIXED_DT)
			check(state.fighters[1].x &lt; -25 and state.fighters[2].x &gt; 25, "Pull pinned escaping automatic pilots")
			return state
		end
		local one, two = pulled(false), pulled(true)
		check(close(one.fighters[1].vx, two.fighters[1].vx) and close(one.fighters[2].vx, two.fighters[2].vx), "Two magnets stacked")
		check(close(math.abs(one.fighters[1].vx), 30 - Simulation.MAGNET_SPEED), "Pull overcame thrust or was asymmetric")
	end)

	test("final total speed caps knockback plus Second Wind and Afterburner", function()
		local state = Simulation.newRound(1, { wildIds = { "Afterburner", "SecondWind" } })
		local actor = state.fighters[1]
		passive(actor, 0, 50, 0); passive(state.fighters[2], 50, 80, 0)
		actor.boostLeft, actor.secondWind, actor._knockX, actor._knockY = 1, true, 200, 200
		Simulation.step(state, Simulation.FIXED_DT)
		check(math.sqrt(actor.vx ^ 2 + actor.vy ^ 2) &lt;= Simulation.MAX_TOTAL_SPEED + 0.00001, "Stacked force escaped total speed cap")
	end)

	test("ram and projectile same-step knockout resolve together", function()
		for _, seat in ipairs({ 1, 2 }) do
			local state = Simulation.newRound(1)
			armed(state.fighters[seat], -4, 0); passive(state.fighters[3 - seat], 4, 50, math.pi)
			state.fighters[1].armor, state.fighters[2].armor = 1, 1
			state.projectiles = { projectile(1, 3 - seat, 20, 50, -6000, 0) }
			Simulation.step(state, Simulation.FIXED_DT)
			check(state.finished and state.winner == 0 and state.fighters[1].armor == 0 and state.fighters[2].armor == 0, "Attack category or seat decided double KO")
		end
	end)

	test("every active offence can attack and is deterministic inside the round cap", function()
		for _, entry in ipairs(Catalog.all("offence")) do
			local config = { offenceId = entry.id, wildIds = { "Magnet", "SecondWind" }, angle = 32 }
			local first, second = run(71391, config, config), run(71391, config, config)
			check(equal(first, second) and first.elapsed &lt;= 35, "Roster replay/cap failed: " .. entry.id)
			check(first.fighters[1].attacks &gt; 0 and first.fighters[2].attacks &gt; 0, "Automatic pilot never attacks: " .. entry.id)
		end
	end)

	return string.format("BattleSimulation: %d tests passed (determinism, fixed ticks, collisions, protection, endings, wild cards, wakes)", passed)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX24">
      <Properties>
        <string name="Name">BattleMatchTests</string>
        <ProtectedString name="Source">-- Deterministic service doubles exercise orchestration, never replication/UI.
return function(BattleLab, Skills)
    local count=0
    local function test(name,fn)
        local ok,err=pcall(fn); assert(ok,name..": "..tostring(err)); count=count+1
    end
    local function harness(options)
        options=options or {}
        local t={time=0,emitted={},terminal={},events={},entered={},players={}}
        local simulation={FIXED_DT=1/60}
        function simulation.newRound(seed,a,b)
            return {seed=seed,elapsed=0,events={},projectiles={},wakes={},fighters={
                {id=1,x=-52,vx=20,heading=.3,armor=3,settings=a},{id=2,x=52,vx=-20,heading=2.8,armor=3,settings=b}}}
        end
        function simulation.step(s,dt)
            if s.finished then return end
            s.elapsed=s.elapsed+dt
            if s.elapsed&gt;=35-0.000001 then s.elapsed=35;s.finished=true;s.reason="timeout";s.winner=s.fighters[1].armor==s.fighters[2].armor and 0 or s.fighters[1].armor&gt;s.fighters[2].armor and 1 or 2 end
        end
        local deps={skills=Skills,simulation=simulation,now=function()return t.time end,
            getPlayers=function()local result={}for _,p in pairs(t.players)do result[#result+1]=p end return result end,
            emit=function(p,s)t.emitted[p.UserId]=s end,
            canEnter=function(p)return not t.entered[p.UserId]end,
            entered=function(p)t.entered[p.UserId]=true end,exited=function(p)t.entered[p.UserId]=nil end,
            onTerminal=function(p,result)t.terminal[#t.terminal+1]={id=p.UserId,result=result}end,
            onEvent=function(p,name,data)t.events[#t.events+1]={id=p.UserId,name=name,data=data}end}
        for key,value in pairs(options)do deps[key]=value end
        t.lab=BattleLab.new(deps)
        function t.player(id)
            local p={UserId=id,Name="Pilot"..id,DisplayName="Pilot"..id}
            function p:GetAttribute(key)if key=="SkyboundColor"then return id end return nil end
            t.players[id]=p;return p
        end
        function t.send(p,kind,extra)
            local s=t.lab:snapshot(p);local payload=extra or {}
            payload.kind=kind;if payload.matchId==nil then payload.matchId=s.matchId end;if payload.stage==nil then payload.stage=s.stage end
            if payload.offerRevision==nil then payload.offerRevision=s.offerRevision end
            if kind=="lock" then payload.slot=payload.slot or s.slot;payload.skillId=payload.skillId or s.selected or s.offer[1] end
            t.lab:command(p,payload)
        end
        function t.advance(seconds)
            local target=t.time+seconds
            while t.time&lt;target-0.000001 do local dt=math.min(.1,target-t.time);t.time=t.time+dt;t.lab:step(dt)end
        end
        function t.pair()
            local a,b=t.player(1),t.player(2);t.send(a,"enter");t.send(b,"enter");return a,b,t.lab.sessions[1].match
        end
        function t.lock(p)
            local s=t.lab:snapshot(p);t.send(p,"pick",{slot=s.slot,skillId=s.offer[1]});t.send(p,"lock")
        end
        function t.fight(a,b)
            t.lock(a);if b then t.lock(b)end;t.advance(2.5)
            assert(t.lab:snapshot(a).phase=="Fight")
        end
        function t.finish(m,winner,reason)
            m.simulation.finished=true;m.simulation.winner=winner;m.simulation.reason=reason or "knockout"
            t.advance(.1)
        end
        return t
    end
    test("pair oldest compatible users and isolate independent matches",function()
        local t=harness();local a,b,m=t.pair();assert(t.lab:snapshot(a).phase=="Pick")
        assert(t.lab:snapshot(a).matchId==t.lab:snapshot(b).matchId)
        assert(not t.lab:snapshot(a).simulatedOpponent)
        local c,d=t.player(3),t.player(4);t.send(c,"enter");t.send(d,"enter")
        assert(t.lab:snapshot(c).matchId~=m.id)
        t.send(a,"exit");assert(t.lab:snapshot(b).result.winner==1 and t.lab:snapshot(c).phase=="Pick")
    end)
    test("eight-second named bot fallback and cancellation remove queue reservations",function()
        local t=harness();local a=t.player(1);t.send(a,"enter");t.advance(7.8)
        assert(t.lab:snapshot(a).phase=="Searching");t.send(a,"exit");t.advance(10);assert(not t.lab:snapshot(a).active)
        t.send(a,"enter");t.advance(8.1);local s=t.lab:snapshot(a)
        assert(s.phase=="Pick" and s.simulatedOpponent and s.players[2].bot and s.players[2].name=="Comet")
        assert(s.resources.reroll==1 and s.resources.pickAny==1)
    end)
    test("offers and selection stay private until simultaneous reveal",function()
        local t=harness();local a,b,m=t.pair();local sa=t.lab:snapshot(a);local sb=t.lab:snapshot(b)
        assert(#sa.offer==3 and #sb.offer==3 and sa.offers==nil and sa.settings[2].offenceId==nil)
        t.send(a,"pick",{slot="offence",skillId=sa.offer[2]});t.send(a,"lock")
        sb=t.lab:snapshot(b);assert(sb.settings[2].offenceId==nil and sb.selected==nil and sb.locked[2])
        t.lock(b);sa=t.lab:snapshot(a);sb=t.lab:snapshot(b)
        assert(sa.phase=="Countdown" and sa.settings[1].offenceId==sb.settings[2].offenceId)
        assert(sa.settings[1].offenceId==sa.simulation.fighters[1].settings.offenceId)
        assert(sb.players[1].userId==2 and sb.players[2].userId==1)
    end)
    test("reject outside-offer inactive wrong-kind cross-player stale and wrong-phase commands",function()
        local t=harness();local a,b,m=t.pair();local s=t.lab:snapshot(a)
        local outside;for _,id in ipairs(s.eligible)do local found=false;for _,o in ipairs(s.offer)do if o==id then found=true end end;if not found then outside=id end end
        for _,extra in ipairs({{slot="offence",skillId=outside},{slot="wild",skillId=s.offer[1]},
            {slot="offence",skillId="Copycat"},{slot="offence",skillId="Afterburner"},
            {slot="offence",skillId=s.offer[1],side=2},{slot="offence",skillId=s.offer[1],userId=2},
            {slot="offence",skillId=s.offer[1],matchId=999},{slot="offence",skillId=s.offer[1],stage=2}})do
            t.advance(.1);t.send(a,"pick",extra);assert(t.lab:snapshot(a).selected==nil)
        end
        t.lock(a);local chosen=m.selected[1];t.advance(.1);t.send(a,"pick",{slot="offence",skillId=s.offer[3]});assert(m.selected[1]==chosen)
        t.lock(b);t.advance(.1);t.send(a,"pickAny");assert(m.resources[1].pickAny==1)
        t.send(a,"configure",{settings={{offenceId="Copycat"},{offenceId="Copycat"}}});assert(m.settings[1].offenceId==chosen)
    end)
    test("reroll changes set once and Pick Any consumes once for the entire match",function()
        local t=harness();local a,b,m=t.pair();local old=t.lab:snapshot(a).offer;t.send(a,"reroll")
        local s=t.lab:snapshot(a);local changed=false
        for _,id in ipairs(s.offer)do local found=false;for _,o in ipairs(old)do if o==id then found=true end end;if not found then changed=true end end
        assert(changed and s.resources.reroll==0 and s.selected==nil)
        local nextOffer=table.concat(s.offer,",");t.send(a,"reroll");assert(table.concat(t.lab:snapshot(a).offer,",")==nextOffer)
        t.send(a,"pickAny");assert(#t.lab:snapshot(a).offer==4 and t.lab:snapshot(a).resources.pickAny==0)
        t.fight(a,b);t.finish(m,0,"timeout");t.advance(4.7)
        assert(m.phase=="Fight" and m.stage==1 and m.resources[1].reroll==0 and m.resources[1].pickAny==0)
    end)
    test("stale offer and bare locks never auto-pick a replacement card",function()
        local t=harness();local a,b,m=t.pair();local old=t.lab:snapshot(a)
        -- Raw commands intentionally bypass the friendly packet helper.
        t.lab:command(a,{kind="lock",matchId=m.id,stage=1})
        assert(not m.locked[1] and m.selected[1]==nil,"Bare lock auto-picked")
        t.send(a,"reroll");local current=t.lab:snapshot(a)
        assert(current.offerRevision==old.offerRevision+1)
        local removed;for _,id in ipairs(old.offer)do if not table.find(current.offer,id)then removed=id end end
        assert(removed)
        t.advance(.1)
        t.lab:command(a,{kind="pick",matchId=m.id,stage=1,slot="offence",skillId=removed,offerRevision=old.offerRevision})
        t.lab:command(a,{kind="lock",matchId=m.id,stage=1,slot="offence",skillId=removed,offerRevision=old.offerRevision})
        assert(not m.locked[1] and m.selected[1]==nil,"Stale offer locked a different card")
        -- Even a card shared by both offers needs the current revision.
        t.advance(.1)
        t.lab:command(a,{kind="lock",matchId=m.id,stage=1,slot="offence",skillId=current.offer[1],offerRevision=old.offerRevision})
        t.lab:command(a,{kind="lock",matchId=m.id,stage=1,slot="offence",offerRevision=current.offerRevision})
        t.lab:command(a,{kind="lock",matchId=m.id,stage=1,slot="offence",skillId=removed,offerRevision=current.offerRevision})
        assert(not m.locked[1] and m.selected[1]==nil,"Invalid lock fell back to the first offer")
        t.advance(.2)
        t.send(a,"lock",{slot="offence",skillId=current.offer[2]});t.lock(b)
        assert(m.phase=="Countdown" and m.settings[1].offenceId==current.offer[2],"Explicit current card not preserved")
    end)
    test("terminal armor win explains the deciding round instead of the rival's last hit",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b)
        t.finish(m,1,"timeout");t.advance(2.1);t.fight(a,b)
        m.roundEvents={{kind="hit",actor=2,target=1,skillId="Pinball"}}
        m.simulation.fighters[1].armor=2;m.simulation.fighters[2].armor=1
        t.finish(m,1,"timeout")
        for _,player in ipairs({a,b})do
            local result=t.lab:snapshot(player).result
            assert(result.reason=="first_to_two" and result.decidingRoundReason=="timeout")
            assert(result.facts[1]=="At 35 seconds, the plane with more armor won.","Last hit misrepresented the armor win")
        end
    end)
    test("draw and terminal caps explain the actual deciding rule",function()
        local t=harness();local a,b,m=t.pair()
        assert(t.lab:facts(m,{winner=0,reason="knockout"},1)[1]=="Both planes lost their final armor together.")
        assert(t.lab:facts(m,{winner=0,reason="timeout"},1)[1]=="Equal armor: this round gave neither pilot a point.")
        for _,reason in ipairs({"wall_cap","round_cap"})do
            assert(string.find(t.lab:facts(m,{winner=0,reason=reason},1)[1],"Match drawn.",1,true))
            assert(string.find(t.lab:facts(m,{winner=1,reason=reason,decidingRoundReason="timeout"},1)[1],"completed round wins",1,true))
        end
    end)
    test("Pick Any revisions reject queued old selections and stale resource requests",function()
        local t=harness();local a,b,m=t.pair();local old=t.lab:snapshot(a)
        t.send(a,"pickAny");local current=t.lab:snapshot(a)
        assert(current.offerRevision==old.offerRevision+1)
        t.send(a,"pick",{slot=old.slot,skillId=old.offer[1],offerRevision=old.offerRevision})
        t.send(a,"lock",{slot=old.slot,skillId=old.offer[1],offerRevision=old.offerRevision})
        t.send(a,"reroll",{offerRevision=old.offerRevision})
        assert(not m.locked[1] and m.selected[1]==nil and m.resources[1].reroll==1)
        t.advance(.1);t.send(a,"lock",{skillId=current.offer[#current.offer]});t.lock(b)
        assert(m.settings[1].offenceId==current.offer[#current.offer])
    end)
    test("eligible pools below equal and above three and disabled reroll does not consume",function()
        for count=2,4 do
            local roster={version="test",offences={"Meteor","Firework","MachineGun","Pinball"},wilds={"Afterburner","SpringBumper"}}
            while #roster.offences&gt;count do table.remove(roster.offences)end
            local t=harness({allowExperimental=true,resolveRoster=function()return roster end})
            local a,b=t.pair();local s=t.lab:snapshot(a);assert(#s.offer==math.min(3,count))
            t.send(a,"reroll");assert(t.lab:snapshot(a).resources.reroll==(count&gt;3 and 0 or 1))
        end
    end)
    test("timeout takes first offer and late picks cannot change the committed round",function()
        local t=harness();local a,b,m=t.pair();local s=t.lab:snapshot(a);local first=s.offer[1]
        t.send(a,"pick",{slot="offence",skillId=s.offer[2]});t.advance(10.1)
        assert(m.phase=="Countdown" and m.settings[1].offenceId==first)
        t.send(a,"pick",{slot="offence",skillId=s.offer[3]});assert(m.settings[1].offenceId==first)
    end)
    test("2-0 ends immediately and draft advances both players after decisive rounds",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1)
        assert(m.stage==2 and m.phase=="Pick" and #m.settings[1].wildIds==0)
        assert(t.lab:snapshot(a).matchPoint and t.lab:snapshot(b).matchPoint)
        t.fight(a,b);t.finish(m,1)
        assert(m.phase=="MatchOver" and m.score[1]==2 and m.roundNumber==2 and #m.settings[1].wildIds==1)
        assert(#t.terminal==2 and t.lab:snapshot(b).result.winner==2)
        t.advance(10);assert(#t.terminal==2)
    end)
    test("2-1 accumulates distinct second wild cards and rejects previous-stage packets",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1);t.fight(a,b);t.finish(m,2);t.advance(2.1)
        assert(m.stage==3 and m.score[1]==1 and m.score[2]==1)
        local first=m.settings[1].wildIds[1]
        for _,id in ipairs(t.lab:snapshot(a).eligible)do assert(id~=first)end
        t.send(a,"pick",{stage=2,slot="wild",skillId=t.lab:snapshot(a).offer[1]});assert(m.selected[1]==nil)
        t.send(a,"pick",{slot="wild",skillId=first});assert(m.selected[1]==nil)
        t.fight(a,b);assert(#m.settings[1].wildIds==2 and m.settings[1].wildIds[2]~=first)
        t.finish(m,2);assert(m.phase=="MatchOver" and m.score[2]==2)
    end)
    test("draw gives no point no pick and a new seed; five drawn rounds end honestly",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b)
        local seeds={}
        for index=1,5 do
            assert(not seeds[m.simulation.seed]);seeds[m.simulation.seed]=true
            t.finish(m,0,"timeout")
            if index&lt;5 then t.advance(4.7);assert(m.phase=="Fight" and m.stage==1 and m.score[1]==0)end
        end
        assert(m.phase=="MatchOver" and m.result.reason=="round_cap" and m.result.winner==0 and m.roundNumber==5)
    end)
    test("five-round cap compares completed wins without inventing an extra point",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1);t.fight(a,b)
        for index=2,5 do t.finish(m,0,"timeout");if index&lt;5 then t.advance(4.7)end end
        assert(m.result.reason=="round_cap" and m.result.winner==1 and m.score[1]==1 and m.score[2]==0)
    end)
    test("wall-clock cap stops unfinished fight without awarding its armor leader a point",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);m.simulation.fighters[1].armor=3;m.simulation.fighters[2].armor=1
        t.time=m.startedAt+240;t.lab:step(.1)
        assert(m.phase=="MatchOver" and m.result.reason=="wall_cap" and m.result.winner==0 and m.completedRounds==0)
        assert(m.score[1]==0 and m.score[2]==0)
        t.send(a,"again");t.advance(8.1);assert(t.lab:snapshot(a).phase=="Pick")
    end)
    test("35-second physical cap compares armor and equal armor draws",function()
        for _,armor in ipairs({3,2})do
            local t=harness();local a,b,m=t.pair();t.fight(a,b);m.simulation.fighters[2].armor=armor;t.advance(35)
            assert(m.roundResult.winner==(armor==3 and 0 or 1) and m.simulation.elapsed==35)
        end
    end)
    test("exit disconnect both leave and repeat departures clear reservations exactly once",function()
        for _,inFight in ipairs({false,true})do
            local t=harness();local a,b,m=t.pair();if inFight then t.fight(a,b)end
            t.lab:remove(a);assert(t.lab:snapshot(b).phase=="MatchOver" and t.lab:snapshot(b).rivalGone)
            assert(t.terminal[1].result.abandoned and not t.terminal[2].result.abandoned)
            assert(not t.entered[1] and t.lab.sessions[1]==nil)
            t.lab:remove(a);assert(#t.terminal==2)
            t.send(b,"exit");assert(t.lab.matches[m.id]==nil and not t.entered[2])
            t.send(a,"enter");t.send(b,"enter");assert(t.lab:snapshot(a).phase=="Pick")
        end
    end)
    test("mutual rematch resets builds and resources while one vote cannot start",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1);t.fight(a,b);t.finish(m,1)
        t.send(a,"rematch");assert(m.phase=="MatchOver" and t.lab:snapshot(a).rematchVotes[1])
        t.send(b,"rematch");local nextMatch=t.lab.sessions[1].match
        assert(nextMatch.id~=m.id and nextMatch.phase=="Pick" and nextMatch.settings[1].offenceId==nil and nextMatch.resources[1].reroll==1)
        t.send(a,"lock",{matchId=m.id,stage=1});assert(not nextMatch.locked[1])
    end)
    test("declined rematch stays terminal with unavailable rival and allows requeue",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1);t.fight(a,b);t.finish(m,1)
        t.send(a,"rematch");t.send(b,"exit");assert(t.lab:snapshot(a).rematchStatus=="unavailable")
        t.advance(.1);t.send(a,"again");assert(t.lab:snapshot(a).phase=="Searching")
    end)
    test("bot rematch accepts immediately and fixed seed is server-only",function()
        local t=harness({allowFixedSeed=true,fixedSeed=731});local a=t.player(1);t.send(a,"enter");t.advance(8.1)
        local m=t.lab.sessions[1].match;t.fight(a);assert(m.simulation.seed==731)
        t.finish(m,1);t.advance(2.1);t.fight(a);assert(m.simulation.seed==731);t.finish(m,1)
        local identity=m.identities[2]
        t.send(a,"rematch");assert(t.lab:snapshot(a).phase=="Pick" and t.lab:snapshot(a).matchId~=m.id)
        local sameBot=t.lab:snapshot(a).players[2]
        assert(sameBot.name==identity.name and sameBot.planeId==identity.planeId and sameBot.portrait==identity.portrait and sameBot.color==identity.color)
    end)
    test("public ignores experimental requests; authorized pools freeze and never mix",function()
        local roster={version="experiment",offences={"Meteor","Firework"},wilds={"Afterburner","SpringBumper"}}
        local t=harness({resolveRoster=function()return roster end});local a,b,m=t.pair();assert(m.roster.mode=="public" and #m.roster.offences==4)
        local x=harness({allowExperimental=true,resolveRoster=function(p)if p.UserId==1 then return roster end end})
        local c,d=x.player(1),x.player(2);x.send(c,"enter");x.send(d,"enter");assert(x.lab:snapshot(c).phase=="Searching")
        x.advance(8.1);local old=x.lab.sessions[1].match;roster.offences={"Pinball"}
        assert(#old.roster.offences==2 and x.lab:snapshot(d).mode=="public" and x.lab:snapshot(c).experimental)
    end)
    test("perspective mirrors complete event identities owners coordinates and results",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b)
        m.simulation.events={{serial=1,kind="hit",actor=1,target=2,x=12,heading=.3,skillId="Meteor"}}
        m.simulation.projectiles={{id=7,owner=1,x=9,vx=2}};m.simulation.wakes={{id=8,owner=2,x=-7}}
        local view=t.lab:snapshot(b).simulation
        assert(view.fighters[1].id==1 and view.fighters[1].x==-52 and view.fighters[1].vx==20)
        assert(view.events[1].actor==2 and view.events[1].target==1 and view.events[1].x==-12)
        assert(view.projectiles[1].id==7 and view.projectiles[1].owner==2 and view.projectiles[1].vx==-2 and view.wakes[1].owner==1)
        assert(m.simulation.events[1].actor==1 and m.simulation.fighters[1].x==-52)
        t.finish(m,1);local result=t.lab:snapshot(b).roundResult
        assert(result.winner==2 and result.events[1].actor==2 and string.find(result.facts[1],"Rival's Meteor"))
    end)
    test("snapshot mutation cannot change the server offer build roster or simulation",function()
        local t=harness();local a,b,m=t.pair();local s=t.lab:snapshot(a)
        s.offer[1]="Copycat";s.eligible[1]="Copycat";s.resources.reroll=99;s.settings[1].wildIds[1]="Copycat"
        assert(m.offers[1][1]~="Copycat" and m.resources[1].reroll==1 and #m.settings[1].wildIds==0)
        t.fight(a,b);s=t.lab:snapshot(a);s.simulation.fighters[1].armor=99;assert(m.simulation.fighters[1].armor==3)
    end)
    test("challenge explicitly accepts into one isolated shared-roster match",function()
        local t=harness();local a,b=t.player(1),t.player(2)
        t.send(a,"challenge",{targetUserId=2});local incoming=t.lab:snapshot(b).challenge
        assert(incoming.direction=="incoming" and incoming.name=="Pilot1" and incoming.expiresAt==25)
        assert(not t.entered[1] and not t.entered[2] and not t.lab:snapshot(a).active)
        t.send(a,"challengeAccept",{inviteId=incoming.inviteId});assert(t.lab:snapshot(b).challenge)
        t.send(b,"challengeAccept",{inviteId=incoming.inviteId})
        local m=t.lab.sessions[1].match
        assert(m==t.lab.sessions[2].match and m.mode=="challenge" and m.phase=="Pick" and t.entered[1] and t.entered[2])
        t.send(b,"challengeAccept",{inviteId=incoming.inviteId});assert(t.lab.sequence==1 and t.lab.sessions[1].match==m)
        t.fight(a,b);assert(m.phase=="Fight")
    end)
    test("crossing challenge requires explicit recipient acceptance and never creates two matches",function()
        local t=harness();local a,b=t.player(1),t.player(2)
        t.send(a,"challenge",{targetUserId=2});t.send(b,"challenge",{targetUserId=1})
        assert(t.lab:snapshot(b).challenge.direction=="incoming" and t.lab.sequence==0)
        local id=t.lab:snapshot(b).challenge.inviteId
        t.send(b,"challengeAccept",{inviteId=id});t.send(a,"enter");t.send(b,"enter")
        assert(t.lab.sequence==1 and #t.lab.queue==0)
    end)
    test("challenge decline cancel expiry departure and stale acceptance release both players",function()
        for _,action in ipairs({"challengeDecline","challengeCancel","expire","depart"})do
            local t=harness({challengeSeconds=5});local a,b=t.player(1),t.player(2)
            t.send(a,"challenge",{targetUserId=2});local id=t.lab:snapshot(b).challenge.inviteId
            if action=="expire" then t.advance(5.1)
            elseif action=="depart" then t.lab:remove(a)
            else t.send(action=="challengeDecline" and b or a,action,{inviteId=id})end
            assert(not t.lab:snapshot(a).challenge and not t.lab:snapshot(b).challenge and not t.entered[1] and not t.entered[2])
            t.send(b,"challengeAccept",{inviteId=id});assert(t.lab.sequence==0)
            t.advance(.2);t.send(a,"enter");t.send(b,"enter");assert(t.lab.sequence==1)
        end
    end)
    test("public queue assignment cancels challenge atomically and never interrupts active match",function()
        local t=harness();local a,b,c=t.player(1),t.player(2),t.player(3)
        t.send(a,"challenge",{targetUserId=2});local id=t.lab:snapshot(b).challenge.inviteId
        t.send(a,"enter");t.send(c,"enter");local m=t.lab.sessions[1].match
        t.send(b,"challengeAccept",{inviteId=id});assert(t.lab:snapshot(b).active==false and t.lab.sessions[1].match==m)
        t.send(b,"challenge",{targetUserId=1});assert(t.lab:snapshot(b).challenge==nil)
        t.send(b,"challenge",{targetUserId=2});assert(t.lab:snapshot(b).challenge==nil)
        assert(m==t.lab.sessions[3].match and t.lab.sequence==1)
    end)
    test("challenge rematch decline returns both users to available hangar controls",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1);t.fight(a,b);t.finish(m,1)
        t.send(a,"rematch");t.send(b,"rematchDecline")
        assert(not t.lab:snapshot(a).active and not t.lab:snapshot(b).active)
        assert(not t.entered[1] and not t.entered[2] and t.lab.matches[m.id]==nil)
        t.send(a,"challenge",{targetUserId=2});assert(t.lab:snapshot(b).challenge.direction=="incoming")
    end)
    test("stale exit cannot forfeit a new rematch",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1);t.fight(a,b);t.finish(m,1)
        t.send(a,"rematch");t.send(b,"rematch");local nextMatch=t.lab.sessions[1].match
        t.send(a,"exit",{matchId=m.id});assert(t.lab.sessions[1].match==nextMatch and nextMatch.phase=="Pick")
    end)
    test("server stall cannot stretch a physical round beyond35 wall-clock seconds",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b)
        local deadline=m.fightDeadline
        t.time=deadline-2.2;t.lab:step(30)
        local snapshot=t.lab:snapshot(a)
        assert(snapshot.fightDeadline==deadline and t.lab:snapshot(b).fightDeadline==deadline)
        assert(snapshot.simulation.elapsed&lt;1 and math.ceil(snapshot.fightDeadline-snapshot.serverTime)==3,"Stale simulation obscured the authoritative deadline")
        m.simulation.fighters[1].armor=1;m.simulation.fighters[2].armor=2
        t.time=m.fightDeadline+.1;t.lab:step(35)
        assert(m.phase=="RoundOver" and m.roundResult.winner==2 and m.simulation.reason=="timeout" and m.simulation.elapsed==35)
        assert(m.fightSeconds==35 and m.completedRounds==1)
    end)
    test("shutdown aborts active matches clears reservations and preserves prior terminal results",function()
        local t=harness();local a,b,m=t.pair();t.fight(a,b);t.finish(m,1);t.advance(2.1)
        local c=t.player(3);t.send(c,"enter")
        t.lab:shutdown()
        assert(next(t.lab.sessions)==nil and next(t.lab.matches)==nil and #t.lab.queue==0)
        assert(not t.entered[1] and not t.entered[2] and not t.entered[3])
        assert(#t.terminal==2 and t.terminal[1].result.reason=="shutdown" and t.terminal[1].result.winner==0)
        t.lab:remove(a);t.lab:remove(b);assert(#t.terminal==2)
    end)
    return "BattleLab: "..count.." orchestration cases passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX25">
      <Properties>
        <string name="Name">SkillCatalogTests</string>
        <ProtectedString name="Source">-- Pure tests: require(thisModule)(SkillCatalog) in Studio or a Lua runtime.
return function(Catalog)
	local passed = 0
	local function check(value, message) assert(value, message) end
	local function test(name, callback)
		local ok, problem = pcall(callback)
		assert(ok, name .. ": " .. tostring(problem))
		passed = passed + 1
	end

	test("every skill has a kind and the copy a player reads", function()
		local seen = {}
		for _, entry in ipairs(Catalog.all()) do
			check(not seen[entry.id], "Duplicate id " .. tostring(entry.id))
			seen[entry.id] = true
			check(entry.kind == "offence" or entry.kind == "wild", "Unknown kind on " .. entry.id)
			for _, field in ipairs({ "name", "promise", "icon", "word", "rarity" }) do
				check(type(entry[field]) == "string" and #entry[field] &gt; 0, entry.id .. " lacks " .. field)
			end
			for _, channel in ipairs({ "r", "g", "b" }) do
				check(type(entry.color[channel]) == "number" and entry.color[channel] &gt;= 0 and entry.color[channel] &lt;= 255, entry.id .. " has a bad colour")
			end
			check(type(entry.starter) == "boolean", entry.id .. " lacks starter")
			if entry.kind == "offence" then
				check(type(entry.windupTell) == "string" and type(entry.attackTell) == "string", entry.id .. " lacks callouts")
			end
			check(entry.price == nil and entry.robux == nil and entry.power == nil, "Catalog carries a price or strength")
		end
	end)

	test("kinds filter and starters cover a full build", function()
		local offence, wild = Catalog.all("offence"), Catalog.all("wild")
		check(#offence + #wild == #Catalog.all() and #offence &gt;= 2 and #wild &gt;= 3, "Kind filter lost skills")
		for _, entry in ipairs(offence) do check(entry.kind == "offence", "Wrong kind in offence list") end
		for _, entry in ipairs(wild) do check(entry.kind == "wild", "Wrong kind in wild list") end
		check(#Catalog.starters("offence") &gt;= 1 and #Catalog.starters("wild") &gt;= Catalog.MAX_WILD, "Starters cannot fill a build")
		check(Catalog.valid(Catalog.DEFAULT_OFFENCE, "offence"), "Default offence is missing")
		check(Catalog.valid("Meteor") and Catalog.valid("Meteor", "offence") and not Catalog.valid("Meteor", "wild"), "Kind check failed")
		check(not Catalog.valid("Paid") and not Catalog.valid({}) and not Catalog.valid(nil) and Catalog.get("Paid") == nil, "Unknown id accepted")
	end)

	test("the public first-test roster is equal and excludes expansion", function()
		local wanted = { Meteor = true, Firework = true, MachineGun = true, Pinball = true,
			Afterburner = true, SpringBumper = true, FizzyFuel = true, Magnet = true, SecondWind = true }
		check(#Catalog.all("offence") == 4 and #Catalog.all("wild") == 5, "Approved roster changed")
		for _, entry in ipairs(Catalog.all()) do
			check(wanted[entry.id] and entry.starter, "Skill is gated or outside agreed roster")
		end
		check(not Catalog.valid("Copycat") and not Catalog.valid("Harpoon"), "Expansion leaked into active roster")
		check(Catalog.ROSTER_VERSION == "sky-battle-public-v1", "Roster has no version")
	end)

	test("records are detached from the catalog", function()
		for _, entry in ipairs(Catalog.all()) do
			local original = Catalog.get(entry.id)
			entry.name, entry.kind, entry.color.r = "mutated", "wild", -1
			local again = Catalog.get(entry.id)
			check(again.name == original.name and again.kind == original.kind and again.color.r == original.color.r, "UI edit reached the catalog")
		end
	end)

	test("a build is one offence and up to two different wild cards", function()
		local build = Catalog.build("Meteor", { "SpringBumper", "Afterburner" })
		check(build and build.offenceId == "Meteor" and #build.wildIds == 2, "Valid build rejected")
		check(build.wildIds[1] == "SpringBumper" and build.wildIds[2] == "Afterburner", "Pick order was not kept")
		local source = { "FizzyFuel" }
		local copy = Catalog.build("Firework", source)
		source[1] = "Afterburner"
		check(copy.wildIds[1] == "FizzyFuel", "Build shares the caller's table")
		check(#Catalog.build("Firework").wildIds == 0 and #Catalog.build("Firework", {}).wildIds == 0, "A build with no wild cards was rejected")
		local function refused(offence, wild, reason)
			local result, why = Catalog.build(offence, wild)
			check(result == nil and why == reason, "Expected " .. reason .. ", got " .. tostring(why))
		end
		refused("Unknown", {}, "offence")
		refused(nil, {}, "offence")
		refused("Afterburner", {}, "offence")
		refused("Meteor", { "Unknown" }, "wild")
		refused("Meteor", { "Firework" }, "wild")
		refused("Meteor", "Afterburner", "wild")
		refused("Meteor", { 5 }, "wild")
		refused("Meteor", { first = "Afterburner" }, "wild")
		refused("Meteor", { [2] = "Afterburner" }, "wild")
		refused("Meteor", { "Afterburner", "Afterburner" }, "duplicate")
		refused("Meteor", { "Afterburner", "SpringBumper", "FizzyFuel" }, "too many")
	end)

	return string.format("SkillCatalog: %d tests passed (copy, kinds, starters, detached records, build rules)", passed)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX26">
      <Properties>
        <string name="Name">PlaneCatalogTests</string>
        <ProtectedString name="Source">-- Pure catalog contract tests: require(thisModule)(PlaneCatalog).
return function(PlaneCatalog)
	local count, seen = 0, {}
	assert(PlaneCatalog.DEFAULT_ID == "cruiser" and #PlaneCatalog.ORDER == 3, "Starter catalog changed")
	for _, id in ipairs(PlaneCatalog.ORDER) do
		local plane = PlaneCatalog.get(id)
		assert(not seen[id] and plane.id == id and plane.available and plane.free, "Starter plane missing or unavailable")
		assert(PlaneCatalog.isSelectable(id) and type(plane.description) == "string" and plane.visualKey == id, "Plane metadata is incomplete")
		assert(plane.angle == plane.defaultAngle and plane.angle &gt;= 15 and plane.angle &lt;= 60 and plane.speed &gt; 0, "Invalid flight profile")
		seen[id] = true
		count = count + 1
	end
	local copied = PlaneCatalog.get("dart")
	copied.speed = 999
	copied.available = false
	assert(PlaneCatalog.get("dart").speed == 81 and PlaneCatalog.isSelectable("dart"), "Caller changed authoritative catalog")
	for _, id in ipairs({ "unknown", "Cruiser", "", 42, {} }) do
		assert(PlaneCatalog.get(id) == nil and not PlaneCatalog.isSelectable(id), "Invalid plane was selectable")
	end
	assert(not PlaneCatalog.isSelectable(nil) and PlaneCatalog.get(nil) == nil, "Missing plane was selectable")
	return tostring(count + 2) .. " PlaneCatalog tests passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX27">
      <Properties>
        <string name="Name">PowerCatalogTests</string>
        <ProtectedString name="Source">-- Pure catalog checks: require(thisModule)(PowerCatalog).
return function(PowerCatalog)
	local expected = { "Pinball", "Muncher", "Meteor" }
	local all = PowerCatalog.all()
	assert(PowerCatalog.DEFAULT_ID == "Pinball" and #all == #expected, "Round power roster changed")
	for index, id in ipairs(expected) do
		local power = PowerCatalog.get(id)
		assert(power and power.id == id and all[index].id == id, "Power is missing or draft order changed")
		assert(type(power.name) == "string" and #power.name &gt; 0 and #power.description &gt; 20 and #power.aimHint &gt; 15, "Choice lacks readable gameplay guidance")
		for _, channel in ipairs({ "r", "g", "b" }) do
			local value = power.color[channel]
			assert(type(value) == "number" and value &gt;= 0 and value &lt;= 255, "Power color is invalid")
		end
	end
	local copied = PowerCatalog.get("Pinball")
	copied.id, copied.color.r = "Meteor", -1
	all[1].name, all[1].color.g = "Changed", -1
	all[2] = nil
	assert(PowerCatalog.get("Pinball").id == "Pinball" and PowerCatalog.get("Pinball").color.r == 255, "get leaked a mutable catalog record")
	assert(PowerCatalog.all()[1].name == "Pinball" and PowerCatalog.all()[1].color.g == 218 and #PowerCatalog.all() == 3, "all leaked catalog state")
	for _, invalid in ipairs({ "", "pinball", "Shield", "Unknown", 1, true, {} }) do
		assert(PowerCatalog.get(invalid) == nil, "Invalid power ID was accepted")
	end
	assert(PowerCatalog.get(nil) == nil, "Missing power ID was accepted")
	return "6 PowerCatalog tests passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX28">
      <Properties>
        <string name="Name">CosmeticCatalogTests</string>
        <ProtectedString name="Source">-- Pure catalog contract checks; visuals must never alter flight parameters.
return function(CosmeticCatalog)
	local seen, cheapest = {}, math.huge
	local all = CosmeticCatalog.all()
	assert(#all == 9 and CosmeticCatalog.get(CosmeticCatalog.DEFAULT_ID).price == 0)
	for _, item in ipairs(all) do
		assert(not seen[item.id] and type(item.name) == "string" and type(item.description) == "string")
		assert(item.price &gt;= 0 and item.price % 1 == 0 and item.lifetime &gt; 0 and item.width &gt; 0)
		assert(item.speed == nil and item.power == nil and item.powerId == nil and item.gadget == nil)
		for _, color in ipairs({ item.color, item.secondaryColor }) do
			for _, channel in ipairs({ "r", "g", "b" }) do assert(color[channel] &gt;= 0 and color[channel] &lt;= 255) end
		end
		if item.price &gt; 0 then cheapest = math.min(cheapest, item.price) end
		seen[item.id] = true
	end
	assert(cheapest &lt;= CosmeticCatalog.PRACTICE_REWARD * 2, "First effect takes more than two completed practice flights")
	local copy = CosmeticCatalog.get("skyblue")
	copy.price = 0; copy.color.r = 0
	assert(CosmeticCatalog.get("skyblue").price == 40 and CosmeticCatalog.get("skyblue").color.r == 67)
	all[1].secondaryColor.r = 0
	assert(CosmeticCatalog.get("classic").secondaryColor.r == 160)
	for _, id in ipairs({ "", "unknown", "Skyblue", {}, 0, false }) do assert(CosmeticCatalog.get(id) == nil) end
	assert(CosmeticCatalog.get(nil) == nil)
	assert(CosmeticCatalog.get(CosmeticCatalog.BATTLE_GOAL_ID).price == CosmeticCatalog.BATTLE_COMPLETION_REWARD * 5)
    for _,id in ipairs(CosmeticCatalog.STARTER_CHOICES) do assert(CosmeticCatalog.get(id).earnedOnly and CosmeticCatalog.get(id).price==0) end
    return "11 CosmeticCatalog tests passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX29">
      <Properties>
        <string name="Name">PlayerStatsTests</string>
        <ProtectedString name="Source">-- Pure injected-store tests. No live Roblox DataStore is accessed.
return function(PlayerStats)
	local passed = 0
	local function test(name, callback)
		local ok, problem = pcall(callback)
		assert(ok, name .. ": " .. tostring(problem))
		passed = passed + 1
	end
	local function clone(value)
		if type(value) ~= "table" then return value end
		local copy = {}
		for key, child in pairs(value) do copy[key] = clone(child) end
		return copy
	end
	local function fakeStore()
		local store = { values = {}, calls = 0, failures = 0, commitErrors = 0, duplicateCallbacks = false }
		function store:UpdateAsync(key, transform)
			self.calls = self.calls + 1
			if self.failures &gt; 0 then self.failures = self.failures - 1; error("transient service error") end
			local value = transform(clone(self.values[key]))
			if self.duplicateCallbacks then value = transform(clone(self.values[key])) end
			if self.beforeCommit then local callback = self.beforeCommit; self.beforeCommit = nil; callback() end
			if value ~= nil then self.values[key] = clone(value) end
			if value ~= nil and self.commitErrors &gt; 0 then self.commitErrors = self.commitErrors - 1; error("response lost after commit") end
			if self.beforeReturn then local callback = self.beforeReturn; self.beforeReturn = nil; callback() end
			return clone(value)
		end
		return store
	end
	local function environment()
		return { time = 1000, waits = 0 }
	end
	local function service(store, id, env, extra)
		env = env or environment()
		local options = { store = store, sessionId = id or "server-A", clock = function() return env.time end,
			monotonic = function() return env.time end, wait = function(seconds) env.time = env.time + seconds; env.waits = env.waits + 1 end,
			spawn = function(callback) callback() end, jitter = function() return 0 end, leaseSeconds = 180, saveInterval = 45 }
		for key, value in pairs(extra or {}) do options[key] = value end
		return PlayerStats.new(options), env
	end
	local function flight(stats, handle, id, outcome, options)
		local input = { outcome = outcome or "win", distance = 500, completed = true }
		for key, value in pairs(options or {}) do input[key] = value end
		return stats:recordFlight(handle, id, input)
	end

	test("new profile acquires a lease and starts with zero statistics", function()
		local store = fakeStore(); local stats = service(store)
		local handle = stats:open(42)
		assert(select(2, stats:get(handle)) == "loading")
		assert(stats:load(handle))
		local data, status = stats:get(handle)
		assert(status == "saved" and data.totalFlights == 0 and data.bestDistance == 0)
		assert(store.values.player_42.lease.id == handle.token)
	end)

	test("human wins losses draws and best streak follow resolved outcomes", function()
		local stats = service(fakeStore()); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "one", "win")
		flight(stats, handle, "two", "draw", { distance = 600 })
		flight(stats, handle, "three", "win")
		local data, status = stats:get(handle)
		assert(data.wins == 2 and data.draws == 1 and data.currentStreak == 2 and data.bestStreak == 2)
		assert(data.bestDistance == 600 and data.totalFlights == 3 and status == "pending")
		flight(stats, handle, "four", "loss", { distance = 200 })
		data = stats:get(handle)
		assert(data.losses == 1 and data.currentStreak == 0 and data.bestStreak == 2)
	end)

	test("practice can improve distance but never a human record or streak", function()
		local stats = service(fakeStore()); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "duel", "win")
		flight(stats, handle, "practice", "loss", { practice = true, distance = 1000 })
		local data = stats:get(handle)
		assert(data.bestDistance == 1000 and data.totalFlights == 2 and data.practiceFlights == 1)
		assert(data.wins == 1 and data.losses == 0 and data.currentStreak == 1)
	end)

	test("forfeit resets streak and aborted flights cannot improve distance", function()
		local stats = service(fakeStore()); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "win", "win")
		flight(stats, handle, "forfeit", "win", { forfeit = true, distance = 9999 })
		flight(stats, handle, "opponent-left", "win", { completed = false, distance = 8888 })
		local data = stats:get(handle)
		assert(data.bestDistance == 500 and data.losses == 1 and data.wins == 2 and data.currentStreak == 1)
		flight(stats, handle, "practice-abort", "loss", { practice = true, forfeit = true, distance = 7777 })
		data = stats:get(handle)
		assert(data.losses == 1 and data.currentStreak == 1 and data.bestDistance == 500)
	end)

	test("duplicate finishes are idempotent in memory and after reconnect", function()
		local store = fakeStore(); local stats = service(store)
		local handle = stats:open(42); stats:load(handle)
		assert(flight(stats, handle, "round-1", "win"))
		assert(not flight(stats, handle, "round-1", "win"))
		assert(stats:close(handle))
		local nextStats = service(store, "server-B"); local nextHandle = nextStats:open(42); nextStats:load(nextHandle)
		assert(not flight(nextStats, nextHandle, "round-1", "win"))
		assert(nextStats:get(nextHandle).totalFlights == 1)
	end)

	test("load failures never overwrite an existing saved profile", function()
		local store = fakeStore(); local first = service(store)
		local handle = first:open(42); first:load(handle); flight(first, handle, "old", "win", { distance = 1500 }); first:close(handle)
		store.failures = 3
		local stats = service(store, "server-B"); local failed = stats:open(42)
		assert(not stats:load(failed) and select(2, stats:get(failed)) == "unavailable")
		local calls = store.calls
		flight(stats, failed, "unsaved", "loss", { distance = 2000 })
		assert(not stats:save(failed))
		stats:close(failed)
		assert(store.calls == calls and store.values.player_42.stats.bestDistance == 1500 and store.values.player_42.stats.wins == 1)
	end)

	test("unknown schema and corrupt data fail closed", function()
		local store = fakeStore()
		store.values.player_42 = { schemaVersion = 99, stats = { wins = 123 } }
		local stats = service(store); local handle = stats:open(42)
		assert(not stats:load(handle) and not stats:save(handle))
		assert(store.calls == 1 and store.values.player_42.schemaVersion == 99)
	end)

	test("bounded retries recover transient errors without double counting", function()
		local store = fakeStore(); store.failures = 2; store.duplicateCallbacks = true
		local stats, env = service(store); local handle = stats:open(42)
		assert(stats:load(handle) and store.calls == 3 and env.waits == 2)
		flight(stats, handle, "win", "win")
		store.commitErrors = 1
		assert(stats:save(handle))
		assert(store.values.player_42.stats.wins == 1 and store.values.player_42.stats.totalFlights == 1)
	end)

	test("ambiguous final-write response is recognized after releasing the lease", function()
		local store = fakeStore(); local stats = service(store); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "one", "win"); store.commitErrors = 1
		assert(stats:close(handle))
		assert(store.values.player_42.lease == nil and store.values.player_42.stats.totalFlights == 1)
	end)

	test("another server cannot load or overwrite an active session lease", function()
		local store, env = fakeStore(), environment()
		local first = service(store, "server-A", env); local a = first:open(42); first:load(a)
		flight(first, a, "first-win", "win"); first:save(a)
		local second = service(store, "server-B", env); local b = second:open(42)
		assert(not second:load(b) and select(2, second:get(b)) == "unavailable")
		flight(second, b, "unsafe", "win", { distance = 9999 })
		assert(not second:save(b) and store.values.player_42.stats.bestDistance == 500)
		assert(store.values.player_42.lease.id == a.token)
	end)

	test("expired lease takeover fences the old server even after new owner releases", function()
		local store, env = fakeStore(), environment()
		local first = service(store, "server-A", env); local a = first:open(42); first:load(a)
		flight(first, a, "a", "win"); first:save(a)
		env.time = env.time + 181
		local second = service(store, "server-B", env); local b = second:open(42); assert(second:load(b))
		flight(second, b, "b", "win", { distance = 1000 }); second:close(b)
		flight(first, a, "stale", "loss", { distance = 9000 })
		assert(not first:save(a) and not a.safe)
		assert(store.values.player_42.lease == nil and store.values.player_42.stats.wins == 2 and store.values.player_42.stats.bestDistance == 1000)
	end)

	test("newer local changes during a save remain pending for the next write", function()
		local store = fakeStore(); local stats = service(store); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "one", "win")
		store.beforeCommit = function() flight(stats, handle, "two", "win", { distance = 750 }) end
		assert(stats:save(handle))
		assert(store.values.player_42.stats.wins == 1 and stats:get(handle).wins == 2)
		assert(select(2, stats:get(handle)) == "pending")
		assert(stats:save(handle) and store.values.player_42.stats.wins == 2)
	end)

	test("outcomes during load are replayed on top of saved data exactly once", function()
		local store = fakeStore(); local first = service(store); local a = first:open(42); first:load(a)
		flight(first, a, "one", "win"); first:close(a)
		local stats = service(store, "server-B"); local handle = stats:open(42)
		store.beforeReturn = function()
			flight(stats, handle, "one", "win") -- Persisted receipt must suppress this on replay.
			flight(stats, handle, "two", "win", { distance = 800 })
		end
		assert(stats:load(handle))
		assert(stats:get(handle).wins == 2 and stats:get(handle).bestDistance == 800 and stats:get(handle).totalFlights == 2)
	end)

	test("save errors retry later but never claim unsaved changes were saved", function()
		local store = fakeStore(); local stats = service(store); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "one", "win"); store.failures = 3
		assert(not stats:save(handle) and select(2, stats:get(handle)) == "unavailable")
		assert(handle.safe and store.values.player_42.stats.wins == 0)
		assert(stats:save(handle) and select(2, stats:get(handle)) == "saved" and store.values.player_42.stats.wins == 1)
	end)

	test("autosave persists dirty data and renews an unchanged lease", function()
		local store, env = fakeStore(), environment()
		local stats = service(store, "server-A", env); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "one", "win")
		env.time = handle.nextSave + 1; stats:step()
		assert(store.values.player_42.stats.wins == 1 and select(2, stats:get(handle)) == "saved")
		local expires = store.values.player_42.lease.expiresAt
		env.time = handle.nextSave + 1; stats:step()
		assert(store.values.player_42.lease.expiresAt &gt; expires and store.values.player_42.stats.wins == 1)
	end)

	test("Studio session-only fallback makes zero store calls and states it honestly", function()
		local store = fakeStore(); local stats = service(store, "studio", nil, { sessionOnly = true })
		local handle = stats:open(42); assert(stats:load(handle))
		flight(stats, handle, "one", "win"); stats:save(handle); stats:step()
		assert(select(2, stats:get(handle)) == "session_only" and stats:get(handle).wins == 1)
		assert(stats:close(handle) and store.calls == 0)
	end)

	test("close during an in-flight load releases the eventual acquired lease", function()
		local store = fakeStore(); local stats = service(store); local handle = stats:open(42)
		store.beforeReturn = function() stats:close(handle, 0) end
		stats:load(handle)
		assert(handle.closed and store.values.player_42.lease == nil and next(stats.records) == nil)
	end)

	test("shutdown saves and releases all loaded handles", function()
		local store = fakeStore(); local stats = service(store)
		local a, b = stats:open(42), stats:open(43); stats:load(a); stats:load(b)
		flight(stats, a, "one", "win"); flight(stats, b, "two", "loss")
		assert(stats:shutdown(25) and next(stats.records) == nil)
		assert(store.values.player_42.lease == nil and store.values.player_43.lease == nil)
		assert(store.values.player_42.stats.wins == 1 and store.values.player_43.stats.losses == 1)
	end)

	test("shutdown waits for a leave-save already in progress", function()
		local store, env = fakeStore(), environment()
		local stats = service(store, "server-A", env); local handle = stats:open(42); stats:load(handle)
		handle.closing = true
		stats.wait = function(seconds)
			env.time = env.time + seconds; env.waits = env.waits + 1
			handle.closing = false; stats:close(handle)
		end
		assert(stats:shutdown(25) and env.waits &gt; 0 and store.values.player_42.lease == nil)
	end)

	test("public payload is detached and internal receipts stay bounded", function()
		local stats = service(fakeStore()); local handle = stats:open(42); stats:load(handle)
		for index = 1, 150 do flight(stats, handle, "round-" .. index, "win") end
		local public = stats:get(handle); public.wins = 0
		assert(stats:get(handle).wins == 150 and #handle.receipts &lt;= PlayerStats.RECEIPT_LIMIT)
		assert(public.lease == nil and public.receipts == nil and public.token == nil)
	end)

	test("v1 migration preserves statistics and receipts without retroactive currency", function()
		local store = fakeStore()
		store.values.player_42 = { schemaVersion = 1, stats = { wins = 7, bestDistance = 810, totalFlights = 7 }, receipts = { "legacy" } }
		local stats = service(store); local handle = stats:open(42); assert(stats:load(handle))
		local wallet = stats:getEconomy(handle)
		assert(stats:get(handle).wins == 7 and stats:get(handle).bestDistance == 810)
		assert(wallet.credits == 0 and wallet.owned.classic and wallet.equippedTrail == "classic" and wallet.canShop)
		assert(store.values.player_42.schemaVersion == PlayerStats.SCHEMA_VERSION and store.values.player_42.economy.credits == 0)
		local applied, reward = flight(stats, handle, "legacy", "win")
		assert(not applied and reward == 0 and stats:getEconomy(handle).credits == 0)
	end)

	test("only completed nonaborted flights award catalog rewards once", function()
		local stats = service(fakeStore()); local handle = stats:open(42); stats:load(handle)
		local ok, reward = flight(stats, handle, "practice", "win", { practice = true })
		assert(ok and reward == 25)
		local _, winReward = flight(stats, handle, "win", "win")
		local _, lossReward = flight(stats, handle, "loss", "loss")
		local _, drawReward = flight(stats, handle, "draw", "draw")
		assert(winReward == 60 and lossReward == 40 and drawReward == 50)
		for index, options in ipairs({ { forfeit = true }, { completed = false }, { aborted = true }, { practice = true, aborted = true } }) do
			local _, amount = flight(stats, handle, "aborted-" .. index, "win", options)
			assert(amount == 0)
		end
		local duplicate, amount = flight(stats, handle, "practice", "win", { practice = true })
		assert(not duplicate and amount == 0 and stats:getEconomy(handle).credits == 175)
	end)

	test("purchase debits once and equip requires ownership; both survive reconnect", function()
		local store = fakeStore(); local stats = service(store); local handle = stats:open(42); stats:load(handle)
		assert(stats:buyCosmetic(handle, "skyblue").code == "insufficient_credits")
		assert(stats:equipCosmetic(handle, "skyblue").code == "not_owned")
		flight(stats, handle, "one", "win", { practice = true }); flight(stats, handle, "two", "win", { practice = true })
		assert(stats:buyCosmetic(handle, "skyblue").code == "purchased")
		local wallet = stats:getEconomy(handle)
		assert(wallet.credits == 10 and wallet.owned.skyblue and wallet.equippedTrail == "classic")
		assert(stats:buyCosmetic(handle, "skyblue").code == "already_owned")
		assert(stats:getEconomy(handle).credits == 10)
		assert(stats:equipCosmetic(handle, "skyblue").code == "equipped")
		assert(stats:equipCosmetic(handle, "skyblue").code == "already_equipped")
		store.duplicateCallbacks = true; store.commitErrors = 1
		assert(stats:close(handle))
		local resumed = service(store, "server-B"); local nextHandle = resumed:open(42); assert(resumed:load(nextHandle))
		wallet = resumed:getEconomy(nextHandle)
		assert(wallet.credits == 10 and wallet.owned.skyblue and wallet.equippedTrail == "skyblue")
		assert(not flight(resumed, nextHandle, "two", "win", { practice = true }))
		assert(resumed:getEconomy(nextHandle).credits == 10)
	end)

	test("invalid identities and detached snapshots cannot alter wallet or ownership", function()
		local stats = service(fakeStore()); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "one", "win")
		for _, id in ipairs({ "", "unknown", "Skyblue", {}, 42, false }) do
			assert(stats:buyCosmetic(handle, id).code == "invalid_item")
			assert(stats:equipCosmetic(handle, id).code == "invalid_item")
		end
		assert(stats:buyCosmetic(handle, nil).code == "invalid_item")
		local wallet = stats:getEconomy(handle); wallet.credits = 9999; wallet.owned.sunset = true; wallet.equippedTrail = "sunset"
		wallet = stats:getEconomy(handle)
		assert(wallet.credits == 60 and not wallet.owned.sunset and wallet.equippedTrail == "classic")
	end)

	test("loading failed saves and closed records block economic changes", function()
		local store = fakeStore(); local stats = service(store); local handle = stats:open(42)
		assert(not stats:getEconomy(handle).canShop and stats:buyCosmetic(handle, "skyblue").code == "loading")
		stats:load(handle); flight(stats, handle, "one", "win")
		store.failures = 3; assert(not stats:save(handle))
		assert(not stats:getEconomy(handle).canShop and stats:buyCosmetic(handle, "skyblue").code == "unavailable")
		assert(stats:equipCosmetic(handle, "classic").code == "unavailable")
		assert(stats:getEconomy(handle).credits == 60 and not stats:getEconomy(handle).owned.skyblue)
		assert(stats:save(handle) and stats:getEconomy(handle).canShop)
		assert(stats:buyCosmetic(handle, "skyblue").ok and stats:close(handle))
		assert(not stats:equipCosmetic(handle, "skyblue").ok and not stats:buyCosmetic(handle, "ember").ok)
		assert(store.values.player_42.economy.credits == 20 and store.values.player_42.economy.owned.skyblue)
	end)

	test("failed load never grants purchases or overwrites an existing collection", function()
		local store = fakeStore(); local first = service(store); local a = first:open(42); first:load(a)
		flight(first, a, "one", "win"); first:buyCosmetic(a, "skyblue"); first:equipCosmetic(a, "skyblue"); first:close(a)
		store.failures = 3
		local nextStats = service(store, "server-B"); local b = nextStats:open(42); assert(not nextStats:load(b))
		flight(nextStats, b, "failed-session", "win")
		assert(not nextStats:buyCosmetic(b, "skyblue").ok and not nextStats:equipCosmetic(b, "skyblue").ok)
		nextStats:close(b)
		assert(store.values.player_42.economy.credits == 20 and store.values.player_42.economy.equippedTrail == "skyblue")
	end)

	test("malformed durable economies fail closed instead of resetting ownership", function()
		for _, corrupt in ipairs({
			{ credits = -1, owned = { classic = true }, equippedTrail = "classic" },
			{ credits = 1.5, owned = { classic = true }, equippedTrail = "classic" },
			{ credits = 0/0, owned = { classic = true }, equippedTrail = "classic" },
			{ credits = 1e15, owned = { classic = true }, equippedTrail = "classic" },
			{ credits = 100, owned = { classic = true }, equippedTrail = "sunset" },
			{ credits = 100, owned = { classic = true, unknown = true }, equippedTrail = "classic" },
			{ credits = 100, owned = { classic = true, skyblue = false }, equippedTrail = "classic" },
		}) do
			local store = fakeStore(); store.values.player_42 = { schemaVersion = 2, stats = {}, receipts = {}, economy = corrupt }
			local stats = service(store); local handle = stats:open(42)
			assert(not stats:load(handle) and store.calls == 1)
			assert(not stats:save(handle) and not stats:buyCosmetic(handle, "skyblue").ok)
		end
	end)

	test("currency and purchases arriving during a save stay pending together", function()
		local store = fakeStore(); local stats = service(store); local handle = stats:open(42); stats:load(handle)
		flight(stats, handle, "one", "win")
		store.beforeCommit = function()
			assert(stats:buyCosmetic(handle, "skyblue").ok)
			assert(stats:equipCosmetic(handle, "skyblue").ok)
			flight(stats, handle, "two", "win", { practice = true })
		end
		assert(stats:save(handle))
		assert(store.values.player_42.economy.credits == 60 and not store.values.player_42.economy.owned.skyblue)
		assert(stats:getEconomy(handle).credits == 45 and select(2, stats:get(handle)) == "pending")
		assert(stats:save(handle))
		assert(store.values.player_42.economy.credits == 45 and store.values.player_42.economy.equippedTrail == "skyblue")
	end)

	test("pending load rewards are merged with saved wallet and receipt deduplication", function()
		local store = fakeStore(); local first = service(store); local a = first:open(42); first:load(a)
		flight(first, a, "one", "win"); first:buyCosmetic(a, "skyblue"); first:close(a)
		local stats = service(store, "server-B"); local b = stats:open(42)
		store.beforeReturn = function()
			flight(stats, b, "one", "win"); flight(stats, b, "two", "win", { practice = true })
			assert(not stats:buyCosmetic(b, "skyblue").ok)
		end
		assert(stats:load(b))
		assert(stats:getEconomy(b).credits == 45 and stats:getEconomy(b).owned.skyblue)
	end)

	test("lease takeover fences old collection changes as one atomic record", function()
		local store, env = fakeStore(), environment()
		local first = service(store, "server-A", env); local a = first:open(42); first:load(a)
		flight(first, a, "one", "win"); first:save(a); env.time = env.time + 181
		local second = service(store, "server-B", env); local b = second:open(42); assert(second:load(b))
		second:buyCosmetic(b, "skyblue"); second:equipCosmetic(b, "skyblue"); second:close(b)
		first:buyCosmetic(a, "skyblue"); assert(not first:save(a) and not first:getEconomy(a).canShop)
		assert(store.values.player_42.economy.credits == 20 and store.values.player_42.economy.equippedTrail == "skyblue")
	end)

    local function battle(stats,handle,id,outcome,extra)
        local input={outcome=outcome or "loss",reason="first_to_two",completedRounds=2,fightSeconds=45,
            mode="public",offenceId="Meteor",wildIds={"SpringBumper"}}
        for key,value in pairs(extra or {})do input[key]=value end
        return stats:recordBattle(handle,id,input)
    end
    test("five battle losses reach separate250 goal with first choice and no combat grants",function()
        local stats=service(fakeStore(),"studio",nil,{sessionOnly=true});local h=stats:open(42);stats:load(h)
        for index=1,5 do
            local applied,reward=battle(stats,h,"battle-"..index,"loss")
            assert(applied and reward.coins==50 and reward.eligible and reward.status=="session_only" and not reward.confirmed)
        end
        local e=stats:getEconomy(h)
        assert(e.credits==250 and e.goal.price==250 and e.goal.remaining==0 and e.goal.id=="aurora")
        assert(e.progression.matches==5 and e.progression.losses==5 and e.progression.title=="Wingmate")
        assert(e.progression.mastery.Meteor==5 and e.progression.mastery.SpringBumper==5 and e.progression.starterAvailable)
        assert(e.skills==nil and e.ownedSkills==nil and stats:get(h).totalFlights==0)
        assert(stats:equipCosmetic(h,"aurora").code=="not_owned")
        assert(stats:claimStarter(h,"rookieblue").ok and stats:getEconomy(h).credits==250)
        assert(stats:buyCosmetic(h,"aurora").ok and stats:getEconomy(h).credits==0)
        assert(stats:buyCosmetic(h,"aurora").code=="already_owned" and stats:getEconomy(h).credits==0)
        assert(stats:equipCosmetic(h,"aurora").ok and stats:getEconomy(h).equippedTrail=="aurora")
    end)
    test("battle wins75 draws50 and losses50 use cosmetic-only mastery and streak",function()
        local stats=service(fakeStore());local h=stats:open(42);stats:load(h)
        local _,win=battle(stats,h,"win","win");local _,draw=battle(stats,h,"draw","draw")
        assert(win.coins==75 and draw.coins==50 and stats:getBattle(h).currentStreak==1)
        local _,loss=battle(stats,h,"loss","loss")
        assert(loss.coins==50 and stats:getEconomy(h).credits==175 and stats:getBattle(h).currentStreak==0)
        assert(stats:getBattle(h).bestStreak==1 and stats:getBattle(h).title=="Rookie")
        for index=4,15 do battle(stats,h,"more"..index,"loss")end
        assert(stats:getBattle(h).title=="Sky Rival" and stats:getBattle(h).nextTitleAt==nil)
    end)
    test("abandonment diagnostic instant-forfeit and unfinished caps pay nothing",function()
        local stats=service(fakeStore());local h=stats:open(42);stats:load(h)
        for index,extra in ipairs({{abandoned=true,reason="exit"},{diagnostic=true},{mode="experimental"},
            {reason="exit",completedRounds=0,fightSeconds=29.9},{reason="disconnect",completedRounds=0,fightSeconds=0},
            {reason="wall_cap",completedRounds=0,fightSeconds=35},{reason="unknown"}})do
            local applied,reward=battle(stats,h,"denied"..index,"win",extra)
            assert(applied and not reward.eligible and reward.coins==0)
        end
        assert(stats:getEconomy(h).credits==0 and stats:getBattle(h).matches==0 and not stats:getBattle(h).starterAvailable)
    end)
    test("exit and disconnect break a real streak without completion or mastery credit",function()
        for _,reason in ipairs({"exit","disconnect"})do
            local store=fakeStore();local stats=service(store);local h=stats:open(42);stats:load(h)
            battle(stats,h,"win","win")
            local _,reward=battle(stats,h,"quit","abandoned",{reason=reason,abandoned=true,completedRounds=0,fightSeconds=0})
            local b=stats:getBattle(h)
            assert(not reward.eligible and reward.coins==0 and b.currentStreak==0 and b.bestStreak==1)
            assert(b.matches==1 and b.wins==1 and b.losses==0 and b.mastery.Meteor==1)
            assert(stats:getEconomy(h).credits==75 and stats:close(h))
            local nextStats=service(store,"server-B");local restored=nextStats:open(42);assert(nextStats:load(restored))
            assert(nextStats:getBattle(restored).currentStreak==0)
            battle(nextStats,restored,"next-win","win")
            assert(not battle(nextStats,restored,"quit","abandoned",{reason=reason,abandoned=true}))
            assert(nextStats:getBattle(restored).currentStreak==1 and nextStats:getEconomy(restored).credits==150)
        end
    end)
    test("diagnostic quits and an opponent's early departure do not break a public streak",function()
        local stats=service(fakeStore());local h=stats:open(42);stats:load(h);battle(stats,h,"win","win")
        battle(stats,h,"diagnostic","abandoned",{reason="exit",abandoned=true,diagnostic=true})
        battle(stats,h,"experimental","abandoned",{reason="disconnect",abandoned=true,mode="experimental"})
        battle(stats,h,"opponent-left","win",{reason="exit",completedRounds=0,fightSeconds=0})
        assert(stats:getBattle(h).currentStreak==1 and stats:getBattle(h).matches==1 and stats:getEconomy(h).credits==75)
        local _,reward=battle(stats,h,"outcome-only","abandoned",{reason="exit"})
        assert(not reward.eligible and reward.coins==0 and stats:getBattle(h).currentStreak==0)
    end)
    test("remaining opponent qualifies after one complete round or30 combat seconds",function()
        local stats=service(fakeStore());local h=stats:open(42);stats:load(h)
        local _,one=battle(stats,h,"one","win",{reason="disconnect",completedRounds=1,fightSeconds=12})
        local _,two=battle(stats,h,"two","win",{reason="exit",completedRounds=0,fightSeconds=30})
        assert(one.coins==75 and two.coins==75 and one.reason=="opponent_departed" and two.eligible)
        assert(stats:getBattle(h).matches==2 and stats:getEconomy(h).credits==150)
    end)
    test("battle receipt deduplicates reward and mastery after reconnect",function()
        local store=fakeStore();local stats=service(store);local h=stats:open(42);stats:load(h)
        assert(battle(stats,h,"same","win"));assert(not battle(stats,h,"same","win"));assert(stats:close(h))
        local nextStats=service(store,"server-B");local nextHandle=nextStats:open(42);assert(nextStats:load(nextHandle))
        local applied,reward=battle(nextStats,nextHandle,"same","win")
        assert(not applied and reward.coins==0 and reward.duplicate and stats:getEconomy(h).credits==75)
        assert(nextStats:getBattle(nextHandle).matches==1 and nextStats:getBattle(nextHandle).mastery.Meteor==1)
    end)
    test("first reward claims exactly once without debit and persists choice equipment and goal",function()
        local store=fakeStore();local stats=service(store);local h=stats:open(42);stats:load(h)
        assert(stats:claimStarter(h,"rookieblue").code=="not_earned")
        assert(stats:buyCosmetic(h,"rookieblue").code=="earned_only")
        battle(stats,h,"first","loss")
        assert(stats:claimStarter(h,"sunset").code=="invalid_item")
        assert(stats:claimStarter(h,"rookiecoral").ok)
        assert(stats:claimStarter(h,"rookieblue").code=="already_claimed")
        assert(not stats:getEconomy(h).owned.rookieblue and stats:getEconomy(h).credits==50)
        assert(stats:selectGoal(h,"skyblue").ok and stats:selectGoal(h,"rookieblue").code=="invalid_goal")
        assert(stats:selectGoal(h,"classic").code=="invalid_goal")
        assert(stats:close(h))
        local nextStats=service(store,"server-B");local nextHandle=nextStats:open(42);nextStats:load(nextHandle)
        local e=nextStats:getEconomy(nextHandle)
        assert(e.owned.rookiecoral and e.equippedTrail=="rookiecoral" and e.progression.starterChoice=="rookiecoral")
        assert(not e.progression.starterAvailable and e.goal.id=="skyblue" and e.progression.confirmed)
    end)
    test("schema2 migration preserves earned wallet cosmetics stats and receipts",function()
        local store=fakeStore();store.values.player_42={schemaVersion=2,stats={wins=7,totalFlights=9},receipts={"legacy"},
            economy={credits=123,owned={classic=true,skyblue=true},equippedTrail="skyblue"}}
        local stats=service(store);local h=stats:open(42);assert(stats:load(h))
        local e=stats:getEconomy(h)
        assert(e.credits==123 and e.owned.skyblue and e.equippedTrail=="skyblue" and stats:get(h).wins==7)
        assert(e.progression.matches==0 and e.goal.id=="aurora" and not e.progression.starterAvailable)
        assert(not battle(stats,h,"legacy","loss"));assert(stats:close(h))
        assert(store.values.player_42.schemaVersion==3 and store.values.player_42.battle.matches==0)
    end)
    test("battle completion while profile loading merges exactly once into durable record",function()
        local store=fakeStore();local old=service(store);local h=old:open(42);old:load(h);battle(old,h,"old","win");old:close(h)
        local stats=service(store,"server-B");local nextHandle=stats:open(42)
        battle(stats,nextHandle,"new","loss");assert(stats:getEconomy(nextHandle).credits==50)
        assert(stats:load(nextHandle));assert(stats:getEconomy(nextHandle).credits==125 and stats:getBattle(nextHandle).matches==2)
        assert(not battle(stats,nextHandle,"new","loss"));assert(stats:save(nextHandle))
        assert(store.values.player_42.economy.credits==125 and store.values.player_42.battle.mastery.Meteor==2)
    end)
    test("failed battle save stays explicitly unconfirmed and retry saves a single grant",function()
        local store=fakeStore();local stats=service(store);local h=stats:open(42);stats:load(h)
        local _,reward=battle(stats,h,"one","loss");assert(reward.status=="pending" and not reward.confirmed)
        store.failures=3;assert(not stats:save(h))
        assert(stats:getBattle(h).status=="unavailable" and not stats:getBattle(h).confirmed)
        assert(stats:claimStarter(h,"rookieblue").code=="unavailable")
        assert(store.values.player_42.economy.credits==0 and not battle(stats,h,"one","loss"))
        assert(stats:save(h) and stats:getBattle(h).confirmed and store.values.player_42.economy.credits==50)
    end)
    test("failed initial load cannot overwrite confirmed battle rewards or cosmetics",function()
        local store=fakeStore();local old=service(store);local h=old:open(42);old:load(h);battle(old,h,"old","win")
        old:claimStarter(h,"rookieblue");old:close(h);store.failures=3
        local stats=service(store,"server-B");local failed=stats:open(42);assert(not stats:load(failed))
        local calls=store.calls;battle(stats,failed,"unsafe","loss")
        assert(not stats:getBattle(failed).confirmed and stats:claimStarter(failed,"rookiecoral").code=="unavailable")
        assert(not stats:save(failed));stats:close(failed);assert(store.calls==calls)
        assert(store.values.player_42.economy.credits==75 and store.values.player_42.economy.owned.rookieblue)
    end)
    test("initial-load recovery replays pending awards once over saved rewards and cosmetics",function()
        local store,env=fakeStore(),environment();local old=service(store,"server-A",env)
        local h=old:open(42);old:load(h);battle(old,h,"old","win");old:claimStarter(h,"rookieblue");old:close(h)
        local stats=service(store,"server-B",env);local recovering=stats:open(42)
        battle(stats,recovering,"old","win") -- Durable receipt must win over optimistic replay.
        store.failures=3;assert(not stats:load(recovering))
        battle(stats,recovering,"during-outage","loss")
        assert(not stats:save(recovering) and not stats:getEconomy(recovering).canShop)
        assert(store.values.player_42.economy.credits==75 and store.values.player_42.battle.matches==1)
        local calls=store.calls;env.time=recovering.loadRetryAt-1;stats:step()
        assert(store.calls==calls and not stats:load(recovering))
        store.duplicateCallbacks=true
        store.beforeReturn=function()battle(stats,recovering,"during-retry","win")end
        env.time=recovering.loadRetryAt;stats:step()
        local e=stats:getEconomy(recovering)
        assert(recovering.loaded and recovering.safe and #recovering.pending==0 and e.canShop)
        assert(e.credits==200 and e.progression.matches==3 and e.progression.mastery.Meteor==3)
        assert(e.owned.rookieblue and e.equippedTrail=="rookieblue" and not e.progression.starterAvailable)
        assert(e.progression.status=="pending" and not e.progression.confirmed and store.values.player_42.economy.credits==75)
        env.time=env.time+1;stats:step()
        assert(stats:getBattle(recovering).confirmed and store.values.player_42.economy.credits==200)
        assert(not battle(stats,recovering,"during-outage","loss"))
        assert(stats:close(recovering))
        local nextStats=service(store,"server-C",env);local restored=nextStats:open(42);assert(nextStats:load(restored))
        assert(nextStats:getEconomy(restored).credits==200 and nextStats:getBattle(restored).matches==3)
    end)
    test("locked initial load retries after lease expiry and fences the former owner",function()
        local store,env=fakeStore(),environment();local first=service(store,"owner",env)
        local a=first:open(42);first:load(a);battle(first,a,"saved-win","win");first:save(a)
        local stats=service(store,"returning",env);local h=stats:open(42)
        assert(not stats:load(h));battle(stats,h,"offline-loss","loss")
        env.time=h.loadRetryAt;stats:step()
        assert(not h.safe and store.values.player_42.lease.id==a.token and store.values.player_42.economy.credits==75)
        env.time=store.values.player_42.lease.expiresAt+1;stats:step()
        assert(h.safe and h.loaded and stats:getEconomy(h).credits==125 and stats:getBattle(h).currentStreak==0)
        assert(stats:save(h) and store.values.player_42.lease.id==h.token)
        battle(first,a,"stale","win");assert(not first:save(a))
        local calls=store.calls;env.time=env.time+300;first:step()
        assert(not first:load(a) and store.calls==calls and store.values.player_42.economy.credits==125)
    end)
    test("initial-load backoff is capped and cannot be bypassed by repeated load calls",function()
        local store,env=fakeStore(),environment();store.failures=100
        local stats=service(store,"retry",env,{maxAttempts=1});local h=stats:open(42)
        assert(not stats:load(h))
        for _,delay in ipairs({5,10,20,40,60,60})do
            assert(h.loadRetryAt-env.time==delay)
            local calls=store.calls
            assert(not stats:load(h));stats:step();assert(store.calls==calls and not h.safe)
            env.time=h.loadRetryAt;stats:step();assert(store.calls==calls+1)
        end
        assert(not stats:save(h) and store.values.player_42==nil)
    end)
    test("corrupt profiles and closed recovery handles never resume writes",function()
        local store,env=fakeStore(),environment();store.values.player_42={schemaVersion=99,stats={wins=3}}
        local stats=service(store,"corrupt",env);local h=stats:open(42);assert(not stats:load(h))
        battle(stats,h,"pending","loss");local calls=store.calls
        env.time=env.time+300;stats:step()
        assert(not stats:load(h) and not stats:save(h) and store.calls==calls and store.values.player_42.schemaVersion==99)
        local store2=fakeStore();store2.failures=3
        local retry=service(store2,"closed",env);local closed=retry:open(43);assert(not retry:load(closed))
        calls=store2.calls;retry:close(closed);env.time=env.time+300;retry:step()
        assert(not retry:load(closed) and store2.calls==calls and store2.values.player_43==nil)
    end)
    test("quit recorded during unavailable load resets the recovered saved streak",function()
        local store,env=fakeStore(),environment();local old=service(store,"old",env)
        local a=old:open(42);old:load(a);battle(old,a,"win","win");old:close(a)
        store.failures=3;local stats=service(store,"returning",env);local h=stats:open(42);assert(not stats:load(h))
        battle(stats,h,"quit","abandoned",{reason="disconnect",abandoned=true})
        env.time=h.loadRetryAt;stats:step();assert(stats:save(h))
        local saved=store.values.player_42
        assert(saved.battle.currentStreak==0 and saved.battle.bestStreak==1 and saved.battle.matches==1)
        assert(saved.economy.credits==75 and saved.battle.mastery.Meteor==1)
    end)
    test("ambiguous committed reward write and duplicate store callbacks never duplicate",function()
        local store=fakeStore();store.duplicateCallbacks=true
        local stats=service(store);local h=stats:open(42);stats:load(h);battle(stats,h,"one","win")
        stats:claimStarter(h,"rookieblue");store.commitErrors=1;assert(stats:close(h))
        assert(store.values.player_42.economy.credits==75 and store.values.player_42.battle.matches==1)
        assert(store.values.player_42.economy.owned.rookieblue and store.values.player_42.lease==nil)
    end)
    test("claim concurrent with save remains pending and is preserved on next flush",function()
        local store=fakeStore();local stats=service(store);local h=stats:open(42);stats:load(h);battle(stats,h,"first","loss")
        store.beforeCommit=function()assert(stats:claimStarter(h,"rookiecoral").ok)end
        assert(stats:save(h));assert(stats:getBattle(h).status=="pending" and not store.values.player_42.economy.owned.rookiecoral)
        assert(stats:save(h));assert(store.values.player_42.economy.owned.rookiecoral and stats:getBattle(h).confirmed)
    end)
    test("corrupt new mastery or unbacked starter choice cannot erase an old record",function()
        for _,corrupt in ipairs({"mastery","starter"})do
            local store=fakeStore();local old=service(store);local h=old:open(42);old:load(h);battle(old,h,"one","loss");old:close(h)
            if corrupt=="mastery"then store.values.player_42.battle.mastery.Copycat=99
            else store.values.player_42.battle.starterAvailable=false;store.values.player_42.battle.starterChoice="rookieblue"end
            local stats=service(store,"server-B");local broken=stats:open(42);assert(not stats:load(broken))
            assert(not stats:save(broken) and store.values.player_42.economy.credits==50)
        end
    end)
    test("invalid terminal inputs do not mutate receipts wallet or mastery",function()
        local stats=service(fakeStore());local h=stats:open(42);stats:load(h)
        for _,extra in ipairs({{completedRounds=6},{fightSeconds=0/0},{offenceId="Copycat"},
            {wildIds={"SpringBumper","SpringBumper"}},{wildIds={bad="Afterburner"}},{outcome="invented"}})do
            assert(not battle(stats,h,"bad","loss",extra))
        end
        assert(stats:getEconomy(h).credits==0 and stats:getBattle(h).matches==0 and #h.receipts==0)
    end)

	return tostring(passed) .. " player-stats tests passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX30">
      <Properties>
        <string name="Name">TelemetryTests</string>
        <ProtectedString name="Source">-- Pure tests: require(thisModule)(Telemetry). All service calls use doubles.
return function(Telemetry)
	local passed = 0
	local function test(name, callback)
		local ok, problem = pcall(callback)
		assert(ok, name .. ": " .. tostring(problem))
		passed = passed + 1
	end
	local function fixture(overrides)
		local calls, time = {}, {value = 10}
		local analytics = {LogCustomEvent = function(_, player, name, value, fields)
			table.insert(calls, {player = player, name = name, value = value, fields = fields})
		end}
		local options = {enabled = true, isStudio = false, analytics = analytics, clock = function() return time.value end}
		for key, value in pairs(overrides or {}) do options[key] = value end
		return Telemetry.new(options), calls, time
	end

	test("disabled by default and in Studio", function()
		local calls = 0
		local analytics = {LogCustomEvent = function() calls = calls + 1 end}
		local disabled = Telemetry.new({analytics = analytics, isStudio = false})
		local studio = Telemetry.new({enabled = true, analytics = analytics, isStudio = true})
		assert(not disabled:sessionStart({}) and not studio:sessionStart({}))
		assert(calls == 0)
	end)

	test("environment detection fails closed", function()
		local telemetry, calls = fixture({isStudio = function() error("unavailable") end})
		assert(not telemetry:sessionStart({}) and #calls == 0)
	end)

	test("lifecycle counts, durations and duplicate suppression", function()
		local telemetry, calls, time = fixture()
		local player = {}
		assert(telemetry:sessionStart(player))
		assert(not telemetry:sessionStart(player))
		assert(telemetry:queueStart(player) and not telemetry:queueStart(player))
		time.value = 15
		assert(telemetry:matchStart(player, false) and not telemetry:matchStart(player, false))
		time.value = 40
		assert(telemetry:matchComplete(player, "win", false))
		assert(not telemetry:matchComplete(player, "win", false))
		assert(calls[4].name == "MatchCompleted" and calls[4].fields.CustomField02 == "win")
		assert(calls[5].name == "MatchDurationSeconds" and calls[5].value == 25)
		assert(telemetry:rematch(player) and not telemetry:rematch(player))
		time.value = 50
		assert(telemetry:sessionEnd(player) and not telemetry:sessionEnd(player))
		assert(calls[7].name == "SessionDurationSeconds" and calls[7].value == 40)
		assert(not telemetry:queueStart(player) and not telemetry:matchStart(player, true))
	end)

	test("practice and rematch use the original launch mode", function()
		local telemetry, calls = fixture()
		local player = {}
		telemetry:sessionStart(player)
		assert(not telemetry:rematch(player) and not telemetry:matchComplete(player, "win", false))
		telemetry:matchStart(player, true)
		telemetry:matchComplete(player, "loss", false)
		telemetry:rematch(player)
		assert(calls[2].fields.CustomField01 == "practice")
		assert(calls[3].fields.CustomField01 == "practice" and calls[5].fields.CustomField01 == "practice")
		assert(telemetry:matchStart(player, false))
		telemetry:matchComplete(player, "tie", false)
		assert(telemetry:rematch(player))
	end)

	test("arbitrary identifiers never enter the fixed schema", function()
		local telemetry, calls = fixture()
		local player = {Name = "private name", UserId = 987654321}
		telemetry:sessionStart(player)
		telemetry:matchStart(player, false)
		telemetry:matchComplete(player, player.Name, false)
		telemetry:phaseAbandoned(player, "secret match ID")
		assert(calls[3].fields.CustomField02 == "unknown")
		assert(calls[5].fields.CustomField03 == "Unknown")
		for _, call in ipairs(calls) do
			assert(call.player == player)
			for key, value in pairs(call.fields or {}) do
				assert(key == "CustomField01" or key == "CustomField02" or key == "CustomField03")
				assert(type(value) == "string" and value ~= player.Name and value ~= tostring(player.UserId))
			end
		end
	end)

	test("abandonment clears queue and flight state", function()
		local telemetry, calls = fixture()
		local player = {}
		telemetry:sessionStart(player)
		telemetry:queueStart(player)
		assert(telemetry:phaseAbandoned(player, "Queued"))
		assert(not telemetry:phaseAbandoned(player, "Queued"))
		assert(telemetry:queueStart(player))
		assert(telemetry:phaseAbandoned(player, "Aim"))
		assert(calls[#calls].fields.CustomField03 == "Aim")
		telemetry:matchStart(player, false)
		assert(telemetry:phaseAbandoned(player, "Flight"))
		assert(not telemetry:matchComplete(player, "win", false) and not telemetry:rematch(player))
		assert(telemetry:matchStart(player, false))
	end)

	test("service failures cannot propagate or cause retries", function()
		local attempts = 0
		local telemetry = fixture({analytics = {LogCustomEvent = function()
			attempts = attempts + 1
			error("service error")
		end}})
		local player = {}
		assert(not telemetry:sessionStart(player))
		assert(not telemetry:sessionStart(player) and attempts == 1)
		telemetry:matchStart(player, false)
		telemetry:matchComplete(player, "win", false)
		telemetry:sessionEnd(player)
		assert(attempts == 5 and telemetry._sessionCount == 0)
	end)

	test("per-player rolling rate limit expires and remains bounded", function()
		local telemetry, calls, time = fixture()
		local player = {}
		telemetry:sessionStart(player)
		for _ = 1, 100 do telemetry:queueStart(player); telemetry:phaseAbandoned(player, "Queued") end
		assert(#calls == 16 and #telemetry._sessions[player].events == 16)
		time.value = 70
		assert(telemetry:queueStart(player))
		assert(#calls == 17 and #telemetry._sessions[player].events == 1)
	end)

	test("server rolling rate limit survives session churn", function()
		local telemetry, calls = fixture()
		for _ = 1, 500 do local player = {}; telemetry:sessionStart(player); telemetry:sessionEnd(player) end
		assert(#calls == 112 and #telemetry._events == 112 and telemetry._sessionCount == 0)
	end)

	test("session storage is capped and released on departure", function()
		local telemetry = fixture()
		local players = {}
		for i = 1, 300 do players[i] = {}; telemetry:sessionStart(players[i]) end
		assert(telemetry._sessionCount == 256 and not telemetry._sessions[players[257]])
		telemetry:sessionEnd(players[1])
		telemetry:sessionStart(players[257])
		assert(telemetry._sessionCount == 256 and telemetry._sessions[players[257]])
	end)

	test("invalid clocks cannot propagate or prevent cleanup", function()
		local telemetry, calls, time = fixture()
		local player = {}
		telemetry:sessionStart(player)
		time.value = 0 / 0
		assert(not telemetry:matchStart(player, false))
		assert(not telemetry:sessionEnd(player) and telemetry._sessionCount == 0)
		assert(#calls == 1)
		local broken = fixture({clock = function() error("clock failed") end})
		assert(not broken:sessionStart({}))
	end)

	test("durations remain finite and nonnegative across clock regression", function()
		local telemetry, calls, time = fixture()
		local player = {}
		telemetry:sessionStart(player)
		telemetry:matchStart(player, false)
		time.value = -50
		telemetry:matchComplete(player, "completed", false)
		assert(calls[4].value == 0)
		time.value = 100000
		telemetry:sessionEnd(player)
		assert(calls[5].value == 86400)
	end)
    test("battle funnel counts actual launches not replay requests", function()
        local telemetry,calls,time=fixture()
        local player={}
        telemetry:sessionStart(player)
        assert(telemetry:battleEvent(player,"join",{cohort="new"}))
        assert(telemetry:battleEvent(player,"usable_lobby",{device="phone"}))
        time.value=18
        assert(telemetry:battleEvent(player,"first_launch",{matchId="a"}))
        assert(not telemetry:battleEvent(player,"first_launch",{matchId="a"}))
        time.value=80
        telemetry:battleEvent(player,"terminal_result",{matchId="a",outcome="loss"})
        telemetry:battleEvent(player,"replay_requested",{matchId="a"})
        local count=#telemetry:battleLog()
        assert(telemetry:battleLog()[count].event=="replay_requested")
        time.value=90
        telemetry:battleEvent(player,"first_launch",{matchId="b",rosterVersion="experimental-test"})
        local log=telemetry:battleLog()
        assert(log[#log-1].event=="next_actual_launch" and log[#log-1].elapsed==10)
        assert(log[#log-1].outcome=="loss" and log[#log-1].voluntary==true)
        assert(log[#log-1].rosterVersion=="experimental-test")
        assert(log[#log].event=="match_launch" and log[#log].firstLaunchSeconds==nil)
        assert(log[3].firstLaunchSeconds==8 and log[3].device=="phone")
        telemetry:battleLeave(player)
        assert(telemetry._battle[player]==nil)
    end)
    test("Studio diagnostic events are bounded and never submitted", function()
        local telemetry,calls=fixture({isStudio=true})
        local player={}
        for i=1,300 do telemetry:battleEvent(player,"match_accepted",{matchId=i}) end
        assert(#telemetry:battleLog()==256 and #calls==0)
        assert(telemetry:battleLog()[1].developer==true)
        assert(not telemetry:battleEvent(player,"arbitrary_event",{}))
    end)
	return string.format("Telemetry: %d tests passed", passed)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX31">
      <Properties>
        <string name="Name">FlightAudioTests</string>
        <ProtectedString name="Source">-- Regression checks for the two-pilot event mix. No real sound is emitted.
return function(Audio)
    local passed=0
    local function test(name,body)
        local ok,problem=pcall(body)
        assert(ok,name..": "..tostring(problem)); passed+=1
    end
    local function fixture(realEvents)
        local calls,attributes={},{}
        local mix=setmetatable({voices={},tweens={},tracks={},played=0,ghostPlayed=0,humanPlayed=0,
            group={Volume=.75},folder={SetAttribute=function(_,key,value) attributes[key]=value end}},Audio)
        if realEvents then
            mix.voice=function(_,name,volume,pitch) table.insert(calls,{name=name,volume=volume,pitch=pitch}) end
        else
            mix.playEvent=function(_,event,gain,pitch,track,pilot)
                table.insert(calls,{kind=event.kind,serial=event.serial,gain=gain,userId=pilot.userId})
            end
        end
        return mix,calls,attributes
    end
    local function pilot(id,bot,elapsed,serial,kind)
        return {userId=id,bot=bot,flight={elapsed=elapsed,
            recentEvents={{serial=serial,kind=kind or "fuel",at=elapsed,value=10}}}}
    end

    test("ghost contacts play while the camera follows the human",function()
        local mix,calls=fixture()
        mix:update({pilot(1,false,0,1,"launch"),pilot(-1,true,0,1,"launch")},"round1",1,true)
        mix:update({pilot(1,false,.3,2),pilot(-1,true,.3,2)},"round1",1,true)
        assert(#calls==4 and calls[4].userId==-1 and calls[4].gain==.65)
    end)
    test("camera switches preserve both cursors and update the mix",function()
        local mix,calls=fixture()
        local players={pilot(1,false,0,1),pilot(-1,true,0,1)}
        mix:update(players,"round1",1,true)
        mix:update(players,"round1",-1,true)
        assert(#calls==2,"camera replayed history")
        players[2]=pilot(-1,true,.2,2,"missile")
        mix:update(players,"round1",-1,true)
        assert(#calls==3 and calls[3].gain==1 and calls[3].kind=="missile")
    end)
    test("independent serials cannot suppress a rival event",function()
        local mix,calls=fixture()
        mix:update({pilot(1,false,0,10),pilot(-1,true,0,1)},"round1",1,true)
        mix:update({pilot(1,false,.2,10),pilot(-1,true,.2,2)},"round1",1,true)
        assert(#calls==3 and calls[3].userId==-1)
    end)
    test("late entry skips history but plays the next contact",function()
        local mix,calls=fixture()
        local players={pilot(1,false,12,20),pilot(-1,true,12,22)}
        mix:update(players,"round1",1,true);assert(#calls==0)
        players[2]=pilot(-1,true,12.2,23)
        mix:update(players,"round1",1,true);assert(#calls==1 and calls[1].serial==23)
    end)
    test("stale events are not replayed and round changes reset cursors",function()
        local mix,calls=fixture()
        local players={pilot(1,false,0,1)}
        mix:update(players,"round1",1,true)
        players[1].flight.elapsed=2
        players[1].flight.recentEvents={{kind="fuel",at=.1,serial=2}}
        mix:update(players,"round1",1,true);assert(#calls==1)
        mix:update({pilot(1,false,0,1)},"round2",1,true);assert(#calls==2)
    end)
    test("cooldowns do not mute simultaneous own and ghost pickups",function()
        local mix,calls,attrs=fixture(true)
        mix:update({pilot(1,false,0,1),pilot(-1,true,0,1)},"round1",1,true)
        assert(#calls==4,"one pilot suppressed the other")
        assert(attrs.GhostEvents==1 and attrs.HumanEvents==1)
        assert(calls[3].volume&gt;0 and calls[3].volume&lt;calls[1].volume)
        assert(calls[3].pitch&lt;calls[1].pitch,"ghost voice should be distinguishable")
    end)
    test("leaving stops voices and retires cursors",function()
        local mix=fixture()
        local stopped,cancelled=0,0
        mix.voices={test={{Stop=function() stopped+=1 end}}}
        mix.tweens={test={Cancel=function() cancelled+=1 end}}
        mix:update({pilot(1,false,0,1),pilot(-1,true,0,1)},"round1",1,true)
        stopped,cancelled=0,0
        mix:update({},"round1",1,false)
        assert(mix.key==nil and next(mix.tracks)==nil and stopped==1 and cancelled==1)
    end)
    test("the mix retains at most two pilots",function()
        local mix,calls=fixture()
        mix:update({pilot(1,false,0,1),pilot(-1,true,0,1),pilot(3,false,0,1)},"round1",1,true)
        assert(#calls==2 and mix.tracks["3"]==nil)
        mix:update({pilot(1,false,.1,1)},"round1",1,true)
        assert(mix.tracks["-1"]==nil)
    end)
    test("power cues mix both pilots and do not replay on camera switches",function()
        local mix,calls,attrs=fixture(true)
        local players={pilot(1,false,0,1,"pinball"),pilot(-1,true,0,1,"munch")}
        mix:update(players,"round1",1,true)
        assert(#calls==6 and attrs.PlayedEvents==2)
        assert(calls[1].name=="boing" and calls[4].name=="land","powers lost their distinct cues")
        mix:update(players,"round1",-1,true)
        assert(#calls==6,"power history replayed after switching cameras")
        players[1]=pilot(1,false,.2,2,"meteorDive")
        players[2]=pilot(-1,true,.2,2,"meteorBoost")
        mix:update(players,"round1",-1,true)
        assert(#calls==11 and attrs.GhostEvents==2 and attrs.HumanEvents==2)
        assert(calls[7].name=="jump" and calls[9].name=="boom")
    end)
    test("mute silences active voices and consumes power event history",function()
        local mix,calls=fixture(true)
        local stopped,cancelled=0,0
        mix.voices={test={{Stop=function() stopped+=1 end}}}
        mix.tweens={test={Cancel=function() cancelled+=1 end}}
        mix:update({pilot(1,false,0,1,"pinball")},"round1",1,true)
        local before=#calls
        mix:setMuted(true)
        assert(stopped&gt;=1 and cancelled&gt;=1 and mix.group.Volume==0)
        local players={pilot(1,false,.2,2,"munch")}
        mix:update(players,"round1",1,true)
        mix:playSelection("Meteor",true)
        assert(#calls==before,"muted action emitted a voice")
        mix:setMuted(false)
        mix:update(players,"round1",1,true)
        assert(#calls==before,"unmute replayed a muted event")
        players[1]=pilot(1,false,.3,3,"meteorBoost")
        mix:update(players,"round1",1,true)
        assert(#calls==before+3 and mix.group.Volume==.75)
    end)
    test("selection is explicit and rapid duplicate callbacks are suppressed",function()
        local mix,calls,attrs=fixture(true)
        mix:playSelection("unknown",true);assert(#calls==0)
        mix:playSelection("Pinball",false);assert(#calls==1)
        mix:playSelection("Pinball",false);assert(#calls==1)
        mix:playSelection("Pinball",true);assert(#calls==3)
        mix:playSelection("Pinball",true);assert(#calls==3)
        mix:playSelection("Muncher",false);assert(#calls==5)
        assert(attrs.LastSelection=="Muncher" and attrs.SelectionConfirmed==false)
        assert(mix.key==nil and next(mix.tracks)==nil,"selection changed flight cursors")
    end)
    return tostring(passed).." flight-audio tests passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX32">
      <Properties>
        <string name="Name">BattleAudioTests</string>
        <ProtectedString name="Source">-- Cursor, mixing and lifecycle checks without loading or playing real sounds.
return function(Audio)
    local passed=0
    local function test(name,body)
        local ok,problem=pcall(body)
        assert(ok,name..": "..tostring(problem)); passed=passed+1
    end
    local function fixture()
        local calls,attributes={},{}
        local folder={Parent=true,destroyed=0}
        function folder:SetAttribute(key,value) attributes[key]=value end
        function folder:Destroy() self.destroyed=self.destroyed+1; self.Parent=nil end
        local mix=setmetatable({voices={},nextVoice={},tweens={},lastAt={},lastSerial=0,
            key=nil,started=false,muted=false,destroyed=false,played=0,
            folder=folder,group={Volume=0.7}},Audio)
        mix._voice=function(_,name,volume,pitch,duration,finishPitch,swell)
            calls[#calls+1]={name=name,volume=volume,pitch=pitch,duration=duration,finishPitch=finishPitch,swell=swell}
        end
        return mix,calls,attributes
    end
    local function event(serial,kind,at,actor)
        return {serial=serial,kind=kind,at=at,actor=actor or 1,target=2}
    end
    local function snapshot(phase,elapsed,events,roundId)
        return {active=true,phase=phase,roundId=roundId or 1,
            simulation={elapsed=elapsed,events=events or {},fighters={{id=1,offenceId="Meteor",armor=3},{id=2,offenceId="Firework",armor=3}}}}
    end
    local function results(roundId,armorA,armorB,reason)
        local s=snapshot("Results",5,{},roundId)
        s.simulation.finished=true; s.simulation.reason=reason or "knockout"
        s.simulation.fighters[1].armor=armorA; s.simulation.fighters[2].armor=armorB
        return s
    end

    test("setup and countdown defer launch cues until Fight",function()
        local mix,calls=fixture()
        local launches={event(1,"launch",0),event(2,"launch",0,2)}
        mix:update(snapshot("Configure",0,launches))
        mix:update(snapshot("Countdown",0,launches)); assert(#calls==0)
        mix:update(snapshot("Fight",0.05,launches)); assert(#calls==2)
        mix:update(snapshot("Fight",0.1,launches)); assert(#calls==2)
    end)
    test("fresh events from both fighters play once across repeated snapshots",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        local s=snapshot("Fight",0.2,{event(3,"rocket",0.2),event(4,"hit",0.2,2)})
        mix:update(s); local count=#calls
        assert(count==4 and mix.lastSerial==4)
        for _=1,10 do mix:update(s) end
        assert(#calls==count)
    end)
    test("late join consumes history and only future events sound",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",12,{event(18,"rocket",11.9),event(19,"hit",12)}))
        assert(#calls==0 and mix.lastSerial==19)
        mix:update(snapshot("Fight",12.2,{event(19,"hit",12),event(20,"hit",12.2,2)}))
        assert(#calls==2 and mix.lastSerial==20)
    end)
    test("late Results entry and stale delivery do not replay the past",function()
        local mix,calls=fixture()
        mix:update(snapshot("Results",35,{event(25,"finish",35)})); assert(#calls==0)
        mix:update(snapshot("Fight",0,{},2))
        mix:update(snapshot("Fight",3,{event(2,"hit",1),event(3,"rocket",1.2)} ,2))
        assert(#calls==0 and mix.lastSerial==3)
        mix:update(snapshot("Fight",3.1,{event(4,"windup",3.1)},2)); assert(#calls==2)
    end)
    test("mute stops existing voices and consumes events without replay on unmute",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        local stopped,cancelled=0,0
        mix.voices={test={{Stop=function() stopped=stopped+1 end}}}
        mix.tweens={test={Cancel=function() cancelled=cancelled+1 end}}
        mix:setMuted(true)
        assert(stopped==1 and cancelled==1 and next(mix.tweens)==nil and mix.group.Volume==0)
        local s=snapshot("Fight",0.2,{event(2,"hit",0.2)})
        mix:update(s); assert(#calls==0 and mix.lastSerial==2)
        mix:setMuted(false); mix:update(s); assert(#calls==0 and mix.group.Volume==0.7)
        mix:update(snapshot("Fight",0.4,{event(3,"hit",0.4)})); assert(#calls==2)
    end)
    test("retry resets serials and exit stops all voices",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0.05,{event(1,"launch",0)}))
        mix:update(snapshot("Configure",0,{event(1,"launch",0)},2)); assert(#calls==1)
        mix:update(snapshot("Fight",0.05,{event(1,"launch",0)},2)); assert(#calls==2)
        local stopped,cancelled=0,0
        mix.voices={test={{Stop=function() stopped=stopped+1 end}}}
        mix.tweens={test={Cancel=function() cancelled=cancelled+1 end}}
        mix:update({active=false})
        assert(stopped==1 and cancelled==1 and mix.key==nil and mix.lastSerial==0)
        mix:update({active=false}); assert(stopped==1)
    end)
    test("a delivery batch is bounded and keeps the newest finish",function()
        local mix,calls,attrs=fixture()
        mix:update(snapshot("Fight",0,{}))
        local events={}
        for i=1,12 do events[i]=event(i,"hit",1+i*0.02,i%2+1) end
        events[13]=event(13,"finish",1.28)
        local s=snapshot("Results",1.3,events); s.simulation.reason="knockout"
        mix:update(s)
        assert(mix.played&lt;=Audio.MAX_EVENTS_PER_UPDATE and #calls&lt;=Audio.MAX_EVENTS_PER_UPDATE*2)
        assert(attrs.LastEvent=="finish" and mix.lastSerial==13)
        local count=#calls; mix:update(s); assert(#calls==count)
    end)
    test("bumps blocks damage and modifiers have distinct mixes",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        mix:update(snapshot("Fight",0.2,{event(1,"bump",0.2)}))
        assert(#calls==1 and calls[1].name=="land" and calls[1].volume&lt;0.1)
        local block=event(2,"blocked",0.4); block.skillId="SpringBumper"
        mix:update(snapshot("Fight",0.4,{block}))
        assert(calls[2].name=="jump" and calls[3].name=="chime")
        mix:update(snapshot("Fight",0.6,{event(3,"wake_hit",0.6)}))
        assert(calls[4].name=="land" and calls[5].name=="boom")
        local boost=event(4,"skill",0.8); boost.skillId="Afterburner"
        mix:update(snapshot("Fight",0.8,{boost}))
        assert(calls[6].name=="jump" and calls[6].finishPitch&gt;calls[6].pitch)
        local wake=event(5,"skill",1); wake.skillId="FizzyFuel"
        mix:update(snapshot("Fight",1,{wake}))
        assert(#calls==6,"wake emission sounded like an armor hit")
    end)
    test("Meteor charge and committed dive differ from Firework arming and ignition",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        mix:update(snapshot("Fight",0.2,{event(1,"windup",0.2)}))
        assert(calls[1].name=="jump" and calls[1].swell and calls[1].finishPitch&gt;calls[1].pitch)
        assert(calls[2].name~="boom","charge sounded like damage")
        mix:update(snapshot("Fight",0.85,{event(2,"dive",0.85)}))
        assert(calls[3].name=="jump" and calls[3].finishPitch&lt;calls[3].pitch)
        assert(calls[4].name~="boom","committing to a dive claimed a hit")
        mix:update(snapshot("Fight",1.2,{event(3,"windup",1.2,2)}))
        assert(calls[5].name=="chime" and calls[5].pitch&gt;calls[1].pitch)
        mix:update(snapshot("Fight",2.25,{event(4,"rocket",2.25,2)}))
        assert(calls[7].name=="jump" and calls[7].finishPitch&gt;calls[7].pitch)
        assert(calls[8].name=="boom" and calls[8].volume&lt;0.15)
        local count=#calls
        mix:update(snapshot("Fight",2.3,{event(2,"dive",0.85),event(4,"rocket",2.25,2)}))
        assert(#calls==count,"commit cue replayed")
    end)
    test("damage source changes the impact and aerial knockout leaves room for the landing",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        local meteor=event(1,"hit",0.2); meteor.source="meteor"
        mix:update(snapshot("Fight",0.2,{meteor}))
        local rocket=event(2,"hit",0.4); rocket.source="rocket"
        mix:update(snapshot("Fight",0.4,{rocket}))
        assert(calls[1].name=="boom" and calls[3].name=="boom")
        assert(calls[1].pitch&lt;calls[3].pitch and calls[2].pitch&lt;calls[4].pitch)
        local ending=snapshot("Results",0.5,{event(3,"finish",0.5)})
        ending.simulation.reason="knockout"; mix:update(ending)
        assert(calls[5].volume&lt;calls[1].volume and calls[5].duration&lt;calls[1].duration)
        assert(calls[6].name=="chime" and not calls[6].swell)
    end)
    test("Meteor charge follows remaining authoritative windup time",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        local charge=snapshot("Fight",0.4,{event(1,"windup",0.2)})
        charge.simulation.fighters[1].windupDuration=1.15
        mix:update(charge)
        assert(math.abs(calls[1].duration-0.95)&lt;0.0001 and calls[1].swell)
        mix:update(charge); assert(#calls==2)
        mix:update(snapshot("Fight",1.35,{event(2,"dive",1.35)}))
        assert(#calls==4 and calls[3].finishPitch&lt;calls[3].pitch)
        local legacy=snapshot("Fight",2,{event(3,"windup",2)})
        legacy.simulation.fighters[1].windupDuration=0/0
        mix:update(legacy)
        assert(math.abs(calls[5].duration-0.65)&lt;0.0001,"old snapshots lost their charge fallback")
    end)
    test("release stops its own charge and Results interrupts remaining charges",function()
        local mix=fixture()
        mix:update(snapshot("Fight",0,{}))
        local stopped,cancelled={0,0},{0,0}
        local a={Stop=function() stopped[1]=stopped[1]+1 end}
        local b={Stop=function() stopped[2]=stopped[2]+1 end}
        mix.charging={[a]=1,[b]=2}
        mix.tweens={[a]={Cancel=function()cancelled[1]=cancelled[1]+1 end},
            [b]={Cancel=function()cancelled[2]=cancelled[2]+1 end}}
        mix:update(snapshot("Fight",0.2,{event(1,"dive",0.2)}))
        assert(stopped[1]==1 and stopped[2]==0 and mix.charging[b]==2)
        mix:update(results(1,1,0))
        assert(stopped[2]==1 and cancelled[1]==1 and cancelled[2]==1)
        assert(next(mix.charging)==nil and next(mix.tweens)==nil)
        mix:update(results(1,1,0)); assert(stopped[2]==1)
    end)
    test("ground crash needs a defeated plane in current Results and plays only once",function()
        local mix,calls,attrs=fixture()
        assert(not mix:playCrash(1,2))
        mix:update(snapshot("Fight",0,{}))
        assert(not mix:playCrash(1,2))
        mix:update(results(1,2,0))
        assert(not mix:playCrash(1,1),"surviving plane crashed")
        assert(not mix:playCrash(1,0) and not mix:playCrash(1,3))
        assert(mix:playCrash(1,2) and #calls==2 and attrs.LastEvent=="crash")
        assert(calls[1].name=="land" and calls[2].name=="boom" and calls[1].pitch&lt;0.7)
        for _=1,8 do mix:update(results(1,2,0)); assert(not mix:playCrash(1,2)) end
        assert(#calls==2)
    end)
    test("a simultaneous knockout has one landing per plane",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{})); mix:update(results(1,0,0))
        assert(mix:playCrash(1,1) and mix:playCrash(1,2))
        assert(not mix:playCrash(1,1) and not mix:playCrash(1,2) and #calls==4)
    end)
    test("muted ground landings are consumed instead of replayed on unmute",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{})); mix:update(results(1,1,0))
        mix:setMuted(true); assert(not mix:playCrash(1,2))
        mix:setMuted(false); assert(not mix:playCrash(1,2) and #calls==0)
    end)
    test("restart and exit invalidate old crash callbacks but permit the next landing",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{})); mix:update(results(1,1,0))
        mix:update(snapshot("Configure",0,{},2))
        assert(not mix:playCrash(1,2) and not mix:playCrash(2,2))
        mix:update(snapshot("Fight",0,{},2)); mix:update(results(2,1,0))
        assert(not mix:playCrash(1,2) and mix:playCrash(2,2) and #calls==2)
        mix:update({active=false}); assert(not mix:playCrash(2,2))
        mix:destroy(); assert(not mix:playCrash(2,2) and #calls==2)
    end)
    test("late Results entry and delayed presentation callbacks stay silent",function()
        local mix,calls=fixture()
        mix:update(results(1,1,0)); assert(not mix:playCrash(1,2))
        mix:update(results(1,1,0)); assert(not mix:playCrash(1,2))
        mix:update(snapshot("Fight",0,{},2)); mix:update(results(2,1,0))
        mix.resultsAt=os.clock()-Audio.MAX_CRASH_AGE-1
        mix:update(results(2,1,0))
        assert(not mix:playCrash(2,2) and #calls==0,"a repeated Results snapshot refreshed stale crash eligibility")
    end)
    test("timeouts and unfinished Results cannot claim a knockout crash",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{})); mix:update(results(1,2,1,"timeout"))
        assert(not mix:playCrash(1,2))
        mix:update(results(1,1,0,"timeout")); assert(not mix:playCrash(1,2))
        local invalid=results(1,1,0); invalid.simulation.finished=false
        mix:update(invalid); assert(not mix:playCrash(1,2) and #calls==0)
    end)
    test("duplicate commit bursts are limited per actor without silencing the rival",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        mix:update(snapshot("Fight",0.2,{event(1,"dive",0.2)}))
        mix:update(snapshot("Fight",0.23,{event(2,"dive",0.23),event(3,"dive",0.23,2)}))
        assert(#calls==4 and mix.played==2 and mix.lastSerial==3)
    end)
    test("missing timestamps are supported after initialization and unknown events are consumed",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        mix:update(snapshot("Fight",0.1,{event(1,"miss",0.1),event(2,"rocket",nil)}))
        assert(#calls==2 and mix.lastSerial==2)
        mix:update(snapshot("Fight",0.2,{event(1,"hit",0.2),event(2,"rocket",nil)}))
        assert(#calls==2)
    end)
    test("destroy is idempotent and later input cannot resurrect the mix",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{})); mix:destroy(); mix:destroy()
        mix:setMuted(false); mix:update(snapshot("Fight",0.1,{event(1,"hit",0.1)}))
        assert(#calls==0 and mix.folder.destroyed==1 and next(mix.voices)==nil)
    end)
    test("new skills have distinct lightweight cues and connection ticks do not break armor",function()
        local mix,calls,attributes=fixture()
        mix:update(snapshot("Fight",0,{}))
        mix:update(snapshot("Fight",0.1,{event(1,"burst",0.1)}))
        assert(attributes.LastEvent=="burst" and #calls==1)
        mix:update(snapshot("Fight",0.2,{event(2,"tracer_hit",0.2)}))
        assert(attributes.LastEvent=="tracer_hit" and #calls==2 and calls[2].name=="chime")
        mix:update(snapshot("Fight",0.3,{event(3,"ricochet",0.3)}))
        assert(attributes.LastEvent=="ricochet")
        local magnet=event(4,"skill",0.4);magnet.skillId="Magnet"
        mix:update(snapshot("Fight",0.4,{magnet}));assert(attributes.LastEvent=="magnet")
        local wind=event(5,"skill",0.5);wind.skillId="SecondWind"
        mix:update(snapshot("Fight",0.5,{wind}));assert(attributes.LastEvent=="secondwind")
    end)
    test("RoundOver and MatchOver use result crash eligibility and reset on next Pick",function()
        local mix,calls=fixture()
        mix:update(snapshot("Fight",0,{}))
        local s=results(1,0,2);s.phase="RoundOver";mix:update(s)
        assert(mix:playCrash(1,1),"RoundOver crash was silent")
        mix:update(snapshot("Pick",0,{},2));assert(not mix:playCrash(1,1),"Old crash survived next draft")
        mix:update(snapshot("Fight",0,{},2));s=results(2,2,0);s.phase="MatchOver";mix:update(s)
        assert(mix:playCrash(2,2),"MatchOver crash was silent")
    end)
    test("quiet UI vocabulary suppresses duplicate action pulses and obeys mute",function()
        local mix,calls,attributes=fixture();local shots={}
        mix._shot=function(_,name,volume,pitch)shots[#shots+1]={name=name,volume=volume,pitch=pitch}end
        mix:ui("select");local count=#shots;local voices=#calls
        mix:ui("select");assert(#shots==count and #calls==voices,"Double helper/callback sound")
        mix:ui("confirm");assert(attributes.LastUI=="confirm")
        mix:ui("back");assert(attributes.LastUI=="back")
        mix:ui("error");assert(shots[#shots].name=="beep")
        mix:ui("purchase");assert(attributes.LastUI=="purchase")
        for _,shot in ipairs(shots)do assert(shot.volume&lt;=0.22,"UI louder than intended")end
        mix:setMuted(true);count=#shots;voices=#calls;mix:ui("tap")
        assert(#shots==count and #calls==voices,"Mute allowed UI sound")
        mix:setMuted(false);mix:ui("tap");assert(#shots==count+1,"Unmute did not restore tap")
    end)
    return tostring(passed).." battle-audio tests passed"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX33">
      <Properties>
        <string name="Name">BattleViewTests</string>
        <ProtectedString name="Source">-- Native Roblox engine checks for post-result presentation, not subjective feel.
-- require(thisModule)(BattleView, World, BattleSimulation). Fixtures are destroyed.
return function(View, World, Simulation)
    local passed=0
    local function test(name,body)
        local cues={}
        local view=View.new(World,function(cue) cues[#cues+1]=cue end)
        view.folder.Name="BattlePresentationFixture"
        local function advance(snapshot,seconds)
            for i=1,math.ceil(seconds*60) do
                view:update(snapshot,1/60)
                if i%12==0 then task.wait() end
            end
        end
        local function snapshot(roundId,phase,armor1,armor2,reason)
            local sim=Simulation.newRound(731)
            sim.fighters[1].x,sim.fighters[1].y=-20,70
            sim.fighters[2].x,sim.fighters[2].y=30,60
            for i,f in ipairs(sim.fighters) do
                f.armor=i==1 and armor1 or armor2
                f.vx,f.vy,f.armed=0,0,false
            end
            sim.finished=phase=="Results"; sim.reason=reason
            sim.winner=armor1==armor2 and 0 or (armor1&gt;armor2 and 1 or 2)
            sim.events={}; sim.elapsed=20
            return {roundId=roundId,phase=phase,active=true,simulation=sim}
        end
        local ok,err=pcall(body,view,cues,advance,snapshot)
        view:destroy()
        assert(view.folder.Parent==nil,"Fixture cleanup failed")
        assert(ok,name..": "..tostring(err))
        passed=passed+1
    end
    local function lowestSolid(model)
        local lowest=math.huge
        for _,p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") and p.Transparency&lt;0.5 and not string.find(p.Name,"Smoke") then
                local c,s=p.CFrame,p.Size
                local extent=(math.abs(c.RightVector.Y)*s.X+math.abs(c.UpVector.Y)*s.Y+math.abs(c.LookVector.Y)*s.Z)/2
                lowest=math.min(lowest,p.Position.Y-extent)
            end
        end
        return lowest
    end
    test("KO falls onto the visible floor once without moving the winner or simulation",function(view,cues,advance,snapshot)
        local s=snapshot(1,"Fight",1,2)
        view:update(s,1/60)
        local start=view.fighters[1].model:GetPivot().Position
        local winner=view.fighters[2].model:GetPivot().Position
        s.phase="Results";s.simulation.finished=true;s.simulation.reason="knockout";s.simulation.fighters[1].armor=0
        advance(s,0.25)
        assert(view.fighters[1].model:GetPivot().Position.Y&lt;start.Y,"Defeated plane did not descend")
        assert(#cues==0,"Ground sound played before landing")
        advance(s,2)
        assert(#cues==1 and cues[1].kind=="crash" and cues[1].actor==1 and cues[1].roundId==1,"Missing or duplicate landing cue")
        assert(view.fighters[1].model:GetAttribute("CrashState")=="Landed","KO did not settle")
        local lip=view.folder.Stadium.FloorLip
        local ground=lip.Position.Y+lip.Size.Y/2
        assert(math.abs(lowestSolid(view.fighters[1].model)-ground)&lt;0.8,"Wreck floats above or penetrates the floor")
        assert((view.fighters[2].model:GetPivot().Position-winner).Magnitude&lt;0.01,"Winner fell or moved")
        assert(s.simulation.fighters[1].y==70 and s.simulation.winner==2,"Presentation changed authoritative result")
        advance(s,1)
        assert(#cues==1,"Ground cue repeated on Results snapshots")
    end)
    test("simultaneous knockout crashes both planes",function(view,cues,advance,snapshot)
        local s=snapshot(2,"Results",0,0,"knockout")
        advance(s,2.5)
        assert(#cues==2 and cues[1].actor~=cues[2].actor,"Double KO did not land both planes once")
        for _,f in pairs(view.fighters) do assert(f.model:GetAttribute("CrashState")=="Landed") end
        assert(s.simulation.winner==0,"Crash changed the draw")
    end)
    test("timeout survivors do not crash",function(view,cues,advance,snapshot)
        local s=snapshot(3,"Results",1,2,"timeout")
        view:update(s,1/60)
        local y=view.fighters[1].model:GetPivot().Position.Y
        advance(s,2)
        assert(#cues==0 and view.fighters[1].model:GetAttribute("CrashState")==nil,"Timeout survivor crashed")
        assert(math.abs(view.fighters[1].model:GetPivot().Position.Y-y)&lt;0.01,"Timeout survivor fell")
    end)
    test("retry during a fall cancels the old landing",function(view,cues,advance,snapshot)
        advance(snapshot(4,"Results",0,2,"knockout"),0.2)
        local nextRound=snapshot(5,"Configure",3,3)
        advance(nextRound,2)
        assert(#cues==0,"Old crash sounded after retry")
        for _,f in pairs(view.fighters) do assert(f.model:GetAttribute("CrashState")==nil,"Retry kept crash state") end
    end)
    test("destroy during a fall cancels pending presentation",function(view,cues,advance,snapshot)
        local s=snapshot(6,"Results",0,2,"knockout")
        advance(s,0.2)
        view:destroy()
        advance(s,2)
        assert(#cues==0,"Destroyed view emitted a delayed landing")
    end)
    test("near-floor knockout reaches first contact and cues in the same update",function(view,cues,advance,snapshot)
        for sample,height in ipairs({8,10,14}) do
            local s=snapshot(20+sample,"Fight",1,2)
            s.simulation.fighters[1].y=height
            view:update(s,1/60)
            s.phase="Results";s.simulation.finished=true;s.simulation.reason="knockout";s.simulation.fighters[1].armor=0
            local before=#cues
            local previousBottom=math.huge
            local landed=false
            for frame=1,90 do
                view:update(s,1/60)
                local fighter=view.fighters[1]
                local bottom=lowestSolid(fighter.model)
                local gap=bottom-view.groundY
                assert(gap&gt;=-0.002,"Near-floor crash penetrated the floor")
                assert(bottom&lt;=previousBottom+0.002,"Near-floor wreck lifted away from the floor")
                previousBottom=bottom
                if fighter.model:GetAttribute("CrashState")=="Landed" then
                    assert(math.abs(gap)&lt;0.002,"Landing cue happened before actual contact")
                    assert(#cues==before+1 and cues[#cues].roundId==s.roundId,"Contact did not emit exactly one current-round cue")
                    landed=true
                    break
                end
                assert(gap&gt;0.002 and #cues==before,"Wreck touched the floor before landing cue")
                if frame%12==0 then task.wait() end
            end
            assert(landed,"Near-floor crash did not settle")
            advance(s,0.25)
            assert(#cues==before+1,"Near-floor landing cue repeated")
        end
    end)
    test("every equipped skin keeps its geometry under every active offence",function(view,cues,advance,snapshot)
        for skinIndex,skin in ipairs({"cruiser","skyhopper","dart"}) do
            local s=snapshot(100+skinIndex,"Pick",3,3)
            s.players={{userId=1,name="You",planeId=skin,color=1},{userId=2,name="Rival",planeId=skin,color=1}}
            s.simulation.finished=false; s.simulation.fighters[1].offenceId=""
            s.simulation.fighters[2].offenceId=""
            view:update(s,1/60)
            local fighter=view.fighters[1]; local bodySize=fighter.body.Size
            local geometry={}
            for _,piece in ipairs(fighter.model:GetChildren()) do
                if piece:IsA("BasePart") and piece.Transparency&lt;0.5 then geometry[piece]=piece.Size end
            end
            for _,name in ipairs({"Nose","Belly","WingLeft","WingRight","Tail","Centre","Top"}) do
                assert(fighter.model.PrimaryPart:FindFirstChild(name):IsA("Attachment"),"Missing "..skin.." "..name)
            end
            for _,offence in ipairs({"Meteor","Firework","MachineGun","Pinball"}) do
                view:_setSignature(fighter,offence)
                assert(fighter.body.Size==bodySize,"Skill reshaped equipped fuselage")
                for piece,size in pairs(geometry) do assert(piece.Size==size and piece.Transparency&lt;0.5,"Skill hid or reshaped "..piece.Name) end
                assert(fighter.model:GetAttribute("PlaneId")==skin,"Wrong equipped skin")
            end
            assert(view.fighters[2].model:GetAttribute("PlaneId")==skin,"Mirror replaced rival skin")
            assert(view.fighters[1].color==view.fighters[2].color,"Mirror replaced rival paint")
            assert(view.fighters[1].sideColor~=view.fighters[2].sideColor,"Mirror lost side identity")
        end
    end)
    test("match phases retain authoritative crash and clear new-skill effects",function(view,cues,advance,snapshot)
        local s=snapshot(200,"Fight",1,2)
        s.simulation.fighters[1].offenceId="MachineGun"; s.simulation.fighters[1].magnetLeft=1
        s.simulation.fighters[1].secondWind=true
        view:update(s,1/60)
        assert(view.fighters[1].magnetRing[1].Transparency&lt;1,"Magnet missing its cue")
        assert(view.fighters[1].windRing[1].Transparency&lt;1,"Second Wind missing its cue")
        s.phase="RoundOver";s.simulation.finished=true;s.simulation.reason="knockout";s.simulation.fighters[1].armor=0
        advance(s,2.5)
        assert(#cues==1,"RoundOver did not land the authoritative knockout")
        local nextRound=snapshot(201,"Pick",3,3)
        advance(nextRound,0.1)
        assert(view.fighters[1].magnetRing[1].Transparency==1 and view.fighters[1].windRing[1].Transparency==1,"Pick retained old cues")
    end)
    test("reduced motion suppresses afterimages and flashes while preserving skill tells",function(view,cues,advance,snapshot)
        view.reducedMotion=true
        local s=snapshot(202,"Fight",3,3)
        s.simulation.fighters[1].offenceId="Meteor";s.simulation.fighters[1].phase="Attack";s.simulation.fighters[1].armed=true
        view:update(s,1/60)
        local fighter=view.fighters[1]
        assert(fighter.chargeShell.Transparency&lt;1,"Reduced motion hid commitment cue")
        for _,ghost in ipairs(fighter.afterimages) do for _,piece in ipairs(ghost.pieces) do assert(piece.Transparency==1,"Reduced motion left afterimage") end end
        assert(view.screenFlash==0,"Reduced motion flashed")
    end)
    test("storm follows every authoritative boundary and resets grade on results",function(view,cues,advance,snapshot)
        for index,pressure in ipairs({0.1,0.5,1}) do
            local s=snapshot(300+index,"Fight",3,3)
            s.simulation.pressure=pressure
            s.simulation.bounds={left=-72+24*pressure,right=72-24*pressure,bottom=8+10*pressure,top=96-14*pressure}
            view:update(s,1/60)
            local bounds=s.simulation.bounds
            local origin=Vector3.new(0,80,-4000)
            assert(math.abs(view.edges[1].Position.X-origin.X-bounds.left)&lt;0.001)
            assert(math.abs(view.edges[2].Position.X-origin.X-bounds.right)&lt;0.001)
            assert(math.abs(view.edges[3].Position.Y-origin.Y-bounds.top)&lt;0.001)
            assert(math.abs(view.edges[4].Position.Y-origin.Y-bounds.bottom)&lt;0.001)
            assert(view.stormClouds[1][1].Transparency&lt;1 and view.grade.Brightness&lt;0,"Storm did not track pressure")
            view.reducedMotion=true;view:update(s,1/60)
            for _,bolt in ipairs(view.lightning) do assert(bolt.Transparency==1,"Reduced motion lightning") end
            s.phase="MatchOver";view:update(s,1/60)
            assert(math.abs(view.grade.Brightness)&lt;0.001 and math.abs(view.grade.Saturation-0.14)&lt;0.001,"Result kept storm grade")
            view.reducedMotion=false
        end
        view:_resetRound(400)
        for side=1,4 do assert(view.stormClouds[side][1].Transparency==1 and view.lightning[side].Transparency==1,"Round reset left storm") end
    end)
    test("generic non-aircraft contract supports equipment and crash without plane parts",function(view,cues,advance,snapshot)
        local originalWorld=view.World
        view.World={trailLook=originalWorld.trailLook,createPlane=function(parent,name,colorIndex,planeId)
            local model=Instance.new("Model");model.Name=name;model:SetAttribute("PlaneId",planeId);model:SetAttribute("BattleVisualSize",8)
            local body=Instance.new("Part");body.Name="BroomBody";body.Size=Vector3.new(8,1,1);body.Anchored=true;body.CanCollide=false;body.Parent=model;model.PrimaryPart=body
            for mountName,position in pairs({Nose=Vector3.new(4,0,0),Tail=Vector3.new(-4,0,0),Belly=Vector3.new(0,-0.5,0),Centre=Vector3.zero,Top=Vector3.new(0,1,0),WingLeft=Vector3.new(0,0,-1),WingRight=Vector3.new(0,0,1)}) do
                local attachment=Instance.new("Attachment");attachment.Name=mountName;attachment.Position=position;attachment.Parent=body
            end
            model.Parent=parent;return model
        end}
        local s=snapshot(410,"Fight",2,3);s.simulation.fighters[1].offenceId="Firework"
        view:update(s,1/60);assert(view.fighters[1].propeller==nil and view.fighters[1].body.Name=="BroomBody")
        s.phase="MatchOver";s.simulation.finished=true;s.simulation.reason="knockout";s.simulation.fighters[1].armor=0
        advance(s,2.5)
        assert(#cues==1 and view.fighters[1].crashLanded,"Generic skin failed to land once")
        assert(#view.fighters[1].debris==5,"Generic fallback grew unbounded debris")
    end)
    test("bounce stays bounded after one ground cue and cleanup cancels the sequence",function(view,cues,advance,snapshot)
        local s=snapshot(420,"Fight",1,3);view:update(s,1/60)
        s.phase="MatchOver";s.simulation.finished=true;s.simulation.reason="knockout";s.simulation.fighters[1].armor=0
        local landed=false;local bounced=false
        for frame=1,180 do
            view:update(s,1/60)
            if view.fighters[1].crashLanded then
                landed=true
                local gap=view.fighters[1].crashContactY-view.groundY
                assert(gap&gt;=-0.002 and gap&lt;=0.81,"Bounce left bounded floor region")
                if gap&gt;0.05 then bounced=true end
            end
            if frame%12==0 then task.wait() end
        end
        assert(landed and bounced and #cues==1,"Bounce failed or repeated first contact")
        assert(math.abs(view.fighters[1].crashContactY-view.groundY)&lt;0.002,"Bounce did not settle")
        advance(snapshot(421,"Pick",3,3),0.1);assert(view.fighters[1].crash==nil,"Next draft kept old fall")
    end)
    return string.format("BattleView: %d native presentation tests passed",passed)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX34">
      <Properties>
        <string name="Name">BattleClientTests</string>
        <ProtectedString name="Source">-- Pure command/presentation contract checks. Native Studio client supplies the module.
return function(Client,Skills)
    local passed=0
    local function test(name,callback)
        local commands={}
        local ui=setmetatable({skills=Skills,audio={ui=function() end},data={active=true,phase="Pick",matchId=10,stage=1,
            slot="offence",offerRevision=1,offer={"Meteor","MachineGun","Pinball"},eligible={"Meteor","Firework","MachineGun","Pinball"},locked={false,false},resources={reroll=1,pickAny=1}}},Client)
        function ui:send(kind,payload) commands[#commands+1]={kind=kind,payload=payload} end
        local ok,problem=pcall(callback,ui,commands);assert(ok,name..": "..tostring(problem));passed=passed+1
    end
    test("ordinary selection sends only the local offered skill, never rival settings",function(ui,commands)
        ui:choose("Firework");assert(#commands==0,"Off-offer choice sent")
        ui:choose("Meteor");ui:fight()
        assert(#commands==2 and commands[1].kind=="pick" and commands[2].kind=="lock")
        assert(commands[1].payload.skillId=="Meteor" and commands[1].payload.slot=="offence")
        assert(commands[2].payload.skillId=="Meteor" and commands[2].payload.slot=="offence","Lock omitted the visible choice")
        assert(commands[1].payload.settings==nil,"Client supplied builds")
    end)
    test("locked or inactive drafts cannot send new picks",function(ui,commands)
        ui.data.locked[1]=true;ui:choose("Meteor");ui:fight();assert(#commands==0)
        ui.data.locked[1]=false;ui.data.phase="Fight";ui:choose("Meteor");assert(#commands==0)
    end)
    test("Pick Any uses only the server eligible roster",function(ui,commands)
        ui.data.pickAnyActive=true;ui:choose("Firework");assert(#commands==1)
        ui:choose("Copycat");assert(#commands==1,"Inactive skill sent")
    end)
    test("pending reroll freezes cards and lock through old snapshots until acknowledgement",function(ui,commands)
        ui:choose("Pinball");ui:changeOffer("reroll")
        assert(ui.pendingOfferChange and ui.pendingSelection==nil and #commands==2)
        ui:choose("Pinball");ui:fight();ui:changeOffer("pickAny");ui:changeOffer("reroll")
        assert(#commands==2,"Old cards or repeated resources stayed interactive")
        local old=ui.data;ui:syncDraft(old,old)
        assert(ui.pendingOfferChange,"Old snapshot reopened draft")
        local fresh=table.clone(old);fresh.offerRevision=2;fresh.offer={"Meteor","MachineGun","Firework"}
        ui:syncDraft(old,fresh);ui.data=fresh
        assert(not ui.pendingOfferChange and ui.pendingSelection==nil)
        ui:choose("Firework");ui:fight()
        assert(#commands==4 and commands[4].payload.skillId=="Firework","Replacement choice was not locked explicitly")
    end)
    test("pending Pick Any clears on deadline phase change or acknowledged prior lock",function(ui,commands)
        ui:changeOffer("pickAny");assert(ui.pendingOfferChange)
        local old=ui.data;local fresh=table.clone(old);fresh.phase="Countdown"
        ui:syncDraft(old,fresh);assert(not ui.pendingOfferChange)
        ui:changeOffer("pickAny");assert(ui.pendingOfferChange)
        fresh.phase="Pick";fresh.locked={true,false};ui:syncDraft(old,fresh)
        assert(not ui.pendingOfferChange,"A lock acknowledged before resource request left updating cards stuck")
    end)
    test("real outbox preserves explicit choice and revision while spacing queued packets",function(ui)
        local sent={};ui.send=Client.send;ui.outbox={};ui.sending=true;ui.lastSend=-math.huge
        ui.command={FireServer=function(_,payload)sent[#sent+1]={payload=payload,at=os.clock()}end}
        ui:choose("Pinball");ui:fight()
        assert(#ui.outbox==2 and #sent==0)
        -- A later snapshot cannot rewrite already queued packets. The server
        -- rejects their stale revision instead of choosing a replacement.
        ui.data.offerRevision=2;ui.sending=false;ui:send("request")
        local deadline=os.clock()+2
        while ui.sending and os.clock()&lt;deadline do task.wait(.02) end
        assert(#sent==3 and sent[1].payload.kind=="pick" and sent[2].payload.kind=="lock")
        for index=1,2 do
            local p=sent[index].payload
            assert(p.skillId=="Pinball" and p.offerRevision==1 and p.matchId==10 and p.stage==1)
        end
        assert(sent[2].at-sent[1].at&gt;=.079 and sent[3].at-sent[2].at&gt;=.079,"Outbox pacing bypassed")
    end)
    test("clock follows server deadlines even when simulation time is stale",function(ui)
        ui.data.phase="Fight";ui.data.fightDeadline=135;ui.data.matchDeadline=340
        ui.data.simulation={elapsed=1}
        assert(ui:clockSeconds(132.2)==3,"Stale simulation extended the visible round")
        assert(ui:clockSeconds(135)==0 and ui:clockSeconds(139)==0,"Expired timer was not clamped")
        ui.data.matchDeadline=133
        assert(ui:clockSeconds(132.2)==1,"Match hard cap was hidden by the round timer")
        ui.data.phase="Pick";ui.data.pickDeadline=142
        assert(ui:clockSeconds(132.2)==10,"Pick timer stopped using its own deadline")
    end)
    test("rematch is mutual and not repeated while waiting",function(ui,commands)
        ui.data.phase="MatchOver";ui:rematch();assert(#commands==1 and commands[1].kind=="rematch")
        ui.data.rematchVotes={true,false};ui:rematch();assert(#commands==1)
        ui.data.rematchVotes={false,false};ui.data.rivalGone=true;ui:rematch();assert(#commands==1)
    end)
    test("round facts preserve authoritative strings with bounded fallbacks",function(ui)
        assert(ui:factText({facts={"Your Meteor landed the final hit."}})=="Your Meteor landed the final hit.")
        assert(string.find(ui:factText({reason="timeout",winner=0}),"equal armor",1,true))
        assert(string.find(ui:factText({reason="round_cap"}),"Five rounds",1,true))
        assert(string.find(ui:factText({reason="disconnect"}),"left",1,true))
    end)
    test("starter claim and goal purchase use current server economy without inventing ownership",function(ui)
        local sent={};ui.progressCommand={FireServer=function(_,payload)sent[#sent+1]=payload end}
        ui.data.phase="MatchOver";ui.data.economy={canShop=true,credits=250,starterChoices={"rookieblue","rookiecoral"},
            progression={starterAvailable=true},goal={id="aurora",price=250,owned=false},equippedTrail="classic"}
        ui:claimStarter("Copycat");assert(#sent==0)
        ui:claimStarter("rookieblue");assert(#sent==1 and sent[1].kind=="claimStarter")
        assert(ui.data.economy.equippedTrail=="classic","Client guessed claim success")
        ui:goalActionRequested();assert(#sent==1,"Double request while pending")
        ui.cosmeticPending=nil;ui:goalActionRequested();assert(#sent==2 and sent[2].kind=="buyCosmetic")
        ui.cosmeticPending=nil;ui.data.economy.goal.owned=true;ui:goalActionRequested()
        assert(#sent==3 and sent[3].kind=="equipCosmetic")
        ui.cosmeticPending=nil;ui.data.phase="Fight";ui:goalActionRequested();assert(#sent==3,"Mid-fight equip sent")
    end)
    test("reward shown reports only visible terminal rewards once per match",function(ui,commands)
        ui.result={Visible=true};ui.data.phase="RoundOver";ui.data.reward={coins=50}
        ui:reportRewardShown(ui.data);assert(#commands==0,"Round reward reported")
        ui.data.phase="MatchOver";ui.data.reward=nil
        ui:reportRewardShown(ui.data);assert(#commands==0,"Missing reward reported")
        ui.data.reward={coins=50};ui.result.Visible=false
        ui:reportRewardShown(ui.data);assert(#commands==0,"Hidden result reported")
        ui.result.Visible=true;ui:reportRewardShown(ui.data);ui:reportRewardShown(ui.data)
        assert(#commands==1 and commands[1].kind=="rewardShown","Reward summary was not deduplicated")
        ui.data.matchId=11;ui:reportRewardShown(ui.data)
        assert(#commands==2,"New match reward was not reported")
        ui.data.matchId=10;ui:reportRewardShown(ui.data);assert(#commands==2,"Old reward retransmission repeated")
    end)
    return string.format("BattleClient: %d command and feedback tests passed",passed)
end
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX35">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">4</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="RBX36">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX38">
        <Properties>
          <string name="Name">FlightClient</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local localPlayer = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("FlightGame")
local Simulation = require(shared:WaitForChild("Simulation"))
local PlaneCatalog = require(shared:WaitForChild("PlaneCatalog"))
local PowerCatalog = require(shared:WaitForChild("PowerCatalog"))
local World = require(shared:WaitForChild("World"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local EffectsShop = require(script.Parent:WaitForChild("EffectsShop"))
local FlightAudio = require(script.Parent:WaitForChild("FlightAudio"))
local PilotAvatar = require(script.Parent:WaitForChild("PilotAvatar"))
local HangarBay = require(script.Parent:WaitForChild("HangarBay"))
local BattleLab = require(script.Parent:WaitForChild("BattleLab"))
local battleLab = BattleLab.new(World,shared)
local challenges = require(script.Parent:WaitForChild("ChallengePanel")).new(shared)
local audio = FlightAudio.new()
local command = shared:WaitForChild("Command")
local snapshots = shared:WaitForChild("Snapshot")
local localSettings = {planeId=PlaneCatalog.DEFAULT_ID,powerId=PowerCatalog.DEFAULT_ID,angle=35,gadget="Shield",color=1}
local latest = nil
local usableReported = false
local receivedAt = 0
local watchedUserId = localPlayer.UserId
local lobbyView = true
local renderedCourse = nil
local courseKey = ""
local planes = {}
local planeLabels = {}
local smooth = {}
local previewPlane = nil
local aimTrajectory = {}
local aimTrajectoryKey = ""
local lastPhase = ""
local lastRound = ""
local cameraPosition = nil
local selfCrashedAt = nil
local manualSpectate = false
local hud = nil
local characterControls = nil
local controlsEnabled = nil
local lobbyCameraReset = true
local restoreZoomAt = 0
local worldFolder = Instance.new("Folder")
worldFolder.Name = "FlightClientVisuals"
worldFolder.Parent = workspace

task.spawn(function()
    local playerModule = localPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule",10)
    if playerModule then
        local ok, controls = pcall(function() return require(playerModule):GetControls() end)
        if ok then characterControls=controls end
    end
end)

local function send(kind, values)
    local payload=values or {}
    payload.kind=kind
    local cues={play="confirm",selectGoal="select",buyCosmetic="confirm",equipCosmetic="select",claimStarter="confirm",returnLobby="back",leaveQueue="back"}
    if cues[kind] then battleLab.audio:ui(cues[kind]) end
    command:FireServer(payload)
end
local effectsShop=EffectsShop.new(send)
local hangarBay=HangarBay.new({send=send,openShop=function(itemId) effectsShop:openAt(itemId) end})
-- The plane in the pilot's bay is changed in place, from the HUD or the bay console.
local function changeLook(change)
    if not latest or latest.phase~="Lobby" or battleLab:isActive() or effectsShop:isOpen() or challenges:isOpen() then return end
    for _,entry in ipairs(latest.players) do
        if entry.userId==localPlayer.UserId then
            local settings=table.clone(entry.settings)
            change(settings); settings.speed=nil
            send("configure",{settings=settings})
            break
        end
    end
end
local function cyclePlane(delta)
    changeLook(function(settings)
        local index=table.find(PlaneCatalog.ORDER,settings.planeId) or 1
        local plane=PlaneCatalog.get(PlaneCatalog.ORDER[(index-1+delta)%#PlaneCatalog.ORDER+1])
        settings.planeId=plane.id; settings.angle=plane.defaultAngle
    end)
end
local function cyclePaint()
    changeLook(function(settings) settings.color=(settings.color or 1)%4+1 end)
end
game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt,player)
    if player and player~=localPlayer then return end
    if not latest or latest.phase~="Lobby" or battleLab:isActive() or effectsShop:isOpen() or challenges:isOpen() then return end
    if prompt.Name=="EffectsShopPrompt" then effectsShop:openAt(nil)
    elseif prompt.Name=="UnlockStandPrompt" then hangarBay:activateStand()
    elseif prompt.Name=="HeroBayPrompt" then cyclePlane(1) end
end)
local function cycleSpectate(delta)
    if not latest then return end
    local choices={}
    for _,p in ipairs(latest.players) do if p.flight then table.insert(choices,p.userId) end end
    if #choices==0 then return end
    local index=table.find(choices,watchedUserId) or 1
    watchedUserId=choices[(index-1+delta)%#choices+1]
    manualSpectate=true
    selfCrashedAt=nil
    cameraPosition=nil
end
hud=Hud.new({
    vote=function(variant) send("vote",{variant=variant}) end,
    configure=function(settings) localSettings=table.clone(settings); send("configure",{settings=settings}) end,
    ready=function(ready) send("ready",{ready=ready,settings=hud:getLocalSettings()}) end,
    spectate=cycleSpectate,
    play=function()
        if battleLab:isActive() or effectsShop:isOpen() or challenges:isOpen() or hud.statsOverlay.Visible then return end
        send("play")
    end,
    cyclePlane=cyclePlane,
    cyclePaint=cyclePaint,
    leaveQueue=function() send("leaveQueue") end,
    returnLobby=function() send("returnLobby") end,
    rematch=function() send("rematch") end,
    lobby=function() send("returnLobby") end,
    mute=function(muted) localPlayer:SetAttribute("SkyboundSoundMuted",muted) end,
    powerSelect=function(powerId,confirmed) audio:playSelection(powerId,confirmed) end,
})
local function syncMute()
    local muted=localPlayer:GetAttribute("SkyboundSoundMuted")==true
    audio:setMuted(muted)
    hud.soundMuted=muted
    hud.soundButton.Text=muted and "SOUND OFF" or "SOUND ON"
end
localPlayer:GetAttributeChangedSignal("SkyboundSoundMuted"):Connect(syncMute)
syncMute()
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack,false) end)
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)

local function clearPlanes()
    for _,model in pairs(planes) do model:Destroy() end
    for _,label in pairs(planeLabels) do label:Destroy() end
    planeLabels={}
    planes={}; smooth={}
    if previewPlane then previewPlane:Destroy(); previewPlane=nil end
end
local function getEntry(id)
    if latest then
        for _,p in ipairs(latest.players) do if p.userId==id then return p end end
    end
    return nil
end

snapshots.OnClientEvent:Connect(function(data)
    if type(data)~="table" or type(data.players)~="table" then return end
    local roundKey=tostring(data.matchId)..":"..tostring(data.roundId)
    local changedRound = lastRound~=roundKey
    local changedPhase = lastPhase~=data.phase
    if changedRound then clearPlanes(); lastRound=roundKey; watchedUserId=localPlayer.UserId; cameraPosition=nil end
    for _,p in ipairs(data.players) do
        if p.flight then
            p.flight.used={}
            for _,id in ipairs(p.flight.usedIds or {}) do p.flight.used[id]=true end
        end
    end
    if data.cosmeticFeedback and data.cosmeticFeedback.id~=localPlayer:GetAttribute("LastCosmeticFeedback") then
        localPlayer:SetAttribute("LastCosmeticFeedback",data.cosmeticFeedback.id)
        battleLab.audio:ui(data.cosmeticFeedback.ok and "purchase" or "error")
    end
    latest=data
    lobbyView=data.phase=="Lobby" or data.phase=="Queued"
    if lobbyView and changedPhase and lastPhase~="Lobby" and lastPhase~="Queued" then lobbyCameraReset=true end
    receivedAt=os.clock()
    local own=getEntry(localPlayer.UserId)
    if changedPhase and own then localSettings=table.clone(own.settings) end
    if data.phase=="Flight" and changedPhase then
        lobbyView=false
        cameraPosition=nil
        watchedUserId=localPlayer.UserId
        selfCrashedAt=nil
        manualSpectate=false
        if previewPlane then previewPlane:Destroy(); previewPlane=nil end
    end
    if data.phase=="BattleLab" then
        clearPlanes()
        if previewPlane then previewPlane:Destroy(); previewPlane=nil end
        if renderedCourse then World.destroyCourse(renderedCourse); renderedCourse=nil; courseKey="" end
        lastPhase=data.phase
        localPlayer:SetAttribute("SkyboundPhase",data.phase)
        return
    end
    local key=tostring(data.courseSeed)..data.courseName
    if key~=courseKey and not lobbyView then
        if renderedCourse then World.destroyCourse(renderedCourse) end
        renderedCourse=World.buildCourse(Simulation.makeCourse(data.courseSeed,data.courseName))
        World.setArenaTheme(data.courseName)
        courseKey=key
    end
    if lobbyView then
        if changedPhase then World.resetTheme() end
        clearPlanes()
        if renderedCourse then World.destroyCourse(renderedCourse); renderedCourse=nil; courseKey="" end
    end
    lastPhase=data.phase
    localPlayer:SetAttribute("SkyboundPhase",data.phase)
    localPlayer:SetAttribute("SkyboundRound",data.roundId)
    localPlayer:SetAttribute("SkyboundMatch",data.matchId)
    if own and own.flight then
        localPlayer:SetAttribute("SkyboundDistance",own.flight.distance)
        localPlayer:SetAttribute("SkyboundAlive",own.flight.alive)
    end
end)

local function adjust(key, amount, low, high)
    if not latest or latest.phase~="Aim" then return end
    local current = hud.getLocalSettings and hud:getLocalSettings() or table.clone(localSettings)
    current[key]=math.clamp(current[key]+amount,low,high)
    localSettings=current
    if hud.setLocalSettings then hud:setLocalSettings(current) else send("configure",{settings=current}) end
end
UserInputService.InputBegan:Connect(function(input,processed)
    if battleLab:isActive() or processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode==Enum.KeyCode.R or input.KeyCode==Enum.KeyCode.ButtonY then
        if latest and (latest.phase=="Configure" or latest.phase=="Aim") then
            if hud.toggleReady then hud:toggleReady()
            else local own=getEntry(localPlayer.UserId); send("ready",{ready=not (own and own.ready),settings=localSettings}) end
        end
    elseif input.KeyCode==Enum.KeyCode.A then adjust("angle",-1,15,60)
    elseif input.KeyCode==Enum.KeyCode.D then adjust("angle",1,15,60)
    elseif input.KeyCode==Enum.KeyCode.Q or input.KeyCode==Enum.KeyCode.ButtonL1 then cycleSpectate(-1)
    elseif input.KeyCode==Enum.KeyCode.E or input.KeyCode==Enum.KeyCode.ButtonR1 then cycleSpectate(1)
    end
end)

local function duelFrame(viewport, target)
    local field=hud:getFlightViewport()
    local portrait=viewport.X&lt;viewport.Y
    local baseHeight=math.max(viewport.Y&lt;450 and 300 or 260,portrait and viewport.Y*240/viewport.X or 0)
    -- At most 18% wider on desktop/landscape, 25% on portrait. Large gaps
    -- become edge markers instead of shrinking the aircraft into distant dots.
    local maxHeight=baseHeight*(portrait and 1.25 or 1.18)
    local own=smooth[target.userId] or target.flight
    local rival
    for _,entry in ipairs(latest.players) do
        if entry.userId~=target.userId and entry.flight then rival=smooth[entry.userId] or entry.flight; break end
    end
    local safeWidth=math.max(80,field.right-field.left)
    local safeHeight=math.max(40,field.bottom-field.top)
    local requiredHeight=baseHeight
    if rival then
        requiredHeight=math.max(requiredHeight,(math.abs(own.x-rival.x)+90)*viewport.Y/safeWidth,
            (math.abs(own.y-rival.y)+64)*viewport.Y/safeHeight)
    end
    local visibleHeight=math.min(requiredHeight,maxHeight)
    local unitsPerPixel=visibleHeight/viewport.Y
    local together=rival and requiredHeight&lt;=maxHeight
    local centerX,centerY
    if together then
        centerX=(own.x+rival.x)/2+12
        centerY=(own.y+rival.y)/2+8
    else
        centerX=own.x+math.min(65,safeWidth*unitsPerPixel*0.16)
        centerY=own.y+12
    end
    -- Bias the frame toward the unobstructed region below the score/power bar,
    -- retaining room beneath the plane for its identity and the ground.
    local safeCenterX=(field.left+field.right)/2
    local safeCenterY=(field.top+field.bottom)/2
    local focusY=centerY+(safeCenterY-viewport.Y/2)*unitsPerPixel
    -- Low skips should skim the bottom of the action area, not reveal a large
    -- empty foreground. Reserve the below-plane label as well as the aircraft;
    -- raising this focus only moves high pilots farther away from the top HUD.
    local groundMargin=math.max(40,12/unitsPerPixel+26)
    focusY=math.max(focusY,(field.bottom-groundMargin-viewport.Y/2)*unitsPerPixel)
    local focus=World.COURSE_ORIGIN+Vector3.new(
        centerX+(viewport.X/2-safeCenterX)*unitsPerPixel,
        focusY,0)
    worldFolder:SetAttribute("CameraMode",together and "duel" or "follow")
    worldFolder:SetAttribute("CameraWorldHeight",visibleHeight)
    worldFolder:SetAttribute("CameraHeightLimit",maxHeight)
    worldFolder:SetAttribute("WatchedUserId",target.userId)
    return focus,visibleHeight
end

RunService:BindToRenderStep("SkyboundFlightView",Enum.RenderPriority.Camera.Value+1,function(dt)
    local camera=workspace.CurrentCamera
    if not latest or not camera then return end
    local phase=latest.phase
    if not usableReported and phase=="Lobby" and localPlayer.Character then
        usableReported=true
        local size=camera.ViewportSize
        local device=UserInputService.TouchEnabled and (math.min(size.X,size.Y)&gt;600 and "tablet" or "phone") or "desktop"
        shared.BattleCommand:FireServer({kind="uiReady",device=device})
    end
    -- Roblox may re-enable avatar controls when a character finishes spawning.
    challenges:update(phase=="Lobby" and not battleLab:isActive() and not effectsShop:isOpen() and not hud.statsOverlay.Visible)
    local allowMovement=lobbyView and not effectsShop:isOpen() and not battleLab:isActive() and not challenges:isOpen() and not hud.statsOverlay.Visible
    if characterControls and (controlsEnabled~=allowMovement or characterControls.controlsEnabled~=allowMovement) then
        controlsEnabled=allowMovement
        if allowMovement then characterControls:Enable() else characterControls:Disable() end
        localPlayer:SetAttribute("SkyboundLobbyControls",characterControls.controlsEnabled)
    end
    local inLab=battleLab:isActive()
    hud.gui.Enabled=not inLab and phase~="BattleLab"
    effectsShop.gui.Enabled=not inLab and phase~="BattleLab"
    if inLab or phase=="BattleLab" then
        if effectsShop:isOpen() then effectsShop:close() end
        audio:update({},"battle-lab",localPlayer.UserId,false)
        hangarBay:update(latest,nil,false,dt)
        battleLab:update(dt)
        return
    end
    battleLab:update(dt)
    local active=phase=="Flight" or phase=="Results"
    local target=getEntry(watchedUserId)
    if active and (not target or not target.flight) then
        for _,p in ipairs(latest.players) do if p.flight then watchedUserId=p.userId; target=p; break end end
    end
    local own=getEntry(localPlayer.UserId)
    if phase=="Flight" and not manualSpectate and watchedUserId==localPlayer.UserId and own and own.flight and not own.flight.alive then
        selfCrashedAt=selfCrashedAt or os.clock()
        if os.clock()-selfCrashedAt&gt;2 then
            local leader=nil
            for _,p in ipairs(latest.players) do
                if p.flight and p.flight.alive and (not leader or p.flight.distance&gt;leader.flight.distance) then leader=p end
            end
            if leader then watchedUserId=leader.userId; target=leader; cameraPosition=nil end
        end
    end
    local renderTime=(latest.elapsed or 0)+(phase=="Flight" and math.min(os.clock()-receivedAt,0.15) or 0)
    if active then
        local present={}
        for index,p in ipairs(latest.players) do
            if p.flight then
                present[p.userId]=true
                if not planes[p.userId] then
                    local model=World.createPlane(worldFolder,p.name,p.settings.color,p.settings.planeId,p.settings.trailId)
                    PilotAvatar.attach(model,p.userId,p.bot)
                    planes[p.userId]=model
                    local text=Instance.new("TextLabel")
                    text.Name="PilotIdentity"; text.Size=UDim2.fromOffset(80,20)
                    text.AnchorPoint=Vector2.new(0.5,0); text.BackgroundTransparency=1; text.ZIndex=3
                    text.Text=p.userId==localPlayer.UserId and "YOU" or (p.bot and "GHOST" or "RIVAL")
                    text.TextColor3=p.userId==localPlayer.UserId and Color3.fromRGB(255,225,112) or Color3.new(1,1,1)
                    text.TextStrokeTransparency=0.1; text.TextStrokeColor3=Color3.fromRGB(23,39,77)
                    text.TextSize=16; text.Font=Enum.Font.FredokaOne
                    local rounding=Instance.new("UICorner")
                    rounding.CornerRadius=UDim.new(0,8); rounding.Parent=text
                    text.Parent=localPlayer.PlayerGui:FindFirstChild("SkyboundHUD")
                    planeLabels[p.userId]=text
                end
                local f=p.flight
                local extrap=f.alive and math.min(os.clock()-receivedAt,0.15) or 0
                local wantX=f.x+f.vx*extrap
                local wantY=math.max(0,f.y+f.vy*extrap)
                local s=smooth[p.userId] or {x=wantX,y=wantY}
                local alpha=1-math.exp(-dt*18)
                s.x+=(wantX-s.x)*alpha; s.y+=(wantY-s.y)*alpha
                smooth[p.userId]=s
                local visual=table.clone(f); visual.x=s.x; visual.y=s.y; visual.elapsed=renderTime; visual.settings=p.settings
                -- Cosmetic lanes only. All planes use the exact same 2D simulation course.
                World.updatePlane(planes[p.userId],visual,(index-1)*20-10,dt)
            end
        end
        for id,model in pairs(planes) do
            if not present[id] then
                model:Destroy(); planes[id]=nil; smooth[id]=nil
                if planeLabels[id] then planeLabels[id]:Destroy(); planeLabels[id]=nil end
            end
        end
    elseif phase=="Configure" or phase=="Aim" or phase=="Countdown" or phase=="Voting" then
        localSettings=hud:getLocalSettings()
        localSettings.trailId=own and own.settings.trailId or "classic"
        if not previewPlane or previewPlane:GetAttribute("PreviewColor")~=localSettings.color
            or previewPlane:GetAttribute("PreviewPlaneId")~=localSettings.planeId
            or previewPlane:GetAttribute("PreviewPowerId")~=localSettings.powerId then
            if previewPlane then previewPlane:Destroy() end
            previewPlane=World.createPlane(worldFolder,localPlayer.DisplayName,localSettings.color,localSettings.planeId,localSettings.trailId)
            previewPlane:SetAttribute("PreviewColor",localSettings.color)
            previewPlane:SetAttribute("PreviewPlaneId",localSettings.planeId)
            previewPlane:SetAttribute("PreviewPowerId",localSettings.powerId)
            PilotAvatar.attach(previewPlane,localPlayer.UserId,false)
        end
        local profile=PlaneCatalog.get(localSettings.planeId) or PlaneCatalog.get(PlaneCatalog.DEFAULT_ID)
        local angle=math.rad(localSettings.angle or profile.angle)
        World.updatePlane(previewPlane,{x=0,y=18,vx=math.cos(angle)*profile.speed,vy=math.sin(angle)*profile.speed,
            elapsed=renderTime,alive=true,settings=localSettings,powerId=localSettings.powerId,powerPhase="armed",
            powerCharges=localSettings.powerId=="Meteor" and 1 or 3,powerUses=0},0,dt)
        if phase=="Aim" or phase=="Countdown" then
            local key=localSettings.planeId..":"..tostring(localSettings.angle)..":"..tostring(localSettings.powerId)
            if key~=aimTrajectoryKey then
                aimTrajectory=Simulation.previewTrajectory(localSettings,3)
                aimTrajectoryKey=key
            end
        end
    end
    if renderedCourse then World.updateCourse(renderedCourse,target and target.flight or nil,renderTime) end
    if lobbyView then
        camera.CameraType=Enum.CameraType.Custom
        camera.FieldOfView=70
        local character=localPlayer.Character
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then camera.CameraSubject=humanoid end
        if lobbyCameraReset and character and character:FindFirstChild("HumanoidRootPart") then
            local focus=character.HumanoidRootPart.Position+Vector3.new(0,2,0)
            localPlayer.CameraMinZoomDistance=32
            localPlayer.CameraMaxZoomDistance=70
            -- Behind the pilot, looking over their plane toward the open doors.
            camera.CFrame=CFrame.lookAt(focus+Vector3.new(7,10,29),focus)
            camera.Focus=CFrame.new(focus)
            lobbyCameraReset=false; restoreZoomAt=os.clock()+0.2
        elseif restoreZoomAt&gt;0 and os.clock()&gt;=restoreZoomAt then
            localPlayer.CameraMinZoomDistance=8; restoreZoomAt=0
        end
    elseif phase=="Aim" or phase=="Countdown" then
        -- A fixed side-on aiming frame keeps pointer movement independent of
        -- camera movement. Match HUD's clear field between its header/footer.
        local viewport=camera.ViewportSize
        local field=hud:getAimViewport()
        local fieldTop=field.top
        local fieldBottom=field.bottom
        local fieldHeight=math.max(42,fieldBottom-fieldTop)
        local targetX=viewport.X*0.24
        local targetY=fieldTop+math.min(fieldHeight*0.65,math.max(0,fieldHeight-44))
        -- Fit the whole tilted jet and its pilot; long guide points are clipped
        -- by HUD at the field edges instead of changing zoom with launch angle.
        local worldWidth=viewport.X&lt;560 and 250 or 320
        local pixelsPerStud=math.max(0.1,math.min(viewport.X/worldWidth,fieldHeight/60))
        local visibleHeight=viewport.Y/pixelsPerStud
        local focus=World.COURSE_ORIGIN+Vector3.new(
            (viewport.X*0.5-targetX)/pixelsPerStud,
            18+(targetY-viewport.Y*0.5)/pixelsPerStud,
            0)
        -- Widen the lens when needed to retain coverage within a 180-stud
        -- setback. The 120-degree FOV limit takes priority on extreme aspect ratios.
        local aimFieldOfView=math.clamp(math.deg(2*math.atan(visibleHeight/360)),50,120)
        camera.CameraType=Enum.CameraType.Scriptable
        camera.FieldOfView=aimFieldOfView
        cameraPosition=focus+Vector3.new(0,0,visibleHeight/(2*math.tan(math.rad(aimFieldOfView/2))))
        camera.CFrame=CFrame.lookAt(cameraPosition,cameraPosition-Vector3.new(0,0,1))
        camera.Focus=CFrame.new(focus)
    else
        camera.CameraType=Enum.CameraType.Scriptable
        local focus
        -- Keep ground and the staggered pickup field in view. Looking ahead makes
        -- upcoming choices readable without shrinking the plane every time it climbs.
        local aspect=camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y)
        local shortScreen=camera.ViewportSize.Y&lt;450
        local fieldOfView=shortScreen and 85 or 70
        camera.FieldOfView=fieldOfView
        local visibleHeight=shortScreen and 300 or 260
        local centerHeight=shortScreen and 125 or 105
        local visibleWidth=visibleHeight*aspect
        local ahead=math.min(145,visibleWidth*0.21)
        if phase=="Flight" and target and target.flight then
            focus,visibleHeight=duelFrame(camera.ViewportSize,target)
        elseif active and target and target.flight then
            local s=smooth[target.userId] or target.flight
            -- Follow a high climb gently so the aircraft stays below the HUD.
            -- The ground returns into view as soon as the plane descends.
            local viewCenterHeight=math.max(centerHeight,s.y+(shortScreen and 5 or -20))
            focus=World.COURSE_ORIGIN+Vector3.new(s.x+ahead,viewCenterHeight,0)
        else
            focus=World.COURSE_ORIGIN+Vector3.new(ahead,centerHeight,0)
        end
        local desired=focus+Vector3.new(0,0,visibleHeight/(2*math.tan(math.rad(fieldOfView/2))))
        cameraPosition=cameraPosition and cameraPosition:Lerp(desired,1-math.exp(-dt*6)) or desired
        camera.CFrame=CFrame.lookAt(cameraPosition,cameraPosition-Vector3.new(0,0,1))
        camera.Focus=CFrame.new(focus)
    end
    latest.viewingLobby=lobbyView
    local inset=GuiService:GetGuiInset()
    local field=phase=="Flight" and hud:getFlightViewport() or nil
    local previousMarker=nil
    for _,p in ipairs(latest.players) do
        local model,label=planes[p.userId],planeLabels[p.userId]
        if model and label then
            local point,visible=camera:WorldToViewportPoint(model:GetPivot().Position-Vector3.new(0,12,0))
            label.Visible=phase=="Flight"
            if field then
                local role=p.userId==localPlayer.UserId and "YOU" or (p.bot and "GHOST" or "RIVAL")
                local landed=p.flight and not p.flight.alive
                local outside=not visible or point.X&lt;field.left+35 or point.X&gt;field.right-35
                    or point.Y&lt;field.top or point.Y&gt;field.bottom-20
                local compact=camera.ViewportSize.X&lt;560 or camera.ViewportSize.Y&lt;450
                local labelHeight=compact and 28 or 32
                local width=(outside or landed) and math.min(compact and 210 or 250,camera.ViewportSize.X*0.48) or 94
                local x=math.clamp(point.X,field.left+width/2,field.right-width/2)
                local y=math.clamp(point.Y,field.top,field.bottom-labelHeight)
                local text=role
                if landed then text=text.." · "..tostring(math.floor(p.flight.distance+0.5)).." m FINAL"
                elseif outside and target and target.flight then
                    local gap=p.flight.x-target.flight.x
                    text=text.." · "..(gap&gt;=0 and "+" or "−")..tostring(math.floor(math.abs(gap)+0.5)).." m"
                end
                if outside then
                    local arrow=point.X&lt;field.left+35 and "←" or (point.X&gt;field.right-35 and "→"
                        or (point.Y&lt;field.top and "↑" or "↓"))
                    text=arrow.." "..text
                end
                if previousMarker and math.abs(x-previousMarker.x)&lt;(width+previousMarker.width)/2+4
                    and math.abs(y-previousMarker.y)&lt;labelHeight+2 then
                    y=y+labelHeight+4&lt;=field.bottom-labelHeight and y+labelHeight+4 or math.max(field.top,y-labelHeight-4)
                end
                label.Size=UDim2.fromOffset(width,labelHeight)
                label.Position=UDim2.fromOffset(x,y-inset.Y)
                label.Text=text
                label.TextSize=compact and 14 or 16
                label.TextXAlignment=Enum.TextXAlignment.Center
                label.TextTruncate=Enum.TextTruncate.AtEnd
                label.BackgroundColor3=Color3.fromRGB(23,39,77)
                label.BackgroundTransparency=outside and 0.12 or 1
                label:SetAttribute("EdgeMarker",outside)
                label:SetAttribute("Landed",landed)
                previousMarker={x=x,y=y,width=width}
            end
        end
    end
    if hud.setLobbyView then hud:setLobbyView(lobbyView) end
    hud:update(latest,localPlayer.UserId,watchedUserId)
    effectsShop:update(latest,own and own.settings)
    hangarBay:update(latest,own and own.settings,lobbyView,dt)
    if (phase=="Aim" or phase=="Countdown") and previewPlane then
        local origin,visible=camera:WorldToViewportPoint(previewPlane:GetPivot().Position)
        local points=table.create(#aimTrajectory)
        for index,point in ipairs(aimTrajectory) do
            local projected=camera:WorldToViewportPoint(World.COURSE_ORIGIN+Vector3.new(point.x,point.y,0))
            points[index]=Vector2.new(projected.X-inset.X,projected.Y-inset.Y)
        end
        hud:updateAimProjection(Vector2.new(origin.X-inset.X,origin.Y-inset.Y),points,visible)
    else
        hud:updateAimProjection(Vector2.zero,{},false)
    end
    audio:update(latest.players,lastRound,watchedUserId,phase=="Flight" or phase=="Results")
    local watchedModel=planes[watchedUserId]
    if phase=="Flight" and watchedModel and target and target.flight then
        local point, visible=camera:WorldToViewportPoint(watchedModel:GetPivot().Position)
        hud:updateFlightFeedback(target.flight,Vector2.new(point.X,point.Y-inset.Y),visible,renderTime)
    else
        hud:updateFlightFeedback(nil,Vector2.zero,false,renderTime)
    end
end)

send("request")
task.delay(2,function() if not latest then send("request") end end)
print("SKYBOUND_CLIENT_READY")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX39">
        <Properties>
          <string name="Name">Hud</string>
          <ProtectedString name="Source">-- SKYBOUND's client-only presentation. Match state and rewards stay on the server.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local PlaneCatalog = require(ReplicatedStorage:WaitForChild("FlightGame"):WaitForChild("PlaneCatalog"))
local PowerCatalog = require(ReplicatedStorage:WaitForChild("FlightGame"):WaitForChild("PowerCatalog"))
local CosmeticCatalog = require(ReplicatedStorage:WaitForChild("FlightGame"):WaitForChild("CosmeticCatalog"))
local Simulation = require(ReplicatedStorage:WaitForChild("FlightGame"):WaitForChild("Simulation"))

local FLIGHT_RECORD_FIELDS = { {"bestDistance", "FURTHEST FLIGHT"}, {"bestStreak", "BEST WIN STREAK"},
	{"wins", "DUEL WINS"}, {"currentStreak", "CURRENT STREAK"}, {"totalFlights", "FLIGHTS FLOWN"}, {"practiceFlights", "PRACTICE FLIGHTS"} }
local BATTLE_RECORD_FIELDS = { {"matches", "MATCHES COMPLETED"}, {"bestStreak", "BEST WIN STREAK"},
	{"wins", "MATCH WINS"}, {"currentStreak", "CURRENT STREAK"}, {"losses", "MATCH LOSSES"}, {"draws", "MATCH DRAWS"} }

local Hud = {}
Hud.__index = Hud

local COLORS = {
	ink = Color3.fromRGB(23, 39, 77),
	muted = Color3.fromRGB(67, 87, 117),
	white = Color3.fromRGB(255, 254, 247),
	soft = Color3.fromRGB(214, 236, 253),
	blue = Color3.fromRGB(20, 109, 211),
	cyan = Color3.fromRGB(64, 224, 248),
	green = Color3.fromRGB(105, 226, 66),
	coral = Color3.fromRGB(242, 79, 106),
	line = Color3.fromRGB(156, 191, 221),
	gold = Color3.fromRGB(255, 217, 65),
	amber = Color3.fromRGB(153, 79, 12),
}
local DISPLAY_TEXT = {
	Brand = true, Title = true, Timer = true, Name = true, Votes = true,
	Distance = true, OpponentDistance = true, YourDistance = true, BestDistance = true,
	Lead = true, Rank = true, RewardAmount = true, RewardGoal = true,
}
local PAINTS = {
	Color3.fromRGB(255, 104, 102),
	Color3.fromRGB(66, 225, 239),
	Color3.fromRGB(255, 212, 80),
	Color3.fromRGB(184, 138, 255),
}
local PAINT_NAMES = { "Coral", "Cyan", "Gold", "Lilac" }
local POWER_IDS = { "Pinball", "Muncher", "Meteor" }
local POWER_COPY = {
	Pinball = { promise = "Turn crashes into takeoffs.", plan = "AIM LOW · BOUNCE FAR", sound = "BOING!" },
	Muncher = { promise = "Danger is your rocket fuel.", plan = "AIM AT THE MISSILES", sound = "CHOMP!" },
	Meteor = { promise = "Drop hard. Blast forward.", plan = "AIM HIGH · BUILD SPEED", sound = "BOOOM!" },
}
local PHASE_NAMES = {
	Lobby = "FLIGHT CLUB",
	Queued = "FINDING YOUR RIVAL",
	Waiting = "GETTING READY",
	Voting = "CHOOSE A COURSE",
	Configure = "CHOOSE YOUR POWER",
	Aim = "AIM YOUR JET",
	Countdown = "CLEARED FOR TAKEOFF",
	Flight = "GO THE DISTANCE",
	Results = "FLIGHT RESULTS",
}

local function create(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 14) }, parent)
end

local function stroke(parent, color, thickness)
	local edge = parent:FindFirstChild("Border") or create("UIStroke", {
		Name = "Border", ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
	edge.Color = color or COLORS.ink
	edge.Thickness = thickness or 2
	return edge
end

local function gloss(parent)
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(207, 225, 245)),
	}, parent)
end

local function frame(parent, name, x, y, width, height, color)
	return create("Frame", {
		Name = name,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = color or COLORS.white,
		BorderSizePixel = 0,
	}, parent)
end

local function label(parent, name, text, x, y, width, height, size, color, bold)
	local display = DISPLAY_TEXT[name] == true
	local result = create("TextLabel", {
		Name = name,
		Text = text,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		TextColor3 = display and (name == "Timer" or name == "Brand") and COLORS.gold
			or (display and COLORS.white or color or COLORS.ink),
		Font = display and Enum.Font.FredokaOne or (bold and Enum.Font.GothamBold or Enum.Font.GothamMedium),
		TextSize = size or 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
	if display then
		create("UIStroke", {
			Name = "LetterOutline", Color = COLORS.ink, Thickness = size &gt;= 23 and 2 or 1.4,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		}, result)
	end
	return result
end

local function button(parent, name, text, x, y, width, height, color)
	local result = create("TextButton", {
		Name = name,
		Text = text,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = color or COLORS.soft,
		BorderSizePixel = 0,
		TextColor3 = COLORS.white,
		TextStrokeColor3 = COLORS.ink,
		TextStrokeTransparency = 0,
		Font = Enum.Font.FredokaOne,
		TextSize = 20,
		AutoButtonColor = true,
		Selectable = true,
	}, parent)
	corner(result, 13)
	stroke(result, COLORS.ink, 2)
	gloss(result)
	local lip = frame(result, "BottomLip", 0, 0, 0, 4, COLORS.ink)
	lip.Position = UDim2.new(0.04, 0, 1, -7)
	lip.Size = UDim2.new(0.92, 0, 0, 4)
	lip.BackgroundTransparency = 0.75
	corner(lip, 2)
	return result
end

-- Native silhouettes stay crisp at both desktop and compact phone badge sizes.
local function courseIcon(badge, name)
	local function shape(id, x, y, w, h, round, color, rotation)
		local part = frame(badge, id, 0, 0, 0, 0, color or COLORS.white)
		part.Position, part.Size = UDim2.fromScale(x, y), UDim2.fromScale(w, h)
		part.Rotation = rotation or 0
		if round then corner(part, 100) end
		return part
	end
	if name == "Skyline" then
		shape("TowerLeft", 0.18, 0.38, 0.2, 0.42)
		shape("TowerTall", 0.42, 0.18, 0.22, 0.62)
		shape("TowerRight", 0.68, 0.46, 0.15, 0.34)
		shape("Window", 0.47, 0.3, 0.1, 0.09, false, COLORS.ink)
	elseif name == "Storm" then
		shape("BoltTop", 0.44, 0.15, 0.2, 0.43, false, COLORS.gold, 28)
		shape("BoltBar", 0.32, 0.43, 0.38, 0.14, false, COLORS.gold)
		shape("BoltBottom", 0.34, 0.46, 0.2, 0.4, false, COLORS.gold, 28)
	else
		shape("CloudLeft", 0.13, 0.4, 0.43, 0.32, true)
		shape("CloudTop", 0.34, 0.23, 0.4, 0.48, true)
		shape("CloudRight", 0.55, 0.43, 0.34, 0.29, true)
	end
end

local function distance(value, precise)
	if precise then return string.format("%.1f m", tonumber(value) or 0) end
	return string.format("%s m", tostring(math.floor((tonumber(value) or 0) + 0.5)))
end

local function sameSettings(a, b)
	return a and b and a.planeId == b.planeId and a.angle == b.angle
		and a.powerId == b.powerId and a.color == b.color
end

local function selection(settings)
	settings = settings or {}
	local planeId = table.find(PlaneCatalog.ORDER, settings.planeId) and settings.planeId or PlaneCatalog.DEFAULT_ID
	local plane = PlaneCatalog.get(planeId)
	local angle = settings.angle
	if type(angle) ~= "number" or angle ~= angle or math.abs(angle) == math.huge then angle = plane.angle end
	return {
		planeId = planeId,
		angle = math.clamp(math.round(angle), 15, 60),
		powerId = table.find(POWER_IDS, settings.powerId) and settings.powerId or PowerCatalog.DEFAULT_ID,
		gadget = "Shield", -- Kept in the payload for older clients; powers replace gadgets.
		color = type(settings.color) == "number" and math.clamp(math.floor(settings.color), 1, #PAINTS) or 1,
	}
end

-- Forward pointing keeps the last valid angle near the pivot or behind the jet.
local function forwardAimAngle(origin, pointer)
	local direction = pointer - origin
	if direction.Magnitude &lt; 16 or direction.X &lt;= 0 then return nil end
	return math.clamp(math.round(math.deg(math.atan2(-direction.Y, direction.X))), 15, 60)
end

local function statNumber(value)
	return (string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", ""))
end

function Hud:_connect(signal, handler)
	table.insert(self.connections, signal:Connect(handler))
end

function Hud:_call(name, ...)
	local handler = self.callbacks[name]
	if handler then
		handler(...)
	end
end

-- Each target owns at most one finite tween. Resize, selection, and destruction
-- can replace it without leaving animation tasks or signal connections behind.
function Hud:_tween(target, duration, properties, delay, reverses)
	if self.tweens[target] then self.tweens[target]:Cancel() end
	if self.reducedMotion then
		if not reverses then
			for key, value in pairs(properties) do target[key] = value end
		end
		return
	end
	local tween = TweenService:Create(target, TweenInfo.new(duration, Enum.EasingStyle.Back,
		Enum.EasingDirection.Out, 0, reverses == true, delay or 0), properties)
	self.tweens[target] = tween
	tween:Play()
end

local function powerColor(id)
	local color = PowerCatalog.get(id).color
	return Color3.fromRGB(color.r, color.g, color.b)
end

local function powerArtwork(parent, id)
	local art = frame(parent, "Artwork", 0, 0, 160, 108, COLORS.white)
	art.BackgroundTransparency = 1
	art.AnchorPoint = Vector2.new(0.5, 0.5)
	local scale = create("UIScale", { Scale = 1 }, art)
	local function shape(name, x, y, w, h, color, rotation, round)
		local part = frame(art, name, x, y, w, h, color)
		part.Rotation = rotation or 0
		if round then corner(part, round) end
		return part
	end
	if id == "Pinball" then
		local ring = shape("BounceRing", 35, 5, 90, 90, COLORS.white, 0, 90)
		ring.BackgroundTransparency = 0.65
		stroke(ring, COLORS.white, 5)
		shape("Ground", 20, 98, 120, 5, COLORS.ink, 0, 3)
		for index = 1, 3 do shape("BounceMark" .. index, 33 + index * 21, 89, 6, 6, COLORS.white, -25, 6) end
	elseif id == "Meteor" then
		shape("OuterFlame", 15, 21, 108, 39, Color3.fromRGB(255, 88, 43), 27, 25)
		shape("MiddleFlame", 28, 26, 96, 32, COLORS.gold, 27, 25)
		shape("InnerFlame", 49, 38, 77, 19, COLORS.white, 27, 25)
	else
		shape("ChompHalo", 27, 4, 103, 90, Color3.fromRGB(55, 125, 49), -12, 65)
		for index = 1, 3 do shape("SpeedLine" .. index, 9, 29 + index * 15, 35, 5, COLORS.white, 0, 3) end
	end
	local jet = frame(art, "Plane", 80, 50, 100, 66, COLORS.white)
	jet.AnchorPoint = Vector2.new(0.5, 0.5)
	jet.BackgroundTransparency = 1
	jet.Rotation = id == "Meteor" and 25 or -15
	local function part(name, x, y, w, h, color, rotation)
		local item = frame(jet, name, x, y, w, h, color)
		item.Rotation = rotation or 0
		corner(item, 6)
		stroke(item, COLORS.ink, 2)
		return item
	end
	part("Tail", 9, 13, 18, 42, COLORS.white, -20)
	part("Wing", 42, 5, 21, 58, COLORS.white, -20)
	part("Body", 10, 25, 84, 20, COLORS.white)
	part("Cockpit", 68, 28, 15, 9, COLORS.cyan)
	if id == "Muncher" then
		local mouth = part("Mouth", 77, 18, 33, 33, COLORS.ink)
		corner(mouth, 16)
		for index = 1, 3 do
			local tooth = frame(mouth, "TopTooth" .. index, 5 + (index - 1) * 9, 2, 6, 10, COLORS.white)
			corner(tooth, 2)
			local bottom = frame(mouth, "BottomTooth" .. index, 5 + (index - 1) * 9, 23, 6, 8, COLORS.white)
			corner(bottom, 2)
		end
	end
	local sound = label(art, "Sound", POWER_COPY[id].sound, 59, 80, 106, 25, 19, COLORS.white, true)
	sound.Font, sound.Rotation = Enum.Font.FredokaOne, -9
	sound.TextStrokeColor3, sound.TextStrokeTransparency = COLORS.ink, 0
	return { frame = art, scale = scale, plane = jet }
end

function Hud:_animatePowerChoice(entrance)
	for index, id in ipairs(POWER_IDS) do
		local card = self.powerCards[id]
		local selected = id == self.settings.powerId
		if entrance and not self.reducedMotion then card.scale.Scale = 0.84 end
		self:_tween(card.scale, 0.3, { Scale = selected and 1.02 or 0.97 }, entrance and (index - 1) * 0.09 or 0)
		self:_tween(card.button, 0.25, { Rotation = selected and -1.5 or 0 })
		if selected and not entrance then
			local angle = id == "Meteor" and 47 or (id == "Pinball" and -34 or -5)
			self:_tween(card.art.plane, 0.24, { Rotation = angle }, 0, true)
		end
	end
end

function Hud:_showPowerBurst(title, detail, color, duration)
	self.powerBurstTitle.Text = title
	self.powerBurstDetail.Text = detail
	self.powerBurst.BackgroundColor3 = color
	self.powerBurstUntil = workspace:GetServerTimeNow() + duration
	self.powerBurst.Visible = true
	self.powerBurstScale.Scale = self.reducedMotion and 1 or 0.72
	self:_tween(self.powerBurstScale, 0.34, { Scale = 1 })
end

function Hud:_panel(name, height)
	local panel = create("ScrollingFrame", {
		Name = name,
		Size = UDim2.fromOffset(470, height),
		Position = UDim2.new(0.5, 0, 0.5, 24),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = COLORS.white,
		BorderSizePixel = 0,
		Visible = false,
		CanvasSize = UDim2.fromOffset(0, height),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = COLORS.muted,
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		ClipsDescendants = true,
	}, self.gui)
	corner(panel, 22)
	stroke(panel, COLORS.ink, 3)
	local scale = create("UIScale", { Scale = 1 }, panel)
	table.insert(self.scaledPanels, { panel = panel, scale = scale, height = height })
	return panel
end

function Hud:_stageOpen()
	return not self.configEndsAt or self.configEndsAt &lt;= 0 or workspace:GetServerTimeNow() &lt; self.configEndsAt
end

function Hud:_canConfigure()
	return self.phase == "Configure" and self:_stageOpen()
end

function Hud:_canAim()
	return self.phase == "Aim" and self:_stageOpen()
end

-- Main projects the actual jet and physics arc into ScreenGui coordinates.
-- Points can extend beyond the visible aim field; those dots are simply hidden.
function Hud:updateAimProjection(origin, points, visible)
	self.aimScreenOrigin = origin
	self.aimScreenPoints = points or {}
	self.aimProjectionVisible = visible == true and origin ~= nil
	if not self.aimProjectionVisible and self.aimDrag then self:_finishAim(false) end
	self:_refreshAim()
	if self.aimFocusPending and self.aimPad.Selectable then
		self.aimFocusPending = false
		GuiService.SelectedObject = self.aimPad
	end
end

function Hud:_refreshAim()
	if not self.aimPad then return end
	local inAim = self.phase == "Aim" or self.phase == "Countdown"
	local visible = inAim and self.aimProjectionVisible == true
	local locked = not self:_canAim()
	local interactive = visible and not locked
	self.aimPad.Visible = inAim
	self.aimPad.Active, self.aimPad.Selectable = interactive, interactive
	local selected = GuiService.SelectedObject == self.aimPad
	local touch = self.aimLastTouch == true or (self.aimLastTouch == nil and UserInputService.TouchEnabled)
	self.aimHint.Text = locked and "FLIGHT PLAN LOCKED" or (selected and "D-PAD ← / → TO AIM"
		or (touch and "TAP OR DRAG TO AIM" or "CLICK OR DRAG TO AIM"))
	local size = self.aimPad.AbsoluteSize
	local short = self.lastViewport.Y &lt; 400
	local function inside(point, margin)
		return point.X &gt;= margin and point.Y &gt;= margin and point.X &lt;= size.X - margin and point.Y &lt;= size.Y - margin
	end
	local points = self.aimScreenPoints or {}
	local dotDiameter = short and 12 or 16
	local lastDotPoint = nil
	for index, dot in ipairs(self.aimDots) do
		local point = visible and #points &gt; 0 and points[math.clamp(math.round(index / #self.aimDots * (#points - 1)) + 1, 1, #points)] or nil
		local localPoint = point and point - self.aimPad.AbsolutePosition
		-- Leave a gap between the larger circles when a phone compresses the arc.
		dot.Visible = localPoint ~= nil and inside(localPoint, dotDiameter / 2 + 2)
			and (lastDotPoint == nil or (localPoint - lastDotPoint).Magnitude &gt;= dotDiameter + 8)
		dot.Size = UDim2.fromOffset(dotDiameter, dotDiameter)
		if localPoint then dot.Position = UDim2.fromOffset(localPoint.X, localPoint.Y) end
		if dot.Visible then lastDotPoint = localPoint end
	end
end

function Hud:_beginAim(input)
	local touch = input.UserInputType == Enum.UserInputType.Touch
	if self.aimDrag or not self:_canAim() or not self.aimProjectionVisible or (not touch and input.UserInputType ~= Enum.UserInputType.MouseButton1) then return end
	local pointer = Vector2.new(input.Position.X, input.Position.Y)
	local fromOrigin = pointer - self.aimScreenOrigin
	if fromOrigin.X &lt; 0 and fromOrigin.Magnitude &gt; 16 then return end
	self.aimLastTouch = touch
	self.aimDrag = { input = input, touch = touch, startSettings = table.clone(self.settings) }
	-- Unready before aiming so the other pilot cannot start a countdown mid-drag.
	if self.ready then
		self.ready = false
		self.pendingReady = false
		self.readyPendingUntil = workspace:GetServerTimeNow() + 0.75
		self:_call("ready", false)
	end
	self:_dragAim(input.Position)
end

function Hud:_dragAim(position)
	if not self.aimDrag then return end
	if not self:_canAim() then self:_finishAim(false); return end
	-- InputObject.Position already shares the inset-adjusted GUI coordinate space.
	local pointer = Vector2.new(position.X, position.Y)
	local angle = forwardAimAngle(self.aimScreenOrigin, pointer)
	if angle then self.settings.angle = angle end
	self:_refreshSettings()
end

function Hud:_finishAim(commit)
	local drag = self.aimDrag
	if not drag then return end
	local chosen = table.clone(self.settings)
	self.aimDrag = nil
	self.settings = drag.startSettings
	if commit and self:_canAim() then self:setLocalSettings({ angle = chosen.angle }) end
	self:_refreshSettings()
end

function Hud:_refreshSettings()
	local setting = self.settings
	local plane = PlaneCatalog.get(setting.planeId)
	local power = PowerCatalog.get(setting.powerId)
	self.fixedStats.Text = string.upper(power.name) .. "  ·  " .. statNumber(setting.angle) .. "°"
	self.planeSpeed.Text = plane.name .. "  ·  " .. statNumber(plane.speed) .. " m/s"
	self.planeStrategy.Text = plane.description
	for id, control in pairs(self.planeButtons) do
		local chosen = setting.planeId == id
		control.Text = (chosen and "✓ " or "") .. PlaneCatalog.get(id).name
		control.BackgroundColor3 = chosen and COLORS.green or COLORS.blue
		self.planeStrokes[id].Thickness = chosen and 3 or 2
	end
	self.powerSummary.Text = string.upper(power.name) .. " · " .. power.description
	for id, card in pairs(self.powerCards) do
		local selected = setting.powerId == id
		card.edge.Color = selected and COLORS.white or COLORS.ink
		card.edge.Thickness = selected and 4 or 2
		card.chosen.Text = selected and "✓ YOUR POWER" or "CHOOSE"
		card.chosen.BackgroundColor3 = selected and COLORS.white or COLORS.ink
		card.chosen.TextColor3 = selected and COLORS.ink or COLORS.white
		card.button.BackgroundColor3 = powerColor(id)
	end
	for index, control in ipairs(self.colorButtons) do
		control.Text = setting.color == index and "✓" or ""
		self.colorStrokes[index].Thickness = setting.color == index and 4 or 2
	end
	self.paintName.Text = PAINT_NAMES[setting.color] .. " / cosmetic only"
	local locked = not self:_canConfigure()
	self.customizeButton.Text = self.compactPowerActions and (self.customizeOpen and "BACK TO\nPOWERS" or "PLANE /\nPAINT")
		or ((self.customizeOpen and "− " or "+ ") .. "PLANE &amp; PAINT  ·  " .. string.upper(plane.name))
	self.readyButton.Text = self.compactPowerActions and (self.ready and "LOCKED ✓" or "LOCK IN →")
		or (self.ready and "POWER LOCKED ✓" or "LOCK IN POWER  →")
	self.readyButton.BackgroundColor3 = self.ready and COLORS.green or COLORS.gold
	self.readyButton.Active = not locked
	self.readyButton.Selectable = not locked
	for _, control in ipairs(self.configControls) do
		control.Active = not locked
		control.Selectable = not locked
		control.AutoButtonColor = not locked
	end
	for _, control in pairs(self.planeButtons) do control.Selectable = not locked and self.customizeOpen end
	for _, control in ipairs(self.colorButtons) do control.Selectable = not locked and self.customizeOpen end
	if self.displayedPower ~= setting.powerId then
		self.displayedPower = setting.powerId
		self:_animatePowerChoice(false)
	end
	self.readyButton.NextSelectionUp = self.powerCards[setting.powerId].button
	local aimLocked = not self:_canAim()
	self.aimReadyButton.Text = self.phase == "Countdown" and "LAUNCHING…" or (self.ready and "READY ✓ · WAITING" or "READY TO LAUNCH")
	self.aimReadyButton.BackgroundColor3 = self.ready and COLORS.cyan or COLORS.green
	self.aimReadyButton.Active, self.aimReadyButton.Selectable = not aimLocked, not aimLocked
	self:_refreshAim()
end

function Hud:getLocalSettings()
	return table.clone(self.settings)
end

function Hud:setLobbyView(enabled)
	self.lobbyView = enabled == true
	self.lobbyButton.Text = "LEAVE DUEL"
end

-- The keyboard/controller owner can use these to share exactly the same UI state.
function Hud:setLocalSettings(settings)
	if not self:_canConfigure() and not self:_canAim() then return end
	if self.aimDrag then self:_finishAim(false) end
	local nextSettings = table.clone(self.settings)
	if self:_canConfigure() then
		if table.find(PlaneCatalog.ORDER, settings.planeId) and nextSettings.planeId ~= settings.planeId then
			nextSettings.planeId = settings.planeId
			nextSettings.angle = PlaneCatalog.get(settings.planeId).angle
		end
		if table.find(POWER_IDS, settings.powerId) then nextSettings.powerId = settings.powerId end
		if type(settings.color) == "number" and settings.color == settings.color and math.abs(settings.color) &lt; math.huge then
			nextSettings.color = math.clamp(math.floor(settings.color), 1, #PAINTS)
		end
	elseif type(settings.angle) == "number" and settings.angle == settings.angle and math.abs(settings.angle) &lt; math.huge then
		nextSettings.angle = math.clamp(math.round(settings.angle), 15, 60)
	end
	if sameSettings(nextSettings, self.settings) then return end
	self.settings = nextSettings
	self.pendingSettings = table.clone(nextSettings)
	self.pendingUntil = workspace:GetServerTimeNow() + 0.75
	if self.ready then
		self.ready = false
	end
	-- Configure atomically updates the settings and clears ready on the server.
	-- A second ready command here would race its command rate limiter.
	self.pendingReady = false
	self.readyPendingUntil = self.pendingUntil
	self:_refreshSettings()
	self:_call("configure", table.clone(nextSettings))
end

function Hud:toggleReady()
	if not self:_canConfigure() and not self:_canAim() then
		return
	end
	if self.aimDrag then self:_finishAim(true) end
	self.ready = not self.ready
	if self.phase == "Configure" and self.ready then
		self:_call("powerSelect", self.settings.powerId, true)
		self:_showPowerBurst(string.upper(PowerCatalog.get(self.settings.powerId).name) .. "!", "LOCKED IN · NEXT: AIM YOUR PLANE", powerColor(self.settings.powerId), 0.85)
	end
	self.pendingReady = self.ready
	self.readyPendingUntil = workspace:GetServerTimeNow() + 0.75
	self:_refreshSettings()
	self:_call("ready", self.ready)
end

function Hud.new(callbacks)
	local self = setmetatable({}, Hud)
	self.callbacks = callbacks or {}
	self.connections = {}
	self.tweens = {}
	self.reducedMotion = false
	pcall(function() self.reducedMotion = GuiService.ReducedMotionEnabled end)
	self.scaledPanels = {}
	self.configControls = {}
	self.settings = selection({ planeId = PlaneCatalog.DEFAULT_ID, powerId = PowerCatalog.DEFAULT_ID, color = 1 })
	self.customizeOpen = false
	self.ready = false
	self.phase = "Lobby"
	self.roundId = nil
	self.lastViewport = Vector2.zero
	self.pendingUntil = 0
	self.readyPendingUntil = 0
	self.lobbyView = false
	self.rematchRequested = false
