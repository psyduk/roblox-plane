	self.powerFlightBadge = frame(self.gui, "FlightPower", 0, 0, 300, 31, COLORS.gold)
	self.powerFlightBadge.AnchorPoint = Vector2.new(0.5, 0)
	self.powerFlightBadge.Visible = false
