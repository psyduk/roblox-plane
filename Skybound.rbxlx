	self.rewardAmount.TextColor3 = COLORS.gold
	self.rewardAmount.TextXAlignment = Enum.TextXAlignment.Center
	self.rewardBalance = label(self.rewardPanel, "Balance", "", 16, 53, 390, 20, 14, COLORS.white, true)
	self.rewardBalance.TextXAlignment = Enum.TextXAlignment.Center
	self.rewardGoal = label(self.rewardPanel, "RewardGoal", "NEXT: SKY BLUE", 16, 79, 390, 24, 21, COLORS.white, true)
	self.rewardGoal.TextXAlignment = Enum.TextXAlignment.Center
	create("UITextSizeConstraint", { MinTextSize = 14, MaxTextSize = 24 }, self.rewardGoal)
	self.rewardTrack = frame(self.rewardPanel, "ProgressTrack", 16, 110, 390, 14, COLORS.muted)
	corner(self.rewardTrack, 7)
	self.rewardFill = frame(self.rewardTrack, "ProgressFill", 0, 0, 0, 14, COLORS.cyan)
	corner(self.rewardFill, 7)
	self.rewardHint = label(self.rewardPanel, "ProgressHint", "", 16, 132, 390, 20, 14, COLORS.white, true)
	self.rewardHint.TextXAlignment = Enum.TextXAlignment.Center
	self.resultActions = frame(self.gui, "ResultActions", 0, 0, 470, 64)
	self.resultActions.AnchorPoint = Vector2.new(0.5, 0)
	self.resultActions.Visible = false
	corner(self.resultActions, 14)
	stroke(self.resultActions, COLORS.ink, 3)
	self.rematchButton = button(self.resultActions, "Rematch", "FLY AGAIN", 8, 8, 219, 48, COLORS.green)
	self.returnButton = button(self.resultActions, "ReturnLobby", "RETURN TO LOBBY", 239, 8, 223, 48, COLORS.soft)
	self:_connect(self.rematchButton.Activated, function()
		local now = workspace:GetServerTimeNow()
		if self.phase ~= "Results" or not self.canRematch or self.rematchRequested
			or now &lt; self.rematchPendingUntil then return end
		-- Only the server's rematchReady flag confirms acceptance.
		self.rematchPendingUntil = now + 1
		self.rematchButton.Text = "REQUESTING…"
		self.rematchButton.Active = false
		self:_call("rematch")
	end)
	self:_connect(self.returnButton.Activated, function() self:_call("returnLobby") end)
	self.header.Visible = false
	self:_makePersonalHud()
	self:_refreshSettings()
	return self
end

function Hud:_makePersonalHud()
	self.statsButton = button(self.gui, "MyStats", "MY STATS", 16, 100, 124, 44, COLORS.gold)
	self.soundButton = button(self.gui, "SoundToggle", "SOUND ON", 152, 100, 112, 44, COLORS.blue)
	self.soundButton.TextSize = 14
	self.soundMuted = false
	self:_connect(self.soundButton.Activated, function()
		self.soundMuted = not self.soundMuted
		self.soundButton.Text = self.soundMuted and "SOUND OFF" or "SOUND ON"
		self:_call("mute", self.soundMuted)
	end)
	self.statsOverlay = frame(self.gui, "PersonalStats", 0, 0, 0, 0, COLORS.ink)
	self.statsOverlay.Size = UDim2.fromScale(1, 1)
	self.statsOverlay.BackgroundTransparency = 0.2
	self.statsOverlay.ZIndex = 20
	self.statsOverlay.Active = true
	self.statsOverlay.Visible = false
	self.statsCard = frame(self.statsOverlay, "Card", 0, 0, 470, 338, COLORS.blue)
	self.statsCard.AnchorPoint = Vector2.new(0.5, 0.5)
	self.statsCard.Position = UDim2.fromScale(0.5, 0.5)
	corner(self.statsCard, 18); stroke(self.statsCard, COLORS.ink, 3); gloss(self.statsCard)
	label(self.statsCard, "Title", "YOUR FLIGHT RECORD", 18, 13, 380, 30, 24, COLORS.white, true)
	self.statsClose = button(self.statsCard, "Close", "X", 412, 8, 44, 44, COLORS.coral)
	self.statsValues = {}
	local fields = { {"bestDistance", "FURTHEST FLIGHT"}, {"bestStreak", "BEST WIN STREAK"},
		{"wins", "DUEL WINS"}, {"currentStreak", "CURRENT STREAK"},
		{"totalFlights", "FLIGHTS FLOWN"}, {"practiceFlights", "PRACTICE FLIGHTS"} }
	self.statsCells = {}
	for index, field in ipairs(fields) do
		local cell = frame(self.statsCard, field[1], 16, 60, 210, 64, index &lt;= 2 and COLORS.gold or COLORS.soft)
		corner(cell, 10); stroke(cell, COLORS.ink, 2)
		label(cell, "Caption", field[2], 12, 5, 184, 15, 10, COLORS.ink, true)
		self.statsValues[field[1]] = label(cell, "Distance", "0", 12, 23, 184, 32, 24, COLORS.white, true)
		table.insert(self.statsCells, cell)
	end
	self.statsRecord = label(self.statsCard, "Record", "0 wins  ·  0 losses  ·  0 draws", 18, 278, 434, 18, 11, COLORS.white, true)
	self.statsSave = label(self.statsCard, "SaveStatus", "Loading your record…", 18, 305, 434, 19, 11, COLORS.white)
	self.statsSave.TextWrapped = true
	self:_connect(self.statsButton.Activated, function() self.statsOverlay.Visible = not self.statsOverlay.Visible end)
	self:_connect(self.statsClose.Activated, function() self.statsOverlay.Visible = false end)
end

function Hud:_layoutPersonal(viewport, height)
	local width = math.min(620, viewport.X - 24)
	local short = height &lt; 430
	local cardHeight = math.min(short and 304 or 420, height - 16)
	self.statsCard.Size = UDim2.fromOffset(width, cardHeight)
	self.statsCard.Title.TextSize = width &lt; 400 and 22 or 30
	self.statsCard.Title.Size = UDim2.fromOffset(width - 80, 36)
	self.statsClose.Position = UDim2.fromOffset(width - 54, 10)
	local cellWidth = (width - 44) / 2
	local cellHeight = (cardHeight - 138) / 3
	for index, cell in ipairs(self.statsCells) do
		cell.Position = UDim2.fromOffset(16 + ((index - 1) % 2) * (cellWidth + 12), 61 + math.floor((index - 1) / 2) * (cellHeight + 8))
		cell.Size = UDim2.fromOffset(cellWidth, cellHeight)
		cell.Caption.Position = UDim2.fromOffset(10, 5)
		cell.Caption.Size = UDim2.fromOffset(cellWidth - 20, 18)
		cell.Caption.TextSize = width &lt; 400 and 11 or 13
		cell.Distance.Position = UDim2.fromOffset(10, 23)
		cell.Distance.Size = UDim2.fromOffset(cellWidth - 20, math.max(22, cellHeight - 25))
		cell.Distance.TextSize = short and 25 or (width &lt; 400 and 29 or 36)
	end
	self.statsRecord.Position = UDim2.fromOffset(18, cardHeight - 54)
	self.statsRecord.Size = UDim2.fromOffset(width - 36, 20)
	self.statsRecord.TextSize = width &lt; 400 and 13 or 15
	self.statsSave.Position = UDim2.fromOffset(18, cardHeight - 32)
	self.statsSave.Size = UDim2.fromOffset(width - 36, 28)
	self.statsSave.TextSize = 12
end

function Hud:_layoutDuel(viewport, height)
	local function place(item, x, y, width, sizeY)
		item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(width, sizeY)
	end
	local portrait = viewport.X &lt; 600
	local short = not portrait and height &lt; 430
	-- Hub: one full-width PLAY action below the plane appearance selector.
	local margin = portrait and 12 or 16
	local blockWidth = math.min(420, viewport.X - margin * 2)
	self.hubBlockWidth = blockWidth
	local playHeight = short and 54 or (portrait and 64 or 76)
	local blockLeft = (viewport.X - blockWidth) / 2
	-- Portrait phones keep Roblox's jump button in the bottom-right corner.
	local bottom = (short and -8 or -14) - ((portrait and UserInputService.TouchEnabled) and 104 or 0)
	self.hubAction.Position = UDim2.new(0, blockLeft, 1, bottom)
	self.hubAction.Size = UDim2.fromOffset(blockWidth, playHeight)
	self.hubAction.TextSize = short and 32 or (portrait and 36 or 44)
	place(self.playCaption, 0, playHeight - 20, blockWidth, 16)
	self.playCaption.TextSize = short and 10 or 12
	local rowHeight = short and 44 or 50
	local rowBottom = bottom - playHeight - 8
	local arrow = rowHeight - 8
	self.planeRow.Position = UDim2.new(0.5, 0, 1, rowBottom)
	self.planeRow.Size = UDim2.fromOffset(blockWidth, rowHeight)
	place(self.planePrevious, 4, 4, arrow, arrow)
	place(self.planeNext, blockWidth - arrow * 2 - 10, 4, arrow, arrow)
	place(self.paintButton, blockWidth - arrow - 4, 4, arrow, arrow)
	local nameWidth = blockWidth - arrow * 3 - 26
	place(self.planeName, arrow + 10, 2, nameWidth, math.floor(rowHeight * 0.56))
	place(self.planeDetail, arrow + 10, math.floor(rowHeight * 0.58), nameWidth, math.floor(rowHeight * 0.34))
	self.planeDetail.TextSize = short and 10 or 11
	local hubHeight = short and 54 or 64
	self.hubCard.Position = UDim2.new(0.5, 0, 1, rowBottom)
	self.hubCard.Size = UDim2.fromOffset(blockWidth, hubHeight)
	place(self.hubTitle, 14, 5, blockWidth - 28, math.floor(hubHeight * 0.5))
	place(self.hubInstruction, 14, math.floor(hubHeight * 0.55), blockWidth - 28, math.floor(hubHeight * 0.38))
	self.hubInstruction.TextSize = blockWidth &lt; 350 and 12 or 13
	local utilityY = short and 6 or 10
	local utilityWidth = portrait and (viewport.X - 36) / 2 or (short and 132 or 148)
	place(self.statsButton, margin, utilityY, utilityWidth, short and 44 or 46)
	self.statsButton.TextSize = short and 17 or 19
	self.hubSoundPosition = UDim2.fromOffset((portrait and 12 or 16) + utilityWidth + 12, utilityY)
	self.hubSoundSize = UDim2.fromOffset(utilityWidth, short and 44 or 46)
	-- Distances lead the scoreboard; two slim rows retain the shared race view.
	local flightWidth = math.min(900, viewport.X - 24)
	local flightHeight = short and 72 or (portrait and 82 or 94)
	local column = (flightWidth - 32) / 3
	self.flightPanel.Position = UDim2.new(0.5, 0, 0, 6)
	self.flightPanel.Size = UDim2.fromOffset(flightWidth, flightHeight)
	self.flightPanel.CanvasSize = UDim2.fromOffset(0, flightHeight)
	self.flightPanel.Rule.Visible = false
	local numberY, numberHeight = short and 18 or 24, short and 32 or 40
	place(self.ownPilot, 12, 4, column, 18)
	place(self.opponentPilot, flightWidth - column - 12, 4, column, 18)
	self.ownPilot.TextSize, self.opponentPilot.TextSize = portrait and 12 or 14, portrait and 12 or 14
	self.ownPilot.TextTruncate, self.opponentPilot.TextTruncate = Enum.TextTruncate.AtEnd, Enum.TextTruncate.AtEnd
	place(self.flightDistance, 12, numberY, column, numberHeight)
	place(self.opponentDistance, flightWidth - column - 12, numberY, column, numberHeight)
	self.flightDistance.TextSize, self.opponentDistance.TextSize = portrait and 30 or (short and 31 or 42), portrait and 30 or (short and 31 or 42)
	place(self.leadLabel, 16 + column, short and 8 or 12, column, portrait and 35 or 29)
	self.leadLabel.TextSize = portrait and 16 or (short and 21 or 25)
	self.leadLabel.TextWrapped = true
	place(self.flightStatus, 16 + column, short and 38 or 47, column, 21)
	self.flightStatus.TextXAlignment = Enum.TextXAlignment.Center
	self.flightStatus.TextSize = portrait and 11 or (short and 12 or 14)
	place(self.watchedLabel, 12, flightHeight - 21, flightWidth / 2 - 18, 18)
	self.watchedLabel.TextSize = portrait and 11 or 13
	place(self.flightStats, flightWidth / 2, flightHeight - 21, flightWidth / 2 - 12, 18)
	self.flightStats.TextSize = portrait and 11 or 13
	self.flightStats.TextXAlignment = Enum.TextXAlignment.Right
	self.flightStats.TextTruncate = Enum.TextTruncate.AtEnd
	self.flightControls.AnchorPoint = Vector2.new(1, 1)
	self.flightControls.Position = UDim2.new(1, -12, 1, -26)
	local controlsWidth = portrait and 274 or (short and 286 or 410)
	local controlsHeight = short and 48 or 58
	self.flightControls.Size = UDim2.fromOffset(controlsWidth, controlsHeight)
	self.flightControls.CanvasSize = UDim2.fromOffset(0, controlsHeight)
	local controlY = short and 2 or 5
	place(self.flightControls.PreviousPilot, 5, controlY, 46, 44)
	self.spectateLabel.Visible = not portrait and not short
	self.spectateLabel.Text = "CAMERA"
	self.spectateLabel.TextSize = 15
	place(self.spectateLabel, 57, controlY, 82, 44)
	local nextX = self.spectateLabel.Visible and 145 or 57
	place(self.flightControls.NextPilot, nextX, controlY, 46, 44)
	place(self.lobbyButton, nextX + 54, controlY, controlsWidth - nextX - 59, 44)
	self.lobbyButton.TextSize = portrait and 15 or 17
	self:_layoutResults(viewport, height)
end

function Hud:_layoutResults(viewport, height)
	local function place(item, x, y, width, sizeY)
		item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(width, sizeY)
	end
	local landscape = viewport.X &gt;= 600 and height &lt; 470
	local width = math.min(landscape and 960 or 620, viewport.X - 24)
	local inner = width - 32
	local top = self.header.Position.Y.Offset + self.header.Size.Y.Offset + 10
	local actionsHeight = landscape and 60 or 72
	local available = math.max(118, height - top - actionsHeight - 18)
	local contentHeight = landscape and 172 or 536
	local visible = math.min(contentHeight, available)
	self.resultsPanel.AnchorPoint = Vector2.new(0.5, 0)
	self.resultsPanel.Position = UDim2.new(0.5, 0, 0, top)
	self.resultsPanel.Size = UDim2.fromOffset(width, visible)
	self.resultsPanel.CanvasSize = UDim2.fromOffset(0, contentHeight)
	self.resultsPanel.Eyebrow.Visible = not landscape
	place(self.resultsPanel.Eyebrow, 20, 12, inner - 8, 18)
	self.resultsPanel.Eyebrow.TextSize = 12
	place(self.resultsPanel.Title, 16, landscape and 7 or 34, inner, landscape and 30 or 43)
	self.resultsPanel.Title.TextSize = landscape and 28 or (width &lt; 430 and 29 or 39)
	place(self.resultMessage, 18, landscape and 42 or 78, inner - 4, 22)
	self.resultMessage.TextSize = width &lt; 430 and 13 or 15
	self.resultMessage.TextTruncate = Enum.TextTruncate.AtEnd
	self.resultMessage.Visible = not landscape
	local scoreWidth = landscape and (inner - 16) / 2 or inner
	local rowY = landscape and 43 or 113
	local rowHeight = landscape and 38 or 49
	for index, row in ipairs(self.resultRows) do
		place(row.frame, 16, rowY + (index - 1) * (rowHeight + (landscape and 6 or 8)), scoreWidth, rowHeight)
		place(row.rank, 9, 0, 28, rowHeight)
		place(row.name, 42, 0, scoreWidth - 162, rowHeight)
		place(row.distance, scoreWidth - 116, 0, 105, rowHeight)
		row.rank.TextSize = 22
		row.name.TextSize = width &lt; 430 and 14 or 17
		row.distance.TextSize = 23
	end
	local personal = self.resultsPanel.PersonalResult
	place(personal, 16, landscape and 133 or 232, scoreWidth, landscape and 30 or 75)
	local half = scoreWidth / 2
	place(personal.YourLabel, 12, 5, half - 16, 18)
	place(personal.BestLabel, half + 4, 5, half - 16, 18)
	personal.YourLabel.TextSize, personal.BestLabel.TextSize = 11, 11
	place(self.yourDistance, 12, landscape and 24 or 29, half - 16, landscape and 29 or 36)
	place(self.bestDistance, half + 4, landscape and 24 or 29, half - 16, landscape and 29 or 36)
	self.yourDistance.TextSize, self.bestDistance.TextSize = landscape and 26 or 30, landscape and 26 or 30
	personal.YourLabel.Visible, self.yourDistance.Visible = not landscape, not landscape
	if landscape then
		place(personal.BestLabel, 10, 5, half - 8, 20)
		place(self.bestDistance, half, 1, half - 12, 28)
	end
	local rewardWidth = landscape and scoreWidth or inner
	local rewardHeight = landscape and 122 or 175
	place(self.rewardPanel, landscape and 32 + scoreWidth or 16, landscape and 43 or 322, rewardWidth, rewardHeight)
	local rewardInner = rewardWidth - 24
	place(self.rewardAmount, 12, landscape and 1 or 5, rewardInner, landscape and 39 or 45)
	self.rewardAmount.TextSize = landscape and 34 or (width &lt; 430 and 35 or 43)
	self.rewardTextSize = self.rewardAmount.TextSize
	place(self.rewardBalance, 12, landscape and 37 or 51, rewardInner, landscape and 18 or 21)
	self.rewardBalance.TextSize = 14
	place(self.rewardGoal, 12, landscape and 58 or 78, rewardInner, landscape and 24 or 27)
	self.rewardGoal.TextSize = width &lt; 430 and 21 or 24
	self.rewardGoal.TextScaled = landscape
	place(self.rewardTrack, 14, landscape and 87 or 115, rewardWidth - 28, landscape and 10 or 14)
	place(self.rewardHint, 12, landscape and 102 or 137, rewardInner, landscape and 18 or 23)
	self.rewardHint.TextSize = landscape and 13 or 14
	self.nextRoundLabel.Visible = not landscape
	place(self.nextRoundLabel, 16, 507, inner, 20)
	self.nextRoundLabel.TextSize = 12
	self.resultActions.Position = UDim2.new(0.5, 0, 0, top + visible + 8)
	self.resultActions.Size = UDim2.fromOffset(width, actionsHeight)
	local actionWidth = (width - 24) / 2
	place(self.rematchButton, 8, 8, actionWidth, actionsHeight - 16)
	place(self.returnButton, 16 + actionWidth, 8, actionWidth, actionsHeight - 16)
	self.rematchButton.TextSize = width &lt; 430 and 15 or 21
	self.returnButton.TextSize = width &lt; 430 and 15 or 21
	self.rematchButton.TextWrapped, self.returnButton.TextWrapped = true, true
	self.returnButton.Text = "BACK TO HANGAR"
end

function Hud:_layoutPowerChoices(viewport, height)
	local function place(item, x, y, w, h)
		item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
	end
	local portrait = viewport.X &lt; 600
	local short = not portrait and height &lt; 430
	self.compactPowerActions = portrait or short
	local width = math.min(1000, math.max(260, viewport.X - 24))
	local top = self.header.Position.Y.Offset + self.header.Size.Y.Offset + 9
	local actionHeight = portrait and 124 or (short and 72 or 92)
	local availableBody = math.max(130, height - top - actionHeight - 26)
	local headingHeight = portrait and 66 or (short and 34 or 88)
	local cardHeight = portrait and math.clamp((availableBody - headingHeight - 12) / 3 - 10, 116, 150)
		or (short and math.clamp(availableBody - headingHeight - 10, 94, 126) or 274)
	local gap = portrait and 12 or (short and 14 or 22)
	local cardWidth = portrait and width - 32 or (width - 36 - gap * 2) / 3
	local cardTop = headingHeight + (short and 2 or 7)
	local cardsBottom = cardTop + (portrait and (cardHeight * 3 + gap * 2) or cardHeight)
	local drawerTop = cardsBottom + (short and 12 or 18)
	local drawerHeight = short and 132 or 190
	local contentHeight = self.compactPowerActions and (self.customizeOpen and drawerTop + drawerHeight + 12 or cardsBottom + 12)
		or (drawerTop + 48 + (self.customizeOpen and 194 or 0) + 12)
	local bodyHeight = math.min(contentHeight, availableBody)
	self.configPanel.AnchorPoint = Vector2.new(0.5, 0)
	self.configPanel.Position = UDim2.new(0.5, 0, 0, top)
	self.configPanel.Size = UDim2.fromOffset(width, bodyHeight)
	self.configPanel.CanvasSize = UDim2.fromOffset(0, contentHeight)
	place(self.powerHeadline, 12, short and 2 or 9, width - 24, short and 30 or (portrait and 35 or 48))
	self.powerHeadline.TextSize = short and 24 or (portrait and (width &lt; 350 and 22 or 25) or 38)
	self.powerSubhead.Visible = not short
	place(self.powerSubhead, 12, portrait and 43 or 57, width - 24, 19)
	self.powerSubhead.TextSize = portrait and 12 or 16
	for index, id in ipairs(POWER_IDS) do
		local card = self.powerCards[id]
		local x = portrait and width / 2 or 18 + cardWidth / 2 + (index - 1) * (cardWidth + gap)
		local y = cardTop + cardHeight / 2 + (portrait and (index - 1) * (cardHeight + gap) or 0)
		place(card.button, x, y, cardWidth, cardHeight)
		local title = string.upper(PowerCatalog.get(id).name)
		card.title.Text = title
		if portrait then
			local artWidth = cardWidth &lt; 320 and 88 or 102
			local textLeft = artWidth + 8
			local textWidth = cardWidth - textLeft - 10
			card.art.frame.Position = UDim2.fromOffset(artWidth / 2 + 5, cardHeight / 2 + 5)
			card.art.scale.Scale = cardWidth &lt; 320 and 0.59 or 0.68
			place(card.chosen, textLeft, 8, textWidth, 21)
			card.chosen.TextSize = 12
			place(card.title, textLeft, 32, textWidth, 27)
			card.title.TextSize = cardWidth &lt; 320 and 21 or 25
			card.title.TextXAlignment = Enum.TextXAlignment.Left
			card.promise.Visible = cardHeight &gt;= 144
			place(card.promise, textLeft, 61, textWidth, 32)
			card.promise.TextSize = 12
			card.promise.TextXAlignment = Enum.TextXAlignment.Left
			place(card.plan, textLeft, cardHeight - 37, textWidth, 28)
			card.plan.TextSize = 12
			card.plan.TextXAlignment = Enum.TextXAlignment.Left
		elseif short then
			card.art.frame.Position = UDim2.fromOffset(32, 49)
			card.art.scale.Scale = 0.34
			place(card.chosen, 7, 5, cardWidth - 14, 18)
			card.chosen.TextSize = 11
			place(card.title, 63, 27, cardWidth - 71, 44)
			card.title.TextSize = cardWidth &lt; 205 and 18 or 21
			card.title.TextXAlignment = Enum.TextXAlignment.Center
			card.promise.Visible = false
			place(card.plan, 9, cardHeight - 33, cardWidth - 18, 27)
			card.plan.TextSize = 12
			card.plan.TextXAlignment = Enum.TextXAlignment.Center
		else
			card.art.frame.Position = UDim2.fromOffset(cardWidth / 2, 83)
			card.art.scale.Scale = math.min(1.08, cardWidth / 240)
			place(card.chosen, 12, 10, cardWidth - 24, 21)
			card.chosen.TextSize = 13
			place(card.title, 10, 142, cardWidth - 20, 59)
			card.title.TextSize = cardWidth &lt; 240 and 25 or 30
			card.title.TextXAlignment = Enum.TextXAlignment.Center
			card.promise.Visible = true
			place(card.promise, 12, 201, cardWidth - 24, 31)
			card.promise.TextSize = 16
			card.promise.TextXAlignment = Enum.TextXAlignment.Center
			place(card.plan, 9, 238, cardWidth - 18, 26)
			card.plan.TextSize = cardWidth &lt; 250 and 12 or 14
			card.plan.TextXAlignment = Enum.TextXAlignment.Center
		end
	end
	self.customizeButton.Parent = self.compactPowerActions and self.configActions or self.configPanel
	if not self.compactPowerActions then place(self.customizeButton, 16, drawerTop, width - 32, 44) end
	self.customizeButton.TextSize = self.compactPowerActions and 14 or 19
	self.customizePanel.Visible = self.customizeOpen
	place(self.customizePanel, 16, drawerTop + (self.compactPowerActions and 0 or 52), width - 32, drawerHeight)
	local drawerWidth = width - 56
	local planeAreaWidth = short and (drawerWidth / 2 - 16) or drawerWidth
	local planeWidth = (planeAreaWidth - 16) / 3
	for index, id in ipairs(PlaneCatalog.ORDER) do
		place(self.planeButtons[id], 12 + (index - 1) * (planeWidth + 8), 10, planeWidth, 44)
		self.planeButtons[id].TextSize = self.compactPowerActions and 14 or 20
	end
	place(self.planeSpeed, 12, 61, planeAreaWidth, 20)
	self.planeSpeed.TextSize = self.compactPowerActions and 13 or 16
	place(self.planeStrategy, 12, 85, planeAreaWidth, 20)
	self.planeStrategy.TextSize = self.compactPowerActions and 12 or 15
	local paintLeft = short and (drawerWidth / 2 + 22) or 12
	place(self.paintName, paintLeft, short and 12 or 111, short and drawerWidth / 2 - 20 or drawerWidth, 18)
	self.paintName.TextSize = 13
	for index, control in ipairs(self.colorButtons) do place(control, paintLeft + (index - 1) * 56, short and 43 or 132, 46, 44) end
	self.configActions.Position = UDim2.new(0.5, 0, 0, top + bodyHeight + 8)
	self.configActions.Size = UDim2.fromOffset(width, actionHeight)
	if portrait then
		place(self.powerSummary, 12, 6, width - 24, 35)
		self.powerSummary.TextSize = 13
		place(self.customizeButton, 10, 48, 100, 48)
		place(self.readyButton, 118, 48, width - 128, 48)
		self.readyButton.TextSize = 20
		place(self.readyStatus, 10, 101, width - 20, 18)
		self.readyStatus.TextSize = 11
		self.readyStatus.TextXAlignment = Enum.TextXAlignment.Center
	else
		local buttonWidth = short and 226 or 286
		local summaryLeft = short and 122 or 14
		if short then place(self.customizeButton, 10, 8, 100, 44) end
		place(self.powerSummary, summaryLeft, short and 6 or 8, width - buttonWidth - summaryLeft - 30, short and 31 or 43)
		self.powerSummary.TextSize = short and 12 or 16
		place(self.readyButton, width - buttonWidth - 10, short and 8 or 12, buttonWidth, short and 44 or 54)
		self.readyButton.TextSize = short and 18 or 22
		place(self.readyStatus, summaryLeft, short and 46 or 66, width - buttonWidth - summaryLeft - 30, 19)
		self.readyStatus.TextSize = short and 11 or 13
		self.readyStatus.TextXAlignment = Enum.TextXAlignment.Left
	end
	local eventWidth = math.min(520, viewport.X - 32)
	self.powerBurst.Size = UDim2.fromOffset(eventWidth, short and 74 or 112)
	self.powerBurst.Position = UDim2.fromScale(0.5, short and 0.43 or 0.4)
	place(self.powerBurstTitle, 10, 5, eventWidth - 20, short and 44 or 76)
	self.powerBurstTitle.TextSize = short and 35 or (portrait and 39 or 60)
	place(self.powerBurstDetail, 10, short and 50 or 82, eventWidth - 20, 21)
	self.powerBurstDetail.TextSize = short and 12 or 15
	self.countdownText.Size = UDim2.fromOffset(math.min(400, viewport.X - 24), short and 120 or 190)
	self.countdownText.TextSize = short and 100 or 158
	local scoreBottom = self.flightPanel.Position.Y.Offset + self.flightPanel.Size.Y.Offset
	local badgeWidth = math.min(700, viewport.X - 28)
	local badgeHeight = short and 38 or 46
	self.powerFlightBadge.Size = UDim2.fromOffset(badgeWidth, badgeHeight)
	self.powerFlightBadge.Position = UDim2.new(0.5, 0, 0, scoreBottom + 8)
	place(self.powerFlightText, 6, 2, badgeWidth / 2 - 12, badgeHeight - 4)
	place(self.opponentPowerText, badgeWidth / 2 + 6, 2, badgeWidth / 2 - 12, badgeHeight - 4)
	place(self.powerFlightDivider, badgeWidth / 2, 6, 1, badgeHeight - 12)
	self.powerFlightText.TextSize = short and 12 or (portrait and 12 or 16)
	self.opponentPowerText.TextSize = self.powerFlightText.TextSize
	self.toast.Size = UDim2.fromOffset(eventWidth, short and 40 or 54)
	self.toast.CanvasSize = UDim2.fromOffset(0, short and 40 or 54)
	self.toast.Position = UDim2.new(0.5, 0, 0, scoreBottom + badgeHeight + 16)
	place(self.toastText, 8, 3, eventWidth - 16, short and 34 or 48)
	self.toastText.TextSize = short and 25 or (portrait and 27 or 33)
end

function Hud:_layoutPlaneChoices(viewport, height)
	local aimWidth = math.min(900, viewport.X - 24)
	local portrait = viewport.X &lt; 560
	local actionHeight = portrait and 112 or 82
	self.aimActions.Size = UDim2.fromOffset(aimWidth, actionHeight)
	local textWidth = portrait and aimWidth - 28 or aimWidth - 282
	self.aimHint.Position, self.aimHint.Size = UDim2.fromOffset(14, 7), UDim2.fromOffset(textWidth, 23)
	self.aimHint.TextSize = portrait and 15 or 19
	self.fixedStats.Position, self.fixedStats.Size = UDim2.fromOffset(14, 33), UDim2.fromOffset(textWidth, 22)
	self.fixedStats.TextSize = portrait and 13 or 16
	self.aimStatus.Position, self.aimStatus.Size = UDim2.fromOffset(portrait and aimWidth / 2 or 14, portrait and 7 or 59), UDim2.fromOffset(portrait and aimWidth / 2 - 14 or textWidth, 14)
	self.aimStatus.TextXAlignment = portrait and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
	self.aimStatus.TextSize = 12
	self.aimStatus.Visible = not portrait
	self.aimReadyButton.Position = UDim2.fromOffset(portrait and 10 or aimWidth - 258, portrait and 61 or 12)
	self.aimReadyButton.Size = UDim2.fromOffset(portrait and aimWidth - 20 or 246, portrait and 44 or 58)
	self.aimReadyButton.TextSize = portrait and 20 or 22
	local fieldTop = self.header.Position.Y.Offset + self.header.Size.Y.Offset + 6
	self.aimPad.Position = UDim2.fromOffset(0, fieldTop)
	self.aimPad.Size = UDim2.fromOffset(viewport.X, math.max(20, height - 28 - actionHeight - 10 - fieldTop))
	self:_refreshAim()
end

function Hud:_resize()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(960, 720)
	if viewport == self.lastViewport then return end
	self.lastViewport = viewport
	local topInset, bottomInset = GuiService:GetGuiInset()
	local height = math.max(180, viewport.Y - topInset.Y - bottomInset.Y)
	self.layoutHeight = height
	local portrait = viewport.X &lt; 600
	local short = not portrait and height &lt; 470
	local function place(item, x, y, width, sizeY)
		item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(width, sizeY)
	end
	self.header.Position = UDim2.fromOffset(12, short and 6 or 10)
	self.header.Size = UDim2.new(1, -24, 0, short and 54 or 76)
	self.header.Brand.Visible, self.brandSub.Visible = not portrait, not portrait
	place(self.header.Brand, 18, short and 2 or 8, 225, 36)
	self.header.Brand.TextSize = short and 27 or 33
	place(self.brandSub, 20, short and 33 or 46, 235, 18)
	self.brandSub.TextSize = 12
	local phaseWidth = portrait and viewport.X - 108 or math.min(430, viewport.X - 350)
	self.phaseLabel.Position = UDim2.new(1, -phaseWidth - 78, 0, short and 1 or 8)
	self.phaseLabel.Size = UDim2.fromOffset(phaseWidth, short and 29 or 32)
	self.phaseLabel.TextXAlignment = portrait and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
	self.phaseLabel.Font = Enum.Font.FredokaOne
	self.phaseLabel.TextSize = portrait and 19 or (short and 20 or 23)
	self.courseLabel.Position = UDim2.new(1, -phaseWidth - 78, 0, short and 31 or 44)
	self.courseLabel.Size = UDim2.fromOffset(phaseWidth, 21)
	self.courseLabel.TextXAlignment = self.phaseLabel.TextXAlignment
	self.courseLabel.TextSize = portrait and 14 or 15
	self.timer.Position = UDim2.new(1, -70, 0, short and 1 or 8)
	self.timer.Size = UDim2.fromOffset(58, short and 48 or 57)
	self.timer.TextSize = short and 36 or 44
	self.footer.TextSize = portrait and 10 or 12
	self.footer.Size = UDim2.fromOffset(viewport.X - 24, 18)
	local top = self.header.Position.Y.Offset + self.header.Size.Y.Offset + 12
	local width = math.min(620, viewport.X - 24)
	local inner = width - 40
	local available = math.max(100, height - top - 24)
	for _, entry in ipairs(self.scaledPanels) do
		local flight = entry.panel == self.flightPanel or entry.panel == self.toast or entry.panel == self.flightControls
		entry.scale.Scale = 1
		entry.panel.ScrollBarThickness = flight and 0 or 5
		entry.panel.ScrollingEnabled = not flight
	end
	self.waitingPanel.AnchorPoint = Vector2.new(0.5, 0)
	self.waitingPanel.Position = UDim2.new(0.5, 0, 0, top + math.max(0, (available - 234) / 2))
	self.waitingPanel.Size = UDim2.fromOffset(width, math.min(234, available))
	self.waitingPanel.CanvasSize = UDim2.fromOffset(0, 234)
	place(self.waitingPanel.Title, 20, 22, inner, 70)
	self.waitingPanel.Title.TextSize = portrait and 29 or 34
	self.waitingPanel.Title.TextWrapped = true
	place(self.waitingPanel.Copy, 20, 97, inner, 67)
	self.waitingPanel.Copy.TextSize = portrait and 18 or 21
	place(self.waitingMessage, 20, 185, inner, 32)
	self.waitingMessage.TextSize, self.waitingMessage.TextWrapped = 15, true
	self.votePanel.AnchorPoint = Vector2.new(0.5, 0)
	self.votePanel.Position = UDim2.new(0.5, 0, 0, top)
	self.votePanel.Size = UDim2.fromOffset(width, math.min(454, available))
	self.votePanel.CanvasSize = UDim2.fromOffset(0, 454)
	self.votePanel.Eyebrow.Visible = not short
	place(self.votePanel.Eyebrow, 20, 15, inner, 18)
	self.votePanel.Eyebrow.TextSize = 13
	place(self.votePanel.Title, 20, 40, inner, 44)
	self.votePanel.Title.TextSize = portrait and 31 or 39
	place(self.votePanel.VoteHint, 20, 416, inner, 23)
	self.votePanel.VoteHint.TextSize = portrait and 12 or 15
	for index, name in ipairs({ "Coast", "Skyline", "Storm" }) do
		local control = self.voteButtons[name]
		place(control, 20, 100 + (index - 1) * 103, inner, 89)
		place(control.Badge, 12, 16, 54, 56)
		local title = control:FindFirstChild("Name")
		place(title, 80, 11, inner - 143, 31)
		title.TextSize = portrait and 23 or 29
		place(control.Detail, 80, 44, inner - 143, 36)
		control.Detail.TextSize, control.Detail.TextWrapped = portrait and 12 or 15, true
		place(control.Votes, inner - 53, 13, 42, 36)
		control.Votes.TextSize = 31
		place(control.VotesLabel, inner - 57, 54, 49, 18)
		control.VotesLabel.TextSize = 11
	end
	if short then
		local wide = math.min(960, viewport.X - 24)
		local cardWidth = (wide - 56) / 3
		self.votePanel.Size = UDim2.fromOffset(wide, math.min(226, available))
		self.votePanel.CanvasSize = UDim2.fromOffset(0, 226)
		place(self.votePanel.Title, 16, 6, wide - 32, 37)
		self.votePanel.Title.TextSize = 30
		for index, name in ipairs({ "Coast", "Skyline", "Storm" }) do
			local control = self.voteButtons[name]
			place(control, 16 + (index - 1) * (cardWidth + 12), 53, cardWidth, 134)
			place(control.Badge, 10, 12, 37, 37)
			local title = control:FindFirstChild("Name")
			place(title, 55, 12, cardWidth - 65, 30)
			title.TextSize = 22
			place(control.Detail, 10, 57, cardWidth - 20, 37)
			control.Detail.TextSize = 13
			place(control.Votes, cardWidth - 51, 96, 39, 30)
			place(control.VotesLabel, 12, 108, cardWidth - 70, 16)
		end
		place(self.votePanel.VoteHint, 16, 200, wide - 32, 20)
		self.votePanel.VoteHint.TextSize = 13
	end
	self:_layoutPersonal(viewport, height)
	self:_layoutPlaneChoices(viewport, height)
	self:_layoutDuel(viewport, height)
	self:_layoutPowerChoices(viewport, height)
end

-- Viewport coordinates, including Roblox's top inset. The camera and edge
-- markers share this clear area so neither drifts underneath the duel controls.
function Hud:getFlightViewport()
	self:_resize()
	local topInset, bottomInset = GuiService:GetGuiInset()
	local viewport = self.lastViewport
	local top = topInset.Y + self.powerFlightBadge.Position.Y.Offset + self.powerFlightBadge.Size.Y.Offset + 12
	local controlTop = self.flightControls.Position.Y.Offset - self.flightControls.Size.Y.Offset
	if viewport.X &lt; 480 then controlTop = math.min(controlTop, -130) end
	local bottom = viewport.Y - bottomInset.Y + controlTop - 14
	return { left = 18, right = viewport.X - 18, top = top, bottom = math.max(top + 40, bottom) }
end

function Hud:getAimViewport()
	self:_resize()
	local topInset = GuiService:GetGuiInset()
	local top = topInset.Y + self.aimPad.Position.Y.Offset
	return { left = 0, right = self.lastViewport.X, top = top, bottom = top + self.aimPad.Size.Y.Offset }
end

-- Animate presentation once for an authoritative award, never a refresh or purchase.
-- The final balance remains the server's value; no currency is granted here.
function Hud:_refreshReward(snapshot, yourResult, now)
	local economy = snapshot.economy
	local earned = math.max(0, tonumber(yourResult and yourResult.creditsEarned) or 0)
	local balance = math.max(0, tonumber(economy and economy.credits) or 0)
	local key = tostring(snapshot.matchId) .. ":" .. tostring(snapshot.roundId)
	local animation = self.rewardAnimation
	if economy and yourResult and earned &gt; 0 and not self.rewardSeen[key] then
		self.rewardSeen[key] = true
		table.insert(self.rewardOrder, key)
		if #self.rewardOrder &gt; 32 then self.rewardSeen[table.remove(self.rewardOrder, 1)] = nil end
		animation = { key = key, started = now, before = math.max(0, balance - earned), after = balance, earned = earned }
		self.rewardAnimation = animation
	end
	local progress = 1
	if animation and animation.key == key and not self.reducedMotion then
		progress = math.clamp((now - animation.started) / 0.85, 0, 1)
		progress = 1 - (1 - progress) ^ 3
	end
	local shownEarned = math.floor(earned * progress + 0.5)
	local shownBalance = balance
	if animation and animation.key == key and animation.after == balance then
		shownBalance = math.floor(animation.before + (balance - animation.before) * progress + 0.5)
	end
	self.rewardAmount.Text = earned &gt; 0 and ("+" .. tostring(shownEarned) .. " COINS") or "FLIGHT COMPLETE"
	self.rewardAmount.TextSize = earned &gt; 0 and (self.rewardTextSize or 35) or math.floor((self.rewardTextSize or 35) * 0.75)
	self.rewardBalance.Text = economy and (tostring(shownBalance) .. " COINS IN YOUR BANK") or "Loading your coin balance…"
	local nextItem
	if economy then
		for _, id in ipairs(CosmeticCatalog.ORDER) do
			local item = CosmeticCatalog.get(id)
			if item.price &gt; 0 and not (economy.owned and economy.owned[id]) then nextItem = item; break end
		end
	end
	self.rewardTrack.Visible = nextItem ~= nil
	if nextItem then
		local color = nextItem.color
		self.rewardFill.BackgroundColor3 = Color3.fromRGB(color.r, color.g, color.b)
		self.rewardFill.Size = UDim2.new(math.clamp(shownBalance / nextItem.price, 0, 1), 0, 1, 0)
		self.rewardGoal.Text = "NEXT: " .. string.upper(nextItem.name)
		if balance &gt;= nextItem.price then
			self.rewardHint.Text = "READY TO BUY · " .. nextItem.price .. " COINS IN HANGAR"
			self.rewardHint.TextColor3 = COLORS.gold
		else
			self.rewardHint.Text = tostring(balance) .. " / " .. nextItem.price .. " · " .. (nextItem.price - balance) .. " MORE COINS"
			self.rewardHint.TextColor3 = COLORS.white
		end
	elseif economy then
		self.rewardGoal.Text = "COLLECTION COMPLETE!"
		self.rewardHint.Text = "Try a different trail in the hangar."
		self.rewardHint.TextColor3 = COLORS.white
	else
		self.rewardGoal.Text = "YOUR NEXT FLIGHT EFFECT"
		self.rewardHint.Text = "Your collection will appear when loaded."
		self.rewardHint.TextColor3 = COLORS.white
	end
end

local function duelPowerState(player, role)
	local flight = player and player.flight
	if not flight then return role .. "\nREADY", COLORS.white end
	local id = flight.powerId or (player.settings and player.settings.powerId) or PowerCatalog.DEFAULT_ID
	local name = id == "Muncher" and "MUNCHER" or string.upper(id)
	if not flight.alive then return role .. " · LANDED\n" .. distance(flight.distance or flight.x), COLORS.white end
	local charges = math.max(0, flight.powerCharges or 0)
	local status
	if id == "Meteor" then
		status = flight.powerPhase == "diving" and "DIVING!" or (charges &gt; 0 and "BLAST READY" or "POWER SPENT")
	else
		status = tostring(charges) .. (id == "Pinball" and " BOUNCES LEFT" or " BITES LEFT")
	end
	return role .. " · " .. name .. "\n" .. status, powerColor(id)
end

function Hud:update(snapshot, localUserId, watchedUserId)
	if not snapshot or not self.gui.Parent then return end
	self:_resize()
	local now = workspace:GetServerTimeNow()
	local phase = snapshot.phase or "Lobby"
	local remaining = math.max(0, math.ceil((snapshot.endsAt or now) - now))
	local localPlayer, watchedPlayer, opponent
	local readyCount, humanCount = 0, 0
	for _, player in ipairs(snapshot.players or {}) do
		if player.userId == localUserId then localPlayer = player end
		if player.userId ~= localUserId then opponent = player end
		if player.userId == watchedUserId then watchedPlayer = player end
		if not player.bot then
			humanCount += 1
			if player.ready then readyCount += 1 end
		end
	end
	watchedPlayer = watchedPlayer or localPlayer
	local changedPhase = self.phase ~= phase or self.roundId ~= snapshot.roundId or self.matchId ~= snapshot.matchId
	if changedPhase then
		if self.aimDrag then self:_finishAim(false) end
		self.phase = phase
		self.aimProjectionVisible = false
		self.aimFocusPending = phase == "Aim" and UserInputService.GamepadEnabled
		self.roundId = snapshot.roundId
		self.matchId = snapshot.matchId
		self.rematchRequested = false
		self.rematchPendingUntil = 0
		self.canRematch = false
		self.rematchButton.Text = "FLY AGAIN"
		self.rematchButton.Active = true
		self.pendingSettings = nil
		self.pendingReady = nil
		self.pendingUntil = 0
		self.readyPendingUntil = 0
		self.lastPowerEvent = nil
		self.lastCountdown = nil
		if phase == "Configure" then
			self.customizeOpen = false
			self:_layoutPowerChoices(self.lastViewport, self.layoutHeight)
		end
		for _, panel in ipairs({ self.votePanel, self.configPanel, self.resultsPanel }) do
			panel.CanvasPosition = Vector2.zero
		end
		if phase == "Voting" then
			self.voted = nil
			for _, line in pairs(self.voteStrokes) do
				line.Thickness, line.Color = 2, COLORS.line
			end
		end
		if phase == "Flight" then
			self.lobbyView = false
			self.lobbyButton.Text = "LEAVE DUEL"
		end
	end
	self.configEndsAt = snapshot.endsAt
	if self.aimDrag and not self:_canAim() then self:_finishAim(false) end
	if localPlayer then
		local authoritative = localPlayer.settings and selection(localPlayer.settings)
		if authoritative and not self.aimDrag and (changedPhase or not self.pendingSettings
			or sameSettings(authoritative, self.pendingSettings) or now &gt; self.pendingUntil) then
			if not sameSettings(self.settings, authoritative) then
				self.settings = authoritative
			end
			self.pendingSettings = nil
		end
		if not self.aimDrag and (changedPhase or self.pendingReady == nil or localPlayer.ready == self.pendingReady or now &gt; self.readyPendingUntil) then
			self.ready = localPlayer.ready == true
			self.pendingReady = nil
		end
	end
	if changedPhase and phase == "Configure" then
		self.displayedPower = self.settings.powerId
		self:_animatePowerChoice(true)
	end
	self.phaseLabel.Text = PHASE_NAMES[phase] or string.upper(phase)
	self.timer.Text = (snapshot.endsAt or 0) &gt; 0 and tostring(remaining) or "--"
	self.courseLabel.Text = snapshot.courseName and string.upper(snapshot.courseName) or "DISTANCE WINS"
	local inHub = phase == "Lobby" or phase == "Queued"
	self.statsButton.Visible = inHub
	if not inHub then self.statsOverlay.Visible = false end
	self.soundButton.Visible = inHub or phase == "Flight"
	self.soundButton.AnchorPoint = inHub and Vector2.zero or Vector2.new(0, 1)
	self.soundButton.Position = inHub and self.hubSoundPosition
		or UDim2.new(0, 12, 1, self.lastViewport.X &lt; 480 and -86 or -26)
	self.soundButton.Size = inHub and self.hubSoundSize or UDim2.fromOffset(118, 44)
	self.soundButton.TextSize = inHub and 18 or 14
	local stats = snapshot.stats or {}
	for key, value in pairs(self.statsValues) do
		value.Text = key == "bestDistance" and distance(stats[key] or 0, true) or tostring(stats[key] or 0)
	end
	self.statsRecord.Text = tostring(stats.wins or 0) .. " wins  ·  " .. tostring(stats.losses or 0) .. " losses  ·  " .. tostring(stats.draws or 0) .. " draws"
	local saveCopy = { loading = "Loading your record…", saved = "Record saved. Practice doesn't affect win streaks.",
		pending = "Saving your record…", session_only = "Session only · cloud saves start in the published game.",
		unavailable = "Cloud save unavailable · this session may not be saved." }
	self.statsSave.Text = saveCopy[snapshot.saveStatus] or "Loading your record…"
	self.header.Visible = not inHub and phase ~= "Flight"
	self.hubCard.Visible = phase == "Queued"
	self.hubAction.Visible = inHub
	self.playCaption.Visible = phase == "Lobby"
	self.hubAction.TextYAlignment = phase == "Lobby" and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
	self.planeRow.Visible = phase == "Lobby"
	self.footer.Visible = not inHub
	self.waitingPanel.Visible = phase == "Waiting"
	self.votePanel.Visible = phase == "Voting"
	self.configPanel.Visible = phase == "Configure"
	self.configActions.Visible = self.configPanel.Visible
	self.aimActions.Visible = phase == "Aim" or phase == "Countdown"
	self.aimPad.Visible = self.aimActions.Visible
	self.flightPanel.Visible = phase == "Flight"
	self.flightControls.Visible = phase == "Flight"
	self.resultsPanel.Visible = phase == "Results"
	self.resultActions.Visible = phase == "Results"
	self.toast.Visible = false
	self.powerFlightBadge.Visible = phase == "Flight"
	self.powerBurst.Visible = (phase == "Configure" or phase == "Aim") and now &lt; (self.powerBurstUntil or 0)
	if phase == "Countdown" then
		self.countdownText.Visible = true
		self.countdownText.Text = tostring(math.max(1, remaining))
		if self.lastCountdown ~= remaining then
			self.lastCountdown = remaining
			self.countdownScale.Scale = self.reducedMotion and 1 or 0.68
			self:_tween(self.countdownScale, 0.3, { Scale = 1 })
		end
	elseif phase == "Flight" and changedPhase then
		self.launchBannerUntil = now + 0.65
		self.countdownText.Text = "FLY!"
		self.countdownText.Visible = true
		self.countdownScale.Scale = self.reducedMotion and 1 or 0.68
		self:_tween(self.countdownScale, 0.25, { Scale = 1 })
	else
		self.countdownText.Visible = phase == "Flight" and now &lt; (self.launchBannerUntil or 0)
	end
	self.waitingMessage.Text = snapshot.message or "Getting the runway ready…"
	if phase == "Lobby" then
		local plane = PlaneCatalog.get(self.settings.planeId) or PlaneCatalog.get(PlaneCatalog.DEFAULT_ID)
		self.planeName.Text = string.upper(plane.name)
		self.planeDetail.Text = "HANGAR LOOK · PLANE + PAINT"
		self.paintButton.BackgroundColor3 = PAINTS[self.settings.color] or PAINTS[1]
		self.hubAction.Text = "PLAY"
		self.hubAction.BackgroundColor3 = COLORS.green
		self.hubAction.Size = UDim2.fromOffset(self.hubBlockWidth, self.hubAction.Size.Y.Offset)
	elseif phase == "Queued" then
		local queue = snapshot.queue or {}
		if queue.quick then
			local wait = math.max(0, math.ceil((queue.fallbackAt or now) - now))
			self.hubTitle.Text = "FINDING A RIVAL…"
			self.hubInstruction.Text = wait &gt; 0 and ("Nobody around? You fly a practice ghost in " .. wait .. "s.")
				or "Starting your flight…"
		else
			local station = queue.stationName or (queue.stationId and "Pad " .. tostring(queue.stationId)) or "1v1 pad"
			self.hubTitle.Text = "WAITING FOR A RIVAL"
			self.hubInstruction.Text = station .. " · walk off the pad to leave."
		end
		self.hubAction.Text = "CANCEL"
		self.hubAction.BackgroundColor3 = COLORS.coral
		self.hubAction.Size = UDim2.fromOffset(self.hubBlockWidth, self.hubAction.Size.Y.Offset)
	elseif phase == "Voting" then
		for name, votes in pairs(self.voteCounts) do
			votes.Text = tostring((snapshot.votes or {})[name] or 0)
		end
	elseif phase == "Configure" then
		self:_refreshSettings()
		if changedPhase and UserInputService.GamepadEnabled then GuiService.SelectedObject = self.powerCards[self.settings.powerId].button end
		self.readyStatus.Text = self.ready and "Waiting for rival · tap a card to change" or "Power lasts this round. Aim your plane next."
	elseif phase == "Aim" or phase == "Countdown" then
		self:_refreshSettings()
		if phase == "Countdown" then
			self.aimStatus.Text = "Takeoff in " .. remaining .. "…"
		else
			local readyText = tostring(readyCount) .. "/" .. tostring(humanCount) .. " ready"
			self.aimStatus.Text = self.ready and (readyText .. " · Waiting for rival") or PowerCatalog.get(self.settings.powerId).aimHint
		end
	elseif phase == "Flight" then
		local flight = watchedPlayer and watchedPlayer.flight
		local ownFlight = localPlayer and localPlayer.flight
		local rivalFlight = opponent and opponent.flight
		local ownDistance = ownFlight and (ownFlight.distance or ownFlight.x) or 0
		local rivalDistance = rivalFlight and (rivalFlight.distance or rivalFlight.x) or 0
		local gap = ownDistance - rivalDistance
		self.powerFlightText.Text, self.powerFlightText.TextColor3 = duelPowerState(localPlayer, "YOU")
		self.opponentPowerText.Text, self.opponentPowerText.TextColor3 = duelPowerState(opponent, opponent and opponent.bot and "GHOST" or "RIVAL")
		self.ownPilot.Text = "YOU" .. (localPlayer and " · " .. string.upper(localPlayer.name) or "")
		self.opponentPilot.Text = opponent and string.upper(opponent.name) or "OPPONENT"
		self.flightDistance.Text = distance(ownDistance)
		self.opponentDistance.Text = distance(rivalDistance)
		if math.abs(gap) &lt; 0.5 then self.leadLabel.Text = "NECK AND NECK"
		elseif gap &gt; 0 then self.leadLabel.Text = "LEAD +" .. distance(gap)
		else self.leadLabel.Text = "TRAIL " .. distance(-gap) end
		self.leadLabel.TextColor3 = gap &lt; -0.5 and COLORS.coral or COLORS.green
		local altitude = flight and math.max(0, flight.y or 0) or 0
		local watchRole = watchedPlayer and (watchedPlayer.userId == localUserId and "YOU" or (watchedPlayer.bot and "GHOST" or "RIVAL")) or "TAKEOFF"
		self.watchedLabel.Text = "CAMERA: " .. watchRole .. (flight and flight.alive and (" · GROUND " .. distance(altitude)) or " · LANDED")
		self.watchedLabel.TextTruncate = Enum.TextTruncate.AtEnd
		self.watchedLabel.TextColor3 = flight and flight.alive and altitude &lt; 28 and COLORS.coral or COLORS.muted
		local elapsed = snapshot.elapsed or 0
		local pressure = Simulation.flightPressure(elapsed)
		self.flightStatus.Text = elapsed &lt; Simulation.PRESSURE_START
			and ("HEADWIND IN " .. tostring(math.ceil(Simulation.PRESSURE_START - elapsed)) .. "s")
			or (pressure &gt;= 1 and "STRONG HEADWIND" or "HEADWIND ↑")
		self.flightStatus.TextColor3 = elapsed &gt;= Simulation.PRESSURE_START and COLORS.amber or COLORS.muted
		self.flightStatus:SetAttribute("HeadwindPressure", pressure)
		self.flightStats.Text = "Waiting for takeoff"
		self.flightStats.TextColor3 = COLORS.muted
		if flight then
			local powerId = PowerCatalog.get(flight.powerId) and flight.powerId
				or (watchedPlayer.settings and watchedPlayer.settings.powerId) or PowerCatalog.DEFAULT_ID
			local power = PowerCatalog.get(powerId) or PowerCatalog.get(PowerCatalog.DEFAULT_ID)
			powerId = power.id
			self.flightStats.Text = "FUEL " .. tostring(flight.pickups or 0)
				.. "  /  HITS " .. tostring(flight.hits or 0)
				.. ((flight.shield == true or (type(flight.shield) == "number" and flight.shield &gt; 0)) and "  /  SHIELD" or "")
			local event = flight.lastEvent
			local eventAge = event and ((snapshot.elapsed or flight.elapsed or 0) - (event.at or 0)) or math.huge
			if event and event.text and eventAge &gt;= 0 and eventAge &lt; 2.3 then
				self.flightStats.Text = event.text
				self.flightStats.TextColor3 = (event.kind == "hit" or event.kind == "missile") and COLORS.coral or COLORS.ink
			end
			if not flight.alive and eventAge &gt;= 2.3 then
				self.flightStats.Text = "Final distance: " .. distance(flight.distance, true)
			end
			local powerEvent
			for _, entry in ipairs(flight.recentEvents or { flight.lastEvent }) do
				local age = (snapshot.elapsed or flight.elapsed or 0) - (entry.at or 0)
				if (entry.kind == "pinball" or entry.kind == "munch" or entry.kind == "meteorDive" or entry.kind == "meteorBoost")
					and age &gt;= 0 and age &lt; 1.35 then powerEvent = entry end
			end
			if powerEvent then
				self.toast.Visible = true
				self.toast.BackgroundColor3 = powerColor(powerId)
				self.toastText.Text = powerEvent.text or "POWER!"
				local key = tostring(watchedUserId) .. ":" .. powerEvent.kind .. ":" .. tostring(powerEvent.at)
				if self.lastPowerEvent ~= key then
					self.lastPowerEvent = key
					self.toastScale.Scale = self.reducedMotion and 1 or 0.76
					self:_tween(self.toastScale, 0.24, { Scale = 1 })
				end
			end
		end
	elseif phase == "Results" then
		local yourResult
		local hasForfeit = false
		for _, result in ipairs(snapshot.results or {}) do
			if result.userId == localUserId then yourResult = result end
			if result.forfeit then hasForfeit = true end
		end
		for index, row in ipairs(self.resultRows) do
			local result = (snapshot.results or {})[index]
			row.frame.Visible = result ~= nil and index &lt;= 2
			if result then
				row.rank.Text = tostring(result.rank or index)
				row.name.Text = result.name .. (result.userId == localUserId and "  (YOU)" or "")
				row.distance.Text = distance(result.distance, true)
				row.frame.BackgroundColor3 = result.userId == localUserId and COLORS.cyan or (index == 1 and COLORS.gold or COLORS.soft)
			end
		end
		self.yourDistance.Text = yourResult and distance(yourResult.distance, true) or "—"
		self.bestDistance.Text = distance(stats.bestDistance or (localPlayer and localPlayer.best) or 0, true)
		self.resultsPanel.PersonalResult.BestLabel.Text = snapshot.saveStatus == "session_only" and "BEST THIS SESSION" or "PERSONAL BEST"
		self.resultMessage.Text = snapshot.message or "Change your setup. Chase a little farther."
		local firstPlaces = 0
		for _, result in ipairs(snapshot.results or {}) do
			if result.rank == 1 then firstPlaces += 1 end
		end
		self.resultsPanel.Title.Text = firstPlaces &gt; 1 and "DEAD HEAT!"
			or (yourResult and yourResult.rank == 1
			and (hasForfeit and "YOU WIN THE DUEL." or "YOU WENT FURTHEST.") or "ONE MORE FLIGHT?")
        self.nextRoundLabel.Text = (snapshot.endsAt or 0) &gt; 0 and ("Back to the hangar in " .. remaining .. "s") or "Request a rematch or head back to the club."
		self:_refreshReward(snapshot, yourResult, now)
		self.canRematch = snapshot.canRematch == true
		self.rematchRequested = localPlayer ~= nil and localPlayer.rematchReady == true
		if not self.canRematch then
			self.rematchPendingUntil = 0
			self.rematchButton.Text = "OPPONENT LEFT"
			self.nextRoundLabel.Text = "Your opponent left. Return to the club to find another duel."
		elseif self.rematchRequested then
			self.rematchPendingUntil = 0
			self.rematchButton.Text = "WAITING FOR RIVAL"
		elseif now &lt; self.rematchPendingUntil then
			self.rematchButton.Text = "REQUESTING…"
		else
			self.rematchButton.Text = opponent and opponent.rematchReady and not opponent.bot and "ACCEPT REMATCH" or "FLY AGAIN"
		end
		local rematchEnabled = self.canRematch and not self.rematchRequested and now &gt;= self.rematchPendingUntil
		self.rematchButton.Active = rematchEnabled
		self.rematchButton.Selectable = rematchEnabled
		self.rematchButton.AutoButtonColor = rematchEnabled
		self.rematchButton.BackgroundColor3 = self.canRematch and (self.rematchRequested and COLORS.cyan or COLORS.green) or COLORS.soft
		self.rematchButton.TextColor3 = self.canRematch and COLORS.white or COLORS.muted
	end
end

-- Show the actual server event sequence beside the watched plane. Several quick
-- collisions can happen between snapshots; the bounded event history retains them.
function Hud:updateFlightFeedback(flight, point, visible, elapsed)
	local events = {}
	if self.phase == "Flight" and flight and visible then
		for _, entry in ipairs(flight.recentEvents or {flight.lastEvent}) do
			local age = elapsed - (entry.at or 0)
			if age &gt;= 0 and age &lt; 1.8 and entry.kind ~= "launch" and entry.kind ~= "finish" then
				table.insert(events, entry)
			end
		end
	end
	local short = self.lastViewport.Y &lt; 450
	local lineHeight = short and 19 or 25
	local stripBottom = self.flightPanel.Position.Y.Offset + self.flightPanel.Size.Y.Offset
	local roomAbove = math.floor((point.Y - 24 - stripBottom - 8) / lineHeight)
	local count = math.min(3, #events, math.max(1, roomAbove))
	for index, control in ipairs(self.flightFeedback) do
		local entry = index &lt;= count and events[#events - index + 1] or nil
		control.Visible = entry ~= nil
		if entry then
			local age = elapsed - entry.at
			local color, text = COLORS.green, entry.text
			if entry.kind == "fuel" then text = "+" .. tostring(entry.value or "") .. " LIFT"
			elseif entry.kind == "missile" then color, text = COLORS.coral, "MISSILE HIT!"
			elseif entry.kind == "shield" then color, text = COLORS.gold, "SHIELD SAVE!"
			elseif entry.kind == "nearMiss" then color, text = COLORS.cyan, "CLOSE CALL!"
			elseif entry.kind == "boost" then text = "RESCUE BOOST!"
			elseif entry.kind == "pinball" then color = powerColor("Pinball")
			elseif entry.kind == "munch" then color = powerColor("Muncher")
			elseif entry.kind == "meteorDive" or entry.kind == "meteorBoost" then color = powerColor("Meteor") end
			control.Text, control.TextColor3 = text, color
			control.TextSize = short and 15 or 20
			control.Size = UDim2.fromOffset(190, lineHeight)
			local fade = math.clamp((age - 1.25) / 0.55, 0, 1)
			control.TextTransparency, control.LetterOutline.Transparency = fade, fade
			local x = math.clamp(point.X, 95, math.max(95, self.lastViewport.X - 95))
			-- Keep the stack out of the score strip, including phone safe insets.
			local bottom = math.max(stripBottom + count * lineHeight + 8, point.Y - 24 - age * 8)
			if roomAbove &lt; 1 then
				-- Beside the aircraft when there is no room above it, never on it.
				x = point.X + 115
				if x &gt; self.lastViewport.X - 95 then x = point.X - 115 end
				x = math.clamp(x, 95, math.max(95, self.lastViewport.X - 95))
				bottom = math.max(stripBottom + lineHeight + 8, point.Y + lineHeight / 2)
			end
			control.Position = UDim2.fromOffset(x, bottom - (index - 1) * lineHeight)
		end
	end
end

function Hud:destroy()
	self.aimDrag = nil
	for _, tween in pairs(self.tweens) do tween:Cancel() end
	table.clear(self.tweens)
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	table.clear(self.connections)
	if self.gui then self.gui:Destroy() end
end

return Hud
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX35">
        <Properties>
          <string name="Name">EffectsShop</string>
          <ProtectedString name="Source">-- A browse -&gt; preview -&gt; buy -&gt; equip flow. Only server snapshots grant ownership.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local shared = game:GetService("ReplicatedStorage"):WaitForChild("FlightGame")
local Catalog = require(shared:WaitForChild("CosmeticCatalog"))
local World = require(shared:WaitForChild("World"))
local Shop = {}
Shop.__index = Shop
local C = { ink=Color3.fromRGB(23,39,77), panel=Color3.fromRGB(255,254,247), tile=Color3.fromRGB(214,236,253),
    white=Color3.fromRGB(255,254,247), muted=Color3.fromRGB(67,87,117), gold=Color3.fromRGB(255,217,65),
    teal=Color3.fromRGB(64,224,248), green=Color3.fromRGB(105,226,66), amber=Color3.fromRGB(153,79,12) }
local function create(kind, props, parent)
    local object=Instance.new(kind)
    for key,value in pairs(props) do object[key]=value end
    object.Parent=parent
    return object
end
local function box(parent,name,color)
    return create("Frame",{Name=name,BackgroundColor3=color or C.panel,BorderSizePixel=0},parent)
end
local function round(parent,radius)
    create("UICorner",{CornerRadius=UDim.new(0,radius or 10)},parent)
end
local function stroke(parent,tint,thickness)
    return create("UIStroke",{Name="Border",ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Color=tint or C.ink,Thickness=thickness or 2},parent)
end
local function text(parent,name,value,size,color)
    return create("TextLabel",{Name=name,Text=value,BackgroundTransparency=1,TextSize=size or 14,
        TextColor3=color or C.ink,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Center},parent)
end
local function display(parent,name,value,size,tint)
    local label=text(parent,name,value,size,tint or C.white)
    label.Font=Enum.Font.FredokaOne
    create("UIStroke",{Name="LetterOutline",ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual,Color=C.ink,Thickness=2},label)
    return label
end
local function button(parent,name,value,color)
    local object=create("TextButton",{Name=name,Text=value,TextSize=20,Font=Enum.Font.FredokaOne,
        TextColor3=C.ink,BackgroundColor3=color or C.tile,BorderSizePixel=0,Selectable=true,AutoButtonColor=true},parent)
    round(object,14); stroke(object)
    return object
end
local function place(object,x,y,w,h)
    object.Position=UDim2.fromOffset(x,y); object.Size=UDim2.fromOffset(w,h)
end
local function color(rgb) return Color3.fromRGB(rgb.r,rgb.g,rgb.b) end
local function viewport(parent,name)
    local view=create("ViewportFrame",{Name=name,BackgroundColor3=C.tile,BorderSizePixel=0,
        Ambient=Color3.fromRGB(200,220,235),LightColor=Color3.new(1,1,1),LightDirection=Vector3.new(-1,-1,-1)},parent)
    round(view,12)
    local world=create("WorldModel",{},view)
    local camera=create("Camera",{FieldOfView=38,CFrame=CFrame.lookAt(Vector3.new(13,17,35),Vector3.new(-7,0,0))},view)
    view.CurrentCamera=camera
    return view,world,camera
end
local function previewPlane(world,item,settings)
    world:ClearAllChildren()
    local plane=World.createPlane(world,"EffectPreviewPlane",settings.color or 2,settings.planeId,item.id)
    plane:ScaleTo(1.4); plane:PivotTo(CFrame.new(3,0,0))
    -- ViewportFrame does not render Trails. This taper uses the actual trail's catalog colors.
    for index=1,18 do
        local t=(index-1)/17
        create("Part",{Name="TrailColorSample",Anchored=true,CanCollide=false,CastShadow=false,
            Material=Enum.Material.Neon,Color=color(item.color):Lerp(color(item.secondaryColor),t),
            Size=Vector3.new(1.05,math.max(0.1,item.width*(1-t*0.8)),0.35),
            CFrame=CFrame.new(-3-index,math.sin(t*4)*0.35,0),Transparency=t*0.7},world)
    end
end

function Shop.new(send)
    local self=setmetatable({send=send,selected=Catalog.DEFAULT_ID,phase="Lobby",pendingUntil=0,cards={},connections={},onlyOwned=false},Shop)
    self.gui=create("ScreenGui",{Name="SkyboundEffects",ResetOnSpawn=false,IgnoreGuiInset=false,
        DisplayOrder=30,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},Players.LocalPlayer:WaitForChild("PlayerGui"))
    self.reducedMotion=false
    pcall(function() self.reducedMotion=GuiService.ReducedMotionEnabled end)
    self.openButton=button(self.gui,"OpenEffects","",C.panel)
    self.rewardScale=create("UIScale",{Scale=1},self.openButton)
    self.coin=box(self.openButton,"Coin",C.gold); round(self.coin,50); stroke(self.coin,C.amber,3)
    self.coinInner=box(self.coin,"Inset",C.gold); round(self.coinInner,50); stroke(self.coinInner,C.amber,1.5)
    self.coinInner.Position=UDim2.fromScale(0.17,0.17); self.coinInner.Size=UDim2.fromScale(0.66,0.66)
    self.coinMark=text(self.coin,"Mark","S",28,C.amber); self.coinMark.Font=Enum.Font.FredokaOne
    self.coinMark.Size=UDim2.fromScale(1,1); self.coinMark.TextXAlignment=Enum.TextXAlignment.Center
    self.wallet=display(self.openButton,"CoinBalance","0",42,C.gold)
    self.wallet.TextScaled=true
    create("UITextSizeConstraint",{MinTextSize=14,MaxTextSize=42},self.wallet)
    self.walletCaption=text(self.openButton,"CoinLabel","COINS",12,C.muted)
    self.browseLabel=text(self.openButton,"Browse","EFFECTS",15,C.ink)
    self.browseLabel.Font=Enum.Font.FredokaOne; self.browseLabel.TextXAlignment=Enum.TextXAlignment.Right
    self.overlay=box(self.gui,"ShopOverlay",C.ink)
    self.overlay.Size=UDim2.fromScale(1,1); self.overlay.BackgroundTransparency=0.18
    self.overlay.Visible=false; self.overlay.Active=true
    self.card=box(self.overlay,"EffectsShop",C.panel); round(self.card,20); stroke(self.card,C.ink,3)
    self.card.AnchorPoint=Vector2.new(0.5,0.5); self.card.Position=UDim2.fromScale(0.5,0.5)
    self.title=display(self.card,"Title","FLIGHT EFFECTS",34)
    self.balance=display(self.card,"Balance","0 COINS",25,C.gold)
    self.closeButton=button(self.card,"Close","X")
    self.body=create("ScrollingFrame",{Name="Browse",BackgroundTransparency=1,BorderSizePixel=0,
        ScrollBarThickness=5,ScrollBarImageColor3=C.ink,CanvasSize=UDim2.fromOffset(0,400)},self.card)
    self.filter=button(self.body,"CollectionFilter","ALL EFFECTS")
    self.collection=text(self.body,"CollectionCount","1 / 6 OWNED",13,C.muted)
    self.preview,self.previewWorld,self.previewCamera=viewport(self.body,"PlanePreview")
    self.previewName=display(self.body,"SelectedName","CLASSIC",27)
    self.previewDetail=text(self.body,"SelectedDescription","",15,C.muted); self.previewDetail.TextWrapped=true
    self.previewNote=text(self.body,"PreviewNote","FLIGHT EFFECT · COSMETIC ONLY",12,C.muted)
    for _,item in ipairs(Catalog.all()) do
        local control=button(self.body,item.id,"",C.tile)
        local swatch=box(control,"Swatch",color(item.color)); round(swatch,5)
        create("UIGradient",{Color=ColorSequence.new(color(item.color),color(item.secondaryColor))},swatch)
        local name=text(control,"ItemName",item.name,17); name.Font=Enum.Font.FredokaOne
        name.TextTruncate=Enum.TextTruncate.AtEnd
        local price=text(control,"Price",tostring(item.price).." COINS",13,C.ink)
        local border=control:FindFirstChild("Border")
        self.cards[item.id]={button=control,swatch=swatch,name=name,price=price,border=border}
        table.insert(self.connections,control.Activated:Connect(function()
            self.selected=item.id; self:_preview(); self:_refresh()
            if self.card.AbsoluteSize.X&lt;600 then self.body.CanvasPosition=Vector2.zero end
        end))
    end
    self.status=text(self.card,"Feedback","Finish flights. Earn coins. Make your plane yours.",14,C.muted)
    self.status.TextWrapped=true
    self.action=button(self.card,"PurchaseOrEquip","EQUIPPED",C.teal); self.action.TextColor3=C.ink
    self.action.TextWrapped=true
    self.saveLabel=text(self.card,"SaveStatus","",11,C.muted)
    table.insert(self.connections,self.openButton.Activated:Connect(function() self:openAt(self.nextItemId) end))
    table.insert(self.connections,self.closeButton.Activated:Connect(function() self:close() end))
    table.insert(self.connections,self.filter.Activated:Connect(function()
        self.onlyOwned=not self.onlyOwned
        if self.onlyOwned and not (self.economy and self.economy.owned[self.selected]) then
            self.selected=self.economy and self.economy.equippedTrail or Catalog.DEFAULT_ID
            self:_preview()
        end
        self:_layout(); self:_refresh()
    end))
    table.insert(self.connections,self.action.Activated:Connect(function()
        if not self.action.Active or os.clock()&lt;self.pendingUntil or not self.economy then return end
        local owned=self.economy.owned[self.selected]
        self.pendingUntil=os.clock()+3
        self.send(owned and "equipCosmetic" or "buyCosmetic",{itemId=self.selected})
        self:_refresh()
    end))
    table.insert(self.connections,UserInputService.InputBegan:Connect(function(input,processed)
        if self.overlay.Visible and (input.KeyCode==Enum.KeyCode.Escape or input.KeyCode==Enum.KeyCode.ButtonB) then self:close() end
    end))
    self:_preview(); self:_layout()
    return self
end

function Shop:_preview()
    local item=Catalog.get(self.selected)
    previewPlane(self.previewWorld,item,self.settings or {})
    self.previewName.Text=string.upper(item.name)
    self.previewDetail.Text=item.description
end

function Shop:_layout()
    local size=self.gui.AbsoluteSize
    if size.X&lt;1 then size=Vector2.new(960,660) end
    self.lastSize=size
    local portrait=size.X&lt;600
    local short=not portrait and size.Y&lt;500
    -- The wallet is a compact pill; the next unlock lives on its stand in the hangar.
    local rw=portrait and size.X-24 or (short and 190 or 214)
    local rh=short and 44 or 46
    self.openButton.AnchorPoint=portrait and Vector2.zero or Vector2.new(1,0)
    self.openButton.Position=portrait and UDim2.fromOffset(12,64) or UDim2.new(1,-16,0,short and 6 or 10)
    self.openButton.Size=UDim2.fromOffset(rw,rh)
    local coinSize=rh-14
    place(self.coin,10,7,coinSize,coinSize)
    self.coinMark.TextSize=22
    place(self.wallet,coinSize+18,2,rw-coinSize-108,rh-16)
    place(self.walletCaption,coinSize+19,rh-16,60,12)
    self.walletCaption.TextSize=9
    place(self.browseLabel,rw-96,0,84,rh)
    self.rewardBaseScale=1
    if not self.rewardTween or self.rewardTween.PlaybackState~=Enum.PlaybackState.Playing then
        self.rewardScale.Scale=self.rewardBaseScale
    end

    local w=math.min(920,size.X-20)
    local h=math.min(630,size.Y-16)
    self.card.Size=UDim2.fromOffset(w,h)
    local narrow=w&lt;600
    local compact=not narrow and h&lt;420
    self.previewCamera.FieldOfView=compact and 28 or 38
    self.filter.Parent=compact and self.card or self.body
    self.preview.Parent=compact and self.card or self.body
    self.previewName.Parent=compact and self.card or self.body
    self.collection.Visible=not compact
    self.previewDetail.Visible=not compact
    self.previewNote.Visible=not compact
    place(self.title,20,10,w-90,38); self.title.TextSize=narrow and (w&lt;350 and 24 or 29) or 34
    place(self.balance,22,49,w-90,29); self.balance.TextSize=narrow and 22 or 25
    place(self.closeButton,w-66,14,48,48)
    local bodyY=compact and 82 or 92
    local footerHeight=compact and 100 or 132
    local bodyHeight=math.max(70,h-bodyY-footerHeight)
    place(self.body,16,bodyY,w-32,bodyHeight)
    local inner=w-40
    local listWidth=narrow and inner or math.floor(inner*0.49)
    if compact then self.body.Size=UDim2.fromOffset(listWidth,bodyHeight) end
    local listTop=narrow and 298 or 0
    place(self.filter,0,listTop,math.min(186,listWidth*0.57),46)
    self.filter.TextSize=narrow and 17 or 18
    if compact then place(self.filter,w-248,15,166,46) end
    place(self.collection,math.min(198,listWidth*0.6),listTop,listWidth-math.min(198,listWidth*0.6),46)
    local cellWidth=(listWidth-10)/2
    local cellHeight=compact and 76 or 94
    local rowStep=cellHeight+10
    local count=0
    for _,item in ipairs(Catalog.all()) do
        local card=self.cards[item.id]
        local visible=not self.onlyOwned or (self.economy and self.economy.owned[item.id])
        card.button.Visible=visible==true
        if visible then
            local row=math.floor(count/2); local col=count%2
            place(card.button,col*(cellWidth+10),listTop+(compact and 2 or 58)+row*rowStep,cellWidth,cellHeight)
            place(card.swatch,10,10,cellWidth-20,compact and 8 or 13)
            place(card.name,10,compact and 23 or 31,cellWidth-20,26)
            place(card.price,10,compact and 51 or 63,cellWidth-20,22)
            card.name.TextSize=cellWidth&lt;150 and 15 or 18
            card.price.TextSize=cellWidth&lt;150 and 12 or 14
            count+=1
        end
    end
    local listBottom=listTop+(compact and 2 or 58)+math.ceil(count/2)*rowStep
    local x=narrow and 0 or listWidth+20
    local previewWidth=narrow and inner or inner-x
    place(self.preview,x,0,previewWidth,narrow and 176 or 208)
    place(self.previewName,x,narrow and 183 or 218,previewWidth,34)
    place(self.previewDetail,x,narrow and 220 or 258,previewWidth,44)
    place(self.previewNote,x,narrow and 271 or 308,previewWidth,18)
    self.previewNote.TextSize=narrow and 11 or 12
    self.body.CanvasSize=UDim2.fromOffset(0,compact and listBottom or math.max(listBottom,narrow and 298 or 336))
    self.previewName.TextSize=compact and 20 or (narrow and 25 or 27)
    if compact then
        place(self.preview,16+x,bodyY,previewWidth,bodyHeight-30)
        place(self.previewName,16+x,bodyY+bodyHeight-27,previewWidth,27)
    end
    place(self.status,20,h-126,w-40,40)
    self.status.TextSize=narrow and 13 or 14
    place(self.action,20,h-78,w-40,52)
    self.action.TextSize=narrow and 17 or 22
    place(self.saveLabel,20,h-22,w-40,17)
    self.saveLabel.TextSize=narrow and 10 or 11
    if compact then
        place(self.status,20,h-97,w-40,27); self.status.TextSize=12
        place(self.action,20,h-66,w-40,46); self.action.TextSize=19
        place(self.saveLabel,20,h-18,w-40,16); self.saveLabel.TextSize=10
    end
end

function Shop:open()
    if self.phase~="Lobby" and self.phase~="Queued" then return end
    self.overlay.Visible=true
    self.openButton.Visible=false; self.openButton.Active=false; self.openButton.Selectable=false
    local hud=Players.LocalPlayer.PlayerGui:FindFirstChild("SkyboundHUD")
    if hud and hud:FindFirstChild("PersonalStats") then hud.PersonalStats.Visible=false end
    self:_layout(); self:_preview(); self:_refresh()
    if UserInputService.GamepadEnabled then GuiService.SelectedObject=self.cards[self.selected].button end
end

-- Open on a particular effect, defaulting to the trail currently equipped.
function Shop:openAt(itemId)
    self.selected=Catalog.get(itemId) and itemId or (self.economy and self.economy.equippedTrail) or Catalog.DEFAULT_ID
    self.onlyOwned=false
    self:open()
end

function Shop:close()
    self.overlay.Visible=false
    if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(self.overlay) then GuiService.SelectedObject=nil end
end

function Shop:isOpen() return self.overlay.Visible end

function Shop:_refresh()
    local economy=self.economy or {credits=0,owned={classic=true},equippedTrail=Catalog.DEFAULT_ID,canShop=false}
    local item=Catalog.get(self.selected)
    local count=0
    local nextItem
    for _,entry in ipairs(Catalog.all()) do
        local owned=economy.owned[entry.id]==true
        if owned then count+=1 elseif not nextItem then nextItem=entry end
        local card=self.cards[entry.id]
        local selected=self.selected==entry.id
        card.border.Color=selected and C.ink or C.muted
        card.border.Thickness=selected and 3 or 1
        card.button.BackgroundColor3=selected and C.teal or C.tile
        card.price.Text=economy.equippedTrail==entry.id and "EQUIPPED" or (owned and "OWNED" or tostring(entry.price).." COINS")
        card.price.TextColor3=C.ink
    end
    local credits=economy.credits or 0
    self.balance.Text=self.economy and (tostring(credits).." COINS") or "LOADING COINS…"
    self.wallet.Text=self.economy and tostring(credits) or "…"
    self.collection.Text=tostring(count).." / "..#Catalog.ORDER.." OWNED"
    self.filter.Text=self.onlyOwned and "MY COLLECTION" or "ALL EFFECTS"
    self.nextItemId=nextItem and nextItem.id or nil
    local canAfford=nextItem and credits&gt;=nextItem.price
    if self.lastNextId~=self.nextItemId then self.pendingRewardPulse=nil end
    if self.lastNextId==self.nextItemId and self.lastAffordable==false and canAfford then
        self.pendingRewardPulse=self.nextItemId
    end
    self.lastNextId=self.nextItemId; self.lastAffordable=canAfford==true
    self.browseLabel.Text=canAfford and "NEW!" or "EFFECTS"
    self.openButton.BackgroundColor3=canAfford and C.gold or C.panel
    if self.pendingRewardPulse==self.nextItemId and canAfford and self.openButton.Visible and not self.overlay.Visible then
        self.pendingRewardPulse=false
        if not self.reducedMotion then
            if self.rewardTween then self.rewardTween:Cancel() end
            self.rewardScale.Scale=self.rewardBaseScale or 1
            self.rewardTween=TweenService:Create(self.rewardScale,TweenInfo.new(0.24,Enum.EasingStyle.Back,Enum.EasingDirection.Out,0,true),{Scale=(self.rewardBaseScale or 1)*1.06})
            self.rewardTween:Play()
        end
    end
    local pending=os.clock()&lt;self.pendingUntil
    local equipped=economy.equippedTrail==item.id
    local owned=economy.owned[item.id]==true
    local affordable=credits&gt;=item.price
    local enabled=self.phase=="Lobby" and economy.canShop and not equipped and (owned or affordable) and not pending
    self.action.Active=enabled==true; self.action.Selectable=enabled==true; self.action.AutoButtonColor=enabled==true
    self.action.BackgroundColor3=enabled and (owned and C.teal or C.gold) or C.tile
    self.action.TextColor3=enabled and C.ink or C.muted
    self.action.Text=pending and "WORKING…" or (equipped and "EQUIPPED FOR YOUR NEXT FLIGHT"
        or (owned and ("EQUIP "..string.upper(item.name))
        or (affordable and ("BUY "..string.upper(item.name).." · "..item.price.." COINS")
        or ("EARN "..(item.price-credits).." MORE COINS"))))
    local feedback=self.feedback
    if self.phase=="Queued" then self.status.Text="Leave the queue to buy or change your trail."
    elseif feedback and os.clock()&lt;(self.feedbackUntil or 0) then
        self.status.Text=feedback.message:gsub("CREDITS","COINS"):gsub("credits","coins")
    elseif not economy.canShop then self.status.Text="Your collection is loading or saving is unavailable. Try again when ready."
    elseif owned then self.status.Text=equipped and "Your equipped trail follows your plane into every flight." or "Owned. Equip this trail for your next flight."
    else self.status.Text="Finish a practice flight: +25 coins. Finish a duel: +40, plus result bonuses." end
    self.status.TextColor3=feedback and not feedback.ok and os.clock()&lt;(self.feedbackUntil or 0) and C.amber or C.muted
    local saves={session_only="STUDIO SESSION · Purchases reset when Play stops.",loading="Loading your collection…",
        saved="Collection saved.",pending="Saving your collection…",unavailable="Cloud save unavailable. Purchases are disabled."}
    self.saveLabel.Text=saves[self.saveStatus] or "Loading your collection…"
end

function Shop:update(snapshot,settings)
    self.phase=snapshot.phase; self.economy=snapshot.economy; self.saveStatus=snapshot.saveStatus; self.settings=settings
    local inHub=self.phase=="Lobby" or self.phase=="Queued"
    local hud=Players.LocalPlayer.PlayerGui:FindFirstChild("SkyboundHUD")
    local stats=hud and hud:FindFirstChild("PersonalStats")
    self.openButton.Visible=inHub and not self.overlay.Visible and not (stats and stats.Visible)
    self.openButton.Active=self.openButton.Visible
    self.openButton.Selectable=self.openButton.Visible
    if not inHub then self:close() end
    local ownedKey=""
    for _,id in ipairs(Catalog.ORDER) do
        if self.economy and self.economy.owned[id] then ownedKey=ownedKey..id..":" end
    end
    if ownedKey~=self.ownedKey then self.ownedKey=ownedKey; self:_layout() end
    local feedback=snapshot.cosmeticFeedback
    if feedback and feedback.id~=self.lastFeedback then
        self.lastFeedback=feedback.id; self.feedback=feedback; self.feedbackUntil=os.clock()+5; self.pendingUntil=0
        if self.onlyOwned then self:_layout() end
    end
    if self.gui.AbsoluteSize~=self.lastSize then self:_layout() end
    self:_refresh()
end

function Shop:destroy()
    if self.rewardTween then self.rewardTween:Cancel() end
    for _,connection in ipairs(self.connections) do connection:Disconnect() end
    self.gui:Destroy()
end

return Shop
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX36">
        <Properties>
          <string name="Name">HangarBay</string>
          <ProtectedString name="Source">-- The living parts of the hangar that differ for every pilot, built locally:
-- your own plane in the centre bay, the next unlock on its stand, the other
-- pilots' planes along the wall, and departures on the runway outside.
-- Everything here is presentation. Coins and ownership come from snapshots.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local shared = game:GetService("ReplicatedStorage"):WaitForChild("FlightGame")
local Catalog = require(shared:WaitForChild("CosmeticCatalog"))
local PlaneCatalog = require(shared:WaitForChild("PlaneCatalog"))
local World = require(shared:WaitForChild("World"))

local Bay = {}
Bay.__index = Bay

local INK = Color3.fromRGB(23, 39, 77)
local CREAM = Color3.fromRGB(255, 245, 217)
local GOLD = Color3.fromRGB(255, 217, 65)
local GREEN = Color3.fromRGB(105, 226, 66)
local CYAN = Color3.fromRGB(66, 225, 239)
local STEEL = Color3.fromRGB(48, 67, 83)
local PIPS = 12

local function block(parent, name, size, color, neon, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	if shape then part.Shape = shape end
	part.Parent = parent
	return part
end

-- A camera-facing caption sized in studs, so it reads as part of the hangar.
local function caption(adornee, offset, width, height)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Caption"
	gui.Adornee = adornee
	gui.Size = UDim2.fromScale(width, height)
	gui.StudsOffsetWorldSpace = offset
	gui.LightInfluence = 0
	gui.MaxDistance = 260
	gui.Parent = adornee
	return gui
end

local function line(gui, name, y, height, color)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0, y)
	label.Size = UDim2.fromScale(1, height)
	label.Font = Enum.Font.FredokaOne
	label.Text = ""
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeColor3 = INK
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return label
end

local function makeRibbons(parent, count)
	local set = table.create(count)
	for index = 1, count do
		set[index] = block(parent, "TrailRibbon", Vector3.one, CREAM, true)
	end
	return set
end

-- A parked plane cannot draw a real Trail, so a tapered ribbon streams back
-- from the tail in the trail's catalog colors, as if in a wind tunnel.
local function flowRibbons(set, pose, scale, color, second, width, length, clock)
	local count = #set
	for index, segment in ipairs(set) do
		local t = (clock * 0.55 + (index - 1) / count) % 1
		local sway = math.sin(t * 5 + clock * 2.4) * 0.35 * t * scale
		segment.Size = Vector3.new(length / count * 1.25, 0.14 * scale, 1.4 * scale * width * (1 - t * 0.55))
		segment.CFrame = pose * CFrame.new(-3.8 * scale - t * length, 0.3 * scale + sway, 0)
		segment.Color = color:Lerp(second, t)
		-- Fade in at the tail so a wrapping segment never pops into view.
		segment.Transparency = 1 - (0.88 - t * 0.88) * math.min(1, t / 0.08)
	end
end

local function nextUnlock(economy)
	for _, id in ipairs(Catalog.ORDER) do
		local item = Catalog.get(id)
		if item.price &gt; 0 and not economy.owned[id] then return item end
	end
	return nil
end

function Bay.new(callbacks)
	local self = setmetatable({}, Bay)
	self.send = callbacks.send
	self.openShop = callbacks.openShop
	self.reducedMotion = false
	pcall(function() self.reducedMotion = GuiService.ReducedMotionEnabled end)
	self.folder = Instance.new("Folder")
	self.folder.Name = "HangarBayVisuals"
	self.folder.Parent = workspace
	self.clock = 0
	self.lineup = {}
	self.coins = {}
	self.lineupTimer = 0
	self.celebrateUntil = 0
	self.nextDeparture = os.clock() + 5
	return self
end

function Bay:_clear()
	self.folder:ClearAllChildren()
	self.hero, self.stand, self.departure = nil, nil, nil
	self.lineup, self.coins = {}, {}
	self.lineupTimer = 0
	self.active = false
end

function Bay:_updateHero(snapshot, settings, dt)
	local bay = World.HERO_BAY
	local key = settings.planeId .. ":" .. tostring(settings.color) .. ":" .. tostring(settings.trailId)
	local hero = self.hero
	if not hero or hero.key ~= key then
		local previous = hero
		if previous then previous.holder:Destroy() end
		local holder = Instance.new("Folder")
		holder.Name = "HeroBay"
		holder.Parent = self.folder
		local model = World.createParkedPlane(holder, "HeroPlane", settings.color, settings.planeId,
			bay.position, bay.rotation, bay.scale, settings.trailId)
		local gui = caption(model.PrimaryPart, Vector3.new(0, 8.6, 0), 21, 4.8)
		hero = { key = key, holder = holder, model = model, rest = model:GetPivot(),
			ribbons = makeRibbons(holder, 9), trailId = settings.trailId, droppedAt = os.clock(),
			name = line(gui, "PlaneName", 0, 0.58, CREAM), record = line(gui, "Record", 0.6, 0.4, GOLD) }
		local plane = PlaneCatalog.get(settings.planeId) or PlaneCatalog.get(PlaneCatalog.DEFAULT_ID)
		hero.name.Text = string.upper(plane.name)
		-- A newly claimed or equipped trail flares for a moment.
		if previous and previous.trailId ~= settings.trailId then self.celebrateUntil = os.clock() + 1.2 end
		self.hero = hero
	end
	-- A swapped plane settles onto its wheels rather than appearing in place.
	local drop = self.reducedMotion and 1 or math.clamp((os.clock() - hero.droppedAt) / 0.28, 0, 1)
	if drop &lt; 1 or hero.settled ~= true then
		hero.model:PivotTo(hero.rest + Vector3.new(0, (1 - drop) ^ 2 * 2.4, 0))
		hero.settled = drop &gt;= 1
	end
	World.idlePlane(hero.model, dt)
	local color, second, entry = World.trailLook(settings.trailId)
	local flare = 1 + math.max(0, self.celebrateUntil - os.clock()) * 0.9
	flowRibbons(hero.ribbons, hero.model:GetPivot(), bay.scale, color, second, entry.width * flare, 15, self.clock)
	if shared:GetAttribute("DistanceModeEnabled") == true then
		local best = snapshot.stats and tonumber(snapshot.stats.bestDistance) or 0
		hero.record.Text = best &gt; 0 and string.format("YOUR BEST  %.1f M", best) or "FLY TO SET YOUR RECORD"
	else
		hero.record.Text = "READY FOR PLANE BATTLES"
	end
end

function Bay:_buildStand(item, settings, key)
	if self.stand then self.stand.holder:Destroy() end
	local origin = World.UNLOCK_STAND
	local holder = Instance.new("Folder")
	holder.Name = "UnlockStand"
	holder.Parent = self.folder
	local shown = item or Catalog.get(settings.trailId) or Catalog.get(Catalog.DEFAULT_ID)
	local model = World.createPlane(holder, "UnlockPlane", settings.color, settings.planeId, shown.id)
	model:ScaleTo(0.85)
	local anchor = block(holder, "CaptionAnchor", Vector3.one, CREAM)
	anchor.Transparency = 1
	anchor.CFrame = CFrame.new(origin + Vector3.new(0, 7.6, 0))
	local color, second = World.trailLook(shown.id)
	local gui = caption(anchor, Vector3.new(0, 5.6, 0), 19, 6)
	local stand = { key = key, holder = holder, model = model, item = item, shown = shown,
		ribbons = makeRibbons(holder, 5), pips = table.create(PIPS), color = color, second = second,
		heading = line(gui, "Heading", 0, 0.24, CREAM), name = line(gui, "EffectName", 0.24, 0.44, color),
		progress = line(gui, "Progress", 0.7, 0.3, GOLD) }
	for index = 1, PIPS do
		local pip = block(holder, "ProgressPip", Vector3.new(2.2, 1, 0.8), STEEL, true)
		pip.CFrame = CFrame.new(origin + Vector3.new(0, 3.9, 0)) * CFrame.Angles(0, (index - 1) / PIPS * math.pi * 2, 0) * CFrame.new(0, 0, -6.4)
		stand.pips[index] = pip
	end
	stand.heading.Text = item and "NEXT UNLOCK" or "COLLECTION COMPLETE"
	stand.name.Text = string.upper(shown.name)
	self.stand = stand
	return stand
end

function Bay:_updateStand(snapshot, settings, dt)
	local economy = snapshot.economy
	self.economy = economy
	if not economy then return end
	local item = nextUnlock(economy)
	local key = (item and item.id or "complete") .. ":" .. settings.planeId .. ":" .. tostring(settings.color)
	local stand = self.stand
	if not stand or stand.key ~= key then stand = self:_buildStand(item, settings, key) end

	-- Coins earned since the pilot was last in the hangar fly from the plane to
	-- the stand. The balance shown only ever catches up to the server's value.
	local credits = math.max(0, tonumber(economy.credits) or 0)
	if self.lastCredits == nil or credits &lt; self.lastCredits or self.reducedMotion or not self.hero then
		self.shownCredits = credits
	elseif credits &gt; self.lastCredits then
		local gain = credits - self.lastCredits
		local count = math.clamp(math.ceil(gain / 5), 3, 12)
		local from = self.hero.model:GetPivot().Position + Vector3.new(0, 2, 0)
		for index = 1, count do
			local coin = block(self.folder, "FlyingCoin", Vector3.new(0.4, 1.7, 1.7), GOLD, true, Enum.PartType.Cylinder)
			coin.Transparency = 1
			table.insert(self.coins, { part = coin, from = from, to = World.UNLOCK_STAND + Vector3.new(0, 6.5, 0),
				age = -(index - 1) * 0.09, value = gain / count })
		end
	end
	self.lastCredits = credits
	if #self.coins == 0 then self.shownCredits = credits end
	local shown = math.min(credits, math.floor(self.shownCredits + 0.5))

	local affordable = item ~= nil and credits &gt;= item.price
	local fraction = item and math.clamp(shown / item.price, 0, 1) or 1
	local lit = math.floor(fraction * PIPS + 0.001)
	local pulse = affordable and (0.5 + 0.5 * math.sin(self.clock * 6)) or 0
	for index, pip in ipairs(stand.pips) do
		local on = index &lt;= lit
		pip.Color = on and (affordable and GREEN or stand.color) or STEEL
		pip.Material = on and Enum.Material.Neon or Enum.Material.Metal
		pip.Transparency = on and pulse * 0.35 or 0
	end
	if item then
		stand.progress.Text = affordable and "READY  -  CLAIM IT!" or (tostring(shown) .. " / " .. tostring(item.price) .. " COINS")
		stand.progress.TextColor3 = affordable and GREEN or GOLD
	else
		stand.progress.Text = shared:GetAttribute("DistanceModeEnabled") == true
			and "FLY YOUR SIGNATURE TRAIL" or "SHOW OFF YOUR SIGNATURE TRAIL"
	end
	stand.angle = ((stand.angle or 0) + dt * (affordable and 1.5 or 0.5) * (self.reducedMotion and 0 or 1)) % (math.pi * 2)
	local pose = CFrame.new(World.UNLOCK_STAND + Vector3.new(0, 7.6 + math.sin(self.clock * 1.6) * 0.3, 0))
		* CFrame.Angles(0, stand.angle, 0) * CFrame.Angles(0, 0, 0.14)
	stand.model:PivotTo(pose)
	World.idlePlane(stand.model, dt)
	local _, _, entry = World.trailLook(stand.shown.id)
	flowRibbons(stand.ribbons, pose, 0.85, stand.color, stand.second, entry.width, 8, self.clock)

	local lobby = workspace:FindFirstChild("FlightLobby")
	local pedestal = lobby and lobby:FindFirstChild("UnlockPedestal")
	local prompt = pedestal and pedestal:FindFirstChild("UnlockStandPrompt")
	if prompt then
		prompt.ActionText = affordable and economy.canShop and ("Claim " .. item.name) or (item and "View effect" or "Browse effects")
		prompt.ObjectText = item and "NEXT UNLOCK" or "FLIGHT EFFECTS"
	end

	-- A claim buys the effect, then equips it once the server confirms ownership.
	local pending = self.pendingEquip
	if pending then
		if economy.equippedTrail == pending then
			self.pendingEquip = nil
		elseif economy.owned[pending] then
			if os.clock() &gt;= self.equipAt then
				self.equipAt = os.clock() + 1
				self.send("equipCosmetic", { itemId = pending })
			end
		elseif os.clock() &gt; self.claimLockUntil + 1 then
			self.pendingEquip = nil
		end
	end
end

function Bay:activateStand()
	local economy = self.economy
	local item = economy and nextUnlock(economy)
	if item and economy.canShop and economy.credits &gt;= item.price then
		if os.clock() &lt; (self.claimLockUntil or 0) then return end
		self.claimLockUntil = os.clock() + 2
		self.pendingEquip, self.equipAt = item.id, os.clock() + 0.4
		self.send("buyCosmetic", { itemId = item.id })
	else
		self.openShop(item and item.id or nil)
	end
end

function Bay:_updateCoins(dt)
	for index = #self.coins, 1, -1 do
		local coin = self.coins[index]
		coin.age += dt
		local t = coin.age / 0.8
		if t &gt;= 1 then
			coin.part:Destroy()
			table.remove(self.coins, index)
			self.shownCredits = (self.shownCredits or 0) + coin.value
		elseif t &gt; 0 then
			local eased = t * t * (3 - 2 * t)
			coin.part.Transparency = 0
			coin.part.CFrame = CFrame.new(coin.from:Lerp(coin.to, eased) + Vector3.new(0, math.sin(eased * math.pi) * 9, 0))
				* CFrame.Angles(0, coin.age * 9, 0)
		end
	end
end

function Bay:_updateLineup(dt)
	self.lineupTimer -= dt
	if self.lineupTimer &lt;= 0 then
		self.lineupTimer = 0.5
		local seen = {}
		for _, player in ipairs(Players:GetPlayers()) do
			local slot = player:GetAttribute("SkyboundBay")
			local bay = player ~= Players.LocalPlayer and type(slot) == "number" and World.LINEUP_BAYS[slot] or nil
			if bay then
				seen[slot] = true
				local planeId = player:GetAttribute("SkyboundPlane") or PlaneCatalog.DEFAULT_ID
				local color = player:GetAttribute("SkyboundColor") or 1
				local trailId = player:GetAttribute("SkyboundTrail") or Catalog.DEFAULT_ID
				local flying = player:GetAttribute("SkyboundFlying") == true
				local key = table.concat({ tostring(player.UserId), tostring(planeId), tostring(color), tostring(trailId), tostring(flying) }, ":")
				local entry = self.lineup[slot]
				if not entry or entry.key ~= key then
					if entry then entry.holder:Destroy() end
					local holder = Instance.new("Folder")
					holder.Name = "ClubBay" .. tostring(slot)
					holder.Parent = self.folder
					local anchor = block(holder, "CaptionAnchor", Vector3.one, CREAM)
					anchor.Transparency = 1
					anchor.CFrame = CFrame.new(bay.position + Vector3.new(0, 4, 0))
					local gui = caption(anchor, Vector3.new(0, 7, 0), 20, 5)
					line(gui, "Pilot", 0, 0.58, CREAM).Text = string.upper(player.DisplayName)
					line(gui, "Status", 0.6, 0.4, flying and GOLD or CYAN).Text = flying and "FLYING NOW" or "IN THE HANGAR"
					entry = { key = key, holder = holder, bay = bay, trailId = trailId }
					-- A pilot who is in a duel has taken their plane with them.
					if not flying then
						entry.model = World.createParkedPlane(holder, "ClubPlane", color, planeId, bay.position, bay.rotation, bay.scale, trailId)
						entry.ribbons = makeRibbons(holder, 5)
					end
					self.lineup[slot] = entry
				end
			end
		end
		for slot, entry in pairs(self.lineup) do
			if not seen[slot] then entry.holder:Destroy(); self.lineup[slot] = nil end
		end
	end
	for _, entry in pairs(self.lineup) do
		if entry.model then
			World.idlePlane(entry.model, dt)
			local color, second, trail = World.trailLook(entry.trailId)
			flowRibbons(entry.ribbons, entry.model:GetPivot(), entry.bay.scale, color, second, trail.width, 9, self.clock)
		end
	end
end

-- Planes leave from the runway outside the doors: on a timer, and promptly
-- whenever another duel starts on this server.
function Bay:_updateDeparture(dt)
	if self.reducedMotion then return end
	local duels = shared:GetAttribute("ActiveDuels") or 0
	if duels &gt; (self.lastDuels or 0) then self.nextDeparture = math.min(self.nextDeparture, os.clock() + 0.5) end
	self.lastDuels = duels
	local flight = self.departure
	if not flight then
		if os.clock() &lt; self.nextDeparture then return end
		local planeId = PlaneCatalog.ORDER[math.random(1, #PlaneCatalog.ORDER)]
		local trailId = Catalog.ORDER[math.random(1, #Catalog.ORDER)]
		local model = World.createParkedPlane(self.folder, "DepartingPlane", math.random(1, 4), planeId,
			Vector3.new(0, 4, -150), math.pi / 2, 1.8, trailId)
		self.departure = { model = model, age = 0, height = model:GetPivot().Position.Y }
		return
	end
	flight.age += dt
	local roll = 17 * flight.age * flight.age
	local climb = math.max(0, flight.age - 3.2)
	flight.model:PivotTo(CFrame.new(0, flight.height + climb * climb * 9, -150 - roll)
		* CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, 0, math.min(0.38, climb * 0.3)))
	World.idlePlane(flight.model, dt, true)
	if flight.age &gt; 7 then
		flight.model:Destroy()
		self.departure = nil
		self.nextDeparture = os.clock() + 12 + math.random() * 8
	end
end

-- `settings` is the local pilot's authoritative loadout from the snapshot.
function Bay:update(snapshot, settings, inHub, dt)
	if not inHub or not settings then
		if self.active then self:_clear() end
		return
	end
	self.active = true
	if not self.reducedMotion then self.clock += dt end
	self:_updateHero(snapshot, settings, dt)
	self:_updateStand(snapshot, settings, dt)
	self:_updateCoins(dt)
	self:_updateLineup(dt)
	self:_updateDeparture(dt)
end

function Bay:destroy()
	self.folder:Destroy()
end

return Bay
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX37">
        <Properties>
          <string name="Name">FlightAudio</string>
          <ProtectedString name="Source">-- Local presentation only: both duel pilots share a bounded mix. Each pilot
-- retains its own event cursor, even when the spectator camera changes.
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")
local Audio = {}
Audio.__index = Audio

-- Free Creator Store cartoon jump by Dizzota; bundled Roblox sounds keep every
-- other layer available without uploads. If the public jump is unavailable,
-- the local jump sound is substituted after preload.
local BOING = "rbxassetid://2772396665"
local JUMP = "rbxasset://sounds/action_jump.mp3"
local EXPLOSION = "rbxasset://sounds/impact_explosion_03.mp3"
local CHIME = "rbxasset://sounds/volume_slider.ogg"
local LAND = "rbxasset://sounds/action_jump_land.mp3"
local SOURCES = { boing=BOING, jump=JUMP, boom=EXPLOSION, chime=CHIME, land=LAND }
Audio.VOICES_PER_SOURCE = 4
Audio.VOICE_POOL_LIMIT = 20

function Audio.new()
    local self=setmetatable({voices={},nextVoice={},tracks={},key=nil,muted=false,
        tweens={},played=0,ghostPlayed=0,humanPlayed=0,ready=false,selectionAt={}},Audio)
    self.folder=Instance.new("Folder"); self.folder.Name="SkyboundAudio"; self.folder.Parent=SoundService
    self.group=Instance.new("SoundGroup"); self.group.Name="FlightMix"; self.group.Volume=0.75; self.group.Parent=self.folder
    local preload={}
    for name,id in pairs(SOURCES) do
        self.voices[name]={}; self.nextVoice[name]=0
        for index=1,Audio.VOICES_PER_SOURCE do
            local sound=Instance.new("Sound")
            sound.Name=name..index; sound.SoundId=id; sound.Volume=0; sound.SoundGroup=self.group
            sound.Parent=self.folder; table.insert(self.voices[name],sound); table.insert(preload,sound)
        end
    end
    task.spawn(function()
        pcall(function() ContentProvider:PreloadAsync(preload) end)
        if not self.folder.Parent then return end
        for _,sound in ipairs(self.voices.boing) do if not sound.IsLoaded then sound.SoundId=JUMP end end
        self.ready=true
        self.folder:SetAttribute("Ready",true)
    end)
    return self
end

function Audio:setMuted(muted)
    self.muted=muted==true
    self.group.Volume=self.muted and 0 or 0.75
    self.folder:SetAttribute("Muted",self.muted)
    if self.muted then
        -- Keep event cursors while silencing active voices, so unmuting never
        -- replays contacts that happened while the player chose quiet mode.
        for _,tween in pairs(self.tweens) do tween:Cancel() end
        for _,pool in pairs(self.voices) do for _,sound in ipairs(pool) do sound:Stop() end end
    end
end

function Audio:voice(name,volume,pitch,duration,finishPitch)
    if self.muted or not self.folder.Parent then return end
    local pool=self.voices[name]
    if not pool then return end
    local index=self.nextVoice[name]%#pool+1; self.nextVoice[name]=index
    local sound=pool[index]
    if self.tweens[sound] then self.tweens[sound]:Cancel() end
    sound:Stop(); sound.TimePosition=0; sound.Volume=volume; sound.PlaybackSpeed=pitch
    sound:Play()
    self.tweens[sound]=TweenService:Create(sound,TweenInfo.new(duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
        {Volume=0,PlaybackSpeed=finishPitch or pitch})
    self.tweens[sound]:Play()
end

function Audio:playEvent(event, gain, pitchFactor, track, pilot)
    if self.muted then return end
    local kind=event.kind
    local now=os.clock()
    gain, pitchFactor = gain or 1, pitchFactor or 1
    track = track or {lastAt={}}
    -- A history batch can contain several contacts; avoid a wall of identical sounds.
    local cooldown=kind=="nearMiss" and 0.45 or 0.07
    if now-(track.lastAt[kind] or -math.huge)&lt;cooldown then return end
    track.lastAt[kind]=now
    local function voice(name, volume, pitch, duration, finishPitch)
        self:voice(name,volume*gain,pitch*pitchFactor,duration,finishPitch and finishPitch*pitchFactor)
    end
    if kind=="fuel" or kind=="boost" then
        local amount=kind=="boost" and 20 or (event.value or 5)
        local pitch=0.95+math.clamp(amount,0,20)*0.017
        voice("boing",0.44,pitch,0.62,pitch+0.12)
        voice("chime",0.22,pitch*1.25,0.48,pitch*1.4)
    elseif kind=="missile" or kind=="hit" then
        voice("boom",0.42,1.2,0.8,0.9)
        voice("land",0.38,0.7,0.24)
    elseif kind=="shield" then
        voice("boom",0.15,1.75,0.36)
        voice("chime",0.36,1.65,0.55)
    elseif kind=="nearMiss" then
        voice("jump",0.16,0.8,0.24,1.55)
    elseif kind=="launch" then
        voice("jump",0.30,0.65,0.4,1.8)
        voice("boom",0.18,1.45,0.35)
    elseif kind=="finish" then
        voice("land",0.42,0.85,0.45)
        voice("chime",0.20,0.95,0.7)
    elseif kind=="pinball" then
        local pitch=0.85+math.clamp(event.value or 1,1,3)*0.16
        voice("boing",0.66,pitch,0.8,pitch+0.4)
        voice("land",0.29,0.7,0.2,1.25)
        voice("chime",0.21,pitch*1.45,0.5)
    elseif kind=="munch" then
        voice("land",0.64,0.65,0.27,1.5)
        voice("boom",0.3,1.9,0.28,1.25)
        voice("jump",0.3,0.95,0.55,1.8)
    elseif kind=="meteorDive" then
        voice("jump",0.48,1.8,0.75,0.6)
        voice("boom",0.27,0.65,0.85,0.45)
    elseif kind=="meteorBoost" then
        voice("boom",0.52,0.95,0.72,1.35)
        voice("jump",0.44,0.65,0.64,1.9)
        voice("chime",0.26,1.2,0.6,1.8)
    else return end
    self.played+=1
    self.folder:SetAttribute("PlayedEvents",self.played)
    self.folder:SetAttribute("LastEvent",kind)
    if pilot then
        self.folder:SetAttribute("LastPilot",tostring(pilot.userId))
        if pilot.bot then self.ghostPlayed+=1 else self.humanPlayed+=1 end
        self.folder:SetAttribute("GhostEvents",self.ghostPlayed)
        self.folder:SetAttribute("HumanEvents",self.humanPlayed)
    end
end

-- Selection sounds only follow deliberate UI input. This shares the same
-- bounded voice pool and mute switch as both pilots' flight events.
function Audio:playSelection(powerId, confirmed)
    if self.muted or (powerId~="Pinball" and powerId~="Muncher" and powerId~="Meteor") then return end
    self.selectionAt=self.selectionAt or {}
    local key=powerId..(confirmed and ":lock" or ":preview")
    local now=os.clock()
    if now-(self.selectionAt[key] or -math.huge)&lt;0.12 then return end
    self.selectionAt[key]=now
    local gain=confirmed and 1 or 0.55
    if powerId=="Pinball" then
        self:voice("boing",0.5*gain,1.1,0.55,1.55)
    elseif powerId=="Muncher" then
        self:voice("land",0.48*gain,0.7,0.22,1.4)
        self:voice("boom",0.2*gain,1.8,0.3)
    else
        self:voice("jump",0.4*gain,1.4,0.6,0.75)
        self:voice("boom",0.23*gain,0.8,0.48)
    end
    if confirmed then self:voice("chime",0.32,1.4,0.65,1.75) end
    self.folder:SetAttribute("LastSelection",powerId)
    self.folder:SetAttribute("SelectionConfirmed",confirmed==true)
end

function Audio:stop()
    for _,tween in pairs(self.tweens) do tween:Cancel() end
    for _,pool in pairs(self.voices) do for _,sound in ipairs(pool) do sound:Stop() end end
    self.key=nil; self.tracks={}
end

function Audio:update(players,roundKey,watchedUserId,active)
    if not active then if self.key then self:stop() end; return end
    local key=tostring(roundKey)
    if self.key~=key then
        self:stop(); self.key=key
    end
    local present={}
    -- A duel has two entrants. Bounding traversal also bounds cursor storage.
    for index=1,math.min(2,#(players or {})) do
        local pilot=players[index]
        local flight=pilot.flight
        if flight then
            local id=tostring(pilot.userId)
            present[id]=true
            local events=flight.recentEvents or (flight.lastEvent and {flight.lastEvent}) or {}
            local track=self.tracks[id]
            if not track then
                track={lastSerial=0,lastAt={}}; self.tracks[id]=track
                -- Suppress history only on joining a flight already in progress.
                -- Switching cameras must not reset either pilot's cursor.
                if (flight.elapsed or 0)&gt;0.6 then
                    for _,event in ipairs(events) do track.lastSerial=math.max(track.lastSerial,event.serial or 0) end
                end
            end
            for _,event in ipairs(events) do
                local serial=event.serial or 0
                if serial&gt;track.lastSerial then
                    track.lastSerial=serial
                    local age=(flight.elapsed or 0)-(event.at or 0)
                    if age&gt;=0 and age&lt;0.7 then
                        self:playEvent(event,pilot.userId==watchedUserId and 1 or 0.65,pilot.bot and 0.94 or 1,track,pilot)
                    end
                end
            end
        end
    end
    for id in pairs(self.tracks) do if not present[id] then self.tracks[id]=nil end end
end

function Audio:destroy()
    self:stop()
    self.folder:Destroy()
end
return Audio
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX38">
        <Properties>
          <string name="Name">PilotAvatar</string>
          <ProtectedString name="Source">-- Decorative, client-only seated pilots. The real character is never reparented
-- or posed; only its Archivable flag is temporarily changed while cloning.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local World = require(ReplicatedStorage:WaitForChild("FlightGame"):WaitForChild("World"))

local PilotAvatar = {}
local active = setmetatable({}, { __mode = "k" })

local function neutralPracticePilot()
	local rig = Instance.new("Model")
	rig.Name = "PilotAvatar"
	local function part(name, size, position, color)
		local object = Instance.new("Part")
		object.Name, object.Size, object.CFrame = name, size, CFrame.new(position)
		object.Color = color
		object.Material = Enum.Material.SmoothPlastic
		object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		object.Parent = rig
		return object
	end
	local function motor(name, parent, child, c0, c1)
		local joint = Instance.new("Motor6D")
		joint.Name, joint.Part0, joint.Part1 = name, parent, child
		joint.C0, joint.C1 = c0, c1 or CFrame.identity
		joint.Parent = parent
	end
	local grey = Color3.fromRGB(193, 209, 217)
	local navy = Color3.fromRGB(32, 49, 66)
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero, navy)
	root.Transparency = 1
	rig.PrimaryPart = root
	local torso = part("Torso", Vector3.new(2, 2, 1), Vector3.zero, navy)
	local head = part("Head", Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0), grey)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType, mesh.Scale, mesh.Parent = Enum.MeshType.Head, Vector3.new(1.12, 1.12, 1.12), head
	local leftArm = part("Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0), grey)
	local rightArm = part("Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0), grey)
	local leftLeg = part("Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0), navy)
	local rightLeg = part("Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0), navy)
	local goggles = part("PracticeGoggles", Vector3.new(1.7, 0.28, 0.18), Vector3.new(0, 1.58, -0.58), Color3.fromRGB(72, 220, 225))
	motor("RootJoint", root, torso, CFrame.identity)
	motor("Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
	motor("Left Shoulder", torso, leftArm, CFrame.new(-1, 0.5, 0), CFrame.new(0.5, 0.5, 0))
	motor("Right Shoulder", torso, rightArm, CFrame.new(1, 0.5, 0), CFrame.new(-0.5, 0.5, 0))
	motor("Left Hip", torso, leftLeg, CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
	motor("Right Hip", torso, rightLeg, CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))
	motor("Goggles", head, goggles, CFrame.new(0, 0.08, -0.58))
	local humanoid = Instance.new("Humanoid")
	humanoid.Parent = rig
	return rig
end

local function cloneCharacter(player)
	local character = player and player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Head") then
		return nil
	end
	local wasArchivable = character.Archivable
	local success, result = pcall(function()
		character.Archivable = true
		return character:Clone()
	end)
	-- No yielding occurs between the temporary change and its restoration.
	character.Archivable = wasArchivable
	if success and result and result:FindFirstChild("HumanoidRootPart") and result:FindFirstChild("Head") then
		return result
	end
	if success and result then result:Destroy() end
	return nil
end

local function stripAndFreeze(rig, connections, alive)
	for _, object in ipairs(rig:GetDescendants()) do
		if object.Parent then
			if object:IsA("LuaSourceContainer") or object:IsA("Tool") or object:IsA("Sound")
				or object:IsA("GuiBase2d") or object:IsA("Animator") or object:IsA("AnimationController")
				or object:IsA("Animation") or object:IsA("ForceField") or object:IsA("BodyMover")
				or object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
				or object:IsA("Fire") or object:IsA("Smoke") or object:IsA("Sparkles") then
				object:Destroy()
			elseif object:IsA("BasePart") then
				object.Anchored = true
				object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
				object.Massless, object.CastShadow = true, false
				object.AssemblyLinearVelocity, object.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				object.LocalTransparencyModifier = 0
				-- Humanoid initialization can restore torso collision after parenting.
				-- Preserve Humanoid for clothing, but enforce a purely visual proxy.
				for property, value in pairs({ Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false }) do
					table.insert(connections, object:GetPropertyChangedSignal(property):Connect(function()
						if alive() and object.Parent and object[property] ~= value then
							object[property] = value
						end
					end))
				end
			elseif object:IsA("Constraint") then
				object.Enabled = false
			elseif object:IsA("Bone") then
				object.Transform = CFrame.identity
			end
		end
	end
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.AutoRotate = false
		humanoid.AutomaticScalingEnabled = false
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.Sit, humanoid.PlatformStand = true, true
		-- Prevent an anchored visual rig from starting its own character state loop.
		humanoid.EvaluateStateMachine = false
	end
end

local function bendForPart(name)
	local normalized = string.lower((string.gsub(name, "[%s_]", "")))
	if normalized == "leftupperleg" or normalized == "rightupperleg" then return 84 end
	if normalized == "leftlowerleg" or normalized == "rightlowerleg" then return -84 end
	if normalized == "leftleg" or normalized == "rightleg" then return 78 end
	if normalized == "leftupperarm" or normalized == "rightupperarm"
		or normalized == "leftarm" or normalized == "rightarm" then return 52 end
	if normalized == "leftlowerarm" or normalized == "rightlowerarm" then return 18 end
	if normalized == "uppertorso" then return -4 end
	return 0
end

local function seatRig(rig, planeScale)
	local root = rig:FindFirstChild("HumanoidRootPart")
	assert(root and root:IsA("BasePart"), "Avatar has no HumanoidRootPart")
	rig.PrimaryPart = root
	rig:ScaleTo(rig:GetScale() * planeScale * 0.9)
	root.Transparency = 1
	local originalRoot = root.CFrame
	local originalOffsets, joints, parts = {}, {}, {}
	for _, object in ipairs(rig:GetDescendants()) do
		if object:IsA("BasePart") then
			originalOffsets[object] = originalRoot:ToObjectSpace(object.CFrame)
			table.insert(parts, object)
		elseif object:IsA("JointInstance") and object.Part0 and object.Part1
			and object.Part0:IsDescendantOf(rig) and object.Part1:IsDescendantOf(rig) then
			table.insert(joints, object)
			if object:IsA("Motor6D") then object.Transform = CFrame.identity end
		end
	end
	-- Bake the pose through the joint graph, independently of Motor6D update timing.
	-- Rotating about rig +X also supports R6's rotated hip/shoulder joint bases.
	local posed = { [root] = CFrame.identity }
	for _ = 1, #joints + 1 do
		local progressed = false
		for _, joint in ipairs(joints) do
			local parentPose = posed[joint.Part0]
			if parentPose and not posed[joint.Part1] then
				local jointPose = parentPose * joint.C0
				local restPose = jointPose * joint.C1:Inverse()
				local bend = bendForPart(joint.Part1.Name)
				local position = jointPose.Position
				posed[joint.Part1] = CFrame.new(position) * CFrame.Angles(math.rad(bend), 0, 0)
					* CFrame.new(-position) * restPose
				progressed = true
			elseif posed[joint.Part1] and not posed[joint.Part0] then
				-- AccessoryWeld often points from its Handle back to the head.
				local jointPose = posed[joint.Part1] * joint.C1
				local restPose = jointPose * joint.C0:Inverse()
				local position = jointPose.Position
				posed[joint.Part0] = CFrame.new(position) * CFrame.Angles(math.rad(bendForPart(joint.Part0.Name)), 0, 0)
					* CFrame.new(-position) * restPose
				progressed = true
			end
		end
		if not progressed then break end
	end
	for _, part in ipairs(parts) do
		part.CFrame = posed[part] or originalOffsets[part]
	end
	-- Store the baked relation so no remaining joint can restore the standing pose.
	for _, joint in ipairs(joints) do
		joint.C0 = joint.Part0.CFrame:ToObjectSpace(joint.Part1.CFrame) * joint.C1
	end
	rig:SetAttribute("Pose", "Seated")
	rig:SetAttribute("PosePartCount", #parts)
	return root
end

function PilotAvatar.attach(model, userId, isGhost)
	assert(typeof(model) == "Instance" and model:IsA("Model"), "PilotAvatar.attach needs a plane Model")
	if active[model] then active[model].cancel() end
	local state = { cancelled = false, avatar = nil, connections = {} }
	active[model] = state
	model:SetAttribute("PilotAvatarLoaded", false)
	model:SetAttribute("PilotAvatarSource", "Loading")
	model:SetAttribute("PilotAvatarError", nil)
	local function alive()
		return not state.cancelled and active[model] == state and model.Parent ~= nil
	end
	local function cancel()
		if state.cancelled then return end
		state.cancelled = true
		for _, connection in ipairs(state.connections) do connection:Disconnect() end
		table.clear(state.connections)
		if state.avatar then state.avatar:Destroy(); state.avatar = nil end
		if state.canopy and state.canopy.Parent then state.canopy.Transparency = state.canopyTransparency end
		if active[model] == state then
			active[model] = nil
			if model.Parent then
				model:SetAttribute("PilotAvatarLoaded", false)
				model:SetAttribute("PilotAvatarSource", "Cancelled")
			end
		end
	end
	state.cancel = cancel
	table.insert(state.connections, model.Destroying:Connect(cancel))
	table.insert(state.connections, model.AncestryChanged:Connect(function(_, parent)
		if not parent then cancel() end
	end))

	task.spawn(function()
		local rig, source
		local success, failure = pcall(function()
			if not alive() then return end
			if isGhost then
				rig, source = neutralPracticePilot(), "PracticeDummy"
			else
				local player = Players:GetPlayerByUserId(userId)
				local deadline = os.clock() + 8
				while player and not rig and alive() do
					rig = cloneCharacter(player)
					if rig or os.clock() &gt;= deadline then break end
					task.wait(0.1)
				end
				if not alive() then return end
				if rig then
					source = "CharacterClone"
				else
					assert(type(userId) == "number" and userId &gt; 0, "Local test character is not available to clone")
					local description = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
					if not alive() then description:Destroy(); return end
					local rigType = Enum.HumanoidRigType.R15
					local humanoid = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid then rigType = humanoid.RigType end
					local created, result = pcall(function()
						return Players:CreateHumanoidModelFromDescriptionAsync(description, rigType)
					end)
					description:Destroy()
					if not created then error(result) end
					rig, source = result, "HumanoidDescription"
				end
			end
			if not alive() then return end
			stripAndFreeze(rig, state.connections, alive)
			seatRig(rig, model:GetScale())
			if not alive() then return end
			rig.Name = "PilotAvatar"
			rig:SetAttribute("UserId", userId)
			rig:SetAttribute("IsGhost", isGhost == true)
			rig:SetAttribute("Source", source)
			rig:SetAttribute("Loaded", true)
			rig:PivotTo(World.getCockpitCFrame(model))
			rig.Parent = model
			state.avatar = rig
			-- Parenting initializes Humanoid and can change torso collision without
			-- firing property signals. Finalize the static state after that step.
			local humanoid = rig:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Physics) end
			for _, body in ipairs(rig:GetDescendants()) do
				if body:IsA("BasePart") then
					body.Anchored = true
					body.CanCollide, body.CanTouch, body.CanQuery = false, false, false
				end
			end
			local canopy = model:FindFirstChild("Cockpit")
			if canopy and canopy:IsA("BasePart") then
				state.canopy, state.canopyTransparency = canopy, canopy.Transparency
				canopy.Transparency = math.max(canopy.Transparency, 0.72)
			end
			model:SetAttribute("PilotAvatarLoaded", true)
			model:SetAttribute("PilotAvatarSource", source)
		end)
		if not success or not alive() then
			if rig then rig:Destroy() end
			state.avatar = nil
			if not success and alive() then
				model:SetAttribute("PilotAvatarSource", "Unavailable")
				model:SetAttribute("PilotAvatarError", string.sub(tostring(failure), 1, 240))
			end
		end
	end)
	return { cancel = cancel, Destroy = cancel }
end

return PilotAvatar
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX39">
        <Properties>
          <string name="Name">BattleLab</string>
          <ProtectedString name="Source">-- A deliberately small control surface for the first combat playtest.
local Players=game:GetService("Players")
local GuiService=game:GetService("GuiService")
local BattleView=require(script.Parent:WaitForChild("BattleView"))
local BattleAudio=require(script.Parent:WaitForChild("BattleAudio"))
local PilotAvatar=require(script.Parent:WaitForChild("PilotAvatar"))
local BattleLab={}
BattleLab.__index=BattleLab
local NAVY=Color3.fromRGB(18,31,51)
local WHITE=Color3.fromRGB(255,245,221)
local MUTED=Color3.fromRGB(172,191,210)
local ACCENTS={Color3.fromRGB(255,113,111),Color3.fromRGB(70,221,234)}
local GOLD=Color3.fromRGB(255,221,87)
local POWERS={
    {id="Meteor",icon="☄️",word="BOOOM!",promise="Charge up, then dive-bomb your rival.",color=Color3.fromRGB(255,128,86)},
    {id="Firework",icon="🎆",word="FWOOSH!",promise="Fire a big rocket on every pass.",color=Color3.fromRGB(160,128,255)},
}
local function make(class,parent,name)
    local item=Instance.new(class); item.Name=name; item.Parent=parent; return item
end
local function surface(item,color,thickness)
    local stroke=make("UIStroke",item,"Edge")
    stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
    stroke.Color=color; stroke.Thickness=thickness or 1; stroke.Transparency=0.6
    local gradient=make("UIGradient",item,"Shading")
    gradient.Rotation=90
    gradient.Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(185,199,220))
    return stroke
end
local function label(parent,name,size,color)
    local item=make("TextLabel",parent,name)
    item.BackgroundTransparency=1; item.TextColor3=color or WHITE
    item.TextSize=size; item.Font=Enum.Font.GothamBold
    item.TextWrapped=true; item.Text=""
    return item
end
local function button(parent,name,text,callback)
    local item=make("TextButton",parent,name)
    item.BackgroundColor3=Color3.fromRGB(44,63,86); item.BorderSizePixel=0
    item.TextColor3=WHITE; item.Font=Enum.Font.GothamBold; item.TextSize=16; item.Text=text
    item.AutoButtonColor=true; item.Selectable=true
    make("UICorner",item,"Corner").CornerRadius=UDim.new(0,10)
    surface(item,Color3.fromRGB(132,169,201),1)
    item.Activated:Connect(callback)
    return item
end
local function place(item,x,y,w,h)
    item.Position=UDim2.fromOffset(x,y); item.Size=UDim2.fromOffset(w,h)
end
function BattleLab.new(World,shared)
    local self=setmetatable({World=World,active=false,data=nil,settings={},outbox={},sending=false,lastSend=-math.huge},BattleLab)
    self.modifiers=require(shared:WaitForChild("BattleModifiers"))
    self.audio=BattleAudio.new()
    self.command=shared:WaitForChild("BattleCommand")
    self.gui=make("ScreenGui",Players.LocalPlayer:WaitForChild("PlayerGui"),"SkyboundBattleLab")
    self.gui.ResetOnSpawn=false; self.gui.DisplayOrder=30; self.gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    self.root=make("Frame",self.gui,"Root"); self.root.Size=UDim2.fromScale(1,1); self.root.BackgroundTransparency=1
    self.panel=make("Frame",self.root,"Lab"); self.panel.Size=UDim2.fromScale(1,1); self.panel.BackgroundTransparency=1; self.panel.Visible=false
    -- One dim sheet sits behind setup and results. It reaches over the fighter
    -- bar and up into the Roblox top bar so the whole sky dims, not a slab.
    self.scrim=make("Frame",self.panel,"Scrim"); self.scrim.BorderSizePixel=0; self.scrim.ZIndex=0
    self.scrim.BackgroundColor3=NAVY; self.scrim.BackgroundTransparency=1
    -- The top of the screen is a fighting-game bar: each pilot's face, name,
    -- power and three chunky armor pips at the edges, the clock between them.
    self.header=make("Frame",self.panel,"Header"); self.header.BackgroundTransparency=1; self.header.BorderSizePixel=0
    self.exit=button(self.panel,"Exit","🏠",function() self:send("exit") end)
    self.mute=button(self.panel,"Mute","🔊",function()
        local p=Players.LocalPlayer
        p:SetAttribute("SkyboundSoundMuted",p:GetAttribute("SkyboundSoundMuted")~=true)
    end)
    self.exit.ZIndex=10; self.mute.ZIndex=10; self.exit.TextSize=20; self.mute.TextSize=18
    self.clock=label(self.header,"Clock",40,WHITE); self.clock.Font=Enum.Font.FredokaOne; self.clock.TextWrapped=false
    local clockEdge=make("UIStroke",self.clock,"Edge"); clockEdge.Thickness=5; clockEdge.Color=NAVY
    self.clockScale=make("UIScale",self.clock,"Pulse")
    self.status=label(self.panel,"Status",22)
    self.status.BackgroundColor3=Color3.fromRGB(31,49,69); self.status.BackgroundTransparency=0.08
    make("UICorner",self.status,"Corner").CornerRadius=UDim.new(0,10)
    self.statusEdge=surface(self.status,Color3.fromRGB(118,154,187),1)
    self.help=label(self.panel,"Help",14,MUTED)
    self.footer=make("Frame",self.panel,"Controls"); self.footer.BackgroundColor3=NAVY; self.footer.BorderSizePixel=0
    surface(self.footer,Color3.fromRGB(67,111,147),1)
    self.footer.AnchorPoint=Vector2.new(0,1)
    self.fighters={}
    for i=1,2 do
        local plate=make("Frame",self.header,"Fighter"..i); plate.BackgroundTransparency=1
        local ring=make("Frame",plate,"Portrait"); ring.BackgroundColor3=NAVY; ring.BorderSizePixel=0
        make("UICorner",ring,"Corner").CornerRadius=UDim.new(1,0)
        local ringEdge=make("UIStroke",ring,"Edge"); ringEdge.Thickness=4; ringEdge.Color=ACCENTS[i]
        local face=make("ImageLabel",ring,"Face"); face.BackgroundTransparency=1; face.Size=UDim2.fromScale(1,1)
        make("UICorner",face,"Corner").CornerRadius=UDim.new(1,0)
        local bot=label(ring,"Bot",30); bot.Size=UDim2.fromScale(1,1); bot.Text="🤖"; bot.TextWrapped=false; bot.Visible=i==2
        local name=label(plate,"PilotName",20,WHITE); name.Font=Enum.Font.FredokaOne; name.TextWrapped=false
        name.TextTruncate=Enum.TextTruncate.AtEnd
        local nameEdge=make("UIStroke",name,"Edge"); nameEdge.Thickness=3; nameEdge.Color=NAVY
        local power=label(plate,"Power",12,NAVY); power.BackgroundTransparency=0; power.BackgroundColor3=ACCENTS[i]; power.TextWrapped=false
        make("UICorner",power,"Corner").CornerRadius=UDim.new(0,8)
        local pips={}
        for pip=1,3 do
            local bar=make("Frame",plate,"Armor"..pip); bar.BorderSizePixel=0; bar.BackgroundColor3=ACCENTS[i]
            make("UICorner",bar,"Corner").CornerRadius=UDim.new(0,6)
            local edge=make("UIStroke",bar,"Edge"); edge.Thickness=3; edge.Color=NAVY
            pips[pip]=bar
        end
        self.fighters[i]={frame=plate,ring=ring,ringEdge=ringEdge,face=face,name=name,power=power,pips=pips}
    end
    self.fighters[1].name.Text=string.upper(Players.LocalPlayer.DisplayName)
    self.fighters[2].name.Text="RIVAL BOT"
    task.spawn(function()
        local ok,image=pcall(function()
            return Players:GetUserThumbnailAsync(Players.LocalPlayer.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size100x100)
        end)
        if ok and self.fighters[1].face.Parent then self.fighters[1].face.Image=image end
    end)
    -- Setup is one screen about your own plane: pick a power card, add a
    -- twist, FIGHT! The rival's build is rolled when the fight starts.
    self.picker=make("Frame",self.panel,"Picker"); self.picker.BorderSizePixel=0
    self.picker.BackgroundTransparency=1
    self.pickTitle=label(self.picker,"Title",38,WHITE); self.pickTitle.Font=Enum.Font.FredokaOne
    self.pickTitle.Text="CHOOSE YOUR POWER"
    local titleEdge=make("UIStroke",self.pickTitle,"Edge"); titleEdge.Thickness=4; titleEdge.Color=NAVY
    self.powerCards={}
    for index,spec in ipairs(POWERS) do
        local card=make("TextButton",self.picker,spec.id)
        card.Text=""; card.AutoButtonColor=false; card.BorderSizePixel=0; card.BackgroundColor3=spec.color
        make("UICorner",card,"Corner").CornerRadius=UDim.new(0,22)
        local edge=make("UIStroke",card,"Edge"); edge.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; edge.Thickness=5
        local shade=make("UIGradient",card,"Shading"); shade.Rotation=90
        shade.Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(200,196,214))
        local tag=label(card,"Tag",13,NAVY); tag.BackgroundColor3=WHITE; tag.BackgroundTransparency=0
        make("UICorner",tag,"Corner").CornerRadius=UDim.new(0,9)
        local icon=label(card,"Icon",60); icon.TextWrapped=false
        local word=label(card,"Word",20,WHITE); word.Font=Enum.Font.FredokaOne; word.Rotation=index==1 and -9 or 9
        word.TextWrapped=false; word.Text=spec.word
        local wordEdge=make("UIStroke",word,"Edge"); wordEdge.Thickness=3; wordEdge.Color=NAVY
        local name=label(card,"PowerName",30,NAVY); name.Font=Enum.Font.FredokaOne; name.Text=string.upper(spec.id)
        local promise=label(card,"Promise",14,NAVY); promise.Text=spec.promise
        local scale=make("UIScale",card,"Pop")
        card.Activated:Connect(function() self:choose("powerId",spec.id) end)
        self.powerCards[index]={spec=spec,button=card,edge=edge,tag=tag,icon=icon,word=word,name=name,promise=promise,scale=scale}
        icon.Text=spec.icon
    end
    self.twistTitle=label(self.picker,"TwistTitle",15,MUTED); self.twistTitle.Text="ADD A TWIST"
    self.chips={}
    for index,modifier in ipairs(self.modifiers.all()) do
        local chip=button(self.picker,"Twist"..modifier.id,modifier.id=="None" and "No twist" or modifier.name,function() self:choose("modifierId",modifier.id) end)
        chip.AutoButtonColor=false
        self.chips[index]={modifier=modifier,button=chip,color=Color3.fromRGB(modifier.color.r,modifier.color.g,modifier.color.b)}
    end
    self.twistHint=label(self.picker,"TwistHint",14,WHITE)
    self.fightButton=button(self.picker,"Fight","FIGHT!",function() self:fight() end)
    self.fightButton.Font=Enum.Font.FredokaOne; self.fightButton.TextSize=32
    self.fightButton.BackgroundColor3=Color3.fromRGB(74,201,96)
    self.fightButton.Edge.Color=WHITE; self.fightButton.Edge.Transparency=0.1; self.fightButton.Edge.Thickness=3
    -- The result is a moment of its own: a slammed-in banner, the winner's
    -- face under a crown, three numbers, and REMATCH as the obvious next tap.
    self.result=make("Frame",self.panel,"Result"); self.result.BorderSizePixel=0; self.result.ZIndex=20
    self.result.BackgroundTransparency=1; self.result.Visible=false; self.result.ClipsDescendants=true
    self.confetti={}
    for index=1,40 do
        local piece=make("Frame",self.result,"Confetti"); piece.BorderSizePixel=0; piece.ZIndex=20
        piece.BackgroundColor3=({GOLD,ACCENTS[1],ACCENTS[2],WHITE,Color3.fromRGB(160,128,255)})[index%5+1]
        self.confetti[index]={frame=piece,x=math.random(),speed=120+math.random()*200,offset=math.random(),spin=(math.random()-0.5)*500,sway=math.random()*6}
    end
    self.banner=label(self.result,"Banner",96,GOLD); self.banner.Font=Enum.Font.FredokaOne; self.banner.TextWrapped=false
    self.banner.ZIndex=22; self.banner.Rotation=-3
    local bannerEdge=make("UIStroke",self.banner,"Edge"); bannerEdge.Thickness=8; bannerEdge.Color=NAVY
    self.bannerScale=make("UIScale",self.banner,"Slam")
    self.resultLine=label(self.result,"Line",18,WHITE); self.resultLine.ZIndex=22
    self.winnerRing=make("Frame",self.result,"Winner"); self.winnerRing.BackgroundColor3=NAVY; self.winnerRing.BorderSizePixel=0; self.winnerRing.ZIndex=21
    make("UICorner",self.winnerRing,"Corner").CornerRadius=UDim.new(1,0)
    self.winnerEdge=make("UIStroke",self.winnerRing,"Edge"); self.winnerEdge.Thickness=6
    self.winnerFace=make("ImageLabel",self.winnerRing,"Face"); self.winnerFace.BackgroundTransparency=1
    self.winnerFace.Size=UDim2.fromScale(1,1); self.winnerFace.ZIndex=21
    make("UICorner",self.winnerFace,"Corner").CornerRadius=UDim.new(1,0)
    self.winnerEmoji=label(self.winnerRing,"Emoji",48); self.winnerEmoji.Size=UDim2.fromScale(1,1); self.winnerEmoji.TextWrapped=false; self.winnerEmoji.ZIndex=22
    self.crown=label(self.result,"Crown",44); self.crown.Text="👑"; self.crown.TextWrapped=false; self.crown.ZIndex=23; self.crown.Rotation=-12
    self.stats={}
    for index,caption in ipairs({"YOUR HITS","RIVAL HITS","TIME"}) do
        local chip=make("Frame",self.result,"Stat"..index); chip.BackgroundColor3=Color3.fromRGB(30,46,72); chip.BorderSizePixel=0; chip.ZIndex=21
        make("UICorner",chip,"Corner").CornerRadius=UDim.new(0,12)
        local edge=make("UIStroke",chip,"Edge"); edge.Thickness=2; edge.Color=Color3.fromRGB(86,118,160)
        local value=label(chip,"Value",28,WHITE); value.Font=Enum.Font.FredokaOne; value.ZIndex=22; value.TextWrapped=false
        local name=label(chip,"Caption",11,MUTED); name.Text=caption; name.ZIndex=22; name.TextWrapped=false
        self.stats[index]={frame=chip,value=value,caption=name,edge=edge}
    end
    self.replay=button(self.result,"Replay","REMATCH",function() self:rematch() end)
    self.replay.BackgroundColor3=Color3.fromRGB(74,201,96); self.replay.Font=Enum.Font.FredokaOne; self.replay.TextSize=30
    self.replay.Edge.Color=WHITE; self.replay.Edge.Transparency=0.1; self.replay.Edge.Thickness=3
    self.edit=button(self.result,"Edit","Change power",function() self.audio:ui(false); self:send("restart",{edit=true}) end)
    self.leave=button(self.result,"Leave","Hangar",function() self.audio:ui(false); self:send("exit") end)
    for _,item in ipairs({self.replay,self.edit,self.leave}) do item.ZIndex=22 end
    self.footerHint=label(self.footer,"Hint",13,MUTED)
    -- Full-screen beats: a white impact flash and the 3-2-1-FIGHT call.
    self.flash=make("Frame",self.panel,"ImpactFlash")
    self.flash.Size=UDim2.fromScale(1,1); self.flash.BorderSizePixel=0; self.flash.Active=false
    self.flash.BackgroundColor3=Color3.new(1,1,1); self.flash.BackgroundTransparency=1; self.flash.ZIndex=40
    self.count=label(self.panel,"Countdown",150,Color3.fromRGB(255,221,87))
    self.count.Font=Enum.Font.FredokaOne; self.count.TextWrapped=false; self.count.ZIndex=41
    self.count.AnchorPoint=Vector2.new(0.5,0.5); self.count.Size=UDim2.fromOffset(900,220); self.count.Visible=false
    local countEdge=make("UIStroke",self.count,"Edge"); countEdge.Thickness=8; countEdge.Color=NAVY
    self.countScale=make("UIScale",self.count,"Pop")
    shared:WaitForChild("BattleSnapshot").OnClientEvent:Connect(function(data)
        if type(data)~="table" then return end
        local wasActive=self.active
        local previousPhase=self.data and self.data.phase
        self.active=data.active==true; self.data=data
        if self.active then
            -- This pilot owns setup edits. Older periodic snapshots must not
            -- roll back a tap that is still travelling to the server.
            if not wasActive or data.phase~="Configure" or previousPhase~="Configure" then
            self.settings={{powerId=data.settings[1].powerId,angle=data.settings[1].angle,modifierId=data.settings[1].modifierId or "None"},
                {powerId=data.settings[2].powerId,angle=data.settings[2].angle,modifierId=data.settings[2].modifierId or "None"}}
            end
            if not self.view then
                self.view=BattleView.new(World,function(cue)
                    if cue.kind=="crash" then self.audio:playCrash(cue.roundId,cue.actor) end
                end,{pilots=PilotAvatar})
            end
        elseif self.view then self.view:destroy(); self.view=nil end
        self.panel.Visible=self.active
        Players.LocalPlayer:SetAttribute("BattleLabPhase",self.active and data.phase or "Inactive")
    end)
    self:send("request")
    return self
end
function BattleLab:send(kind,payload)
    payload=payload or {}; payload.kind=kind
    if payload.settings then
        payload.settings={{powerId=payload.settings[1].powerId,angle=payload.settings[1].angle,modifierId=payload.settings[1].modifierId},
            {powerId=payload.settings[2].powerId,angle=payload.settings[2].angle,modifierId=payload.settings[2].modifierId}}
    end
    -- Queue button intents in order, including configuration before launch.
    -- Coalesce rapid setup taps and stay below the server's shared rate limit.
    local last=self.outbox[#self.outbox]
    if last and last.kind=="configure" and kind=="configure" then self.outbox[#self.outbox]=payload
    else table.insert(self.outbox,payload) end
    if self.sending then return end
    self.sending=true
    task.spawn(function()
        while #self.outbox&gt;0 do
            local delay=0.08-(os.clock()-self.lastSend)
            if delay&gt;0 then task.wait(delay) end
            local nextPayload=table.remove(self.outbox,1)
            self.command:FireServer(nextPayload); self.lastSend=os.clock()
        end
        self.sending=false
    end)
end
function BattleLab:isActive() return self.active end
function BattleLab:choose(key,value)
    if not self.data or self.data.phase~="Configure" or not self.settings[1] then return end
    self.settings[1][key]=value
    self.pickedAt=os.clock()
    self.audio:ui(false)
    self:send("configure",{settings=self.settings})
end
-- The rival's build is a surprise revealed by the countdown. Firework mirrors
-- still trade into draws, so the bot never copies a Firework pick.
function BattleLab:fight()
    if not self.data or self.data.phase~="Configure" or not self.settings[2] then return end
    local twists=self.modifiers.all()
    local rival=self.settings[2]
    rival.powerId=self.settings[1].powerId=="Firework" and "Meteor" or POWERS[math.random(#POWERS)].id
    rival.modifierId=twists[math.random(#twists)].id
    rival.angle=math.random(4,10)*5
    self.audio:ui(true)
    self.launchHide=os.clock()+1.5
    self:send("launch",{settings=self.settings})
end
-- One tap from results to a fresh fight against a newly rolled rival.
function BattleLab:rematch()
    self.rematchUntil=os.clock()+1.5
    self.audio:ui(true)
    self:send("restart",{edit=true})
end
-- Waits for the knockout to play out in the arena, then takes the screen.
function BattleLab:showResult(data,results,accents,width,height,headerHeight,compact,short)
    if not results then self.result.Visible=false; self.resultRound=nil; return end
    local sim=data.simulation
    if self.resultRound~=data.roundId then
        self.resultRound,self.resultAt,self.resultSounded=data.roundId,os.clock(),false
    end
    local age=os.clock()-self.resultAt-(sim.reason=="knockout" and 1.8 or 0.6)
    self.result.Visible=age&gt;0
    if age&lt;=0 then return end
    local outcome=sim.winner==1 and "win" or (sim.winner==2 and "lose" or "draw")
    if not self.resultSounded then self.resultSounded=true; self.audio:result(outcome) end
    local area=height-headerHeight
    place(self.result,0,headerHeight,width,area)
    self.resultDim=1-0.55*math.clamp(age/0.25,0,1)
    local bannerHeight=compact and 60 or (short and 70 or 104)
    local face=short and 0 or math.clamp(area*0.2,56,124)
    local statHeight=short and 48 or 64
    local stacked=compact
    local buttonsHeight=stacked and 112 or 64
    local total=bannerHeight+26+(face&gt;0 and face+22 or 0)+statHeight+18+buttonsHeight+10
    local y=math.max(4,(area-total)/2)
    local tint=outcome=="win" and GOLD or (outcome=="lose" and Color3.fromRGB(150,170,205) or WHITE)
    place(self.banner,0,y,width,bannerHeight)
    self.banner.Text=outcome=="win" and "VICTORY!" or (outcome=="lose" and "DEFEAT" or "DRAW!")
    self.banner.TextColor3=tint
    self.banner.TextSize=math.min(bannerHeight*0.95,width*0.17)
    self.bannerScale.Scale=1+1.6*math.max(0,1-age/0.2)^2
    y=y+bannerHeight
    place(self.resultLine,12,y,width-24,22)
    self.resultLine.TextSize=compact and 13 or 18
    self.resultLine.Text=sim.reason=="timeout"
        and (outcome=="draw" and "Time ran out with armor level" or (outcome=="win" and "Time! You had more armor left" or "Time! The rival had more armor left"))
        or (outcome=="draw" and "Both planes went down" or (outcome=="win" and "You knocked the rival out of the sky" or "You got knocked out of the sky"))
    y=y+26
    local settled=age&gt;0.3
    self.winnerRing.Visible=face&gt;0 and settled; self.crown.Visible=face&gt;0 and settled and outcome~="draw"
    if face&gt;0 then
        y=y+14
        place(self.winnerRing,(width-face)/2,y,face,face)
        self.winnerEdge.Color=outcome=="draw" and WHITE or accents[sim.winner]
        self.winnerFace.Image=outcome=="win" and self.fighters[1].face.Image or ""
        self.winnerEmoji.Text=outcome=="lose" and "🤖" or (outcome=="draw" and "🤝" or "")
        self.winnerEmoji.TextSize=face*0.55
        place(self.crown,(width-face)/2-face*0.18,y-face*0.32,face*0.6,face*0.6)
        self.crown.TextSize=face*0.46
        y=y+face+8
    end
    local statWidth=math.min(170,(width-40)/3)
    local values={tostring(sim.fighters[1].hits),tostring(sim.fighters[2].hits),string.format("%.1fs",sim.elapsed)}
    for index,stat in ipairs(self.stats) do
        stat.frame.Visible=settled
        place(stat.frame,width/2-statWidth*1.5-8+(index-1)*(statWidth+8),y,statWidth,statHeight)
        place(stat.value,0,2,statWidth,statHeight*0.6); stat.value.Text=values[index]; stat.value.TextSize=statHeight*0.46
        place(stat.caption,0,statHeight*0.62,statWidth,statHeight*0.3); stat.caption.TextSize=compact and 9 or 11
        stat.edge.Color=index&lt;3 and accents[index] or Color3.fromRGB(86,118,160)
    end
    y=y+statHeight+18
    for _,item in ipairs({self.replay,self.edit,self.leave}) do item.Visible=age&gt;0.5 end
    if stacked then
        place(self.replay,16,y,width-32,56)
        place(self.edit,16,y+62,(width-40)/2,44); place(self.leave,24+(width-40)/2,y+62,(width-40)/2,44)
    else
        local main=math.min(300,width*0.3)
        local sideWidth=math.min(170,width*0.16)
        local row=main+2*(sideWidth+10)
        place(self.replay,(width-row)/2+sideWidth+10,y,main,64)
        place(self.edit,(width-row)/2,y+10,sideWidth,46)
        place(self.leave,(width-row)/2+sideWidth+10+main+10,y+10,sideWidth,46)
    end
    -- A gentle pulse keeps the eye on the next fight.
    self.replay.TextSize=(stacked and 26 or 30)+2*math.sin(os.clock()*5)
    for _,piece in ipairs(self.confetti) do
        piece.frame.Visible=outcome=="win" and not self.reducedMotion
        if piece.frame.Visible then
            local fall=(age*piece.speed+piece.offset*area)%(area+40)-20
            piece.frame.Size=UDim2.fromOffset(8,14)
            piece.frame.Position=UDim2.fromOffset(piece.x*width+math.sin(age*2+piece.sway)*18,fall)
            piece.frame.Rotation=age*piece.spin
        end
    end
end
function BattleLab:feedback(data)
    local sim=data.simulation
    if self.feedbackRound~=data.roundId then
        self.feedbackRound=data.roundId; self.eventSerial=0; self.feedbackUntil=0; self.lastHit=nil; self.hitTimes={}
    end
    if data.phase=="Configure" or data.phase=="Countdown" then return end
    for _,event in ipairs(sim.events or {}) do
        if event.serial&gt;(self.eventSerial or 0) then
            self.eventSerial=event.serial
            local recent=sim.elapsed-(event.at or 0)&lt;0.75
            if event.kind=="hit" or event.kind=="wake_hit" then
                local attack=event.source=="meteor" and "METEOR SLAM" or (event.source=="wake" and "FIZZY WAKE HIT" or "ROCKET HIT")
                local victim=event.target==1 and "YOU" or "RIVAL"
                self.lastHit={target=event.target,source=attack}
                if recent then
                    self.feedbackText=attack.." · "..victim.." −1"; self.feedbackUntil=os.clock()+0.7
                    self.hitTimes[event.target]=os.clock()
                end
            elseif event.kind=="blocked" and recent then
                self.feedbackText=(event.actor==1 and "YOUR BUMPER" or "RIVAL BUMPER").." SAVED A HIT!"
                self.feedbackUntil=os.clock()+0.8
            end
        end
    end
end
function BattleLab:update(dt)
    local width,height=self.root.AbsoluteSize.X,self.root.AbsoluteSize.Y
    local muted=Players.LocalPlayer:GetAttribute("SkyboundSoundMuted")==true
    if self.muted~=muted then self.audio:setMuted(muted); self.muted=muted end
    self.audio:update(self.data or {active=false})
    if not self.active or not self.data or not self.view then return end
    local data=self.data
    -- The HUD wears the same paint as the two planes.
    local accents={self.view:accent(1),self.view:accent(2)}
    local config=data.phase=="Configure"
    local results=data.phase=="Results"
    local compact=width&lt;600
    local short=height&lt;500
    local headerHeight=(short or compact) and 62 or 98
    local plainFight=data.phase=="Fight" and (data.settings[1].modifierId or "None")=="None"
        and (data.settings[2].modifierId or "None")=="None"
    local quiet=config or plainFight or data.phase=="Countdown"
    quiet=quiet or results
    local footerHeight=quiet and 0 or 54
    self.footer.Visible=not quiet
    place(self.header,0,0,width,headerHeight)
    place(self.exit,12,headerHeight+4,40,40)
    place(self.mute,58,headerHeight+4,40,40); self.mute.Text=muted and "🔇" or "🔊"
    local portrait=headerHeight-18
    local plateWidth=math.min(340,(width-124)/2)
    local sim=data.simulation
    for i,fighter in ipairs(self.fighters) do
        local right=i==2
        local f=sim.fighters[i]
        local flash=math.max(0,1-(os.clock()-((self.hitTimes or {})[i] or -100))/0.35)
        place(fighter.frame,right and width-12-plateWidth or 12,8,plateWidth,portrait+4)
        place(fighter.ring,right and plateWidth-portrait or 0,2,portrait,portrait)
        fighter.ringEdge.Color=accents[i]:Lerp(WHITE,flash); fighter.ringEdge.Thickness=4+flash*4
        local textWidth=plateWidth-portrait-12
        local textLeft=right and 0 or portrait+12
        local side=right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
        place(fighter.name,textLeft,0,textWidth,compact and 18 or 28)
        fighter.name.TextXAlignment=side; fighter.name.TextSize=compact and 14 or 24
        local powerWidth=math.min(textWidth,compact and 86 or 112)
        local rowTwo=compact and 19 or 31
        place(fighter.power,right and textLeft+textWidth-powerWidth or textLeft,rowTwo,powerWidth,compact and 14 or 19)
        fighter.power.Text=(right and config) and "???" or string.upper(f.powerId)
        fighter.power.TextSize=compact and 10 or 13; fighter.power.BackgroundColor3=accents[i]
        local pipHeight=compact and 9 or 18
        local pipWidth=math.min(compact and 30 or 62,(textWidth-12)/3)
        for pip,bar in ipairs(fighter.pips) do
            local offset=(pip-1)*(pipWidth+6)
            place(bar,right and textLeft+textWidth-offset-pipWidth or textLeft+offset,portrait-pipHeight+1,pipWidth,pipHeight)
            local full=pip&lt;=f.armor
            bar.BackgroundColor3=(full and accents[i] or Color3.fromRGB(36,44,62)):Lerp(WHITE,flash*0.7)
            bar.BackgroundTransparency=full and 0 or 0.35
        end
    end
    -- The clock is the centre of the bar and gets loud in the last ten seconds.
    local left=math.max(0,math.ceil(35-sim.elapsed))
    local urgent=data.phase=="Fight" and left&lt;=10
    place(self.clock,width/2-60,4,120,headerHeight-12)
    self.clock.Text=data.phase=="Fight" and tostring(left) or (results and (sim.reason=="timeout" and "TIME!" or "K.O.") or "VS")
    self.clock.TextSize=(compact and 26 or 52)*(#self.clock.Text&gt;2 and 0.7 or 1)
    self.clock.TextColor3=urgent and Color3.fromRGB(255,96,84) or (results and GOLD or WHITE)
    self.clockScale.Scale=urgent and 1+0.14*math.abs(math.sin(os.clock()*math.pi)) or 1
    local statusWidth=math.min(width-24,620)
    local statusTop=headerHeight+(compact and 48 or 6)
    place(self.status,(width-statusWidth)/2,statusTop,statusWidth,28)
    self.status.TextSize=compact and 17 or 22
    place(self.help,12,statusTop+28,width-24,22)
    self.help.TextSize=compact and 11 or 14
    self.help.Visible=not config and not results; self.status.Visible=not config and not results
    place(self.footer,0,height,width,footerHeight)
    -- A rematch passes through setup for a moment; roll the rival and go.
    local rematching=config and self.rematchUntil~=nil and os.clock()&lt;self.rematchUntil
    if rematching then self.rematchUntil=nil; self:fight() end
    -- Hide setup the moment a fight is requested; return if nothing started.
    self.picker.Visible=config and os.clock()&gt;(self.launchHide or 0)
    if self.picker.Visible then
        local top=headerHeight
        local area=height-top
        place(self.picker,0,top,width,area)
        local panelWidth=math.min(width-24,760)
        local x0=(width-panelWidth)/2
        local showTitle=area&gt;=380
        local chipRows=compact and 2 or 1
        local chipHeight=short and 36 or 42
        local fightHeight=short and 48 or 62
        local fixed=(showTitle and 54 or 8)+(showTitle and 26 or 0)+chipRows*(chipHeight+6)+(showTitle and 26 or 0)+fightHeight+34
        local cardHeight=math.clamp(area-fixed,72,230)
        local y=math.max(6,(area-fixed-cardHeight)/2)
        self.pickTitle.Visible=showTitle; self.twistTitle.Visible=showTitle; self.twistHint.Visible=showTitle
        if showTitle then
            place(self.pickTitle,x0,y,panelWidth,46); self.pickTitle.TextSize=compact and 26 or 38; y=y+54
        else y=y+8 end
        local cardWidth=(panelWidth-14)/2
        for index,card in ipairs(self.powerCards) do
            local chosen=self.settings[1].powerId==card.spec.id
            place(card.button,x0+(index-1)*(cardWidth+14),y,cardWidth,cardHeight)
            card.button.BackgroundColor3=chosen and card.spec.color or card.spec.color:Lerp(NAVY,0.45)
            card.edge.Color=chosen and GOLD or NAVY; card.edge.Thickness=chosen and 6 or 4
            -- The chosen card pops forward with a little bounce.
            local bounce=chosen and math.max(0,1-(os.clock()-(self.pickedAt or 0))/0.2) or 0
            card.scale.Scale=(chosen and 1.03 or 0.95)+bounce*0.07
            card.button.ZIndex=chosen and 3 or 2
            local roomy=cardHeight&gt;=150
            place(card.tag,12,10,math.min(cardWidth-24,150),22)
            card.tag.Text=chosen and "✓ YOUR POWER" or "TAP TO PICK"
            card.tag.BackgroundTransparency=chosen and 0 or 0.45
            place(card.icon,0,roomy and 34 or 4,roomy and cardWidth or cardHeight,roomy and cardHeight*0.4 or cardHeight-8)
            card.icon.TextSize=math.clamp((roomy and cardHeight*0.34 or cardHeight*0.5),28,84)
            place(card.word,cardWidth-math.min(150,cardWidth*0.5),roomy and 40 or 6,math.min(140,cardWidth*0.46),28)
            card.word.TextSize=compact and 15 or 22; card.word.Visible=roomy or cardWidth&gt;300
            if roomy then
                place(card.name,8,34+cardHeight*0.4,cardWidth-16,36)
                place(card.promise,14,34+cardHeight*0.4+36,cardWidth-28,cardHeight-(34+cardHeight*0.4+36)-8)
            else
                place(card.name,cardHeight,cardHeight/2-16,cardWidth-cardHeight-8,32)
            end
            card.name.TextSize=math.clamp(cardWidth*0.12,18,34)
            card.promise.Visible=roomy; card.promise.TextSize=compact and 12 or 15
        end
        y=y+cardHeight+12
        if showTitle then place(self.twistTitle,x0,y,panelWidth,20); y=y+26 end
        local perRow=#self.chips/chipRows
        local chipWidth=(panelWidth-(perRow-1)*8)/perRow
        local chosenTwist=self.modifiers.get(self.settings[1].modifierId) or self.modifiers.get("None")
        for index,chip in ipairs(self.chips) do
            local row,column=math.floor((index-1)/perRow),(index-1)%perRow
            local chosen=chip.modifier.id==chosenTwist.id
            place(chip.button,x0+column*(chipWidth+8),y+row*(chipHeight+6),chipWidth,chipHeight)
            chip.button.BackgroundColor3=chosen and chip.color or Color3.fromRGB(40,58,84)
            chip.button.TextColor3=chosen and NAVY or WHITE
            chip.button.TextSize=compact and 13 or 16
            chip.button.Edge.Color=chosen and GOLD or chip.color; chip.button.Edge.Transparency=chosen and 0 or 0.35
            chip.button.Edge.Thickness=chosen and 3 or 1
        end
        y=y+chipRows*(chipHeight+6)
        if showTitle then
            place(self.twistHint,x0,y,panelWidth,22); self.twistHint.TextSize=compact and 12 or 15
            self.twistHint.Text=chosenTwist.id=="None" and "No twist: just your power." or chosenTwist.description
            y=y+26
        end
        local fightWidth=math.min(panelWidth,440)
        place(self.fightButton,(width-fightWidth)/2,y+8,fightWidth,fightHeight)
        self.fightButton.TextSize=short and 26 or 34
    end
    self.footerHint.Visible=not config
    self.footerHint.TextSize=compact and 12 or 13
    place(self.footerHint,12,7,width-24,40)
    self:showResult(data,results,accents,width,height,headerHeight,compact,short)
    self:feedback(data)
    self.status.TextColor3=WHITE
    self.statusEdge.Color=Color3.fromRGB(118,154,187)
    self.statusEdge.Transparency=0.6
    if config then
        self.status.Text=""; self.help.Text=""
    elseif data.phase=="Countdown" then
        self.status.Text="GET READY"
        self.help.Text="Watch the windup. The attack is committed."
        self.footerHint.Text="Meteor dives into a ram · Firework sends a rocket"
    elseif results then
        self.status.Text=""; self.help.Text=""
    else
        self.status.Text=sim.pressure&gt;0 and "WIND CLOSING IN" or "BATTLE!"
        if os.clock()&lt;(self.feedbackUntil or 0) then
            self.status.Text=self.feedbackText; self.status.TextColor3=Color3.fromRGB(255,213,94)
            self.statusEdge.Color=self.status.TextColor3; self.statusEdge.Transparency=0.15
        end
        self.help.Text=""
        local effects={}
        for i,f in ipairs(sim.fighters) do
            local effect=self.modifiers.get(f.modifierId or "None")
            local name=effect and effect.name or "No effect"
            if f.modifierId=="SpringBumper" then name=f.bumperReady and "Bumper ready" or "Bumper spent" end
            if (f.boostLeft or 0)&gt;0 then name="Afterburner firing!" end
            effects[i]=(i==1 and "YOU: " or "RIVAL: ")..name
        end
        self.footerHint.Text=table.concat(effects,"   ·   ")
    end
    -- Three evenly spaced beats across the server countdown, then FIGHT!
    local call=nil
    if data.phase=="Countdown" then
        local remaining=data.endsAt-workspace:GetServerTimeNow()
        if self.countRound~=data.roundId then self.countRound=data.roundId; self.countSpan=math.max(0.3,remaining) end
        call=tostring(4-math.clamp(math.floor((1-remaining/self.countSpan)*3)+1,1,3))
    elseif data.phase=="Fight" and sim.elapsed&lt;0.8 then call="FIGHT!" end
    if call~=self.countText then self.countText=call; self.countAt=os.clock() end
    self.count.Visible=call~=nil
    if call then
        local age=os.clock()-(self.countAt or 0)
        self.count.Text=call
        self.count.Position=UDim2.fromOffset(width/2,headerHeight+(height-headerHeight-footerHeight)/2)
        self.count.TextSize=math.min(call=="FIGHT!" and 130 or 170,width*0.24)
        self.count.TextColor3=call=="FIGHT!" and Color3.fromRGB(255,112,92) or Color3.fromRGB(255,221,87)
        self.countScale.Scale=1+1.1*math.max(0,1-age/0.18)^2
        self.count.TextTransparency=math.clamp((age-0.45)/0.3,0,1)
        self.count.Edge.Transparency=self.count.TextTransparency
    end
    local inset=GuiService:GetGuiInset()
    place(self.scrim,-inset.X,-inset.Y,width+inset.X*2,height+inset.Y)
    self.scrim.BackgroundTransparency=self.picker.Visible and 0.3 or (self.result.Visible and self.resultDim or 1)
    local origin=self.root.AbsolutePosition+inset
    self.view:update(data,dt,{left=origin.X+10,right=origin.X+width-10,
        top=origin.Y+(config and headerHeight+8 or statusTop+50),bottom=origin.Y+height-footerHeight-8})
    self.flash.BackgroundTransparency=1-math.min(0.7,self.view.screenFlash*0.7)
end
return BattleLab
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX40">
        <Properties>
          <string name="Name">BattleView</string>
          <ProtectedString name="Source">--!nonstrict
-- Local presentation for Battle Lab. Simulation owns every hit and outcome.
-- The caller owns the render connection and must skip its normal flight camera
-- while calling update. viewportRect uses Camera.ViewportSize pixel coordinates.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")

local BattleView = {}
BattleView.__index = BattleView

local ORIGIN = Vector3.new(0, 80, -4000)
local SCALE = 1.5
local MIN_X, MAX_X, MIN_Y, MAX_Y = -72, 72, 8, 96
local CENTER_Y = (MIN_Y + MAX_Y) / 2
local COLORS = {
	coral = Color3.fromRGB(255, 104, 102), cyan = Color3.fromRGB(66, 225, 239),
	cream = Color3.fromRGB(255, 245, 217), yellow = Color3.fromRGB(255, 212, 80),
	fire = Color3.fromRGB(255, 145, 54), boost = Color3.fromRGB(161, 246, 255),
	navy = Color3.fromRGB(20, 35, 59), dark = Color3.fromRGB(12, 22, 39),
	grid = Color3.fromRGB(39, 62, 83), steel = Color3.fromRGB(60, 86, 104),
	purple = Color3.fromRGB(184, 138, 255), ink = Color3.fromRGB(14, 22, 44),
	skyTop = Color3.fromRGB(30, 78, 186), skyMid = Color3.fromRGB(78, 158, 236),
	horizon = Color3.fromRGB(255, 216, 176), cloud = Color3.fromRGB(255, 247, 232),
	cloudShade = Color3.fromRGB(255, 205, 196), deck = Color3.fromRGB(38, 58, 92),
	storm = Color3.fromRGB(86, 64, 150),
}
-- Same order as the hangar's paint swatch, so a pilot's paint carries over.
local PLANE_COLORS = { COLORS.coral, COLORS.cyan, COLORS.yellow, COLORS.purple }
local PLAYER_COLORS = { COLORS.coral, COLORS.cyan }
local FAN_COLORS = { COLORS.coral, COLORS.cyan, COLORS.yellow, COLORS.cream, COLORS.purple }
local FULL_WIDTH, FULL_HEIGHT = 172, 112
-- The lens rests fairly wide and only closes in while someone is attacking.
local REST_VIEW_WIDTH, REST_VIEW_HEIGHT = 126, 80
local ATTACK_VIEW_WIDTH, ATTACK_VIEW_HEIGHT = 94, 60
local SMOKE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE_TEXTURE = "rbxasset://textures/particles/fire_main.dds"
local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local BURST_LIMIT = 6
local EFFECT_LIMIT, ROCKET_LIMIT, WAKE_LIMIT = 10, 24, 12

local function part(parent, name, size, pose, color, material, shape)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = pose
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.CastShadow = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	if shape then object.Shape = shape end
	object.Parent = parent
	return object
end

local function ellipsoid(parent, name, size, pose, color, material)
	local object = part(parent, name, size, pose, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = object
	return object
end

local function arenaPose(x, y, z)
	return CFrame.new(ORIGIN + Vector3.new(x, y, z or 0))
end

local function numeric(value, fallback)
	return type(value) == "number" and value == value and math.abs(value) &lt; 1e7 and value or fallback
end

local function hide(pieces)
	for _, piece in ipairs(pieces) do piece.Transparency = 1 end
end

local function makeRing(parent, name, count, color)
	local pieces = {}
	for index = 1, count do
		pieces[index] = part(parent, name, Vector3.one, CFrame.identity, color, Enum.Material.Neon)
		pieces[index].Transparency = 1
	end
	return pieces
end

local function ring(pieces, center, radius, color, transparency, rotation, thickness)
	for index, piece in ipairs(pieces) do
		local angle = index / #pieces * math.pi * 2 + (rotation or 0)
		piece.Size = Vector3.new(math.max(0.1, 2 * radius * math.sin(math.pi / #pieces) * 0.78), thickness or 0.35, 0.18)
		piece.CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * radius, math.sin(angle) * radius, 0))
			* CFrame.Angles(0, 0, angle + math.pi / 2)
		piece.Color, piece.Transparency = color, transparency
	end
end

local function makeWake(parent)
	local disc = part(parent, "FizzyFuelHazard", Vector3.one, CFrame.identity, COLORS.fire, Enum.Material.Neon, Enum.PartType.Cylinder)
	disc.Transparency = 1
	return { disc = disc, edge = makeRing(parent, "WakeBoundary", 8, COLORS.fire) }
end

local function hideWake(wake)
	wake.disc.Transparency = 1
	hide(wake.edge)
end

local function poseForVelocity(position, vx, vy, facing, bank)
	-- Plane geometry points along local +X. Yaw when facing left preserves the
	-- cockpit above the wings instead of flipping the aircraft upside down.
	-- Yaw(pi) * Rz(pitch) maps the nose to (-cos(pitch), sin(pitch), 0),
	-- so positive vertical velocity correctly pitches UP on either heading.
	local pitch = math.clamp(math.atan2(vy, math.max(0.1, math.abs(vx))), -1.5, 1.5)
	return CFrame.new(position) * CFrame.Angles(0, facing &lt; 0 and math.pi or 0, 0)
		* CFrame.Angles(0, 0, pitch) * CFrame.Angles(bank or 0.22, 0, 0)
end

local function chargeProgress(fighter, state, sampleAge)
	local duration = math.max(0.01, numeric(state.windupDuration, fighter.observedWindupDuration or 1))
	return math.clamp(1 - (numeric(state.phaseLeft, duration) - sampleAge) / duration, 0, 1)
end

local function solidBottom(geometry, rotation)
	local bottom = math.huge
	for _, solid in ipairs(geometry) do
		local pose = rotation * solid.pose
		local half = solid.half
		local extent = math.abs(pose.RightVector.Y) * half.X
			+ math.abs(pose.UpVector.Y) * half.Y + math.abs(pose.LookVector.Y) * half.Z
		bottom = math.min(bottom, pose.Position.Y - extent)
	end
	return bottom &lt; math.huge and bottom or -3
end

local function emitter(parent, name, texture, properties)
	local object = Instance.new("ParticleEmitter")
	object.Name = name
	object.Texture = texture
	object.Enabled = false
	object.Rate = 0
	object.LightInfluence = 0
	object.SpreadAngle = Vector2.new(180, 180)
	for key, value in pairs(properties) do object[key] = value end
	object.Parent = parent
	return object
end

local function fade(from, to)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, from), NumberSequenceKeypoint.new(1, to) })
end

local function makeSky(scenery)
	-- A painted late-afternoon sky above a cloud sea. Everything is far behind
	-- the combat plane, so the moving camera gets parallax for free.
	local sky = part(scenery, "Sky", Vector3.new(2048, 1500, 4), arenaPose(0, CENTER_Y + 150, -270), COLORS.skyMid)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.LightInfluence = 0
	gui.CanvasSize = Vector2.new(64, 256)
	gui.Parent = sky
	local wash = Instance.new("Frame")
	wash.Size = UDim2.fromScale(1, 1)
	wash.BorderSizePixel = 0
	wash.BackgroundColor3 = Color3.new(1, 1, 1)
	wash.Parent = gui
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, COLORS.skyTop), ColorSequenceKeypoint.new(0.56, COLORS.skyMid),
		ColorSequenceKeypoint.new(0.67, COLORS.horizon), ColorSequenceKeypoint.new(1, COLORS.cloudShade),
	})
	gradient.Parent = wash
	local sun = ellipsoid(scenery, "Sun", Vector3.new(56, 56, 3), arenaPose(-120, CENTER_Y + 62, -262), COLORS.cream, Enum.Material.Neon)
	sun.Transparency = 0.1
	local halo = ellipsoid(scenery, "SunHalo", Vector3.new(150, 150, 3), arenaPose(-120, CENTER_Y + 62, -265), COLORS.horizon, Enum.Material.Neon)
	halo.Transparency = 0.72
	local clouds = {}
	local function cloud(x, y, z, size, drift)
		local model = Instance.new("Model")
		model.Name = "Cloud"
		model.Parent = scenery
		local core = ellipsoid(model, "Puff", Vector3.new(size * 2.2, size * 0.8, size * 0.6), arenaPose(x, y, z), COLORS.cloud)
		model.PrimaryPart = core
		ellipsoid(model, "Puff", Vector3.new(size * 1.3, size * 0.95, size * 0.6), arenaPose(x - size * 0.42, y + size * 0.26, z + 0.4), COLORS.cloud)
		ellipsoid(model, "Puff", Vector3.new(size * 1.1, size * 0.75, size * 0.6), arenaPose(x + size * 0.5, y + size * 0.16, z + 0.2), COLORS.cloud)
		ellipsoid(model, "Shade", Vector3.new(size * 1.9, size * 0.34, size * 0.5), arenaPose(x + size * 0.05, y - size * 0.24, z + 0.6), COLORS.cloudShade)
		table.insert(clouds, { model = model, x = x, y = y, z = z, drift = drift, span = 300 + math.abs(z) * 1.5 })
	end
	-- Deterministic scatter: near clouds are large and quick, far ones slow.
	local seed = 11
	local function roll()
		seed = (seed * 16807) % 2147483647
		return (seed - 1) / 2147483646
	end
	for layer, depth in ipairs({ -50, -100, -160, -225 }) do
		for _ = 1, 5 do
			local span = 300 + math.abs(depth) * 1.5
			cloud((roll() * 2 - 1) * span, CENTER_Y - 30 + roll() * (100 + layer * 20), depth - roll() * 14,
				14 + layer * 6 + roll() * 10, (1.6 + roll() * 1.4) * (5 - layer) * 0.6)
		end
	end
	-- The cloud sea the arena floats above.
	for index = 1, 12 do
		local z = -34 - (index % 4) * 40
		local span = 300 + math.abs(z) * 1.5
		cloud((roll() * 2 - 1) * span, MIN_Y - 24 - (index % 3) * 9, z, 44 + roll() * 30, 1.2 + roll())
	end
	return clouds
end

local function makeStands(scenery)
	-- Two bleachers behind the deck. Each row is one model so a whole row can
	-- bounce with a single pivot when the crowd reacts.
	local rows = {}
	for sideIndex, side in ipairs({ -1, 1 }) do
		local accent = PLAYER_COLORS[sideIndex]
		for row = 1, 3 do
			local model = Instance.new("Model")
			model.Name = "CrowdRow"
			model.Parent = scenery
			local y, z = MIN_Y - 3.4 + row * 3.1, -9 - row * 4.2
			local bench = part(model, "Bench", Vector3.new(58, 1.1, 4), arenaPose(side * 41, y - 1.6, z), row % 2 == 0 and COLORS.deck or COLORS.steel)
			model.PrimaryPart = bench
			for seat = 1, 13 do
				local x = side * 41 - 27 + (seat - 0.5) * 54 / 13 + (row % 2) * 1.6
				local color = (seat + row) % 3 == 0 and accent or FAN_COLORS[(seat * 3 + row * 2 + sideIndex) % #FAN_COLORS + 1]
				part(model, "Fan", Vector3.new(2.4, 2.4, 2.4), arenaPose(x, y, z), color, nil, Enum.PartType.Ball)
				part(model, "FanBody", Vector3.new(2.1, 1.7, 1.6), arenaPose(x, y - 1.6, z), color:Lerp(COLORS.ink, 0.25))
			end
			table.insert(rows, { model = model, base = bench.CFrame, phase = row * 1.3 + sideIndex * 0.7 })
		end
		part(scenery, "StandBack", Vector3.new(62, 15, 2), arenaPose(side * 41, MIN_Y + 2.5, -25), COLORS.deck)
		part(scenery, "StandBanner", Vector3.new(62, 1.6, 0.6), arenaPose(side * 41, MIN_Y + 10.4, -24), accent, Enum.Material.Neon)
	end
	return rows
end

local function makeArena(parent)
	local scenery = Instance.new("Folder")
	scenery.Name = "Stadium"
	scenery.Parent = parent
	local clouds = makeSky(scenery)
	local crowd = makeStands(scenery)
	-- A floating flight deck with tall light pylons marks the shared combat
	-- plane. The side rails are the real bounce walls; nothing here collides.
	for _, side in ipairs({ -1, 1 }) do
		for _, y in ipairs({ MIN_Y - 4, MAX_Y + 4 }) do
			part(scenery, "CornerBrace", Vector3.new(11, 2.4, 3), arenaPose(side * 74, y, -6), COLORS.steel)
			local lamp = part(scenery, "StadiumLamp", Vector3.new(6.5, 0.9, 0.9), arenaPose(side * 74, y, -3.8),
				side &lt; 0 and COLORS.coral or COLORS.cyan, Enum.Material.Neon)
			local light = Instance.new("PointLight")
			light.Color, light.Brightness, light.Range = lamp.Color, 0.45, 38
			light.Shadows = false
			light.Parent = lamp
		end
	end
	part(scenery, "Floor", Vector3.new(170, 5, 30), arenaPose(0, MIN_Y - 5, -6), COLORS.deck)
	part(scenery, "FloorKeel", Vector3.new(120, 9, 18), arenaPose(0, MIN_Y - 11, -8), COLORS.ink)
	local floorLip = part(scenery, "FloorLip", Vector3.new(160, 0.7, 1.2), arenaPose(0, MIN_Y - 2.1, 9), COLORS.cream)
	for index = -3, 3 do
		part(scenery, "FloorInset", Vector3.new(13, 0.2, 1), arenaPose(index * 21, MIN_Y - 2.25, 4),
			index &lt; 0 and COLORS.coral or (index &gt; 0 and COLORS.cyan or COLORS.yellow), Enum.Material.Neon)
	end
	for index = -7, 7 do
		part(scenery, "DeckStripe", Vector3.new(5, 0.12, 9), arenaPose(index * 11, MIN_Y - 2.45, -4), COLORS.cream).Transparency = 0.55
	end
	local edges = {}
	for index, x in ipairs({ MIN_X, MAX_X }) do
		part(scenery, "Pylon" .. index, Vector3.new(2.6, 104, 5), arenaPose(x + (index == 1 and -3.4 or 3.4), CENTER_Y, -4), COLORS.deck)
		part(scenery, "PylonCap" .. index, Vector3.new(5, 3, 6), arenaPose(x + (index == 1 and -3.4 or 3.4), MAX_Y + 8, -4), COLORS.cream)
		edges[index] = part(scenery, "SideBoundary" .. index, Vector3.new(0.9, 88, 0.6), arenaPose(x, CENTER_Y, -2), PLAYER_COLORS[index], Enum.Material.Neon)
		edges[index].Transparency = 0.2
		for y = MIN_Y, MAX_Y, 22 do
			part(scenery, "BoundaryTick", Vector3.new(2.2, 0.4, 0.5), arenaPose(x + (index == 1 and -1.8 or 1.8), y, -2), COLORS.cream)
		end
	end
	edges[3] = part(scenery, "CeilingBoundary", Vector3.new(144, 0.5, 0.5), arenaPose(0, MAX_Y, -2), COLORS.cream, Enum.Material.Neon)
	edges[4] = part(scenery, "FloorBoundary", Vector3.new(144, 0.5, 0.5), arenaPose(0, MIN_Y, -2), COLORS.cream, Enum.Material.Neon)
	local wind = {}
	for index = 1, 4 do
		wind[index] = part(scenery, "WindPressure" .. index, Vector3.one, arenaPose(0, CENTER_Y, -5), COLORS.storm, Enum.Material.Neon)
		wind[index].Transparency = 1
	end
	return edges, wind, floorLip, clouds, crowd
end

local function makeRocket(parent)
	local model = Instance.new("Model")
	model.Name = "BattleRocket"
	model.Parent = parent
	local body = part(model, "Body", Vector3.new(5, 1.65, 1.65), CFrame.identity, COLORS.cream, nil, Enum.PartType.Cylinder)
	model.PrimaryPart = body
	local nose = part(model, "Warhead", Vector3.new(2, 2, 2), CFrame.new(2.4, 0, 0), COLORS.coral, nil, Enum.PartType.Ball)
	local fin = part(model, "Fins", Vector3.new(1.6, 3.2, 0.3), CFrame.new(-1.65, 0, 0), COLORS.coral)
	local crossFin = part(model, "CrossFins", Vector3.new(1.6, 0.3, 3.2), CFrame.new(-1.65, 0, 0), COLORS.coral)
	local exhaust = ellipsoid(model, "Exhaust", Vector3.new(3.5, 1.1, 1.1), CFrame.new(-4, 0, 0), COLORS.fire, Enum.Material.Neon)
	local core = ellipsoid(model, "ExhaustCore", Vector3.new(2.6, 0.55, 0.55), CFrame.new(-3.5, 0, 0), COLORS.cream, Enum.Material.Neon)
	local stripes = {}
	local pieces = { body, nose, fin, crossFin, exhaust, core }
	for _, x in ipairs({ -0.8, 0.65 }) do
		local stripe = part(model, "CandyStripe", Vector3.new(0.45, 1.72, 1.72), CFrame.new(x, 0, 0), COLORS.coral, nil, Enum.PartType.Cylinder)
		table.insert(stripes, stripe)
		table.insert(pieces, stripe)
	end
	local sparks = {}
	for index = 1, 3 do
		sparks[index] = part(model, "RocketSpark", Vector3.one * 0.35, CFrame.identity, COLORS.yellow, Enum.Material.Neon)
		table.insert(pieces, sparks[index])
	end
	local a = Instance.new("Attachment")
	a.Position = Vector3.new(-2.5, -0.6, 0)
	a.Parent = body
	local b = Instance.new("Attachment")
	b.Position = Vector3.new(-2.5, 0.6, 0)
	b.Parent = body
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a, b
	trail.Color = ColorSequence.new(COLORS.yellow, COLORS.cream)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Lifetime = 0.7
	trail.LightEmission = 0.9
	trail.MinLength = 0.15
	trail.Parent = body
	local fizz = emitter(a, "RocketFizz", SPARK_TEXTURE, {
		Lifetime = NumberRange.new(0.35, 0.7), Speed = NumberRange.new(2, 9), Size = fade(1.5, 0),
		LightEmission = 1, Color = ColorSequence.new(COLORS.yellow, COLORS.fire), ZOffset = 1,
	})
	return { fizz = fizz, model = model, nose = nose, fin = fin, crossFin = crossFin, trail = trail, pieces = pieces,
		stripes = stripes, sparks = sparks, exhaust = exhaust, core = core }
end

-- options.pilots seats avatars in the cockpits (PilotAvatar module).
function BattleView.new(World, onPresentationCue, options)
	local self = setmetatable({
		World = World, fighters = {}, rockets = {}, rocketPool = {}, effects = {}, wakes = {}, wakePool = {},
		effectCursor = 0, roundId = nil, lastEvent = 0, clock = 0, realClock = 0,
		sampleElapsed = nil, sampleAge = 0, destroyed = false,
		shake = 0, punch = 0, freeze = 0, screenFlash = 0, hype = 0, bursts = {}, burstCursor = 0,
		onPresentationCue = type(onPresentationCue) == "function" and onPresentationCue or nil,
		pilots = type(options) == "table" and options.pilots or nil,
	}, BattleView)
	pcall(function() self.reducedMotion = GuiService.ReducedMotionEnabled end)
	self.folder = Instance.new("Folder")
	self.folder.Name = "SkyboundBattleView"
	self.folder.Parent = Workspace
	self.edges, self.wind, self.floorLip, self.clouds, self.crowd = makeArena(self.folder)
	-- Glow and grade belong to this view and leave with it.
	self.bloom = Instance.new("BloomEffect")
	self.bloom.Name = "SkyboundBattleBloom"
	self.bloom.Intensity, self.bloom.Size, self.bloom.Threshold = 0.55, 24, 1.1
	self.bloom.Parent = Lighting
	self.grade = Instance.new("ColorCorrectionEffect")
	self.grade.Name = "SkyboundBattleGrade"
	self.grade.Saturation, self.grade.Contrast = 0.14, 0.06
	self.grade.Parent = Lighting
	self.fxAnchor = part(self.folder, "ParticleAnchor", Vector3.one, CFrame.new(ORIGIN), COLORS.cream)
	self.fxAnchor.Transparency = 1
	self.groundY = self.floorLip.Position.Y + self.floorLip.Size.Y / 2
	self.folder:SetAttribute("GroundY", self.groundY)
	self.dynamic = Instance.new("Folder")
	self.dynamic.Name = "Combat"
	self.dynamic.Parent = self.folder
	return self
end

function BattleView:_resetRound(roundId)
	self.roundId, self.lastEvent, self.sampleElapsed, self.sampleAge = roundId, 0, nil, 0
	self.finishTime, self.finishReal = nil, nil
	self.shake, self.punch, self.freeze, self.screenFlash = 0, 0, 0, 0
	for _, fighter in pairs(self.fighters) do
		fighter.damageSmoke.Rate, fighter.damageFire.Rate = 0, 0
		fighter.damageSmoke:Clear()
		fighter.damageFire:Clear()
		fighter.position, fighter.pose, fighter.armor = nil, nil, nil
		fighter.hitTime, fighter.blockTime, fighter.lastHitBurst = -100, -100, -100
		fighter.shotTime = -100
		fighter.finishRotation, fighter.finishPosition = nil, nil
		fighter.crash, fighter.crashLanded, fighter.crashContactY = nil, false, nil
		fighter.crashGroundY = nil
		fighter.previousPhase, fighter.observedWindupDuration = nil, nil
		fighter.model:SetAttribute("CrashState", nil)
		fighter.model:SetAttribute("CrashContactY", nil)
		fighter.scuff.Transparency = 1
		hide(fighter.debris)
		hide(fighter.reticle)
		hide(fighter.aimDots)
		hide(fighter.statusRing)
		hide(fighter.speedLines)
		hide(fighter.cometFlames)
		hide(fighter.signatureSparks)
		hide(fighter.muzzleFlashes)
		fighter.chargeShell.Transparency = 1
		fighter.noseLight.Brightness = 0
		fighter.trail.Enabled = false
		fighter.trail:Clear()
	end
	for id, wake in pairs(self.wakes) do
		hideWake(wake)
		table.insert(self.wakePool, wake)
		self.wakes[id] = nil
	end
	for id, rocket in pairs(self.rockets) do
		rocket.trail.Enabled = false
		rocket.trail:Clear()
		rocket.fizz.Rate = 0
		for _, piece in ipairs(rocket.pieces) do piece.Transparency = 1 end
		table.insert(self.rocketPool, rocket)
		self.rockets[id] = nil
	end
	for _, burst in ipairs(self.bursts) do
		burst.spark:Clear()
		burst.smoke:Clear()
		burst.fire:Clear()
	end
	for _, effect in ipairs(self.effects) do
		effect.active = false
		hide(effect.pieces)
		hide(effect.ring)
		effect.flash.Transparency = 1
	end
end

-- Fighter one is the local pilot's own hangar plane: paint and trail carry
-- over. The rival gets a paint that cannot be confused with it.
function BattleView:_look(index)
	local player = Players.LocalPlayer
	local own = { colorIndex = 1, planeId = "cruiser", trailId = nil }
	if player then
		own.colorIndex = math.clamp(math.floor(numeric(player:GetAttribute("SkyboundColor"), 1)), 1, #PLANE_COLORS)
		own.planeId = player:GetAttribute("SkyboundPlane") or "cruiser"
		own.trailId = player:GetAttribute("SkyboundTrail")
		own.userId = player.UserId
	end
	local look = own
	if index ~= 1 then
		look = { colorIndex = own.colorIndex == 2 and 1 or 2, planeId = own.planeId == "dart" and "cruiser" or "dart" }
	end
	look.color = PLANE_COLORS[look.colorIndex]
	look.trailColor, look.trailLife, look.trailEmission, look.trailWidth =
		ColorSequence.new(look.color, COLORS.cream), 0.55, 0.6, 1
	if index == 1 and self.World.trailLook then
		local ok, first, second, entry = pcall(self.World.trailLook, look.trailId)
		if ok and entry then
			look.trailColor = ColorSequence.new(first, second)
			look.trailLife = 0.4 + numeric(entry.lifetime, 0.6) * 0.5
			look.trailEmission = numeric(entry.emission, 0.6)
			look.trailWidth = numeric(entry.width, 1)
		end
	end
	return look
end

-- Both pilots' paints, for a HUD that matches the planes.
function BattleView:accent(index)
	local fighter
	for _, candidate in pairs(self.fighters) do
		if candidate.index == index then fighter = candidate end
	end
	return fighter and fighter.color or self:_look(index).color
end

function BattleView:_fighter(id, index)
	local fighter = self.fighters[id]
	if fighter then return fighter end
	local look = self:_look(index)
	local color = look.color
	local model = self.World.createPlane(self.dynamic, "BattlePlane" .. tostring(id), look.colorIndex, look.planeId, look.trailId)
	model:ScaleTo(SCALE)
	local pivot = model.PrimaryPart
	local trail = pivot:FindFirstChild("Contrail")
	-- The shared racing trail spans the wing axis, which is edge-on here. Give
	-- it vertical separation for a readable ribbon in the side camera.
	trail.Attachment0.Position = Vector3.new(-4.1, -0.75 * look.trailWidth, 0) * SCALE
	trail.Attachment1.Position = Vector3.new(-4.1, 0.75 * look.trailWidth, 0) * SCALE
	trail.Color = look.trailColor
	trail.Transparency = NumberSequence.new(0.12, 1)
	trail.Lifetime = look.trailLife
	trail.LightEmission = look.trailEmission
	trail.WidthScale = NumberSequence.new(1, 0)
	if self.pilots then
		pcall(self.pilots.attach, model, look.userId, look.userId == nil)
	end
	local noseGlow = part(model, "ArmedNose", Vector3.one * 2.7, CFrame.new(5.6 * SCALE, 0, 0), color, Enum.Material.Neon, Enum.PartType.Ball)
	noseGlow.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Name = "AttackTell"
	gui.Adornee = pivot
	gui.Size = UDim2.fromOffset(260, 44)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 10, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 10000
	gui.Enabled = false
	gui.Parent = pivot
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 26
	label.TextColor3 = COLORS.cream
	label.TextTransparency = 0
	label.Rotation = index == 1 and -5 or 5
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness, stroke.Color = 3.5, COLORS.ink
	stroke.Parent = label
	local pop = Instance.new("UIScale")
	pop.Parent = label
	-- Always on: a dark ink outline makes any paint read against the sky. A hit
	-- fills it white for an instant; the winner's outline turns gold.
	local highlight = Instance.new("Highlight")
	highlight.Name = "CombatFeedback"
	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillTransparency, highlight.OutlineColor, highlight.OutlineTransparency = 1, COLORS.ink, 0
	highlight.Parent = model
	-- Keep the FX outside the aircraft model so the full-model hit highlight
	-- cannot accidentally outline distant aim markers or a victory halo.
	local fx = Instance.new("Folder")
	fx.Name = "FighterEffects" .. tostring(id)
	fx.Parent = self.dynamic
	local chargeShell = ellipsoid(fx, "MeteorChargeShell", Vector3.one, CFrame.identity, COLORS.fire, Enum.Material.Neon)
	chargeShell.Transparency = 1
	local cometFlames = {}
	for index = 1, 3 do
		cometFlames[index] = ellipsoid(fx, "CometFlame" .. index, Vector3.one, CFrame.identity,
			index == 1 and COLORS.fire or (index == 2 and COLORS.yellow or COLORS.cream), Enum.Material.Neon)
		cometFlames[index].Transparency = 1
	end
	local muzzleFlashes = {}
	for index = 1, 2 do
		muzzleFlashes[index] = ellipsoid(fx, "LauncherFlash" .. index, Vector3.one, CFrame.identity, COLORS.yellow, Enum.Material.Neon)
		muzzleFlashes[index].Transparency = 1
	end
	local lampAnchor = part(fx, "PowerLamp", Vector3.one, CFrame.identity, color)
	lampAnchor.Transparency = 1
	local noseLight = Instance.new("PointLight")
	noseLight.Color, noseLight.Range, noseLight.Brightness = COLORS.fire, 16, 0
	noseLight.Shadows = false
	noseLight.Parent = lampAnchor
	local smokeAnchor = part(fx, "DamageAnchor", Vector3.one, CFrame.identity, color)
	smokeAnchor.Transparency = 1
	local smokeAt = Instance.new("Attachment")
	smokeAt.Parent = smokeAnchor
	local damageSmoke = emitter(smokeAt, "DamageSmoke", SMOKE_TEXTURE, {
		Lifetime = NumberRange.new(0.7, 1.3), Speed = NumberRange.new(2, 6), Size = fade(2.4, 7),
		Transparency = fade(0.35, 1), Color = ColorSequence.new(Color3.fromRGB(58, 60, 74), Color3.fromRGB(120, 122, 136)),
		Acceleration = Vector3.new(0, 9, 0), RotSpeed = NumberRange.new(-70, 70), Rotation = NumberRange.new(0, 360),
		SpreadAngle = Vector2.new(25, 25), Enabled = true,
	})
	local damageFire = emitter(smokeAt, "DamageFire", FIRE_TEXTURE, {
		Lifetime = NumberRange.new(0.25, 0.5), Speed = NumberRange.new(3, 8), Size = fade(3.4, 0.4),
		Transparency = fade(0.1, 1), Color = ColorSequence.new(COLORS.yellow, COLORS.fire), LightEmission = 1,
		Acceleration = Vector3.new(0, 6, 0), SpreadAngle = Vector2.new(30, 30), ZOffset = 0.5, Enabled = true,
	})
	local scuff = ellipsoid(fx, "CrashScuff", Vector3.new(12, 0.6, 0.25), CFrame.identity, COLORS.dark)
	scuff.Transparency = 1
	local debris = makeRing(fx, "CrashDebris", 5, color)
	for index, fragment in ipairs(debris) do
		fragment.Material = Enum.Material.SmoothPlastic
		fragment.Color = index % 2 == 0 and COLORS.steel or color
	end
	fighter = {
		model = model, color = color, body = model:FindFirstChild("Fuselage"),
		propeller = model:FindFirstChild("Propeller"), trail = trail,
		flare = model:FindFirstChild("FlightFlare"), noseGlow = noseGlow,
		smoke = { model:FindFirstChild("HitSmoke1"), model:FindFirstChild("HitSmoke2"), model:FindFirstChild("HitSmoke3") },
		gui = gui, label = label, pop = pop, stroke = stroke, look = look,
		smokeAnchor = smokeAnchor, damageSmoke = damageSmoke, damageFire = damageFire,
		hitTime = -100, blockTime = -100, lastHitBurst = -100, tellTime = -100,
		facing = index == 1 and 1 or -1, highlight = highlight, fx = fx,
		reticle = makeRing(fx, "AttackLock", 8, color),
		aimDots = makeRing(fx, "AimDash", 3, color),
		statusRing = makeRing(fx, "BumperOrVictory", 12, COLORS.yellow),
		speedLines = makeRing(fx, "AfterburnerStreak", 2, COLORS.boost),
		chargeShell = chargeShell, cometFlames = cometFlames, muzzleFlashes = muzzleFlashes,
		signatureSparks = makeRing(fx, "SignatureSpark", 8, COLORS.yellow),
		lampAnchor = lampAnchor, noseLight = noseLight, shotTime = -100,
		scuff = scuff, debris = debris, crashLanded = false, index = index,
	}
	-- Smoke is positioned in world space and must never enlarge aircraft
	-- bounds or the damage highlight while a disabled plane falls.
	for _, puff in ipairs(fighter.smoke) do puff.Parent = fx end
	self.fighters[id] = fighter
	return fighter
end

function BattleView:_crashPose(fighter, state, target)
	local crash = fighter.crash
	if not crash then
		fighter.finishPosition, fighter.finishRotation = target, fighter.pose.Rotation
		fighter.stoppedPropeller = math.pi / 4
		-- Freeze the propeller before sampling the solid geometry. Visual
		-- flames, hidden race wings, and smoke never determine floor contact.
		local modelPose = fighter.model:GetPivot()
		fighter.propeller:PivotTo(modelPose * CFrame.new(5.1 * SCALE, 0, 0) * CFrame.Angles(fighter.stoppedPropeller, 0, 0))
		local geometry = {}
		for _, object in ipairs(fighter.model:GetDescendants()) do
			if object:IsA("BasePart") and object.Transparency &lt; 0.95
				and object.Name ~= "FlightFlare" and object.Name ~= "ArmedNose" then
				table.insert(geometry, { pose = modelPose:ToObjectSpace(object.CFrame), half = object.Size / 2 })
			end
		end
		local clearance = math.max(0, target.Y + solidBottom(geometry, fighter.finishRotation) - self.groundY)
		local roomToFall = math.clamp(clearance / 16, 0, 1)
		local drift = (math.clamp(numeric(state.vx, 0) * 0.1, -6, 6) + (state.id == 1 and -3 or 3)) * roomToFall
		crash = {
			startedAt = self.clock,
			duration = clearance &lt;= 0.01 and 0 or ((0.32 + roomToFall * 0.63) + math.clamp((clearance - 16) / 54, 0, 1) * 0.4),
			geometry = geometry, clearance = clearance, smoke = {},
			landX = math.clamp(target.X + drift, ORIGIN.X + MIN_X + 13, ORIGIN.X + MAX_X - 13),
			restRotation = CFrame.Angles(0, fighter.facing &lt; 0 and math.pi or 0, 0) * CFrame.Angles(0.06, 0, -0.04),
		}
		fighter.crash, fighter.crashLanded, fighter.crashGroundY = crash, false, self.groundY
		fighter.model:SetAttribute("CrashState", "Falling")
	end
	local progress = crash.duration == 0 and 1 or math.clamp((self.clock - crash.startedAt) / crash.duration, 0, 1)
	-- Touching is landing: a frame that ends a hair above the floor must not
	-- look like contact while the thud and dust wait for the next one.
	if crash.clearance * (1 - progress * progress) &lt; 0.004 then progress = 1 end
	local settle = math.clamp((progress - 0.64) / 0.36, 0, 1)
	settle = settle * settle * (3 - 2 * settle)
	local rotation
	if crash.clearance &lt; 16 then
		-- There is no room for a somersault immediately above the floor.
		-- A brief belly-down settle reaches first contact with the thud.
		rotation = fighter.finishRotation:Lerp(crash.restRotation, progress * progress * (3 - 2 * progress))
	else
		local spin = math.clamp((progress - 0.18) / 0.68, 0, 1)
		rotation = (fighter.finishRotation * CFrame.Angles(0, 0, -math.pi * 2 * spin)):Lerp(crash.restRotation, settle)
	end
	local lower = solidBottom(crash.geometry, rotation)
	-- Descend the lowest solid point, not the pivot. Clamping a tumbling
	-- pivot to the floor can cause early contact followed by a ground spin.
	local clearance = crash.clearance * (1 - progress * progress)
	local position = Vector3.new(fighter.finishPosition.X + (crash.landX - fighter.finishPosition.X) * (1 - (1 - progress) ^ 2),
		self.groundY - lower + clearance, ORIGIN.Z)
	fighter.position = position
	fighter.crashContactY = position.Y + lower
	fighter.model:SetAttribute("CrashContactY", fighter.crashContactY)
	if progress &gt;= 1 then
		if not fighter.crashLanded then
			fighter.crashLanded, crash.landedAt = true, self.clock
			fighter.model:SetAttribute("CrashState", "Landed")
			self:_burst(position.X - ORIGIN.X, self.groundY - ORIGIN.Y + 0.12, COLORS.yellow, true, "crash")
			self:_particles(position.X - ORIGIN.X, self.groundY - ORIGIN.Y + 1.5, COLORS.fire, 50, 22, 18, 60)
			self:_jolt(4, 0.6, 0.06, 0.4, 1)
			fighter.scuff.CFrame = CFrame.new(position.X, self.groundY + 0.05, ORIGIN.Z + 9.8)
			fighter.scuff.Transparency = 0.2
			if self.onPresentationCue then
				local ok, err = pcall(self.onPresentationCue, { kind = "crash", roundId = self.roundId, actor = state.id })
				if not ok then warn("BattleView presentation cue failed: " .. tostring(err)) end
			end
		end
		local scatter = math.clamp((self.clock - crash.landedAt) / 0.45, 0, 1)
		for index, fragment in ipairs(fighter.debris) do
			local side = index % 2 == 0 and -1 or 1
			local angle = index * 0.7 + scatter * side * 2
			fragment.Size = Vector3.new(0.7 + index * 0.13, 0.4, 0.5)
			local extent = math.abs(math.sin(angle)) * fragment.Size.X / 2 + math.abs(math.cos(angle)) * fragment.Size.Y / 2
			fragment.CFrame = CFrame.new(position.X + side * (2 + index * 1.6) * scatter,
				self.groundY + extent + math.sin(scatter * math.pi) * (1.5 + index * 0.3), ORIGIN.Z + 9.8)
				* CFrame.Angles(0, 0, angle)
			fragment.Transparency = 0
		end
	end
	return CFrame.new(position) * rotation
end

function BattleView:_setSignature(fighter, powerId)
	if fighter.powerId == powerId then return end
	if fighter.signature then fighter.signature:Destroy() end
	fighter.powerId = powerId
	fighter.signature = Instance.new("Folder")
	fighter.signature.Name = "Signature"
	fighter.signature.Parent = fighter.model
	local pose = fighter.model:GetPivot()
	fighter.chargePieces, fighter.muzzleOffsets = {}, {}
	-- The power reshapes the airframe, whichever hangar plane it started as.
	local stock = { MainWing = true, LeftWingTip = true, RightWingTip = true, TailWing = true, TailFin = true,
		UpperWing = true, WingStrut = true, UpperWingTip = true, SweptWing = true, RacerWingTip = true, RacingStripe = true }
	for _, original in ipairs(fighter.model:GetChildren()) do
		if stock[original.Name] and original:IsA("BasePart") then original.Transparency = 1 end
	end
	local function piece(name, size, offset, color, material, shape, rotation)
		return part(fighter.signature, name, size * SCALE, pose * CFrame.new(offset * SCALE) * (rotation or CFrame.identity), color, material, shape)
	end
	if powerId == "Firework" then
		fighter.body.Size = Vector3.new(9.7, 2.35, 2.6) * SCALE
		piece("ForkedTail", Vector3.new(1.8, 0.25, 6.8), Vector3.new(-3.9, 0.2, 0), COLORS.cream)
		for _, side in ipairs({ -1, 1 }) do
			piece("SweptLaunchWing", Vector3.new(2.6, 0.32, 6.5), Vector3.new(-1.4, -0.45, side * 2.9), fighter.color,
				nil, nil, CFrame.Angles(0, -side * 0.58, 0))
			piece("TwinTailFin", Vector3.new(1.7, 1.7, 0.3), Vector3.new(-3.8, 1.05, side * 1.55), fighter.color,
				nil, nil, CFrame.Angles(0, 0, -0.35))
			piece("RocketPod", Vector3.new(4.1, 1.8, 1.8), Vector3.new(0.8, -0.65, side * 3.75), COLORS.cream, nil, Enum.PartType.Cylinder)
			for _, stripeX in ipairs({ -0.45, 1.0 }) do
				piece("LauncherStripe", Vector3.new(0.5, 1.85, 1.85), Vector3.new(stripeX, -0.65, side * 3.75), fighter.color, nil, Enum.PartType.Cylinder)
			end
			piece("LauncherRim", Vector3.new(0.38, 2.15, 2.15), Vector3.new(2.9, -0.65, side * 3.75), COLORS.steel, nil, Enum.PartType.Cylinder)
			local mouth = piece("IgnitionChamber", Vector3.new(0.12, 1.6, 1.6), Vector3.new(3.11, -0.65, side * 3.75), COLORS.fire, Enum.Material.Neon, Enum.PartType.Cylinder)
			table.insert(fighter.chargePieces, mouth)
			table.insert(fighter.muzzleOffsets, Vector3.new(3.25, -0.65, side * 3.75) * SCALE)
		end
	else
		fighter.body.Size = Vector3.new(8.9, 3.6, 3.8) * SCALE
		piece("HeavyMainWing", Vector3.new(4.3, 0.65, 13.4), Vector3.new(-0.7, -0.15, 0), fighter.color)
		piece("WingArmor", Vector3.new(2.4, 0.18, 10.6), Vector3.new(-0.8, 0.28, 0), COLORS.steel)
		piece("HeavyTailWing", Vector3.new(2.2, 0.42, 6.0), Vector3.new(-3.5, 0.35, 0), COLORS.cream)
		piece("HeavyTailFin", Vector3.new(2.5, 2.8, 0.55), Vector3.new(-3.3, 1.6, 0), fighter.color, nil, nil, CFrame.Angles(0, 0, -0.23))
		piece("ImpactCollar", Vector3.new(1.15, 3.9, 3.9), Vector3.new(3.65, 0, 0), COLORS.yellow, nil, Enum.PartType.Cylinder)
		piece("NoseArmorBand", Vector3.new(0.35, 4.05, 4.05), Vector3.new(3.25, 0, 0), COLORS.steel, nil, Enum.PartType.Cylinder)
		for _, side in ipairs({ -1, 1 }) do
			piece("ArmoredWingTip", Vector3.new(3.9, 0.85, 1.2), Vector3.new(-0.7, -0.05, side * 6.3), COLORS.cream)
			local vent = piece("ChargeVent", Vector3.new(2.0, 0.22, 0.32), Vector3.new(0.3, 1.0, side * 1.65), COLORS.yellow, Enum.Material.Neon)
			table.insert(fighter.chargePieces, vent)
		end
	end
	-- Signature geometry is cosmetic. Collision and damage remain in the sim.
	fighter.model:SetAttribute("PowerId", powerId)
end

-- One pooled attachment with spark, smoke and fire emitters per impact.
function BattleView:_particles(x, y, color, sparks, smoke, fire, speed)
	self.burstCursor = self.burstCursor % BURST_LIMIT + 1
	local burst = self.bursts[self.burstCursor]
	if not burst then
		local at = Instance.new("Attachment")
		at.Parent = self.fxAnchor
		burst = { at = at,
			spark = emitter(at, "ImpactSparks", SPARK_TEXTURE, {
				Lifetime = NumberRange.new(0.35, 0.8), Size = fade(2.6, 0), LightEmission = 1, Drag = 3,
				Acceleration = Vector3.new(0, -26, 0), ZOffset = 3,
			}),
			smoke = emitter(at, "ImpactSmoke", SMOKE_TEXTURE, {
				Lifetime = NumberRange.new(0.6, 1.2), Size = fade(3, 9), Transparency = fade(0.3, 1), Drag = 4,
				Color = ColorSequence.new(Color3.fromRGB(70, 72, 88), Color3.fromRGB(150, 152, 166)),
				Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-90, 90), ZOffset = 1,
			}),
			fire = emitter(at, "ImpactFire", FIRE_TEXTURE, {
				Lifetime = NumberRange.new(0.2, 0.45), Size = fade(5, 0.5), Transparency = fade(0, 1), LightEmission = 1,
				Drag = 5, Color = ColorSequence.new(COLORS.cream, COLORS.fire), ZOffset = 2,
			}),
		}
		self.bursts[self.burstCursor] = burst
	end
	burst.at.WorldPosition = ORIGIN + Vector3.new(x, y, 3)
	burst.spark.Color = ColorSequence.new(COLORS.cream, color)
	burst.spark.Speed = NumberRange.new(speed * 0.4, speed)
	burst.smoke.Speed = NumberRange.new(speed * 0.1, speed * 0.35)
	burst.fire.Speed = NumberRange.new(speed * 0.1, speed * 0.4)
	if sparks &gt; 0 then burst.spark:Emit(sparks) end
	if smoke &gt; 0 then burst.smoke:Emit(smoke) end
	if fire &gt; 0 then burst.fire:Emit(fire) end
end

-- Camera kick, freeze-frame and screen flash. Presentation only: the
-- simulation keeps running and the view catches up after the freeze.
function BattleView:_jolt(shake, punch, freeze, flash, hype)
	if self.reducedMotion then shake, punch, freeze = 0, 0, 0 end
	self.shake = math.max(self.shake, shake)
	self.punch = math.max(self.punch, punch)
	self.freeze = math.max(self.freeze, freeze)
	self.screenFlash = math.max(self.screenFlash, flash)
	self.hype = math.min(1, self.hype + hype)
end

function BattleView:_burst(x, y, color, strong, style, heading)
	self.effectCursor = self.effectCursor % EFFECT_LIMIT + 1
	local effect = self.effects[self.effectCursor]
	if not effect then
		effect = { pieces = {}, ring = makeRing(self.dynamic, "HitRing", 12, color) }
		effect.flash = ellipsoid(self.dynamic, "ImpactFlash", Vector3.one, CFrame.identity, COLORS.cream, Enum.Material.Neon)
		effect.flash.Transparency = 1
		for index = 1, 10 do
			effect.pieces[index] = part(self.dynamic, "ImpactRay", Vector3.one, CFrame.identity, color, Enum.Material.Neon)
		end
		self.effects[self.effectCursor] = effect
	end
	effect.active, effect.age, effect.x, effect.y, effect.strong = true, 0, x, y, strong
	effect.color = color
	effect.style, effect.heading = style, heading or 0
	for _, piece in ipairs(effect.pieces) do piece.Color = color end
	hide(effect.ring)
	effect.flash.Transparency = 1
end

function BattleView:_hit(fighter, x, y, source, actorColor)
	if fighter then
		fighter.hitTime = self.clock
		-- An armor delta and its event can arrive in the same snapshot. The
		-- authoritative impact protection makes distinct hits farther apart.
		if self.clock - fighter.lastHitBurst &lt; 0.12 then return end
		fighter.lastHitBurst = self.clock
	end
	local color = source == "meteor" and COLORS.yellow or (source == "rocket" and actorColor and actorColor:Lerp(COLORS.cream, 0.55) or COLORS.cream)
	self:_burst(x, y, color, true, source)
	x, y = numeric(x, 0), numeric(y, CENTER_Y)
	if source == "meteor" then
		self:_particles(x, y, COLORS.fire, 46, 12, 16, 70)
		self:_jolt(3.4, 1, 0.1, 0.55, 0.7)
	elseif source == "rocket" then
		-- A firework is supposed to burst: a big ball of the shooter's colour.
		self:_particles(x, y, actorColor or COLORS.yellow, 70, 8, 8, 95)
		self:_particles(x, y, COLORS.yellow, 30, 0, 0, 55)
		self:_jolt(2.6, 0.85, 0.08, 0.45, 0.7)
	else
		self:_particles(x, y, color, 34, 8, 8, 60)
		self:_jolt(2.2, 0.7, 0.07, 0.35, 0.5)
	end
end

function BattleView:_events(simulation)
	local newest = self.lastEvent
	for _, event in ipairs(simulation.events or {}) do
		local serial = numeric(event.serial, 0)
		if serial &gt; self.lastEvent then
			newest = math.max(newest, serial)
			local kind = string.lower(tostring(event.kind or ""))
			local target = self.fighters[event.target]
			local actor = self.fighters[event.actor]
			local x = numeric(event.x, target and target.position and target.position.X - ORIGIN.X or 0)
			local y = numeric(event.y, target and target.position and target.position.Y - ORIGIN.Y or CENTER_Y)
			local age = numeric(simulation.elapsed, 0) - numeric(event.at, numeric(simulation.elapsed, 0))
			if age &lt;= 0.45 then
				if kind == "hit" or kind == "wake_hit" or kind == "damage" or kind == "meteorhit" or kind == "rockethit" then
					self:_hit(target, x, y, event.source, actor and actor.color)
				elseif kind == "finish" then
					if simulation.reason == "knockout" then
						self:_particles(x, y, COLORS.yellow, 60, 16, 20, 90)
						self:_jolt(4.6, 1, 0.16, 0.9, 1)
					else
						self:_jolt(1.2, 0.4, 0, 0.3, 0.6)
					end
				elseif kind == "dive" and age &lt;= 0.18 then
					self:_jolt(0.9, 0.25, 0, 0, 0.15)
					-- A complete commitment can hit and recover between snapshots.
					-- Record only a short streak at its real launch point; never keep
					-- the plane looking armed after the simulation has recovered.
					self:_burst(x, y, COLORS.yellow, false, "dive", numeric(event.heading, 0))
				elseif kind == "rocket" then
					if actor then actor.shotTime = self.clock - math.max(0, age) end
					self:_particles(x, y, COLORS.yellow, 14, 5, 6, 35)
					self:_jolt(0.7, 0.15, 0, 0, 0.1)
				elseif kind == "miss" and actor and actor.powerId == "Firework" then
					self:_burst(x, y, COLORS.steel, false, "fizzle")
					self:_particles(x, y, actor.color, 26, 6, 0, 45)
				elseif kind == "blocked" then
					if actor then actor.blockTime = self.clock end
					self:_burst(x, y, COLORS.yellow, false)
					self:_particles(x, y, COLORS.yellow, 30, 0, 0, 65)
					self:_jolt(1.6, 0.5, 0.05, 0.15, 0.4)
				elseif kind == "bounce" or kind == "wall" or kind == "bump" then
					self:_burst(x, y, COLORS.steel, false)
					self:_particles(x, y, COLORS.cream, 12, 3, 0, 40)
					self:_jolt(1, 0.3, 0, 0, 0.15)
				end
			end
		end
	end
	self.lastEvent = newest
end

function BattleView:_signatureEffects(fighter, state, simulation, moving, pose)
	local meteor = fighter.powerId == "Meteor"
	local windup = moving and state.phase == "Windup"
	local armed = moving and state.armed == true
	local charge = windup and chargeProgress(fighter, state, self.sampleAge) or 0
	local shotAge = self.clock - fighter.shotTime
	local shooting = moving and not meteor and shotAge &lt; 0.2
	local winner = simulation.finished == true and simulation.winner == state.id
	local finishAge = self.finishTime and self.clock - self.finishTime or 100
	local pulse = 1 + math.sin(self.clock * 34) * 0.08
	fighter.lampAnchor.CFrame = pose * CFrame.new(6, 0, 0)
	fighter.noseLight.Color = meteor and COLORS.fire or fighter.color
	fighter.noseLight.Brightness = armed and 0.85 or (shooting and 1 or charge * 0.5)
	for index, piece in ipairs(fighter.chargePieces or {}) do
		piece.Color = windup and COLORS.yellow or (armed and COLORS.cream or (meteor and COLORS.yellow or COLORS.fire))
		piece.Transparency = (windup or armed or shooting) and (0.05 + (1 - charge) * 0.15) or 0.62
		if not meteor and windup then piece.Transparency = 0.15 + (math.sin(self.clock * 24 + index * math.pi) + 1) * 0.2 end
	end
	if meteor and (windup or armed) then
		local shellCharge = armed and 1 or charge
		fighter.chargeShell.Size = Vector3.new(9 + shellCharge * 4, 3.8 + shellCharge * 3, 3.6 + shellCharge * 2.6) * SCALE
		fighter.chargeShell.CFrame = pose * CFrame.new(0.8, 0, 0)
		fighter.chargeShell.Color = armed and COLORS.yellow or COLORS.fire
		fighter.chargeShell.Transparency = armed and 0.62 or (0.95 - charge * 0.4)
	else
		fighter.chargeShell.Transparency = 1
	end
	for index, flame in ipairs(fighter.cometFlames) do
		if meteor and armed then
			local length = (21 - index * 4) * pulse
			local width = 5.8 - index * 1.4
			flame.Size = Vector3.new(length, width, width * 0.8)
			flame.CFrame = pose * CFrame.new(-7.4 - length * 0.3, 0, index * 0.2)
			flame.Transparency = 0.42 - index * 0.1
		else flame.Transparency = 1 end
	end
	for index, flash in ipairs(fighter.muzzleFlashes) do
		if shooting and fighter.muzzleOffsets[index] then
			local strength = 1 - shotAge / 0.2
			flash.Size = Vector3.new(2 + strength * 4.5, 1 + strength * 1.8, 1.2)
			flash.CFrame = pose * CFrame.new(fighter.muzzleOffsets[index] + Vector3.new(1.5, 0, 0))
			flash.Transparency = 0.12 + (1 - strength) * 0.7
		else flash.Transparency = 1 end
	end
	for index, spark in ipairs(fighter.signatureSparks) do
		if winner and finishAge &lt; 1.1 then
			local progress = math.clamp(finishAge / 1.1, 0, 1)
			local angle = index / #fighter.signatureSparks * math.pi * 2
			local offset = Vector3.new(math.cos(angle) * (6 + progress * 8), 4 + math.sin(angle) * (3 + progress * 7) - progress * progress * 6, 8)
			spark.Size = Vector3.new(0.75, 1.7, 0.25)
			spark.CFrame = CFrame.new(fighter.position + offset) * CFrame.Angles(0, 0, angle + progress * 5)
			spark.Color = index % 2 == 0 and COLORS.yellow or fighter.color
			spark.Transparency = progress * progress
		elseif meteor and (windup or armed) then
			local angle = index / #fighter.signatureSparks * math.pi * 2 + self.clock * 2
			local radius = windup and (3.5 + charge * 2.2) or 3.8
			local offset = Vector3.new(4.7 + math.cos(angle) * radius * 0.35, math.sin(angle) * radius, math.cos(angle) * radius)
			spark.Size = Vector3.new(armed and 2.2 or (0.6 + charge * 0.6), 0.3, 0.3)
			spark.CFrame = pose * CFrame.new(offset) * CFrame.Angles(0, 0, windup and angle or 0)
			spark.Color, spark.Transparency = index % 2 == 0 and COLORS.cream or COLORS.yellow, windup and 0.35 or 0.14
		else spark.Transparency = 1 end
	end
end

function BattleView:_fighterEffects(fighter, state, simulation, moving, displayPose)
	local windup = moving and state.phase == "Windup"
	local boosted = moving and numeric(state.boostLeft, 0) &gt; self.sampleAge
	local hitAge, blockAge = self.clock - fighter.hitTime, self.clock - fighter.blockTime
	local winner = simulation.finished == true and simulation.winner == state.id
	local knockedOut = simulation.finished == true and numeric(state.armor, 3) &lt;= 0
	local flashing = hitAge &lt; 0.18
	fighter.highlight.FillColor = flashing and Color3.new(1, 1, 1) or COLORS.yellow
	fighter.highlight.OutlineColor = flashing and Color3.new(1, 1, 1) or (winner and COLORS.yellow or COLORS.ink)
	fighter.highlight.FillTransparency = flashing and (0.05 + math.min(1, hitAge / 0.18) * 0.85) or (winner and 0.88 or 1)
	local center = fighter.position + Vector3.new(0, 0, 9)
	if winner then
		ring(fighter.statusRing, center, 10.5 + math.sin(self.clock * 3) * 0.3, COLORS.yellow, 0.2, self.clock * 0.2, 0.5)
	elseif not knockedOut and fighter.modifierId == "SpringBumper" then
		local ready = state.bumperReady == true
		local popping = blockAge &lt; 0.38
		local radius = popping and (8 + blockAge / 0.38 * 3) or 8
		ring(fighter.statusRing, center, radius, (ready or popping) and COLORS.yellow or COLORS.steel,
			popping and (0.15 + blockAge / 0.38 * 0.6) or (ready and 0.3 or 0.76), 0, ready and 0.5 or 0.22)
	else
		hide(fighter.statusRing)
	end
	if windup and type(state.lockX) == "number" and type(state.lockY) == "number" then
		local target = ORIGIN + Vector3.new(state.lockX, state.lockY, 7)
		local remaining = 1 - chargeProgress(fighter, state, self.sampleAge)
		ring(fighter.reticle, target, 2.7 + remaining * 2.5, fighter.color, 0.18, math.pi / 8, 0.38)
		local from = fighter.position + Vector3.new(0, 0, 7)
		local direction = target - from
		local angle = math.atan2(direction.Y, direction.X)
		for index, dash in ipairs(fighter.aimDots) do
			dash.Size = Vector3.new(2.4, 0.25, 0.18)
			dash.CFrame = CFrame.new(from:Lerp(target, 0.35 + index * 0.12)) * CFrame.Angles(0, 0, angle)
			dash.Color, dash.Transparency = fighter.color, 0.56
		end
	else
		hide(fighter.reticle)
		hide(fighter.aimDots)
	end
	for index, streak in ipairs(fighter.speedLines) do
		if boosted then
			local side = index == 1 and -1 or 1
			local length = 6 + math.sin(self.clock * 28 + index) * 2
			streak.Size = Vector3.new(length, 0.36, 0.25)
			streak.CFrame = displayPose * CFrame.new(-10 - length * 0.2, side * 3.1, 3)
			streak.Color, streak.Transparency = COLORS.boost, 0.18
		else
			streak.Transparency = 1
		end
	end
	local tell
	if winner then tell = "WINNER!"
	elseif knockedOut then tell = "K.O.!"
	elseif hitAge &lt; 0.45 then tell = "POW!"
	elseif blockAge &lt; 0.45 then tell = "BOING!"
	elseif windup then tell = fighter.powerId == "Meteor" and "CHARGING..." or "LOCKED ON"
	elseif moving and state.phase == "Attack" then tell = fighter.powerId == "Meteor" and "DIVE!" or "FIRE!"
	elseif boosted then tell = "BOOST!" end
	fighter.gui.Enabled = tell ~= nil
	if tell and tell ~= fighter.label.Text then fighter.tellTime = self.realClock end
	fighter.label.Text = tell or ""
	-- Each new word lands oversized and settles, like a comic sound effect.
	local landed = math.clamp((self.realClock - fighter.tellTime) / 0.16, 0, 1)
	fighter.pop.Scale = self.reducedMotion and 1 or (1.7 - 0.7 * (1 - (1 - landed) ^ 3))
	fighter.label.TextColor3 = (winner or hitAge &lt; 0.45) and COLORS.yellow or COLORS.cream
	fighter.stroke.Color = (hitAge &lt; 0.45 and not winner) and COLORS.coral:Lerp(COLORS.ink, 0.35) or fighter.color:Lerp(COLORS.ink, 0.55)
	self:_signatureEffects(fighter, state, simulation, moving, displayPose)
end

function BattleView:_wakes(simulation, moving)
	local active, states = {}, {}
	if moving then
		for index, state in ipairs(simulation.wakes or {}) do
			if index &gt; WAKE_LIMIT then break end
			local id = state.id or index
			active[id] = true
			table.insert(states, { id = id, state = state })
		end
	end
	for id, wake in pairs(self.wakes) do
		if not active[id] then
			hideWake(wake)
			table.insert(self.wakePool, wake)
			self.wakes[id] = nil
		end
	end
	for _, entry in ipairs(states) do
		local state = entry.state
		local wake = self.wakes[entry.id]
		if not wake then
			wake = table.remove(self.wakePool) or makeWake(self.dynamic)
			self.wakes[entry.id] = wake
		end
		local radius = math.max(0.1, numeric(state.radius, 5))
		local life = math.max(0, numeric(state.life, 0) - self.sampleAge)
		local fraction = math.clamp(life / math.max(0.01, numeric(state.maxLife, 3.2)), 0, 1)
		local arming = numeric(state.armLeft, 0) &gt; self.sampleAge
		local center = ORIGIN + Vector3.new(numeric(state.x, 0), numeric(state.y, CENTER_Y), 4)
		local owner = self.fighters[state.owner]
		local edgeColor = owner and owner.color or COLORS.fire
		-- Keep the authoritative collision footprint fixed as it fades. These
		-- bright discs are hazardous, unlike the thin cosmetic contrails.
		wake.disc.Size = Vector3.new(0.16, radius * 2, radius * 2)
		wake.disc.CFrame = CFrame.new(center) * CFrame.Angles(0, math.pi / 2, 0)
		wake.disc.Color = arming and COLORS.yellow or COLORS.fire
		wake.disc.Transparency = life &lt;= 0 and 1 or (arming and 0.8 or (0.5 + (1 - fraction) * 0.25))
		ring(wake.edge, center + Vector3.new(0, 0, 0.2), radius, edgeColor,
			life &lt;= 0 and 1 or (arming and 0.5 or (0.12 + (1 - fraction) * 0.35)), self.clock * 0.5, 0.36)
	end
end

-- The box the camera should hold: both planes and any rocket in flight, with
-- breathing room. Close fights fill the screen; a chase pulls the lens back.
function BattleView:_frame(simulation)
	if self.reducedMotion then return 0, CENTER_Y, FULL_WIDTH, FULL_HEIGHT end
	local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
	local function include(position)
		local x, y = position.X - ORIGIN.X, position.Y - ORIGIN.Y
		minX, maxX, minY, maxY = math.min(minX, x), math.max(maxX, x), math.min(minY, y), math.max(maxY, y)
	end
	-- A knockout first belongs to the plane going down, then to the scene.
	local knockout = simulation.finished == true and simulation.reason == "knockout"
		and self.finishReal ~= nil and self.realClock - self.finishReal &lt; 1.1
	for _, fighter in pairs(self.fighters) do
		if fighter.position and (not knockout or fighter.crash) then include(fighter.position) end
	end
	if not knockout then
		for _, rocket in pairs(self.rockets) do
			if rocket.position then include(rocket.position) end
		end
	end
	if minX &gt; maxX then return 0, CENTER_Y, FULL_WIDTH, FULL_HEIGHT end
	local attacking = knockout
	for _, state in ipairs(simulation.fighters or {}) do
		if state.phase == "Windup" or state.phase == "Attack" then attacking = true end
	end
	local width = math.clamp(maxX - minX + 58, attacking and ATTACK_VIEW_WIDTH or REST_VIEW_WIDTH, FULL_WIDTH)
	local height = math.clamp(maxY - minY + 42, attacking and ATTACK_VIEW_HEIGHT or REST_VIEW_HEIGHT, FULL_HEIGHT)
	local slackX, slackY = (FULL_WIDTH - width) / 2, (FULL_HEIGHT - height) / 2
	return math.clamp((minX + maxX) / 2, -slackX, slackX),
		math.clamp((minY + maxY) / 2, CENTER_Y - slackY, CENTER_Y + slackY), width, height
end

function BattleView:_camera(rect, simulation, dt)
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	local width, height = math.max(1, viewport.X), math.max(1, viewport.Y)
	local left = math.clamp(numeric(rect and rect.left, 16), 0, width - 1)
	local top = math.clamp(numeric(rect and rect.top, 90), 0, height - 1)
	local right = math.clamp(numeric(rect and rect.right, width - 16), left + 1, width)
	local bottom = math.clamp(numeric(rect and rect.bottom, height - 80), top + 1, height)
	local regionWidth, regionHeight = math.max(1, right - left), math.max(1, bottom - top)
	local aspect = width / height
	local targetX, targetY, targetWidth, targetHeight = self:_frame(simulation)
	local view = self.view
	if not view then
		view = { x = targetX, y = targetY, width = targetWidth, height = targetHeight }
		self.view = view
	end
	-- Widen quickly so nobody leaves the frame; close in gently.
	local follow = 1 - math.exp(-6 * dt)
	local widen, tighten = 1 - math.exp(-6 * dt), 1 - math.exp(-3 * dt)
	view.x = view.x + (targetX - view.x) * follow
	view.y = view.y + (targetY - view.y) * follow
	view.width = view.width + (targetWidth - view.width) * (targetWidth &gt; view.width and widen or tighten)
	view.height = view.height + (targetHeight - view.height) * (targetHeight &gt; view.height and widen or tighten)
	local zoom = 1 - 0.07 * self.punch
	local fullHeight = math.max(view.width * zoom / (regionWidth / width) / aspect, view.height * zoom / (regionHeight / height))
	local fullWidth = fullHeight * aspect
	local shakeX = math.sin(self.realClock * 83) * self.shake
	local shakeY = math.cos(self.realClock * 97) * self.shake
	local centerX = ORIGIN.X + view.x + shakeX - ((left + right) / (2 * width) - 0.5) * fullWidth
	local centerY = ORIGIN.Y + view.y + shakeY + ((top + bottom) / (2 * height) - 0.5) * fullHeight
	-- Keep geometry close enough for Studio's lowest detail setting. A narrow
	-- lens with a far-away camera can cull the entire arena on small screens.
	local fieldOfView = math.clamp(math.deg(2 * math.atan(fullHeight / 360)), 14, 120)
	local distance = fullHeight / (2 * math.tan(math.rad(fieldOfView) / 2))
	local focus = Vector3.new(centerX, centerY, ORIGIN.Z)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = fieldOfView
	camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, 0, distance), focus)
	camera.Focus = CFrame.new(focus)
	self.folder:SetAttribute("VisibleHeight", fullHeight)
end

function BattleView:update(snapshot, dt, viewportRect)
	if self.destroyed or not snapshot then return end
	dt = math.clamp(numeric(dt, 1 / 60), 0, 0.1)
	local realDt = dt
	self.realClock = self.realClock + realDt
	if snapshot.roundId ~= self.roundId then self:_resetRound(snapshot.roundId) end
	local simulation = snapshot.simulation or {}
	if simulation.finished == true then self.finishReal = self.finishReal or self.realClock
	else self.finishReal = nil end
	-- The final blow plays in slow motion. Only this view's clock slows.
	local slowMotion = not self.reducedMotion and simulation.finished == true and simulation.reason == "knockout"
		and self.realClock - self.finishReal &lt; 0.5
	if slowMotion then dt = dt * 0.35 end
	self.clock = self.clock + dt
	self.freeze = math.max(0, self.freeze - realDt)
	self.shake = self.shake * math.exp(-9 * realDt)
	self.punch = self.punch * math.exp(-6 * realDt)
	self.screenFlash = self.screenFlash * math.exp(-11 * realDt)
	self.hype = self.hype * math.exp(-0.9 * realDt)
	self.grade.Brightness = self.screenFlash * 0.16
	self.grade.Contrast = 0.06 + self.screenFlash * 0.2
	self.grade.Saturation = slowMotion and -0.35 or 0.14
	for _, cloud in ipairs(self.clouds) do
		cloud.x = cloud.x + cloud.drift * realDt
		if cloud.x &gt; cloud.span then cloud.x = -cloud.span end
		cloud.model:PivotTo(arenaPose(cloud.x, cloud.y, cloud.z))
	end
	for _, row in ipairs(self.crowd) do
		local hop = math.abs(math.sin(self.realClock * (4 + self.hype * 7) + row.phase)) * (0.2 + self.hype * 1.7)
		row.model:PivotTo(row.base + Vector3.new(0, self.reducedMotion and 0 or hop, 0))
	end
	local elapsed = numeric(simulation.elapsed, 0)
	if elapsed ~= self.sampleElapsed then
		self.sampleElapsed, self.sampleAge = elapsed, 0
	else
		self.sampleAge = self.sampleAge + dt
	end
	local moving = snapshot.phase == "Fight" and simulation.finished ~= true
	if simulation.finished == true then self.finishTime = self.finishTime or self.clock
	else self.finishTime = nil end
	local extrapolate = moving and math.min(self.sampleAge, 0.055) or 0
	-- A freeze-frame holds every aircraft and rocket where the blow landed.
	local smoothing = self.freeze &gt; 0 and 0 or 1 - math.exp(-24 * dt)
	local states = simulation.fighters
	if not states or #states == 0 then
		states = {}
		for index = 1, 2 do
			local settings = snapshot.settings and snapshot.settings[index] or {}
			local direction = index == 1 and 1 or -1
			local angle = math.rad(numeric(settings.angle, 25))
			states[index] = { id = index, powerId = settings.powerId or (index == 1 and "Meteor" or "Firework"),
				modifierId = settings.modifierId or "None", bumperReady = settings.modifierId == "SpringBumper",
				x = -direction * 44, y = 34, vx = math.cos(angle) * direction, vy = math.sin(angle), armor = 3 }
		end
	end
	local bounds = simulation.bounds or { left = MIN_X, right = MAX_X, bottom = MIN_Y, top = MAX_Y }
	-- Ensure both event targets exist, then accept hits before drawing this
	-- frame. All stronger flashes below correspond to damage, never a bump.
	for index, state in ipairs(states) do
		if index &gt; 2 then break end
		self:_fighter(state.id or index, index)
	end
	self:_events(simulation)
	local seenFighters = {}
	for index, state in ipairs(states) do
		if index &gt; 2 then break end
		local id = state.id or index
		seenFighters[id] = true
		local fighter = self:_fighter(id, index)
		local settings = snapshot.settings and snapshot.settings[index]
		self:_setSignature(fighter, state.powerId or (settings and settings.powerId) or "Meteor")
		fighter.modifierId = state.modifierId or (settings and settings.modifierId) or "None"
		if state.phase == "Windup" and fighter.previousPhase ~= "Windup" then
			fighter.observedWindupDuration = math.max(0.01, numeric(state.phaseLeft, 1))
		end
		fighter.previousPhase = state.phase
		local vx, vy = numeric(state.vx, 0), numeric(state.vy, 0)
		if math.abs(vx) &gt; 0.1 then fighter.facing = vx &gt; 0 and 1 or -1 end
		local target = ORIGIN + Vector3.new(
			math.clamp(numeric(state.x, index == 1 and -45 or 45) + vx * extrapolate, bounds.left, bounds.right),
			math.clamp(numeric(state.y, CENTER_Y) + vy * extrapolate, bounds.bottom, bounds.top), 0)
		fighter.position = fighter.position and fighter.position:Lerp(target, smoothing) or target
		local desiredPose = poseForVelocity(fighter.position, vx, vy, fighter.facing, 0.20 + math.sin(self.clock * 3 + index) * 0.05)
		fighter.pose = fighter.pose and fighter.pose:Lerp(desiredPose, smoothing) or desiredPose
		-- Position interpolation happens once; keep turn interpolation independent.
		fighter.pose = fighter.pose.Rotation + fighter.position
		local armor = numeric(state.armor, 3)
		local displayPose = fighter.pose
		local knockedOut = simulation.finished == true and armor &lt;= 0
		if knockedOut then
			displayPose = self:_crashPose(fighter, state, target)
		else
			fighter.finishRotation, fighter.finishPosition = nil, nil
		end
		fighter.model:PivotTo(displayPose)
		local propellerPhase = knockedOut and fighter.stoppedPropeller or self.clock * (moving and 52 or 16)
		fighter.propeller:PivotTo(displayPose * CFrame.new(5.1 * SCALE, 0, 0) * CFrame.Angles(propellerPhase, 0, 0))
		if fighter.armor and armor &lt; fighter.armor then self:_hit(fighter, state.x, state.y) end
		fighter.armor = armor
		fighter.model:SetAttribute("Armor", armor)
		fighter.model:SetAttribute("Phase", state.phase or "Approach")
		fighter.model:SetAttribute("ModifierId", fighter.modifierId)
		fighter.model:SetAttribute("BumperReady", state.bumperReady == true)
		local flash = self.clock - fighter.hitTime &lt; 0.14
		fighter.body.Color = flash and COLORS.cream or (armor &lt;= 0 and fighter.color:Lerp(COLORS.steel, 0.65) or fighter.color)
		local protected = state.invulnerable == true or numeric(state.invulnerable, 0) &gt; 0
		fighter.body.Transparency = protected and 0.16 or 0
		local windup = moving and state.phase == "Windup"
		local armed = moving and state.armed == true
		local boosted = moving and numeric(state.boostLeft, 0) &gt; self.sampleAge
		fighter.noseGlow.Color = windup and COLORS.yellow or fighter.color
		fighter.noseGlow.Transparency = armed and 0.18 or (windup and (0.48 + math.sin(self.clock * 25) * 0.18) or 1)
		fighter.trail.Enabled = moving and armor &gt; 0 and vx * vx + vy * vy &gt; 4
		fighter.trail.Lifetime = fighter.look.trailLife * (armed and 1.5 or 1)
		fighter.flare.Transparency = (armed or boosted) and 0.12 or 1
		fighter.flare.Color = boosted and COLORS.boost or (fighter.powerId == "Meteor" and COLORS.yellow or fighter.color)
		fighter.flare.Size = Vector3.new(boosted and 11 or (armed and 9 or 5), boosted and 2 or 1.5, 1.5) * SCALE
		self:_fighterEffects(fighter, state, simulation, moving, displayPose)
		-- Damage shows on the airframe: smoke after one hit, fire after two.
		local hurt = (snapshot.phase == "Fight" or snapshot.phase == "Results") and 3 - armor or 0
		fighter.smokeAnchor.CFrame = displayPose * CFrame.new(-2.2 * SCALE, 0.5, 0)
		fighter.damageSmoke.Rate = knockedOut and (fighter.crashLanded and 12 or 46) or (hurt &gt;= 2 and 24 or (hurt == 1 and 10 or 0))
		fighter.damageFire.Rate = knockedOut and (fighter.crashLanded and 6 or 28) or (hurt &gt;= 2 and 16 or 0)
		for smokeIndex, puff in ipairs(fighter.smoke) do
			local smokeAge = self.clock - fighter.hitTime - (smokeIndex - 1) * 0.13
			if knockedOut and fighter.crash then
				local crash = fighter.crash
				local age = self.clock - crash.startedAt + (smokeIndex - 1) * 0.28
				local cycle = math.floor(age / 0.84)
				local sample = crash.smoke[smokeIndex]
				if not sample or sample.cycle ~= cycle then
					sample = { cycle = cycle, position = fighter.position + Vector3.new(-fighter.facing * 2, 1, 5) }
					crash.smoke[smokeIndex] = sample
				end
				local progress = age / 0.84 - cycle
				puff.Size = Vector3.one * (2 + progress * 4)
				puff.CFrame = CFrame.new(sample.position + Vector3.new(fighter.facing * progress, progress * 7, 0))
				puff.Transparency = 0.3 + progress * 0.7
			elseif smokeAge &gt;= 0 and smokeAge &lt; 0.85 then
				local progress = smokeAge / 0.85
				puff.Size = Vector3.one * (1.4 + progress * 3.2)
				puff.CFrame = displayPose * CFrame.new((-6 - progress * 4) * SCALE, 0, 0)
					+ Vector3.new(0, progress * 5, 1)
				puff.Transparency = 0.35 + progress * 0.65
			else
				puff.Transparency = 1
			end
		end
		if not moving then fighter.trail.Enabled = false end
	end
	for id, fighter in pairs(self.fighters) do
		if not seenFighters[id] then fighter.model:Destroy(); fighter.fx:Destroy(); self.fighters[id] = nil end
	end

	local seenRockets, rocketStates, rocketCount = {}, {}, 0
	for _, state in ipairs(simulation.projectiles or {}) do
		rocketCount = rocketCount + 1
		if rocketCount &gt; ROCKET_LIMIT then break end
		local id = state.id or rocketCount
		seenRockets[id] = true
		table.insert(rocketStates, { id = id, state = state })
	end
	-- Release vanished IDs before acquiring replacements, so even a complete
	-- projectile turnover cannot grow the allocation beyond ROCKET_LIMIT.
	for id, rocket in pairs(self.rockets) do
		if not seenRockets[id] then
			rocket.trail.Enabled = false
			rocket.trail:Clear()
			rocket.fizz.Rate = 0
			for _, piece in ipairs(rocket.pieces) do piece.Transparency = 1 end
			table.insert(self.rocketPool, rocket)
			self.rockets[id] = nil
		end
	end
	for _, entry in ipairs(rocketStates) do
		local id, state = entry.id, entry.state
		local rocket = self.rockets[id]
		if not rocket then
			rocket = table.remove(self.rocketPool) or makeRocket(self.dynamic)
			self.rockets[id] = rocket
			rocket.position = nil
			for _, piece in ipairs(rocket.pieces) do piece.Transparency = 0 end
			rocket.trail:Clear()
		end
		local owner = self.fighters[state.owner]
		local color = owner and owner.color or PLAYER_COLORS[tonumber(state.owner) or 1] or COLORS.yellow
		rocket.nose.Color, rocket.fin.Color, rocket.crossFin.Color = color, color, color
		for _, stripe in ipairs(rocket.stripes) do stripe.Color = color end
		local vx, vy = numeric(state.vx, 0), numeric(state.vy, 0)
		local target = ORIGIN + Vector3.new(numeric(state.x, 0) + vx * extrapolate, numeric(state.y, CENTER_Y) + vy * extrapolate, 2)
		rocket.position = rocket.position and rocket.position:Lerp(target, smoothing) or target
		local rocketPose = CFrame.new(rocket.position) * CFrame.Angles(0, 0, math.atan2(vy, vx))
		rocket.model:PivotTo(rocketPose)
		local sputter = 1 + math.sin(self.clock * 49 + numeric(tonumber(id), 0)) * 0.23
		rocket.exhaust.Size = Vector3.new(3.6 * sputter, 1.25, 1.25)
		rocket.exhaust.CFrame = rocketPose * CFrame.new(-3.9, 0, 0)
		rocket.exhaust.Transparency = moving and (0.18 + (sputter - 0.77) * 0.2) or 1
		rocket.core.Size = Vector3.new(2.4 * sputter, 0.62, 0.62)
		rocket.core.CFrame = rocketPose * CFrame.new(-3.55, 0, 0.25)
		rocket.core.Transparency = moving and 0.08 or 1
		for index, spark in ipairs(rocket.sparks) do
			local progress = (self.clock * 7 + index / 3) % 1
			spark.Size = Vector3.new(0.55 * (1 - progress) + 0.12, 0.3, 0.25)
			spark.CFrame = rocketPose * CFrame.new(-4.5 - progress * 3.5, (index % 2 == 0 and 1 or -1) * progress, 1)
			spark.Transparency = moving and progress or 1
		end
		rocket.trail.Enabled = moving
		rocket.trail.Color = ColorSequence.new(COLORS.yellow, color)
		rocket.fizz.Rate = moving and 55 or 0
		rocket.fizz.Color = ColorSequence.new(COLORS.cream, color)
	end
	self:_wakes(simulation, moving)
	for _, effect in ipairs(self.effects) do
		if effect.active then
			effect.age = effect.age + dt
			local duration = effect.style == "dive" and 0.18 or (effect.strong and 0.42 or 0.24)
			local progress = math.clamp(effect.age / duration, 0, 1)
			local radius = 2 + progress * (effect.strong and 11 or 6)
			for index, piece in ipairs(effect.pieces) do
				local angle = index / #effect.pieces * math.pi * 2
				if effect.style == "dive" then
					local forward, across = -3 + progress * 5, (index - 2) * 1.5
					piece.Size = Vector3.new(8 * (1 - progress) + 0.1, 0.45, 0.3)
					piece.CFrame = arenaPose(effect.x + math.cos(effect.heading) * forward - math.sin(effect.heading) * across,
						effect.y + math.sin(effect.heading) * forward + math.cos(effect.heading) * across, 8) * CFrame.Angles(0, 0, effect.heading)
					piece.Transparency = index &lt;= 3 and (0.2 + progress * 0.8) or 1
				elseif effect.style == "crash" then
					local groundAngle = (index - 0.5) / #effect.pieces * math.pi
					piece.Size = Vector3.new(2.8 * (1 - progress) + 0.1, 0.4, 0.3)
					piece.CFrame = arenaPose(effect.x + math.cos(groundAngle) * radius,
						effect.y + math.sin(groundAngle) * radius * 0.55 + 0.3, 10) * CFrame.Angles(0, 0, groundAngle)
					piece.Transparency = progress
				else
					local actualRadius = effect.style == "fizzle" and radius * 0.45 or radius
					piece.Size = Vector3.new((effect.strong and 3.5 or 2) * (1 - progress) + 0.1, effect.strong and 0.5 or 0.3, 0.3)
					piece.CFrame = arenaPose(effect.x + math.cos(angle) * actualRadius, effect.y + math.sin(angle) * actualRadius, 8) * CFrame.Angles(0, 0, angle)
					piece.Transparency = effect.strong and progress or (0.6 + progress * 0.4)
				end
			end
			if effect.strong then
				if effect.style == "crash" then
					for index, piece in ipairs(effect.ring) do
						local angle = (index - 0.5) / #effect.ring * math.pi
						piece.Size = Vector3.new(1.6, 0.3, 0.2)
						piece.CFrame = arenaPose(effect.x + math.cos(angle) * (2 + progress * 9),
							effect.y + math.sin(angle) * (2 + progress * 5), 10) * CFrame.Angles(0, 0, angle + math.pi / 2)
						piece.Color, piece.Transparency = effect.color, progress
					end
				else
					ring(effect.ring, ORIGIN + Vector3.new(effect.x, effect.y, 8), 2 + progress * 9,
						effect.color, progress, 0, 0.7 * (1 - progress) + 0.1)
				end
				effect.flash.Size = Vector3.new(3 + progress * 7, effect.style == "crash" and 2 or (3 + progress * 7), 0.5)
				effect.flash.CFrame = arenaPose(effect.x, effect.y + (effect.style == "crash" and 1 or 0), effect.style == "crash" and 10 or 8.5)
				effect.flash.Transparency = progress &lt; 0.3 and (0.2 + progress * 2.5) or 1
			end
			if progress &gt;= 1 then effect.active = false; hide(effect.ring); effect.flash.Transparency = 1 end
		end
	end
	local pressured = simulation.pressure == true or numeric(simulation.pressure, 0) &gt; 0
	local fieldWidth, fieldHeight = bounds.right - bounds.left, bounds.top - bounds.bottom
	local fieldX, fieldY = (bounds.left + bounds.right) / 2, (bounds.bottom + bounds.top) / 2
	self.edges[1].Size = Vector3.new(0.6, fieldHeight, 0.5)
	self.edges[1].CFrame = arenaPose(bounds.left, fieldY, -2)
	self.edges[2].Size = Vector3.new(0.6, fieldHeight, 0.5)
	self.edges[2].CFrame = arenaPose(bounds.right, fieldY, -2)
	self.edges[3].Size = Vector3.new(fieldWidth, 0.5, 0.5)
	self.edges[3].CFrame = arenaPose(fieldX, bounds.top, -2)
	self.edges[4].Size = Vector3.new(fieldWidth, 0.5, 0.5)
	self.edges[4].CFrame = arenaPose(fieldX, bounds.bottom, -2)
	local windZones = {
		{ bounds.left - MIN_X, MAX_Y - MIN_Y, (bounds.left + MIN_X) / 2, CENTER_Y },
		{ MAX_X - bounds.right, MAX_Y - MIN_Y, (MAX_X + bounds.right) / 2, CENTER_Y },
		{ fieldWidth, MAX_Y - bounds.top, fieldX, (MAX_Y + bounds.top) / 2 },
		{ fieldWidth, bounds.bottom - MIN_Y, fieldX, (bounds.bottom + MIN_Y) / 2 },
	}
	for index, zone in ipairs(windZones) do
		self.wind[index].Size = Vector3.new(math.max(0.05, zone[1]), math.max(0.05, zone[2]), 0.2)
		self.wind[index].CFrame = arenaPose(zone[3], zone[4], -5)
		self.wind[index].Transparency = pressured and (0.6 + 0.08 * math.sin(self.clock * 4 + index)) or 1
	end
	for index, edge in ipairs(self.edges) do
		edge.Color = pressured and COLORS.yellow or (index &lt;= 2 and self:accent(index) or COLORS.cream)
		edge.Transparency = pressured and (0.05 + 0.12 * math.sin(self.clock * 5)) or (index &lt;= 2 and 0.2 or 0.55)
	end
	self.folder:SetAttribute("Phase", snapshot.phase or "Configure")
	self.folder:SetAttribute("RoundId", tostring(snapshot.roundId or ""))
	self:_camera(viewportRect, simulation, realDt)
end

function BattleView:destroy()
	if self.destroyed then return end
	self.destroyed = true
	self.folder:Destroy()
	self.bloom:Destroy()
	self.grade:Destroy()
	table.clear(self.fighters)
	table.clear(self.rockets)
	table.clear(self.rocketPool)
	table.clear(self.effects)
	table.clear(self.wakes)
	table.clear(self.wakePool)
	-- The normal client camera resumes on its next render. No connections,
	-- lighting effects, delayed callbacks, or external instances survive.
end

return BattleView
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX41">
        <Properties>
          <string name="Name">BattleAudio</string>
          <ProtectedString name="Source">-- Local presentation only. Authoritative events decide which impacts are heard.
-- No per-event instances or delayed callbacks. The original pitched stock
-- voices are layered with licensed Creator Store samples and three beds.
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")

local BattleAudio = {}
BattleAudio.__index = BattleAudio
BattleAudio.VOICES_PER_SOURCE = 4
BattleAudio.VOICE_POOL_LIMIT = 16
BattleAudio.MAX_EVENTS_PER_UPDATE = 4
BattleAudio.MAX_EVENT_AGE = 0.55
BattleAudio.JOIN_GRACE = 0.3
BattleAudio.MAX_CRASH_AGE = 3

local SOURCES = {
    jump = "rbxasset://sounds/action_jump.mp3",
    boom = "rbxasset://sounds/impact_explosion_03.mp3",
    chime = "rbxasset://sounds/volume_slider.ogg",
    land = "rbxasset://sounds/action_jump_land.mp3",
}
-- Licensed one-shots from Pro Sound Effects' official Creator Store channel
-- (@ProSoundEffects): free for use in experiences, not open user uploads.
local SAMPLES = {
    thump = "rbxassetid://9116329674",    -- Low Impacts 1
    punch = "rbxassetid://9119061110",    -- Sharp Punch 2
    crunch = "rbxassetid://9120188871",   -- Toolbox Impact Wood Metal Hits Fall Crash 12
    shatter = "rbxassetid://9114591567",  -- Glass Breaks 4
    blast = "rbxassetid://9117982785",    -- Pyro Explosion 4
    bigBlast = "rbxassetid://9117982449", -- Pyro Explosion 1
    sub = "rbxassetid://9126009582",      -- Subwoofer Impact Deep Rumbling Pops Booming
    whoosh = "rbxassetid://9126229255",   -- Whoosh By Fast Airy Swooshing Whipping Thuds
    rise = "rbxassetid://9125805781",     -- Rising Whoosh Hissing Build Up Ascending
    ignite = "rbxassetid://9114446852",   -- Fire Whoosh 15
    comic = "rbxassetid://9113496949",    -- Body Hit Comic 2
    beep = "rbxassetid://9117060347",     -- Nasa Transmission Beep 1
    whistle = "rbxassetid://9125967307",  -- Soccer Whistle Acme Thunderer
    cheer = "rbxassetid://9120974378",    -- Wrestling Crowd 3
    gasp = "rbxassetid://9114013354",     -- Crowd Reaction 4
    thunder = "rbxassetid://9120018172",  -- Thunder Distant Boom Thud Rapid Hits 20
    click = "rbxassetid://9119717523",    -- Switch Click On Or Off Toggle Button 2
    -- APM Music "Champion Fanfare" (Bruton, Big Heavy Horn Riffs), @APMOfficial.
    fanfare = "rbxassetid://9043234711",
}
-- Beds. Music is APM Music's "Feel That Move" (30 second light version: 80s
-- clavinet funk) from the official @APMOfficial channel, chosen after the
-- cinematic "Rival" cue proved too dramatic; the rest are Pro Sound Effects.
local LOOPS = {
    music = "rbxassetid://9044946334",
    crowd = "rbxassetid://9119562311",    -- Stadium Crowd 2
    storm = "rbxassetid://9125742262",    -- Plasma Trails Constant Airy Whooshing Windy
}
BattleAudio.SHOTS_PER_SAMPLE = 2
BattleAudio.ROUND_TIME = 35
local KINDS = {
    launch=true, windup=true, dive=true, rocket=true, hit=true, bump=true,
    bumper_block=true, wake_hit=true, afterburner=true, finish=true, knockout=true,
}
local function finite(value)
    return type(value)=="number" and value==value and value&gt;-math.huge and value&lt;math.huge
end
local function audibleKind(event)
    if event.kind=="modifier" then
        return event.modifierId=="Afterburner" and "afterburner" or nil
    elseif event.kind=="blocked" then
        return event.modifierId=="SpringBumper" and "bumper_block" or nil
    end
    return KINDS[event.kind] and event.kind or nil
end

function BattleAudio.new()
    local self=setmetatable({voices={},nextVoice={},tweens={},lastAt={},lastSerial=0,
        key=nil,started=false,muted=false,destroyed=false,played=0,crashes={},charging={}},BattleAudio)
    self.folder=Instance.new("Folder")
    self.folder.Name="SkyboundBattleAudio"; self.folder.Parent=SoundService
    self.group=Instance.new("SoundGroup")
    self.group.Name="BattleMix"; self.group.Volume=0.7; self.group.Parent=self.folder
    local preload={}
    self.shots,self.nextShot,self.loops={}, {}, {}
    for name,id in pairs(SAMPLES) do
        local pool={}; self.shots[name]=pool
        for index=1,BattleAudio.SHOTS_PER_SAMPLE do
            local sound=Instance.new("Sound")
            sound.Name="shot_"..name..index; sound.SoundId=id; sound.Volume=0
            sound.Looped=false; sound.SoundGroup=self.group; sound.Parent=self.folder
            pool[index]=sound; preload[#preload+1]=sound
        end
    end
    for name,id in pairs(LOOPS) do
        local sound=Instance.new("Sound")
        sound.Name="loop_"..name; sound.SoundId=id; sound.Volume=0
        sound.Looped=true; sound.SoundGroup=self.group; sound.Parent=self.folder
        self.loops[name]=sound; preload[#preload+1]=sound
    end
    for name,id in pairs(SOURCES) do
        local pool={}; self.voices[name]=pool; self.nextVoice[name]=0
        for index=1,BattleAudio.VOICES_PER_SOURCE do
            local sound=Instance.new("Sound")
            sound.Name=name..index; sound.SoundId=id; sound.Volume=0
            sound.Looped=false; sound.SoundGroup=self.group; sound.Parent=self.folder
            pool[index]=sound; preload[#preload+1]=sound
        end
    end
    task.spawn(function()
        local ok=pcall(function() ContentProvider:PreloadAsync(preload) end)
        if self.destroyed or not self.folder.Parent then return end
        self.folder:SetAttribute("PreloadCompleted",ok)
    end)
    return self
end

function BattleAudio:_silence()
    for _,tween in pairs(self.tweens) do tween:Cancel() end
    self.tweens={}; self.charging={}
    for _,pool in pairs(self.voices) do
        for _,sound in ipairs(pool) do sound:Stop() end
    end
    for _,pool in pairs(self.shots or {}) do
        for _,sound in ipairs(pool) do sound:Stop() end
    end
end

-- A licensed sample at its natural length. Mocked mixes have no pools.
function BattleAudio:_shot(name,volume,speed)
    local pool=self.shots and self.shots[name]
    if not pool or self.destroyed or self.muted then return end
    local index=(self.nextShot[name] or 0)%#pool+1
    self.nextShot[name]=index
    local sound=pool[index]
    sound:Stop(); sound.TimePosition=0
    sound.Volume=volume; sound.PlaybackSpeed=speed or 1
    sound:Play()
end

function BattleAudio:_loop(name,volume,speed)
    local sound=self.loops[name]
    if self.muted then volume=0 end
    if volume&gt;0 and not sound.IsPlaying then sound:Play() end
    sound.Volume=sound.Volume+(volume-sound.Volume)*0.07
    sound.PlaybackSpeed=speed
    if volume==0 and sound.Volume&lt;0.004 and sound.IsPlaying then sound:Stop() end
end

-- Music, crowd and storm beds follow the phase every frame, including the
-- frames after a battle closes so each bed fades instead of cutting.
function BattleAudio:_ambience(snapshot)
    if not self.loops or self.destroyed then return end
    local active=type(snapshot)=="table" and snapshot.active==true
    local phase=active and snapshot.phase or nil
    local simulation=active and type(snapshot.simulation)=="table" and snapshot.simulation or nil
    local pressure=simulation and finite(simulation.pressure) and simulation.pressure or 0
    local elapsed=simulation and finite(simulation.elapsed) and simulation.elapsed or 0
    local fighting=phase=="Fight"
    local closing=fighting and pressure&gt;0
    -- The battle loop steps right back at the result so the sting can land.
    self:_loop("music",active and ((fighting or phase=="Countdown") and 0.24 or (phase=="Results" and 0.05 or 0.13)) or 0,closing and 1.04 or 1)
    self:_loop("crowd",active and ((fighting or phase=="Countdown") and 0.22 or 0.1) or 0,1)
    self:_loop("storm",closing and 0.14+pressure*0.3 or 0,1)
    if phase=="Countdown" and finite(snapshot.endsAt) then
        -- Three evenly spaced beats, however long the server's countdown is.
        local remaining=snapshot.endsAt-workspace:GetServerTimeNow()
        if self.countRound~=snapshot.roundId then
            self.countRound,self.countSpan,self.countBeat=snapshot.roundId,math.max(0.3,remaining),0
        end
        local beat=math.clamp(math.floor((1-remaining/self.countSpan)*3)+1,1,3)
        if beat&gt;self.countBeat then self.countBeat=beat; self:_shot("beep",0.5,0.85+beat*0.1) end
    elseif fighting then
        if self.ambientPhase=="Countdown" then self:_shot("whistle",0.55,1); self:_shot("cheer",0.4,1) end
        if closing and not self.wasClosing then self:_shot("thunder",0.6,1) end
        local left=math.ceil(BattleAudio.ROUND_TIME-elapsed)
        if left&lt;=5 and left&gt;0 and left~=self.lastTick then self.lastTick=left; self:_shot("beep",0.3,1.6) end
    end
    self.wasClosing=closing
    self.ambientPhase=phase
end

-- The result banner: horns and a roar for a win, a groan for a loss.
function BattleAudio:result(outcome)
    self:_stopShot("fanfare")
    if outcome=="win" then self:_shot("fanfare",0.5,1); self:_shot("cheer",0.6,1)
    elseif outcome=="lose" then self:_shot("gasp",0.55,0.85); self:_shot("thump",0.5,0.7)
    else self:_shot("whistle",0.4,0.8); self:_shot("gasp",0.35,1) end
end
function BattleAudio:_stopShot(name)
    for _,sound in ipairs(self.shots and self.shots[name] or {}) do sound:Stop() end
end

-- Menu feedback: a click for a choice, a whoosh for committing to the fight.
function BattleAudio:ui(confirm)
    self:_stopShot("fanfare")
    if confirm then self:_shot("whoosh",0.45,1.1); self:_shot("click",0.5,0.8)
    else self:_shot("click",0.5,1.15) end
end

function BattleAudio:setMuted(muted)
    if self.destroyed then return end
    self.muted=muted==true
    self.group.Volume=self.muted and 0 or 0.7
    self.folder:SetAttribute("Muted",self.muted)
    if self.muted then self:_silence() end
end

function BattleAudio:_stopCharges(actor)
    for sound,owner in pairs(self.charging or {}) do
        if not actor or owner==actor then
            if self.tweens[sound] then self.tweens[sound]:Cancel(); self.tweens[sound]=nil end
            sound:Stop(); self.charging[sound]=nil
        end
    end
end

function BattleAudio:_voice(name,volume,pitch,duration,finishPitch,swell,actor)
    if self.destroyed or self.muted or not self.folder.Parent then return end
    local pool=self.voices[name]
    if not pool then return end
    local index=self.nextVoice[name]%#pool+1
    self.nextVoice[name]=index
    local sound=pool[index]
    if self.tweens[sound] then self.tweens[sound]:Cancel() end
    -- Reusing a pooled voice transfers ownership, so a later dive cannot stop
    -- another cue that has since borrowed that same Sound.
    self.charging[sound]=swell and actor or nil
    sound:Stop(); sound.TimePosition=0
    if swell then
        -- With Quad/In pitch interpolation, mean speed is (2*start+end)/3.
        -- Fit the finite sample to the remaining windup instead of letting a
        -- longer charge go silent early. Before preload, scale the old cue.
        local endPitch=finishPitch or pitch
        local meanPitch=(2*pitch+endPitch)/3
        local fit=finite(sound.TimeLength) and sound.TimeLength&gt;0
            and sound.TimeLength/(duration*meanPitch) or 0.65/duration
        fit=math.max(0.2,math.min(2.5,fit))
        pitch=pitch*fit; finishPitch=endPitch*fit
    end
    -- Charges swell on a finite, non-looping sample. Its natural end needs no
    -- delayed callback; ordinary impacts instead decay immediately.
    sound.Volume=swell and volume*0.18 or volume; sound.PlaybackSpeed=pitch
    sound:Play()
    local tween=TweenService:Create(sound,
        TweenInfo.new(duration,Enum.EasingStyle.Quad,swell and Enum.EasingDirection.In or Enum.EasingDirection.Out),
        {Volume=swell and volume or 0,PlaybackSpeed=finishPitch or pitch})
    self.tweens[sound]=tween; tween:Play()
end

function BattleAudio:_playEvent(event,elapsed,simulation)
    if self.muted or self.destroyed then return end
    local kind=audibleKind(event)
    if not kind then return end
    local actor=event.actor==2 and 2 or 1
    local time=finite(event.at) and event.at or elapsed
    local key=kind..":"..actor
    local cooldown=(kind=="bump" and 0.3) or (kind=="windup" and 0.25) or 0.08
    if time-(self.lastAt[key] or -math.huge)&lt;cooldown then return end
    self.lastAt[key]=time
    -- Both aircraft remain audible; a small timbral difference separates them.
    local gain=actor==2 and 0.88 or 1
    local pitchShift=actor==2 and 1.06 or 1
    local function voice(name,volume,pitch,duration,finishPitch,swell)
        self:_voice(name,volume*gain,pitch*pitchShift,duration,
            finishPitch and finishPitch*pitchShift,swell,actor)
    end
    local function shot(name,volume,speed) self:_shot(name,volume*gain,speed) end
    if kind=="launch" then
        shot("whoosh",0.22,0.85)
        voice("jump",0.14,0.75,0.28,1.5)
    elseif kind=="windup" then
        local fighter=simulation.fighters and simulation.fighters[actor]
        if fighter and fighter.powerId=="Meteor" then
            -- Low rising charge, then a separate downward sweep on commitment.
            local duration=finite(fighter.windupDuration) and fighter.windupDuration&gt;0
                and math.max(0.2,math.min(3,fighter.windupDuration)) or 0.65
            local age=math.max(0,elapsed-time)
            local remaining=math.max(0.08,duration-age)
            voice("jump",0.16,0.55,remaining,1.15,true)
            voice("chime",0.055,0.7,math.min(0.48,remaining),1.0)
            shot("rise",0.42,math.clamp(1.9/remaining,0.8,2.4))
        else
            -- A tiny bright arming cue leaves space for rocket ignition.
            voice("chime",0.11,1.85,0.24,2.1)
            voice("land",0.045,2.25,0.09)
            shot("beep",0.2,1.9)
        end
    elseif kind=="dive" then
        self:_stopCharges(actor)
        -- Commitment sounds fast and weighty, but never claims an armor hit.
        voice("jump",0.25,1.65,0.46,0.55)
        voice("land",0.10,0.75,0.16,0.5)
        shot("whoosh",0.6,0.75); shot("ignite",0.35,0.9)
    elseif kind=="rocket" then
        voice("jump",0.22,1.15,0.3,1.9)
        voice("boom",0.12,2.1,0.14,1.6)
        shot("ignite",0.55,1.15)
    elseif kind=="hit" then
        if event.source=="meteor" then
            voice("boom",0.30,0.8,0.46,0.55)
            voice("land",0.30,0.55,0.18)
            -- A slam: low thump, a knuckle crack and bending metal.
            shot("thump",0.8,0.9); shot("punch",0.65,0.85); shot("crunch",0.5,0.9)
        else
            voice("boom",0.29,1.5,0.32,0.95)
            voice("land",0.21,1.05,0.13)
            -- A rocket: the bang first, then the same body blow underneath.
            shot("blast",0.7,1.1); shot("thump",0.55,1.1); shot("punch",0.4,1.15)
        end
        -- Every damaging hit breaks one armor pip and the crowd feels it.
        shot("shatter",0.34,1.1); shot("gasp",0.3,1)
    elseif kind=="bumper_block" then
        voice("jump",0.27,0.85,0.4,1.9)
        voice("chime",0.12,1.6,0.28)
        shot("comic",0.6,1)
    elseif kind=="wake_hit" then
        voice("land",0.23,1.25,0.2)
        voice("boom",0.17,1.8,0.3,1.1)
        shot("punch",0.4,1.3); shot("shatter",0.26,1.3)
    elseif kind=="afterburner" then
        voice("jump",0.17,0.65,0.32,1.8)
    elseif kind=="bump" then
        -- A normal collision pushes without armor loss: never use the hit mix.
        voice("land",0.065,1.55,0.11)
        shot("comic",0.26,1.35)
    elseif kind=="knockout" or (kind=="finish" and simulation.reason=="knockout") then
        self:_stopCharges()
        -- Armor breaking ends the fight. The heavier ground thud belongs to
        -- playCrash, when the defeated plane actually reaches the floor.
        voice("boom",0.13,1.25,0.24,0.85)
        voice("chime",0.21,0.95,0.48,1.4)
        -- The finishing blow is its own, larger sound, and the stands erupt.
        shot("bigBlast",0.85,0.9); shot("sub",0.9,1); shot("cheer",0.7,1)
    elseif kind=="finish" then
        self:_stopCharges()
        voice("land",0.12,0.9,0.2)
        voice("chime",0.23,1.1,0.5)
        shot("whistle",0.55,0.9); shot("cheer",0.5,1)
    end
    self.played=self.played+1
    self.folder:SetAttribute("PlayedEvents",self.played)
    self.folder:SetAttribute("LastEvent",kind)
end

function BattleAudio:playCrash(roundId,actor)
    if self.destroyed or not self.key or tostring(roundId)~=self.key
        or (actor~=1 and actor~=2) or self.phase~="Results" or not self.crashAllowed
        or not self.resultsAt or os.clock()-self.resultsAt&gt;BattleAudio.MAX_CRASH_AGE
        or not self.resultArmor or not finite(self.resultArmor[actor]) or self.resultArmor[actor]&gt;0
        or self.crashes[actor] then return false end
    -- Consume muted landings too: unmuting must never replay an old crash.
    self.crashes[actor]=true
    if self.muted then return false end
    local gain=actor==2 and 0.88 or 1
    self:_voice("land",0.38*gain,0.5,0.24,0.4)
    self:_voice("boom",0.26*gain,0.62,0.48,0.45)
    self:_shot("crunch",0.85*gain,0.75); self:_shot("thump",0.8*gain,0.8)
    self.played=self.played+1
    self.folder:SetAttribute("PlayedEvents",self.played)
    self.folder:SetAttribute("LastEvent","crash")
    return true
end

function BattleAudio:stop()
    if self.destroyed then return end
    self:_silence()
    self.key=nil; self.started=false; self.lastSerial=0; self.lastAt={}
    self.phase=nil; self.sawFight=false; self.resultsAt=nil; self.crashAllowed=false
    self.resultArmor=nil; self.crashes={}
end

function BattleAudio:update(snapshot)
    if self.destroyed then return end
    self:_ambience(snapshot)
    if type(snapshot)~="table" or snapshot.active~=true then
        if self.key then self:stop() end
        return
    end
    local key=tostring(snapshot.roundId)
    if self.key~=key then self:stop(); self.key=key end
    local phase=snapshot.phase
    local previousPhase=self.phase
    self.phase=phase
    self.crashAllowed=false
    -- newRound already contains launch events during setup. Leave their cursor
    -- untouched until the actual fight starts; Configure/Countdown stay quiet.
    if phase~="Fight" and phase~="Results" then return end
    local simulation=snapshot.simulation
    if type(simulation)~="table" then return end
    if phase=="Fight" then
        self.sawFight=true
    elseif phase=="Results" then
        if previousPhase~="Results" then self.resultsAt=os.clock(); self:_stopCharges() end
        self.crashAllowed=self.sawFight==true and simulation.finished==true and simulation.reason=="knockout"
        self.resultArmor={}
        for index,fighter in ipairs(simulation.fighters or {}) do
            if index&gt;2 then break end
            self.resultArmor[fighter.id or index]=fighter.armor
        end
    end
    local elapsed=finite(simulation.elapsed) and simulation.elapsed or 0
    local events=type(simulation.events)=="table" and simulation.events or {}
    local skipHistory=not self.started and (phase=="Results" or elapsed&gt;BattleAudio.JOIN_GRACE)
    self.started=true
    local newest=self.lastSerial
    local pending={}
    for index=1,math.min(#events,32) do
        local event=events[index]
        local serial=type(event)=="table" and event.serial
        if finite(serial) and serial&gt;self.lastSerial then
            newest=math.max(newest,serial)
            local age=finite(event.at) and elapsed-event.at or 0
            if not skipHistory and age&gt;=-0.001 and age&lt;=BattleAudio.MAX_EVENT_AGE
                and audibleKind(event) then pending[#pending+1]=event end
        end
    end
    -- Cursors advance even while muted, for unknown events, and stale batches.
    self.lastSerial=newest
    table.sort(pending,function(a,b) return a.serial&lt;b.serial end)
    -- Keep the freshest feedback after a delivery stall; never burst the full
    -- server history. Its serial order preserves a hit followed by its finish.
    for index=math.max(1,#pending-BattleAudio.MAX_EVENTS_PER_UPDATE+1),#pending do
        self:_playEvent(pending[index],elapsed,simulation)
    end
end

function BattleAudio:destroy()
    if self.destroyed then return end
    self:stop(); self.destroyed=true
    self.folder:Destroy()
    self.voices={}; self.nextVoice={}
end

return BattleAudio
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Lighting" referent="RBX42">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="ClockTime">14</float>
      <float name="Brightness">2</float>
    </Properties>
  </Item>
</roblox>