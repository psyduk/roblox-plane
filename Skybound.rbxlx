	stroke(self.powerFlightBadge, COLORS.ink, 2)
	self.powerFlightText = label(self.powerFlightBadge, "PowerState", "PINBALL · 3 BOUNCES", 9, 3, 282, 25, 13, COLORS.ink, true)
	self.powerFlightText.Font = Enum.Font.FredokaOne
